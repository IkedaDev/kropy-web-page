---
const currentYear = new Date().getFullYear() || 2026;
---

<footer
  class="border-t border-slate-200/60 bg-slate-50/50 py-16 transition-all duration-300 dark:border-neutral-800/60 dark:bg-neutral-950/40"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Sección de rejilla principal -->
    <div
      class="grid grid-cols-1 gap-12 border-b border-slate-200/60 pb-12 md:grid-cols-2 lg:grid-cols-6 dark:border-neutral-800/60"
    >
      <!-- Columna 1: Branding y Estado (Ancho 2 columnas) -->
      <div class="space-y-6 lg:col-span-2">
        <a href="/" class="flex items-center gap-2 text-xl font-extrabold tracking-tighter">
          <div class="h-6 w-6 rounded-md bg-emerald-600 shadow-[0_4px_12px_rgba(5,150,105,0.4)]">
          </div>
          <span class="text-slate-950 dark:text-white">KROPY</span>
        </a>
        <p class="max-w-sm text-sm leading-relaxed font-light text-slate-500 dark:text-neutral-400">
          Ingeniería de software y diseño web de alto impacto. Creamos herramientas digitales
          rápidas, seguras y optimizadas para el crecimiento de tu marca.
        </p>

        <!-- Indicador de Estado Operativo Premium -->
        <div
          class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/10 bg-emerald-500/5 px-3 py-1 text-[11px] font-semibold text-emerald-600 dark:border-emerald-500/20 dark:text-emerald-400"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          Sistemas 100% operativos
        </div>
      </div>

      <!-- Columna 2: Productos -->
      <div class="space-y-4">
        <h4
          class="text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >
          Productos
        </h4>
        <ul class="space-y-3 text-sm font-light">
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Landing Pages</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >E-commerces</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Proyectos a Medida</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Menús QR</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 3: Servicios Especiales -->
      <div class="space-y-4">
        <h4
          class="text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >
          Servicios
        </h4>
        <ul class="space-y-3 text-sm font-light">
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Apps Móviles</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >APIs & Microservicios</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Diseño UI/UX</a
            >
          </li>
          <li>
            <a
              href="/servicios"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Consultoría</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 4: Información -->
      <div class="space-y-4">
        <h4
          class="text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >
          Soporte e Info
        </h4>
        <ul class="space-y-3 text-sm font-light">
          <li>
            <a
              href="/information/infrastructure"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Infraestructura</a
            >
          </li>
          <li>
            <a
              href="/information/sla"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Garantía y SLA</a
            >
          </li>
          <li>
            <a
              href="/nosotros#faq"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Preguntas FAQ</a
            >
          </li>
          <li>
            <a
              href="/contacto"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Contacto directo</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 5: Marco Legal -->
      <div class="space-y-4">
        <h4
          class="text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >
          Legal
        </h4>
        <ul class="space-y-3 text-sm font-light">
          <li>
            <a
              href="/legal/terms"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Términos de Uso</a
            >
          </li>
          <li>
            <a
              href="/legal/services"
              class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-neutral-300 dark:hover:text-emerald-400"
              >Contratación</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Sección de Copyright e Iconos de Redes Sociales -->
    <div
      class="mx-auto flex flex-col items-center justify-between gap-6 pt-8 text-xs font-medium text-slate-400 sm:flex-row dark:text-neutral-500"
    >
      <!-- Derechos Reservados -->
      <div>
        © {currentYear} Kropy Labs. Todos los derechos reservados. Diseñado en Chile.
      </div>

      <!-- Redes Sociales Refinadas con Iconos SVG Limpios -->
      <div class="flex gap-4">
        <!-- LinkedIn -->
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-slate-200 bg-white p-2 text-slate-400 transition-all duration-300 hover:border-emerald-600/30 hover:text-emerald-600 hover:shadow-lg hover:shadow-emerald-600/5 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500 dark:hover:border-emerald-400/30 dark:hover:text-emerald-400"
          aria-label="LinkedIn de Kropy"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path>
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-slate-200 bg-white p-2 text-slate-400 transition-all duration-300 hover:border-emerald-600/30 hover:text-emerald-600 hover:shadow-lg hover:shadow-emerald-600/5 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500 dark:hover:border-emerald-400/30 dark:hover:text-emerald-400"
          aria-label="Instagram de Kropy"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            ></path>
          </svg>
        </a>

        <!-- Twitter / X -->
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-slate-200 bg-white p-2 text-slate-400 transition-all duration-300 hover:border-emerald-600/30 hover:text-emerald-600 hover:shadow-lg hover:shadow-emerald-600/5 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500 dark:hover:border-emerald-400/30 dark:hover:text-emerald-400"
          aria-label="Twitter de Kropy"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
