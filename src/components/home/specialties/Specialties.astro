<script>
  import { animate, stagger } from "animejs";

  function initScrollAnimations() {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (entry.target.id === "specialties-section") {
            animate("#specialties-header", {
              y: [20, 0],
              opacity: [0, 1],
              ease: "outCubic",
              duration: 800,
            });

            animate(".specialty-card", {
              y: [30, 0],
              opacity: [0, 1],
              ease: "outElastic(1, .8)",
              duration: 1200,
              delay: stagger(100, { start: 300 }),
            });

            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);

    const specialtiesSection = document.getElementById("specialties-section");
    if (specialtiesSection) observer.observe(specialtiesSection);
  }

  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>
