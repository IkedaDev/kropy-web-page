---
import type { Product } from "@interfaces/product";
import PricingCard from "./PricingCard.astro";

const products: Product[] = [
  {
    title: "Landing Pages",
    price: "120.000",
    features: [
      "4 Secciones a elegir",
      "Dominio .cl por un año",
      "2 Correos corporativos",
      "Certificado SSL",
      "Mapa de ubicacion",
      "Adaptado a mobiles",
      "Boton flotante a Whatsapp",
      "Enlace a redes sociales",
    ],
    href: "/contacto",
    buttonText: "Adquirir",
    buttonVariant: "dark" as const,
  },
  {
    title: "E-commerces",
    price: "400.000",
    isRecommended: true,
    features: [
      "6 Secciones a elegir",
      "Dominio .cl por un año",
      "4 Correos corporativos",
      "Certificado SSL",
      "Mapa de ubicacion",
      "Adaptado a mobiles",
      "Boton flotante a Whatsapp",
      "Sistema de productos administrable",
      "Carrito de compras",
      "Capacitacion de uso",
    ],
    href: "/contacto",
    buttonText: "Comenzar",
    buttonVariant: "emerald" as const,
  },
  {
    title: "Customs",
    price: "100.000",
    pricePrefix: "Desde",
    features: [
      "Estructuras y funcionalidades a medida",
      "Integraciones avanzadas",
      "Certificado SSL",
      "Adaptado a mobiles",
    ],
    href: "/contacto",
    buttonText: "Cotizar",
    buttonVariant: "outline" as const,
  },
];
---

<section id="pricing-section" class="bg-slate-50 py-20 transition-colors dark:bg-neutral-900/50">
  <div class="mx-auto max-w-6xl px-4 text-center">
    <div id="services-header" class="opacity-0">
      <span
        class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
      >
        Nuestros Productos
      </span>
      <h1 class="mb-16 text-4xl font-extrabold tracking-tight md:text-5xl">
        Tarifas Transparentes
      </h1>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {products.map((product) => <PricingCard {...product} />)}
    </div>
  </div>
</section>

<script>
  import { createTimeline, stagger } from "animejs";

  function initScrollAnimations() {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (entry.target.id === "pricing-section") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 1000 },
            });

            tl.add("#services-header", { y: [30, 0], opacity: [0, 1] }, 0).add(
              ".pricing-card",
              { y: [40, 0], opacity: [0, 1], delay: stagger(150) },
              "-=600"
            );

            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);

    const pricingSection = document.getElementById("pricing-section");
    if (pricingSection) observer.observe(pricingSection);
  }

  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>
