---

---
<section id="contacto" class="py-24 bg-white">
            <div class="max-w-4xl mx-auto px-4">
                <div class="text-center mb-16">
                    <h2 class="text-4xl font-extrabold mb-4 tracking-tight">Hablemos de tu proyecto.</h2>
                    <p class="text-slate-500">Completa el formulario y un arquitecto de Kropy te contactará en menos de 24 horas.</p>
                </div>
                <form class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Nombre Completo</label>
                            <input type="text" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:border-emerald-600 transition-colors" placeholder="Ej: Juan Pérez">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Email Corporativo</label>
                            <input type="email" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:border-emerald-600 transition-colors" placeholder="juan@empresa.com">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">¿Cómo podemos ayudarte?</label>
                        <textarea rows="4" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:border-emerald-600 transition-colors" placeholder="Cuéntanos brevemente sobre tu negocio..."></textarea>
                    </div>
                    <button type="submit" class="w-full bg-emerald-600 text-white font-bold py-4 rounded-xl hover:bg-emerald-700 transition-all shadow-xl shadow-emerald-600/20">Enviar Solicitud</button>
                </form>
            </div>
        </section>