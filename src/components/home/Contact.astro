---

---

<section id="contacto" class="bg-white py-24">
  <div class="mx-auto max-w-4xl px-4">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-4xl font-extrabold tracking-tight">Hablemos de tu proyecto.</h2>
      <p class="text-slate-500">
        Completa el formulario y un arquitecto de Kropy te contactará en menos de 24 horas.
      </p>
    </div>
    <form class="space-y-6">
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label class="mb-2 block text-xs font-bold tracking-widest text-slate-400 uppercase"
            >Nombre Completo</label
          >
          <input
            type="text"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition-colors focus:border-emerald-600 focus:outline-none"
            placeholder="Ej: Juan Pérez"
          />
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold tracking-widest text-slate-400 uppercase"
            >Email Corporativo</label
          >
          <input
            type="email"
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition-colors focus:border-emerald-600 focus:outline-none"
            placeholder="juan@empresa.com"
          />
        </div>
      </div>
      <div>
        <label class="mb-2 block text-xs font-bold tracking-widest text-slate-400 uppercase"
          >¿Cómo podemos ayudarte?</label
        >
        <textarea
          rows="4"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition-colors focus:border-emerald-600 focus:outline-none"
          placeholder="Cuéntanos brevemente sobre tu negocio..."></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-xl bg-emerald-600 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-all hover:bg-emerald-700"
        >Enviar Solicitud</button
      >
    </form>
  </div>
</section>
