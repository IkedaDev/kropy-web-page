<section id="mv" class="bg-slate-50 py-24 transition-colors dark:bg-neutral-900/50">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-12 md:grid-cols-2">
      <div
        class="mv-card rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-all hover:shadow-md dark:border-neutral-800 dark:bg-neutral-950"
      >
        <div
          class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
        >
          🎯
        </div>
        <h3 class="mb-4 text-2xl font-bold">Nuestra Misión</h3>
        <p class="leading-relaxed text-slate-500 dark:text-neutral-400">
          Democratizar el acceso a software de alta gama mediante un modelo transparente. Queremos
          que emprendedores y empresas tengan sitios que respiren calidad técnica sin la carga de
          gestionar infraestructura.
        </p>
      </div>
      <div
        class="mv-card rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-all hover:shadow-md dark:border-neutral-800 dark:bg-neutral-950"
      >
        <div
          class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
        >
          👁️
        </div>
        <h3 class="mb-4 text-2xl font-bold">Nuestra Visión</h3>
        <p class="leading-relaxed text-slate-500 dark:text-neutral-400">
          Convertirnos en el estándar global de soluciones "Web-as-a-Service", siendo reconocidos
          por nuestra arquitectura invisible y potente que permite a las marcas florecer.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { createTimeline, stagger } from "animejs";

  function initScrollAnimations() {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observerMV = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          console.log("1");
          if (entry.target.id === "mv") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 2000 },
            });

            tl.add(
              ".mv-card",
              { y: [-80, 0], opacity: [0, 1], delay: stagger(200, { start: 200 }) },
              0
            );
            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);
    const mvSection = document.getElementById("mv");
    if (mvSection) observerMV.observe(mvSection);
  }

  // Asegura la compatibilidad con el ClientRouter / ViewTransitions de Astro
  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>
