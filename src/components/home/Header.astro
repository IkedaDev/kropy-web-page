---
interface NavLink {
  href: string;
  label: string;
}

const navLinks: NavLink[] = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/portafolio", label: "Portafolio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/contacto", label: "Contacto" },
  { href: "/blog", label: "Blog" },
];
---

<header class="fixed top-0 left-0 z-50 w-full py-5 transition-all duration-300" id="main-header">
  <div class="mx-auto max-w-6xl px-4">
    <nav
      class="glass flex items-center justify-between rounded-full border border-slate-200/50 px-6 py-3 shadow-sm transition-colors dark:border-neutral-800/80"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-xl font-extrabold tracking-tighter">
        <div class="h-6 w-6 rounded-md bg-emerald-600 shadow-[0_4px_10px_rgba(5,150,105,0.3)]">
        </div>
        <span class="text-slate-950 dark:text-white">KROPY</span>
      </a>

      <!-- Navegación -->
      <ul class="hidden list-none gap-8 md:flex">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="nav-link text-xs font-bold tracking-widest text-slate-500 uppercase transition-colors hover:text-emerald-600 dark:text-neutral-400 dark:hover:text-emerald-400"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Acciones -->
      <div class="flex items-center gap-4">
        <!-- Toggle de Tema con Animación Circular -->
        <button
          id="theme-toggle"
          class="relative z-50 rounded-full p-2 transition-colors hover:bg-slate-100 dark:hover:bg-neutral-900"
          aria-label="Cambiar Tema"
        >
          <!-- Icono Sol (Modo Claro) -->
          <svg
            id="theme-toggle-light-icon"
            class="hidden h-4 w-4 text-emerald-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
            ></path>
          </svg>
          <!-- Icono Luna (Modo Oscuro) -->
          <svg
            id="theme-toggle-dark-icon"
            class="hidden h-4 w-4 text-slate-500 dark:text-neutral-400"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>

        <a
          href="/contacto"
          class="rounded-full bg-emerald-600 px-5 py-2.5 text-xs font-bold text-white shadow-lg shadow-emerald-600/20 transition-all hover:bg-emerald-700"
          >Empezar</a
        >

        <!-- Hamburguesa Móvil -->
        <button id="mobile-menu-btn" class="p-2 text-slate-600 md:hidden dark:text-neutral-400">
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"
            ></path></svg
          >
        </button>
      </div>
    </nav>
  </div>

  <!-- Menú Móvil -->
  <div
    id="mobile-menu"
    class="glass mx-4 mt-2 flex hidden flex-col gap-3 rounded-2xl border border-slate-200/50 p-4 text-center shadow-lg transition-colors md:hidden dark:border-neutral-800/80"
  >
    {
      navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="py-2 text-xs font-bold text-slate-700 uppercase dark:text-neutral-200"
        >
          {label}
        </a>
      ))
    }
  </div>
</header>

<style is:global>
  /* Clases locales para el efecto Glassmorphic */
  .glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .dark .glass {
    background: rgba(12, 12, 12, 0.85);
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* --- ANIMACIÓN ESTILO TELEGRAM (VIEW TRANSITIONS RESETS) --- */
  ::view-transition-image-pair(root) {
    isolation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
    display: block;
  }
</style>
<script>
  let scrollHandler: () => void;

  // 1. Función para leer localStorage/sistema y aplicar la clase correspondiente
  const applyTheme = () => {
    const localStorageTheme = localStorage.getItem("theme");
    const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

    if (localStorageTheme === "dark" || (!localStorageTheme && systemPrefersDark)) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };

  document.addEventListener("astro:after-swap", applyTheme);

  // 3. Configurar el resto de la interactividad al cargar la página
  document.addEventListener("astro:page-load", () => {
    applyTheme();

    const toggleBtn = document.getElementById("theme-toggle");
    const lightIcon = document.getElementById("theme-toggle-light-icon");
    const darkIcon = document.getElementById("theme-toggle-dark-icon");

    function updateIcons() {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        lightIcon?.classList.remove("hidden");
        darkIcon?.classList.add("hidden");
      } else {
        lightIcon?.classList.add("hidden");
        darkIcon?.classList.remove("hidden");
      }
    }

    // Sincronizar los iconos del botón según el estado real del HTML
    updateIcons();

    // Función de toggle del tema estándar
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateIcons();
    };

    // Evento de click para el cambio de tema
    toggleBtn?.addEventListener("click", (event) => {
      if (
        !document.startViewTransition ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        toggleTheme();
        return;
      }

      const x = event.clientX;
      const y = event.clientY;

      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = document.startViewTransition(() => {
        toggleTheme();
      });

      transition.ready.then(() => {
        document.documentElement.animate(
          {
            clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`],
          },
          {
            duration: 600,
            easing: "cubic-bezier(0.8, 1, 0.6, 0.8)",
            pseudoElement: "::view-transition-new(root)",
          }
        );
      });
    });

    // --- Control menú móvil ---
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    menuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
    });

    // --- Marcar enlace activo según la url ---
    const path = window.location.pathname;
    document.querySelectorAll(".nav-link").forEach((link) => {
      const href = link.getAttribute("href");
      if (href === path) {
        link.classList.remove("text-slate-500", "dark:text-neutral-400");
        link.classList.add("text-emerald-600", "dark:text-emerald-400");
      }
    });

    // --- Animación suave del header al hacer scroll ---
    const header = document.getElementById("main-header");

    if (scrollHandler) {
      window.removeEventListener("scroll", scrollHandler);
    }

    scrollHandler = () => {
      if (!header) return;
      if (window.scrollY > 50) {
        header.classList.remove("py-5");
        header.classList.add("py-2");
      } else {
        header.classList.remove("py-2");
        header.classList.add("py-5");
      }
    };

    window.addEventListener("scroll", scrollHandler);
    scrollHandler();
  });
</script>
