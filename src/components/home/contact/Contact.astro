---
import ContactInfo from "./ContactInfo.astro";
import ContactForm from "./ContactForm.astro";
import Modal from "../Modal.astro";
---

<section id="contact-section" class="bg-white py-16 transition-colors lg:py-24 dark:bg-neutral-950">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <ContactInfo />
      <ContactForm />
    </div>
  </div>
</section>

<Modal />
<script>
  import { createTimeline, stagger } from "animejs";

  function initContactAnimations() {
    const observerOptions = { root: null, rootMargin: "0px", threshold: 0.2 };
    const observerContact = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target.id === "contact-section") {
          const tl = createTimeline({ defaults: { ease: "outExpo", duration: 1200 } });

          // Sintaxis correcta AnimeJS v4: tl.add(target, parameters, offset)
          tl.add(".anim-contact-item", { opacity: [0, 1], y: [30, 0], delay: stagger(150) }, 0);

          tl.add("#contact-form-box", { opacity: [0, 1], x: [140, 0] }, 0);

          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const contactSection = document.getElementById("contact-section");
    if (contactSection) observerContact.observe(contactSection);

    // Lógica global para conectar el Formulario con el Modal
    const form = document.getElementById("contact-form");
    const modal = document.getElementById("success-modal");

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      modal?.classList.remove("hidden");
      (form as HTMLFormElement).reset();

      // Restablecer visualmente el selector a persona clickeando el botón (si existe)
      document.getElementById("btn-client-persona")?.click();
    });
  }

  document.addEventListener("astro:page-load", initContactAnimations);
</script>
