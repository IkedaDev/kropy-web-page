---

---

<div
  id="contact-form-box"
  class="rounded-3xl border border-slate-200/60 bg-slate-50/40 p-8 opacity-0 transition-colors sm:p-10 lg:col-span-7 dark:border-neutral-800/60 dark:bg-neutral-900/20"
>
  <form class="space-y-6" id="contact-form">
    <input type="hidden" name="subject" value="🚀 Nuevo Lead desde Kropy Web" />
    <input type="hidden" name="from_name" value="Kropy Notificaciones" />

    <div class="space-y-3">
      <label
        class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >¿Quién nos escribe?</label
      >
      <div
        class="grid grid-cols-2 gap-2 rounded-2xl border border-slate-200/40 bg-slate-100 p-1.5 dark:border-neutral-800/40 dark:bg-neutral-900/80"
      >
        <button
          type="button"
          id="btn-client-persona"
          class="client-type-btn rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all duration-200"
          data-type="persona">Persona / Freelancer</button
        >
        <button
          type="button"
          id="btn-client-empresa"
          class="client-type-btn rounded-xl px-4 py-2.5 text-xs font-bold tracking-wider text-slate-500 uppercase transition-all duration-200 hover:text-slate-900 dark:text-neutral-400 dark:hover:text-white"
          data-type="empresa">Empresa / Organización</button
        >
      </div>
      <input type="hidden" id="form-client-type" name="Tipo de Cliente" value="persona" />
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-2">
        <label
          class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
          id="label-name">Tu Nombre</label
        >
        <input
          required
          type="text"
          id="form-name"
          name="Nombre"
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
          placeholder="Ej: Juan Pérez"
        />
      </div>
      <div class="space-y-2">
        <label
          class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
          >Correo de Contacto</label
        >
        <input
          required
          type="email"
          id="form-email"
          name="email"
          class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
          placeholder="juan@correo.com"
        />
      </div>
    </div>

    <div class="hidden space-y-2" id="company-field-container">
      <label
        class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        >Nombre de la Empresa o Startup</label
      >
      <input
        type="text"
        id="form-company"
        name="Empresa"
        class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
        placeholder="Ej: Innova SpA"
      />
    </div>

    <div class="space-y-2">
      <label
        class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
        id="label-message">Cuéntanos sobre tu idea</label
      >
      <textarea
        required
        id="form-message"
        name="message"
        rows="4"
        class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
        placeholder="Necesito levantar una landing page para validar mi servicio..."></textarea>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-all duration-300 hover:bg-emerald-700"
    >
      <span id="submit-text">Enviar Solicitud</span>
      <svg
        id="submit-spinner"
        class="hidden h-5 w-5 animate-spin text-white"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        ><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle><path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path></svg
      >
    </button>
  </form>
</div>

<script>
  // Accedemos a la variable de entorno desde el lado del front/compilación de Astro
  const API_KEY = import.meta.env.PUBLIC_API_EMAIL_URL || "";
  const API_EMAIL_KEY_PROVIDER = import.meta.env.PUBLIC_API_EMAIL_KEY_PROVIDER || "";

  function initFormLogic() {
    const btnPersona = document.getElementById("btn-client-persona");
    const btnEmpresa = document.getElementById("btn-client-empresa");
    const clientTypeInput = document.getElementById("form-client-type") as HTMLInputElement;
    const companyFieldContainer = document.getElementById("company-field-container");
    const companyInput = document.getElementById("form-company") as HTMLInputElement;
    const labelName = document.getElementById("label-name");
    const labelMessage = document.getElementById("label-message");
    const inputMessage = document.getElementById("form-message") as HTMLTextAreaElement;

    // Referencias para el envío
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const submitText = document.getElementById("submit-text");
    const submitSpinner = document.getElementById("submit-spinner");
    const successModal = document.getElementById("success-modal");

    function setClientType(type: "persona" | "empresa") {
      if (clientTypeInput) clientTypeInput.value = type;
      if (type === "persona") {
        btnPersona?.classList.add("bg-emerald-600", "text-white", "shadow-sm");
        btnPersona?.classList.remove(
          "text-slate-500",
          "dark:text-neutral-400",
          "hover:text-slate-900",
          "dark:hover:text-white"
        );
        btnEmpresa?.classList.remove("bg-emerald-600", "text-white", "shadow-sm");
        btnEmpresa?.classList.add(
          "text-slate-500",
          "dark:text-neutral-400",
          "hover:text-slate-900",
          "dark:hover:text-white"
        );
        companyFieldContainer?.classList.add("hidden");
        if (companyInput) companyInput.required = false;
        if (labelName) labelName.innerText = "Tu Nombre";
        if (labelMessage) labelMessage.innerText = "Cuéntanos sobre tu idea";
        if (inputMessage)
          inputMessage.placeholder =
            "Necesito levantar una landing page para validar mi servicio...";
      } else {
        btnEmpresa?.classList.add("bg-emerald-600", "text-white", "shadow-sm");
        btnEmpresa?.classList.remove(
          "text-slate-500",
          "dark:text-neutral-400",
          "hover:text-slate-900",
          "dark:hover:text-white"
        );
        btnPersona?.classList.remove("bg-emerald-600", "text-white", "shadow-sm");
        btnPersona?.classList.add(
          "text-slate-500",
          "dark:text-neutral-400",
          "hover:text-slate-900",
          "dark:hover:text-white"
        );
        companyFieldContainer?.classList.remove("hidden");
        if (companyInput) companyInput.required = true;
        if (labelName) labelName.innerText = "Nombre de contacto";
        if (labelMessage) labelMessage.innerText = "Cuéntanos sobre tu requerimiento de software";
        if (inputMessage)
          inputMessage.placeholder =
            "Buscamos reestructurar nuestra plataforma administrativa actual y crear una API externa...";
      }
    }

    btnPersona?.addEventListener("click", () => setClientType("persona"));
    btnEmpresa?.addEventListener("click", () => setClientType("empresa"));

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (submitBtn) submitBtn.disabled = true;
      if (submitText) submitText.innerText = "Procesando...";
      submitSpinner?.classList.remove("hidden");

      // Obtenemos los valores limpios del formulario nativo
      const clientType = clientTypeInput?.value || "persona";
      const name = (document.getElementById("form-name") as HTMLInputElement).value;
      const email = (document.getElementById("form-email") as HTMLInputElement).value;
      const company = companyInput?.value || "No especificada";
      const message = inputMessage?.value;

      // Construcción dinámica del HTML Content dependiendo del tipo de cliente
      let htmlContent = `
        <div style="font-family: sans-serif; padding: 20px; color: #333; max-width: 600px; border: 1px solid #eee; border-radius: 12px;">
          <h2 style="color: #10b981; margin-bottom: 20px;">🚀 Nuevo Lead desde Kropy Web</h2>
          <p><strong>Tipo de Cliente:</strong> ${clientType === "empresa" ? "🏢 Empresa / Organización" : "👤 Persona / Freelancer"}</p>
          <p><strong>Nombre:</strong> ${name}</p>
          <p><strong>Correo de Contacto:</strong> <a href="mailto:${email}">${email}</a></p>
      `;

      if (clientType === "empresa") {
        htmlContent += `<p><strong>Empresa/Startup:</strong> ${company}</p>`;
      }

      htmlContent += `
          <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;" />
          <p><strong>Mensaje / Idea:</strong></p>
          <blockquote style="background: #f9f9f9; padding: 15px; border-left: 4px solid #10b981; margin: 0; border-radius: 4px;">
            ${message.replace(/\n/g, "<br>")}
          </blockquote>
        </div>
      `;

      // Payload estructurado exactamente como lo requiere tu API centralizada
      const payload = {
        apikey: API_KEY,
        sender: {
          name: "Kropy Labs",
          email: "sebaaignacio111@gmail.com",
        },
        to: [
          {
            name: "Sebastian Torrealba",
            email: "sebaaignacio111@gmail.com",
          },
        ],
        subject: `Nuevo mensaje de ${name} (${clientType === "empresa" ? company : "Freelancer"})`,
        htmlContent: htmlContent,
      };

      try {
        const response = await fetch(`${API_EMAIL_KEY_PROVIDER}/v1/emails/send`, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          form.reset();
          setClientType("persona");
          successModal?.classList.remove("hidden");
        } else {
          const data = await response.json();
          console.error("Error al enviar desde la API:", data);
          alert("Hubo un problema al enviar la solicitud. Por favor intenta de nuevo.");
        }
      } catch (error) {
        console.error("Error de red:", error);
        alert("Ocurrió un error de red al conectar con el servidor de correos.");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.innerText = "Enviar Solicitud";
        submitSpinner?.classList.add("hidden");
      }
    });
  }

  document.addEventListener("astro:page-load", initFormLogic);
</script>
