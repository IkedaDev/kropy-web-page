---
// src/components/blog/BlogCard.astro

interface Props {
  id: string;
  title: string;
  description: string;
  image?: string;
  tags: string[];
  classList: string;
}

const { id, title, description, image, tags, classList } = Astro.props;
---

<a
  href={`/blog/${id}`}
  class=`group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition-transform hover:shadow-md dark:border-neutral-800 dark:bg-neutral-950 ${classList}`
>
  {
    image && (
      <div class="overflow-hidden">
        {" "}
        <img
          src={image}
          alt={title}
          class="rouded-tl-3xl rouded-tr-3xl h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="p-8">
    <div class="mb-4 flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <span class="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold tracking-widest text-emerald-600 uppercase dark:bg-neutral-900 dark:text-emerald-400">
            {tag}
          </span>
        ))
      }
    </div>
    <h2
      class="mb-2 text-xl font-bold text-slate-900 transition-colors group-hover:text-emerald-600 dark:text-white dark:group-hover:text-emerald-400"
    >
      {title}
    </h2>
    <p class="text-sm text-slate-500 dark:text-neutral-400">
      {description}
    </p>
  </div>
</a>
