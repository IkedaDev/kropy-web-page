---
import HomeLayout from "../layouts/HomeLayout.astro";
import { Icon } from "astro-icon/components";
---

<HomeLayout
  title="Servicios & Precios"
  description="Nuestras tarifas y soluciones web transparentes"
>
  <section id="pricing-section" class="bg-slate-50 py-20 transition-colors dark:bg-neutral-900/50">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <div id="services-header" class="opacity-0">
        <span
          class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
          >Nuestros Productos</span
        >
        <h1 class="mb-16 text-4xl font-extrabold tracking-tight md:text-5xl">
          Tarifas Transparentes
        </h1>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <div
          class="pricing-card flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-10 opacity-0 shadow-sm transition-colors dark:border-neutral-800 dark:bg-neutral-950"
        >
          <div>
            <h3 class="mb-4 text-xs font-bold tracking-widest text-slate-400 uppercase">
              Landing Pages
            </h3>
            <div class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white">
              120.000 <span class="text-sm font-medium text-slate-400">CLP</span>
            </div>
            <ul class="mb-10 space-y-4 text-left text-sm text-slate-500 dark:text-neutral-400">
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> 4 Secciones a elegir
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Sistema de Blog
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> 2 Correos corporativos
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Certificado SSL
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Mapa de ubicacion
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Adaptado a mobiles
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Boton flotante a Whatsapp
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Enlace a redes sociales
              </li>
            </ul>
          </div>
          <a
            href="/contacto"
            class="block w-full rounded-full bg-slate-900 py-3 font-bold text-white transition-colors hover:bg-slate-800 dark:bg-neutral-800 dark:hover:bg-neutral-700"
            >Adquirir</a
          >
        </div>

        <div
          class="pricing-card relative flex scale-105 transform flex-col justify-between rounded-3xl border-2 border-emerald-600 bg-white p-10 opacity-0 shadow-2xl shadow-emerald-600/10 transition-colors dark:bg-neutral-950"
        >
          <span
            class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-emerald-600 px-4 py-1 text-[10px] font-bold tracking-widest text-white uppercase"
            >Recomendado</span
          >
          <div>
            <h3 class="mb-4 text-xs font-bold tracking-widest text-slate-400 uppercase">
              E-commerces
            </h3>
            <div class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white">
              400.000 <span class="text-sm font-medium text-slate-400">CLP</span>
            </div>
            <ul class="mb-10 space-y-4 text-left text-sm text-slate-500 dark:text-neutral-400">
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> 6 Secciones a elegir
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Sistema de Blog
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> 4 Correos corporativos
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Certificado SSL
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Mapa de ubicacion
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Adaptado a mobiles
              </li>

              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Boton flotante a Whatsapp
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Sistema de productos administrable
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Carrito de compras
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Capacitacion de uso
              </li>
            </ul>
          </div>
          <a
            href="/contacto"
            class="block w-full rounded-full bg-emerald-600 py-3 font-bold text-white transition-colors hover:bg-emerald-700"
            >Comenzar</a
          >
        </div>

        <div
          class="pricing-card flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-10 opacity-0 shadow-sm transition-colors dark:border-neutral-800 dark:bg-neutral-950"
        >
          <div>
            <h3 class="mb-4 text-xs font-bold tracking-widest text-slate-400 uppercase">Customs</h3>
            <div class="mb-6 text-4xl font-extrabold text-slate-900 dark:text-white">
              <span class="text-sm font-medium text-slate-400">Desde</span> 100.000 <span
                class="text-sm font-medium text-slate-400">CLP</span
              >
            </div>
            <ul class="mb-10 space-y-4 text-left text-sm text-slate-500 dark:text-neutral-400">
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Estructuras y funcionalidades
                a medida
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Integraciones avanzadas
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Certificado SSL
              </li>
              <li class="flex gap-2">
                <Icon name="lucide:check" class="h-5 w-5 text-emerald-600" /> Adaptado a mobiles
              </li>
            </ul>
          </div>
          <a
            href="/contacto"
            class="block w-full rounded-full border border-slate-200 py-3 font-bold text-slate-900 transition-colors hover:bg-slate-50 dark:border-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-800"
            >Cotizar</a
          >
        </div>
      </div>
    </div>
  </section>

  <section id="specialties-section" class="bg-white py-24 transition-colors dark:bg-neutral-950">
    <div class="mx-auto max-w-6xl px-4">
      <div id="specialties-header" class="mb-16 text-center opacity-0">
        <span
          class="mb-4 block text-[10px] font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
          >Especialidades</span
        >
        <h2 class="text-4xl font-extrabold tracking-tight">Otras Soluciones Tecnológicas</h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="specialty-card rounded-3xl border border-slate-100 bg-slate-50 p-8 opacity-0 dark:border-neutral-900 dark:bg-neutral-900/50"
        >
          <span
            class="mb-2 block text-xs font-bold tracking-wider text-emerald-600 dark:text-emerald-400"
            >40.000 CLP</span
          >
          <h4 class="mb-3 text-lg font-bold">Menús para Restaurantes</h4>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
            Cartas interactivas con lectura QR para móviles y alta velocidad.
          </p>
        </div>
        <div
          class="specialty-card rounded-3xl border border-slate-100 bg-slate-50 p-8 opacity-0 dark:border-neutral-900 dark:bg-neutral-900/50"
        >
          <span
            class="mb-2 block text-xs font-bold tracking-wider text-emerald-600 dark:text-emerald-400"
            >Consultorías</span
          >
          <h4 class="mb-3 text-lg font-bold">Servicios de Consultoría</h4>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
            Asesorías avanzadas de optimización y reestructuración de software.
          </p>
        </div>
        <div
          class="specialty-card rounded-3xl border border-slate-100 bg-slate-50 p-8 opacity-0 dark:border-neutral-900 dark:bg-neutral-900/50"
        >
          <span
            class="mb-2 block text-xs font-bold tracking-wider text-emerald-600 dark:text-emerald-400"
            >Híbridas & Nativas</span
          >
          <h4 class="mb-3 text-lg font-bold">Aplicaciones Móviles</h4>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
            Desarrollo especializado de apps fluidas para iOS y Android.
          </p>
        </div>
        <div
          class="specialty-card rounded-3xl border border-slate-100 bg-slate-50 p-8 opacity-0 dark:border-neutral-900 dark:bg-neutral-900/50"
        >
          <span
            class="mb-2 block text-xs font-bold tracking-wider text-emerald-600 dark:text-emerald-400"
            >Figma UI/UX</span
          >
          <h4 class="mb-3 text-lg font-bold">Diseños Web</h4>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
            Estudios de interfaz de usuario de alta fidelidad, interactivos y limpios.
          </p>
        </div>
        <div
          class="specialty-card rounded-3xl border border-slate-100 bg-slate-50 p-8 opacity-0 dark:border-neutral-900 dark:bg-neutral-900/50"
        >
          <span
            class="mb-2 block text-xs font-bold tracking-wider text-emerald-600 dark:text-emerald-400"
            >Arquitectura backend</span
          >
          <h4 class="mb-3 text-lg font-bold">Creación de APIs y Microservicios</h4>
          <p class="text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
            Creación de microservicios robustos y bases de datos integradas.
          </p>
        </div>
      </div>
    </div>
  </section>
</HomeLayout>

<script>
  import { animate, createTimeline, stagger } from "animejs";

  function initScrollAnimations() {
    // Configuración del observador: Se dispara cuando el 15% de la sección es visible
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        // Solo animamos si el elemento está visible en la pantalla
        if (entry.isIntersecting) {
          // 1. Si el usuario scrollea hasta la sección principal de tarifas
          if (entry.target.id === "pricing-section") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 1000 },
            });

            tl.add("#services-header", { y: [30, 0], opacity: [0, 1] }, 0).add(
              ".pricing-card",
              { y: [40, 0], opacity: [0, 1], delay: stagger(150) },
              "-=600"
            );

            // Dejamos de observar para que la animación no se repita al subir y bajar
            observer.unobserve(entry.target);
          }

          // 2. Si el usuario scrollea hasta la sección de especialidades
          if (entry.target.id === "specialties-section") {
            animate("#specialties-header", {
              y: [20, 0],
              opacity: [0, 1],
              ease: "outCubic",
              duration: 800,
            });

            animate(".specialty-card", {
              y: [30, 0],
              opacity: [0, 1],
              ease: "outElastic(1, .8)",
              duration: 1200,
              delay: stagger(100, { start: 300 }),
            });

            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);

    // Seleccionamos las secciones y les aplicamos el observador
    const pricingSection = document.getElementById("pricing-section");
    const specialtiesSection = document.getElementById("specialties-section");

    if (pricingSection) observer.observe(pricingSection);
    if (specialtiesSection) observer.observe(specialtiesSection);
  }

  // Asegura la compatibilidad con el ClientRouter / ViewTransitions de Astro
  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>
