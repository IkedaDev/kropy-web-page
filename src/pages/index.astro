---
import HomeLayout from "../layouts/HomeLayout.astro";
---

<HomeLayout title="Inicio" description="Soluciones de desarrollo y diseño web de vanguardia">
  <!-- Hero Section con fondo Kropy original -->
  <section
    class="bg-[radial-gradient(circle_at_top,_#ecfdf5_0%,_transparent_50%)] px-4 pt-16 pb-24 text-center dark:bg-[radial-gradient(circle_at_top,_rgba(16,185,129,0.06)_0%,_transparent_50%)]"
  >
    <div class="mx-auto max-w-4xl">
      <span
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[10px] font-bold tracking-widest text-emerald-600 uppercase dark:border-neutral-800 dark:bg-neutral-900 dark:text-emerald-400"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-600"></span>
        v2.4.0: INFRAESTRUCTURA DE VANGUARDIA
      </span>
      <h1 class="mb-6 text-5xl leading-tight font-extrabold tracking-tight md:text-7xl">
        Tu presencia digital, <br /><span class="text-emerald-600 italic dark:text-emerald-400"
          >sin complicaciones.</span
        >
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-500 dark:text-neutral-400">
        Kropy es el motor de tu negocio. Desplegamos sitios de alta gama con infraestructura
        orquestada para que tú solo te preocupes de vender.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/servicios"
          class="rounded-full bg-emerald-600 px-8 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-transform hover:scale-105"
          >Ver Planes</a
        >
        <a
          href="/contacto"
          class="rounded-full border border-slate-200 bg-white px-8 py-4 font-bold text-slate-900 transition-colors hover:bg-slate-50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:bg-neutral-800"
          >Hablemos</a
        >
      </div>
    </div>
  </section>

  <!-- Sección de Capacidades -->
  <section class="bg-white py-24 transition-colors dark:bg-neutral-950">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <span
        class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
        >Capacidades</span
      >
      <h2 class="mb-16 text-4xl font-extrabold tracking-tight">
        Software de alta gama para tu marca.
      </h2>
      <div class="grid gap-12 md:grid-cols-3">
        <div class="p-6">
          <div class="mb-4 text-4xl">⚡</div>
          <h3 class="mb-2 text-xl font-bold">Velocidad Extrema</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            Código ultra optimizado y entrega inmediata para retener a tus clientes.
          </p>
        </div>
        <div class="p-6">
          <div class="mb-4 text-4xl">🛡️</div>
          <h3 class="mb-2 text-xl font-bold">Seguridad Avanzada</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            SSL automático, aislamiento de bases de datos y protección DDoS activa.
          </p>
        </div>
        <div class="p-6">
          <div class="mb-4 text-4xl">🔄</div>
          <h3 class="mb-2 text-xl font-bold">Evolución Continua</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            Garantizamos mantenimiento y actualización constante de dependencias.
          </p>
        </div>
      </div>
    </div>
  </section>
</HomeLayout>
