---
import HomeLayout from "../layouts/HomeLayout.astro";
import Pricings from "../components/home/Pricings.astro";
import Contact from "../components/home/Contact.astro";
---

<HomeLayout>
  <!-- Hero Section -->
  <section
    class="bg-[radial-gradient(circle_at_top,_#ecfdf5_0%,_transparent_50%)] px-4 pt-32 pb-20 text-center"
  >
    <div class="mx-auto max-w-4xl">
      <span
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[10px] font-bold tracking-widest text-emerald-600 uppercase"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-600"></span>
        v2.4.0: Infraestructura Lista
      </span>
      <h1 class="mb-6 text-5xl leading-tight font-extrabold tracking-tight md:text-7xl">
        Tu presencia digital, <br /><span class="text-emerald-600 italic">sin complicaciones.</span>
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-500">
        Kropy es el motor de tu negocio. Desplegamos sitios de alta gama con infraestructura
        orquestada manualmente para que tú solo te preocupes de vender.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="#pricing"
          class="rounded-full bg-emerald-600 px-8 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-transform hover:scale-105"
          >Ver Planes</a
        >
        <a
          href="#contacto"
          class="rounded-full border border-slate-200 bg-white px-8 py-4 font-bold text-slate-900 transition-colors hover:bg-slate-50"
          >Agendar Llamada</a
        >
      </div>
    </div>
  </section>

  <!-- Nosotros (About Us) -->
  <section id="nosotros" class="bg-white py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-4 md:grid-cols-2">
      <div>
        <span class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase"
          >Sobre Nosotros</span
        >
        <h2 class="mb-6 text-4xl font-extrabold tracking-tight">
          Cultura de ingeniería, <br />pasión por el diseño.
        </h2>
        <p class="mb-6 text-lg text-slate-500">
          En Kropy, nacimos de la necesidad de cerrar la brecha entre el hosting genérico y el
          desarrollo de software de alta calidad. No somos una agencia tradicional; somos tu socio
          tecnológico.
        </p>
        <p class="mb-8 text-slate-500">
          Nuestro equipo combina años de experiencia en infraestructura de nube (ikedadev-infra) con
          un ojo obsesivo por el detalle visual. Creemos que cada suscripción es un compromiso de
          crecimiento mutuo.
        </p>
        <div class="grid grid-cols-2 gap-8">
          <div>
            <h4 class="text-2xl font-bold text-emerald-600">+150</h4>
            <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">
              Sitios Desplegados
            </p>
          </div>
          <div>
            <h4 class="text-2xl font-bold text-emerald-600">99.9%</h4>
            <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">
              Uptime Garantizado
            </p>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="aspect-square w-full overflow-hidden rounded-3xl bg-slate-100 shadow-2xl">
          <!-- Imagen de placeholder para representación visual -->
          <div class="flex h-full w-full items-center justify-center text-slate-300">
            [Imagen de Equipo Trabajando]
          </div>
        </div>
        <div
          class="absolute -bottom-6 -left-6 max-w-xs rounded-2xl bg-emerald-600 p-8 text-white shadow-xl"
        >
          <p class="text-sm font-medium italic">
            "Nuestra meta es que nunca más tengas que preocuparte por una actualización de
            servidor."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y Visión (MV) -->
  <section id="mv" class="bg-slate-50 py-24">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-12 md:grid-cols-2">
        <div
          class="rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-shadow hover:shadow-md"
        >
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600"
          >
            🎯
          </div>
          <h3 class="mb-4 text-2xl font-bold">Nuestra Misión</h3>
          <p class="leading-relaxed text-slate-500">
            Democratizar el acceso a software de alta gama mediante un modelo de suscripción justo.
            Queremos que emprendedores y empresas tengan sitios que respiren calidad técnica sin la
            carga de gestionar infraestructura.
          </p>
        </div>
        <div
          class="rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-shadow hover:shadow-md"
        >
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600"
          >
            👁️
          </div>
          <h3 class="mb-4 text-2xl font-bold">Nuestra Visión</h3>
          <p class="leading-relaxed text-slate-500">
            Convertirnos en el estándar global de "Web-as-a-Service", siendo reconocidos por nuestra
            arquitectura invisible y potente que permite a las marcas florecer en un ecosistema
            digital en constante cambio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Características (Breve repaso) -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <span class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase"
        >Capacidades</span
      >
      <h2 class="mb-16 text-4xl font-extrabold tracking-tight">Software que trabaja por ti.</h2>
      <div class="grid gap-12 md:grid-cols-3">
        <div>
          <div class="mb-4 text-4xl">⚡</div>
          <h4 class="mb-2 text-xl font-bold">Velocidad Extrema</h4>
          <p class="text-sm text-slate-500">
            Optimización de activos y CDN global para cargas instantáneas.
          </p>
        </div>
        <div>
          <div class="mb-4 text-4xl">🛡️</div>
          <h4 class="mb-2 text-xl font-bold">Seguridad Core</h4>
          <p class="text-sm text-slate-500">
            Aislamiento por contenedor y SSL automático de grado bancario.
          </p>
        </div>
        <div>
          <div class="mb-4 text-4xl">🔄</div>
          <h4 class="mb-2 text-xl font-bold">Evolución Diaria</h4>
          <p class="text-sm text-slate-500">
            Tu web nunca envejece. Actualizamos código y dependencias mensualmente.
          </p>
        </div>
      </div>
    </div>
  </section>
  <Pricings />
  <Contact />
</HomeLayout>

<script>
  // Animación de compactación del header al hacer scroll
  const header = document.getElementById("main-header");
  window.addEventListener("scroll", () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.remove("py-5");
      header.classList.add("py-2");
    } else {
      header.classList.remove("py-2");
      header.classList.add("py-5");
    }
  });
</script>
