---
import HomeLayout from "../layouts/HomeLayout.astro";
---

<HomeLayout title="Inicio" description="Soluciones de desarrollo y diseño web de vanguardia">
  <section
    id="hero-section"
    class="relative top-[-40px] bg-[radial-gradient(circle_at_top,_#ecfdf5_0%,_transparent_50%)] px-4 pt-26 pb-24 text-center dark:bg-[radial-gradient(circle_at_top,_rgba(16,185,129,0.06)_0%,_transparent_50%)]"
  >
    <div class="mx-auto max-w-4xl">
      <span
        id="hero-badge"
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[10px] font-bold tracking-widest text-emerald-600 uppercase opacity-0 dark:border-neutral-800 dark:bg-neutral-900 dark:text-emerald-400"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-600"></span>
        v2.4.0: INFRAESTRUCTURA DE VANGUARDIA
      </span>
      <h1
        id="hero-title"
        class="mb-6 text-5xl leading-tight font-extrabold tracking-tight opacity-0 md:text-7xl"
      >
        Tu presencia digital, <br /><span class="text-emerald-600 italic dark:text-emerald-400"
          >sin complicaciones.</span
        >
      </h1>
      <p
        id="hero-text"
        class="mx-auto mb-10 max-w-2xl text-lg text-slate-500 opacity-0 dark:text-neutral-400"
      >
        Kropy es el motor de tu negocio. Desplegamos sitios de alta gama con infraestructura
        orquestada para que tú solo te preocupes de vender.
      </p>
      <div id="hero-buttons" class="flex flex-col justify-center gap-4 opacity-0 sm:flex-row">
        <a
          href="/servicios"
          class="rounded-full bg-emerald-600 px-8 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-transform hover:scale-105"
          >Ver Planes</a
        >
        <a
          href="/contacto"
          class="rounded-full border border-slate-200 bg-white px-8 py-4 font-bold text-slate-900 transition-colors hover:bg-slate-50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:bg-neutral-800"
          >Hablemos</a
        >
      </div>
    </div>
  </section>

  <section id="features-section" class="bg-white py-24 transition-colors dark:bg-neutral-950">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <div id="features-header">
        <span
          id="features-badge"
          class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase opacity-0 dark:text-emerald-400"
          >Capacidades</span
        >
        <h2 id="features-title" class="mb-16 text-4xl font-extrabold tracking-tight opacity-0">
          Software de alta gama para tu marca.
        </h2>
      </div>
      <div class="grid gap-12 md:grid-cols-3">
        <div class="feature-card p-6 opacity-0">
          <div class="mb-4 text-4xl">⚡</div>
          <h3 class="mb-2 text-xl font-bold">Velocidad Extrema</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            Código ultra optimizado y entrega inmediata para retener a tus clientes.
          </p>
        </div>
        <div class="feature-card p-6 opacity-0">
          <div class="mb-4 text-4xl">🛡️</div>
          <h3 class="mb-2 text-xl font-bold">Seguridad Avanzada</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            SSL automático, aislamiento de bases de datos y protección DDoS activa.
          </p>
        </div>
        <div class="feature-card p-6 opacity-0">
          <div class="mb-4 text-4xl">🔄</div>
          <h3 class="mb-2 text-xl font-bold">Evolución Continua</h3>
          <p class="text-sm text-slate-500 dark:text-neutral-400">
            Garantizamos mantenimiento y actualización constante de dependencias.
          </p>
        </div>
      </div>
    </div>
  </section>
</HomeLayout>

<script>
  import { animate, createTimeline } from "animejs"; // Ya no necesitamos 'stagger' aquí

  function initHomeAnimations() {
    // 1. Observador para el Hero Section (Ejecución inmediata)
    const heroObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const tl = createTimeline({ defaults: { ease: "outQuint", duration: 1000 } });

            tl.add("#hero-badge", { y: [-20, 0], opacity: [0, 1] }, 200)
              .add("#hero-title", { y: [30, 0], opacity: [0, 1] }, "-=700")
              .add("#hero-text", { y: [20, 0], opacity: [0, 1] }, "-=750")
              .add("#hero-buttons", { y: [15, 0], opacity: [0, 1] }, "-=800");

            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0 }
    );

    // 2. Observador para el TÍTULO de Capacidades
    const headerObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate("#features-badge, #features-title", {
              y: [20, 0],
              opacity: [0, 1],
              ease: "outCubic",
              duration: 800,
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    // 3. Observador INDIVIDUAL para cada Tarjeta
    const cardObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Animamos específicamente el 'entry.target' (la tarjeta exacta que entró a la pantalla)
            animate(entry.target, {
              y: [40, 0],
              opacity: [0, 1],
              ease: "outElastic(1, .8)",
              duration: 1200,
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    ); // Requiere que el 15% de LA TARJETA sea visible para animarse

    // Enganchamos los observadores a sus respectivos elementos
    const heroSection = document.getElementById("hero-section");
    const featuresHeader = document.getElementById("features-header");
    const featureCards = document.querySelectorAll(".feature-card");

    if (heroSection) heroObserver.observe(heroSection);
    if (featuresHeader) headerObserver.observe(featuresHeader);

    // Le asignamos el observador a cada tarjeta de forma independiente
    featureCards.forEach((card) => cardObserver.observe(card));
  }

  // Asegura la compatibilidad completa con el ClientRouter de Astro
  document.addEventListener("astro:page-load", () => {
    initHomeAnimations();
  });
</script>
