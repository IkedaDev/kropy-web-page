---
import HomeLayout from "../layouts/HomeLayout.astro";
---

<HomeLayout
  title="Contacto"
  description="Escríbenos, llámanos o agenda una reunión para iniciar tu proyecto web de alto tráfico."
>
  <section class="bg-white py-16 transition-colors lg:py-24 dark:bg-neutral-950">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Contenedor de rejilla de 2 columnas -->
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Columna de Información (40% de ancho en escritorio) -->
        <div class="space-y-10 lg:col-span-5">
          <div class="space-y-4">
            <span
              class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
              >Conexion Directa</span
            >
            <h1
              class="text-4xl leading-tight font-extrabold tracking-tight text-slate-950 lg:text-5xl dark:text-white"
            >
              Hablemos sin rodeos.
            </h1>

            <!-- Mensaje rompehielos sutil -->
            <p
              class="pt-2 text-base leading-relaxed font-light text-slate-500 dark:text-neutral-400"
            >
              Sabemos que rellenar formularios puede ser aburrido o intimidante. Prometemos que este
              no es un buzón sin salida. Al otro lado hay desarrolladores y diseñadores reales
              listos para escuchar tu idea, tomarnos un café (asíncrono o por Meet) y planificar
              algo increíble.
            </p>
          </div>

          <!-- Canales de comunicación expuestos -->
          <div class="space-y-6">
            <h3
              class="text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
            >
              Canales directos
            </h3>

            <div class="space-y-4">
              <!-- Teléfono / Celular -->
              <a
                href="tel:+56987654321"
                class="group flex items-center gap-4 rounded-2xl border border-slate-100 bg-slate-50/50 p-4 transition-all duration-300 hover:border-emerald-600/20 dark:border-neutral-900 dark:bg-neutral-900/10 dark:hover:border-emerald-400/20"
              >
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 transition-all group-hover:bg-emerald-600 group-hover:text-white dark:text-emerald-400"
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <span
                    class="block text-xs font-bold tracking-wider text-slate-400 uppercase dark:text-neutral-500"
                    >Celular / WhatsApp</span
                  >
                  <span class="text-sm font-semibold text-slate-900 dark:text-neutral-100"
                    >+56 9 8909 5115</span
                  >
                </div>
              </a>

              <!-- Correo electrónico -->
              <a
                href="mailto:hola@kropy.cl"
                class="group flex items-center gap-4 rounded-2xl border border-slate-100 bg-slate-50/50 p-4 transition-all duration-300 hover:border-emerald-600/20 dark:border-neutral-900 dark:bg-neutral-900/10 dark:hover:border-emerald-400/20"
              >
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 transition-all group-hover:bg-emerald-600 group-hover:text-white dark:text-emerald-400"
                >
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <span
                    class="block text-xs font-bold tracking-wider text-slate-400 uppercase dark:text-neutral-500"
                    >Correo electrónico</span
                  >
                  <span class="text-sm font-semibold text-slate-900 dark:text-neutral-100"
                    >kropyservices@gmail.com
                  </span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Columna del Formulario (70% de ancho en escritorio) -->
        <div
          class="rounded-3xl border border-slate-200/60 bg-slate-50/40 p-8 transition-colors sm:p-10 lg:col-span-7 dark:border-neutral-800/60 dark:bg-neutral-900/20"
        >
          <form class="space-y-6" id="contact-form">
            <!-- Selector segmentado tipo Persona / Empresa -->
            <div class="space-y-3">
              <label
                class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
                >¿Quién nos escribe?</label
              >
              <div
                class="grid grid-cols-2 gap-2 rounded-2xl border border-slate-200/40 bg-slate-100 p-1.5 dark:border-neutral-800/40 dark:bg-neutral-900/80"
              >
                <!-- Botón Persona -->
                <button
                  type="button"
                  id="btn-client-persona"
                  class="client-type-btn rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all duration-200"
                  data-type="persona"
                >
                  Persona / Freelancer
                </button>
                <!-- Botón Empresa -->
                <button
                  type="button"
                  id="btn-client-empresa"
                  class="client-type-btn rounded-xl px-4 py-2.5 text-xs font-bold tracking-wider text-slate-500 uppercase transition-all duration-200 hover:text-slate-900 dark:text-neutral-400 dark:hover:text-white"
                  data-type="empresa"
                >
                  Empresa / Organización
                </button>
              </div>
              <input type="hidden" id="form-client-type" name="client_type" value="persona" />
            </div>

            <!-- Campos Estándar -->
            <div class="grid gap-6 md:grid-cols-2">
              <div class="space-y-2">
                <label
                  class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
                  id="label-name">Tu Nombre</label
                >
                <input
                  required
                  type="text"
                  id="form-name"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
                  placeholder="Ej: Juan Pérez"
                />
              </div>
              <div class="space-y-2">
                <label
                  class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
                  >Correo de Contacto</label
                >
                <input
                  required
                  type="email"
                  id="form-email"
                  class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
                  placeholder="juan@correo.com"
                />
              </div>
            </div>

            <!-- Campo dinámico adicional (Nombre de Empresa, oculto al inicio) -->
            <div class="hidden space-y-2" id="company-field-container">
              <label
                class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
                >Nombre de la Empresa o Startup</label
              >
              <input
                type="text"
                id="form-company"
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
                placeholder="Ej: Innova SpA"
              />
            </div>

            <!-- Campo Mensaje -->
            <div class="space-y-2">
              <label
                class="block text-xs font-bold tracking-widest text-slate-400 uppercase dark:text-neutral-500"
                id="label-message">Cuéntanos sobre tu idea</label
              >
              <textarea
                required
                id="form-message"
                rows="4"
                class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-light text-slate-900 transition-colors focus:border-emerald-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-950 dark:text-white"
                placeholder="Necesito levantar una landing page para validar mi servicio..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-xl bg-emerald-600 py-4 font-bold text-white shadow-xl shadow-emerald-600/20 transition-all duration-300 hover:bg-emerald-700"
            >
              Enviar Solicitud
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal de Éxito sutil (Evitamos alert()) -->
  <div
    id="success-modal"
    class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/40 p-4 backdrop-blur-sm"
  >
    <div
      class="w-full max-w-sm rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-2xl transition-colors dark:border-neutral-800 dark:bg-neutral-900"
    >
      <div
        class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 font-bold text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
      >
        ✓
      </div>
      <h4 class="mb-2 text-lg font-extrabold text-slate-950 dark:text-white">
        ¡Solicitud Recibida!
      </h4>
      <p class="mb-6 text-sm leading-relaxed text-slate-500 dark:text-neutral-400">
        Hemos registrado tus datos. Un miembro de nuestro equipo te contactará para agendar nuestra
        primera reunión técnica.
      </p>
      <button
        id="close-modal-btn"
        class="w-full rounded-full bg-emerald-600 py-2.5 text-xs font-bold tracking-widest text-white uppercase transition-colors hover:bg-emerald-700"
        >Entendido</button
      >
    </div>
  </div>
</HomeLayout>

<script>
  // Lógica del selector segmentado de clientes
  const btnPersona = document.getElementById("btn-client-persona");
  const btnEmpresa = document.getElementById("btn-client-empresa");
  const clientTypeInput = document.getElementById("form-client-type") as HTMLInputElement;
  const companyFieldContainer = document.getElementById("company-field-container");
  const companyInput = document.getElementById("form-company") as HTMLInputElement;

  // Referencias a etiquetas dinámicas
  const labelName = document.getElementById("label-name");
  const labelMessage = document.getElementById("label-message");
  const inputMessage = document.getElementById("form-message") as HTMLTextAreaElement;

  function setClientType(type: "persona" | "empresa") {
    if (clientTypeInput) clientTypeInput.value = type;

    if (type === "persona") {
      // Activar botón persona
      btnPersona?.classList.add("bg-emerald-600", "text-white", "shadow-sm");
      btnPersona?.classList.remove(
        "text-slate-500",
        "dark:text-neutral-400",
        "hover:text-slate-900",
        "dark:hover:text-white"
      );

      // Desactivar botón empresa
      btnEmpresa?.classList.remove("bg-emerald-600", "text-white", "shadow-sm");
      btnEmpresa?.classList.add(
        "text-slate-500",
        "dark:text-neutral-400",
        "hover:text-slate-900",
        "dark:hover:text-white"
      );

      // Ocultar campo empresa y remover requerimiento
      companyFieldContainer?.classList.add("hidden");
      if (companyInput) companyInput.required = false;

      // Actualizar textos contextuales
      if (labelName) labelName.innerText = "Tu Nombre";
      if (labelMessage) labelMessage.innerText = "Cuéntanos sobre tu idea";
      if (inputMessage)
        inputMessage.placeholder = "Necesito levantar una landing page para validar mi servicio...";
    } else {
      // Activar botón empresa
      btnEmpresa?.classList.add("bg-emerald-600", "text-white", "shadow-sm");
      btnEmpresa?.classList.remove(
        "text-slate-500",
        "dark:text-neutral-400",
        "hover:text-slate-900",
        "dark:hover:text-white"
      );

      // Desactivar botón persona
      btnPersona?.classList.remove("bg-emerald-600", "text-white", "shadow-sm");
      btnPersona?.classList.add(
        "text-slate-500",
        "dark:text-neutral-400",
        "hover:text-slate-900",
        "dark:hover:text-white"
      );

      // Mostrar campo empresa y hacerlo obligatorio
      companyFieldContainer?.classList.remove("hidden");
      if (companyInput) companyInput.required = true;

      // Actualizar textos contextuales
      if (labelName) labelName.innerText = "Nombre de contacto";
      if (labelMessage) labelMessage.innerText = "Cuéntanos sobre tu requerimiento de software";
      if (inputMessage)
        inputMessage.placeholder =
          "Buscamos reestructurar nuestra plataforma administrativa actual y crear una API externa...";
    }
  }

  btnPersona?.addEventListener("click", () => setClientType("persona"));
  btnEmpresa?.addEventListener("click", () => setClientType("empresa"));

  // Manejo de modal de éxito
  const form = document.getElementById("contact-form");
  const modal = document.getElementById("success-modal");
  const closeBtn = document.getElementById("close-modal-btn");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    modal?.classList.remove("hidden");
    (form as HTMLFormElement).reset();
    setClientType("persona"); // Restablecer a persona por defecto
  });

  closeBtn?.addEventListener("click", () => {
    modal?.classList.add("hidden");
  });
</script>
