---
import BlogCard from "@components/blog/BlogCard.astro";
import HomeLayout from "../../layouts/HomeLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => {
  return data.isDraft !== true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<HomeLayout title="Blog | Kropy - Desarrollo Web">
  <div class="mx-auto max-w-6xl px-4 pt-20 pb-20">
    <div id="blog-header" class="mb-16 text-center opacity-0">
      <span
        class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
      >
        Comunidad
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl dark:text-white">
        Nuestro Blog
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500 dark:text-neutral-400">
        Noticias, tutoriales y reflexiones sobre desarrollo de vanguardia.
      </p>
    </div>

    {/* Renderizado limpio usando tu nuevo componente */}
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        sortedPosts.map((post) => (
          <BlogCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image || ""}
            tags={post.data.tags}
            classList="item-card opacity-0"
          />
        ))
      }
    </div>
  </div>
</HomeLayout>

<!-- Fade un desde abajo -->
<script>
  import { createTimeline } from "animejs";

  function initScrollAnimations() {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (entry.target.id === "blog-header") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 1000 },
            });

            tl.add("#blog-header", { y: [30, 0], opacity: [0, 1] }, 0);

            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);

    const section = document.getElementById("blog-header");
    if (section) observer.observe(section);
  }

  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>

<!-- Animacion scroll galeria -->
<script>
  import { animate, stagger } from "animejs";

  function initScrollAnimations() {
    const observerOptions = {
      root: null,
      rootMargin: "0px 0px 50px 0px",
      threshold: 0.1,
    };

    let batch: Element[] = [];
    let timeoutId: NodeJS.Timeout | null = null;

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          batch.push(entry.target);
          observer.unobserve(entry.target);

          if (!timeoutId) {
            timeoutId = setTimeout(() => {
              // ✨ CONFIGURACIÓN FLUIDA DE VANGUARDIA ✨
              animate(batch, {
                opacity: [0, 1],
                ease: "outQuart", // Una curva más suave que outCubic
                duration: 800, // 👈 Elevado de 100ms a 800ms para notar la transición
                delay: stagger(120), // Un escalonamiento más ágil y dinámico
              });

              batch = [];
              timeoutId = null;
            }, 50);
          }
        }
      });
    }, observerOptions);

    const cards = document.querySelectorAll(".item-card");
    cards.forEach((card) => {
      observer.observe(card);
    });
  }

  // Integración perfecta con el ciclo de vida de ClientRouter de Astro
  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>

