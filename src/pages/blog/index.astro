---
import BlogCard from "@components/blog/BlogCard.astro";
import HomeLayout from "../../layouts/HomeLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => {
  return data.isDraft !== true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<HomeLayout title="Blog | Kropy - Desarrollo Web">
  <main class="mx-auto max-w-6xl px-4 pt-20 pb-20">
    <div class="mb-16 text-center">
      <span
        class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
      >
        Comunidad
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl dark:text-white">
        Nuestro Blog
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-500 dark:text-neutral-400">
        Noticias, tutoriales y reflexiones sobre desarrollo de vanguardia.
      </p>
    </div>

    {/* Renderizado limpio usando tu nuevo componente */}
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        sortedPosts.map((post) => (
          <BlogCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image || ""}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </main>
</HomeLayout>
