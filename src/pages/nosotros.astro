---
import HomeLayout from "../layouts/HomeLayout.astro";
---

<HomeLayout
  title="Nosotros"
  description="Conoce nuestra visión, misión y aclara tus dudas con las FAQ"
>
  <!-- Sobre Nosotros -->
  <section class="bg-white py-20 transition-colors dark:bg-neutral-950">
    <div id="aboutus" class="mx-auto grid max-w-6xl items-center gap-16 px-4 md:grid-cols-2">
      <div id="aboutus-text">
        <span
          class="mb-4 block text-xs font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
          >Sobre Nosotros</span
        >
        <h2 class="mb-6 text-4xl font-extrabold tracking-tight">
          Cultura de ingeniería, pasión por el software.
        </h2>
        <p class="mb-6 text-lg text-slate-500 dark:text-neutral-400">
          Nacimos de la necesidad de cerrar la brecha entre el diseño plano y el desarrollo de
          software de alta calidad. No somos una agencia tradicional; somos tu socio tecnológico de
          confianza.
        </p>
        <p class="mb-8 text-slate-500 dark:text-neutral-400">
          Nuestro equipo combina años de experiencia en infraestructura de nube con un ojo obsesivo
          por el detalle estético.
        </p>
        <div class="grid grid-cols-2 gap-8">
          <div>
            <h4 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">100%</h4>
            <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">
              Optimización SEO & Rendimiento
            </p>
          </div>
          <div>
            <h4 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">< 1.2s</h4>
            <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">
              Tiempo de Carga Promedio
            </p>
          </div>
        </div>
      </div>
      <div id="aboutus-image" class="relative">
        <div
          class="flex aspect-square w-full items-center justify-center overflow-hidden rounded-3xl bg-slate-100 text-slate-300 shadow-2xl transition-colors dark:bg-neutral-900 dark:text-neutral-700"
        >
          [Imagen de Equipo de Desarrollo]
        </div>
        <div
          class="absolute -bottom-6 -left-6 max-w-xs rounded-2xl bg-emerald-600 p-8 text-white shadow-xl"
        >
          <p class="text-sm font-medium italic">
            "Nuestra meta es que nunca más tengas que preocuparte por una actualización de
            servidor."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y Visión -->
  <section id="mv" class="bg-slate-50 py-24 transition-colors dark:bg-neutral-900/50">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-12 md:grid-cols-2">
        <div
          class="mv-card rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-all hover:shadow-md dark:border-neutral-800 dark:bg-neutral-950"
        >
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
          >
            🎯
          </div>
          <h3 class="mb-4 text-2xl font-bold">Nuestra Misión</h3>
          <p class="leading-relaxed text-slate-500 dark:text-neutral-400">
            Democratizar el acceso a software de alta gama mediante un modelo transparente. Queremos
            que emprendedores y empresas tengan sitios que respiren calidad técnica sin la carga de
            gestionar infraestructura.
          </p>
        </div>
        <div
          class="mv-card rounded-3xl border border-slate-100 bg-white p-10 shadow-sm transition-all hover:shadow-md dark:border-neutral-800 dark:bg-neutral-950"
        >
          <div
            class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"
          >
            👁️
          </div>
          <h3 class="mb-4 text-2xl font-bold">Nuestra Visión</h3>
          <p class="leading-relaxed text-slate-500 dark:text-neutral-400">
            Convertirnos en el estándar global de soluciones "Web-as-a-Service", siendo reconocidos
            por nuestra arquitectura invisible y potente que permite a las marcas florecer.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="bg-white py-24 transition-colors dark:bg-neutral-950">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mb-16 text-center">
        <span
          class="mb-4 block text-[10px] font-bold tracking-widest text-emerald-600 uppercase dark:text-emerald-400"
          >Resolución de dudas</span
        >
        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Preguntas Frecuentes
        </h2>
      </div>
      <div class="space-y-4">
        <details
          class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 dark:border-neutral-800 dark:bg-neutral-900"
        >
          <summary
            class="flex cursor-pointer list-none items-center justify-between p-6 font-bold text-slate-800 dark:text-neutral-200"
          >
            ¿Quién es el dueño del código de mi web?
            <span
              class="text-emerald-600 transition-transform duration-300 group-open:rotate-180 dark:text-emerald-400"
              >▼</span
            >
          </summary>
          <div
            class="border-t border-slate-100 p-6 pt-4 text-sm leading-relaxed text-slate-500 dark:border-neutral-800 dark:text-neutral-400"
          >
            Tú eres el dueño absoluto de tu marca, contenido y dominio. Kropy te proporciona el
            entorno y la infraestructura. Si decides migrar, te facilitamos la exportación completa
            de tus datos de manera transparente.
          </div>
        </details>

        <details
          class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 dark:border-neutral-800 dark:bg-neutral-900"
        >
          <summary
            class="flex cursor-pointer list-none items-center justify-between p-6 font-bold text-slate-800 dark:text-neutral-200"
          >
            ¿Qué pasa si mi sitio recibe un pico masivo de tráfico?
            <span
              class="text-emerald-600 transition-transform duration-300 group-open:rotate-180 dark:text-emerald-400"
              >▼</span
            >
          </summary>
          <div
            class="border-t border-slate-100 p-6 pt-4 text-sm leading-relaxed text-slate-500 dark:border-neutral-800 dark:text-neutral-400"
          >
            Nuestra infraestructura integrada se apoya en una red automatizada de autoescalado,
            asegurando estabilidad y que la latencia se mantenga óptima al 100%.
          </div>
        </details>
      </div>
    </div>
  </section>
</HomeLayout>

<script>
  import { createTimeline, stagger } from "animejs";

  function initScrollAnimations() {
    // Configuración del observador: Se dispara cuando el 15% de la sección es visible
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15,
    };

    const observerAboutUs = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (entry.target.id === "aboutus") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 1000 },
            });

            tl.add("#aboutus-image", { x: [150, 0], opacity: [0, 1] }, 0);
            tl.add("#aboutus-text", { x: [-150, 0], opacity: [0, 1] }, 0);
            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);
    const aboutUsSection = document.getElementById("aboutus");
    if (aboutUsSection) observerAboutUs.observe(aboutUsSection);

    const observerMV = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          console.log("1");
          if (entry.target.id === "mv") {
            const tl = createTimeline({
              defaults: { ease: "outQuint", duration: 2000 },
            });

            tl.add(
              ".mv-card",
              { y: [-80, 0], opacity: [0, 1], delay: stagger(200, { start: 200 }) },
              0
            );
            observer.unobserve(entry.target);
          }
        }
      });
    }, observerOptions);
    const mvSection = document.getElementById("mv");
    if (mvSection) observerMV.observe(mvSection);
  }

  // Asegura la compatibilidad con el ClientRouter / ViewTransitions de Astro
  document.addEventListener("astro:page-load", () => {
    initScrollAnimations();
  });
</script>
