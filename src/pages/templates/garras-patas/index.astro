---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Garras & Patas | Alimentos y Accesorios para Mascotas en Temuco";
const description =
  "La mejor tienda de mascotas online en Temuco. Alimentos premium, juguetes y accesorios para perros y gatos con despacho a domicilio rápido en la Araucanía.";
const ogImage =
  "https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&w=600&q=80";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} image={ogImage} />

    <!-- Importación obligatoria de Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts con vibra amigable y retail -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Quicksand", sans-serif;
      }
      h1,
      h2,
      h3,
      .font-brand {
        font-family: "Fredoka", sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <!-- TOP ANNOUNCEMENT BANNER (Optimiza conversión) -->
    <div class="bg-indigo-600 px-4 py-2 text-center text-xs font-bold tracking-wide text-white">
      🐾 ¡Despacho GRATIS en Temuco urbano por compras sobre $25.000! 🐾
    </div>

    <!-- HEADER / NAVBAR -->
    <header class="sticky top-0 z-50 border-b border-slate-100 bg-white shadow-md">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <!-- Logotipo Comercial -->
        <a href="#" class="flex items-center space-x-2">
          <div class="rounded-xl bg-amber-500 p-2 text-white">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 14c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm5.5-3c.83 0 1.5-.67 1.5-1.5S18.33 8 17.5 8 16 8.67 16 9.5s.67 1.5 1.5 1.5zM6.5 11c.83 0 1.5-.67 1.5-1.5S7.33 8 6.5 8 5 8.67 5 9.5s.67 1.5 1.5 1.5zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 13v1c0 1.1.9 2 2 2v1.93zm6.34-3.86c-.26-.64-.84-1.07-1.54-1.07H16v-3c0-.55-.45-1-1-1H9v-2h2c.55 0 1-.45 1-1V6h1.93c2.89 0 5.41 1.74 6.41 4.4.14.37.16.78.07 1.17l-1.07 4.5z"
              ></path>
            </svg>
          </div>
          <span class="text-2xl font-bold tracking-tight text-indigo-900">Garras & Patas</span>
        </a>

        <!-- Navegación -->
        <nav class="hidden items-center space-x-8 font-bold text-slate-600 lg:flex">
          <a href="#categorias" class="transition-colors hover:text-amber-500">Categorías</a>
          <a href="#destacados" class="transition-colors hover:text-amber-500">Ofertas Destacadas</a
          >
          <a href="#despacho" class="transition-colors hover:text-amber-500">Zonas de Envío</a>
          <a href="#contacto" class="transition-colors hover:text-amber-500">Contacto</a>
        </nav>

        <!-- CTA Pedido Rápido -->
        <div class="hidden sm:block">
          <a
            href="https://wa.me/56987654321?text=Hola%20Garras%20y%20Patas,%20quiero%20hacer%20un%20pedido"
            target="_blank"
            class="flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-slate-900 shadow-md transition-all hover:bg-amber-600"
          >
            🛒 Pedir por WhatsApp
          </a>
        </div>

        <!-- Botón de Menú Móvil -->
        <button
          id="hamburger-btn"
          class="p-2 text-slate-700 focus:outline-none lg:hidden"
          aria-label="Menu"
        >
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </button>
      </div>

      <!-- Menú Desplegable Móvil -->
      <div
        id="mobile-dropdown"
        class="hidden space-y-3 border-t border-slate-100 bg-white px-4 py-4 shadow-lg lg:hidden"
      >
        <a href="#categorias" class="block py-2 font-bold text-slate-700">Categorías</a>
        <a href="#destacados" class="block py-2 font-bold text-slate-700">Ofertas Destacadas</a>
        <a href="#despacho" class="block py-2 font-bold text-slate-700">Zonas de Envío</a>
        <a href="#contacto" class="block py-2 font-bold text-slate-700">Contacto</a>
        <a
          href="https://wa.me/56987654321?text=Hola%20Garras%20y%20Patas,%20quiero%20hacer%20un%20pedido"
          target="_blank"
          class="block rounded-xl bg-indigo-600 py-3 text-center font-bold text-white shadow"
        >
          Catálogo WhatsApp
        </a>
      </div>
    </header>

    <main>
      <!-- HERO SECTION (Alta Conversión) -->
      <section class="bg-gradient-to-br from-amber-400 via-amber-300 to-orange-100 py-12 lg:py-20">
        <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
          <div class="space-y-6 text-center md:text-left">
            <span
              class="inline-block rounded-full bg-white/80 px-4 py-1.5 text-sm font-bold text-orange-700 shadow-sm"
            >
              🐶 Todo para perros y gatos en Temuco
            </span>
            <h1 class="text-4xl leading-tight font-bold text-indigo-950 sm:text-5xl lg:text-6xl">
              ¡La felicidad de tu peludo directo a tu casa!
            </h1>
            <p class="mx-auto max-w-lg text-lg font-medium text-slate-800 md:mx-0">
              Alimentos de las mejores marcas, juguetes ultra-resistentes y accesorios premium con
              reparto veloz en toda la Araucanía.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#destacados"
                class="rounded-2xl bg-indigo-600 px-8 py-4 text-center font-bold text-white shadow-lg transition-all hover:bg-indigo-700"
              >
                Ver Ofertas de la Semana
              </a>
              <a
                href="https://wa.me/56987654321?text=Hola,%20solicito%20asesoria%20para%20comprar%20el%20alimento%20de%20mi%20mascota"
                target="_blank"
                class="flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-8 py-4 text-center font-bold text-indigo-950 shadow-sm transition-all hover:bg-slate-100"
              >
                Hablar con un Experto
              </a>
            </div>
          </div>

          <!-- Ilustración/Contenedor visual representativo de retail -->
          <div class="relative flex justify-center">
            <div
              class="relative flex aspect-square w-full max-w-md flex-col justify-between overflow-hidden rounded-3xl border-4 border-white bg-indigo-900 p-8 text-white shadow-2xl"
            >
              <div class="flex items-start justify-between">
                <span
                  class="rounded-full bg-amber-500 px-3 py-1 text-xs font-bold text-slate-900 uppercase"
                  >Pet Shop Online</span
                >
                <span class="text-3xl">🦴</span>
              </div>
              <div class="space-y-2">
                <h3 class="text-2xl font-bold">Nutrición & Entretención</h3>
                <p class="text-sm text-indigo-200">
                  Despachos programados para que nunca les falte su comida favorita.
                </p>
              </div>
              <!-- Gráfico decorativo simulando empaque de comida -->
              <div
                class="mt-4 flex h-24 w-full items-center justify-center rounded-xl bg-amber-400 text-xl font-black tracking-widest text-slate-900"
              >
                PREMIUM QUALITY
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN CATEGORÍAS (Estructuración limpia) -->
      <section id="categorias" class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="text-3xl font-bold text-indigo-950">Explora por Consentido</h2>
            <p class="mt-2 font-medium text-slate-500">
              Encuentra de forma rápida lo necesario según el perfil de tu mascota
            </p>
          </div>

          <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
            <!-- Categoría Perros -->
            <a
              href="#destacados"
              class="group rounded-2xl border-2 border-transparent bg-amber-50 p-6 text-center transition-all hover:border-amber-400"
            >
              <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-400 text-3xl transition-transform group-hover:scale-110"
              >
                🐕
              </div>
              <h3 class="text-lg font-bold text-indigo-950">Mundo Perros</h3>
              <p class="mt-1 text-xs text-slate-500">Sacos, arneses, snacks</p>
            </a>

            <!-- Categoría Gatos -->
            <a
              href="#destacados"
              class="group rounded-2xl border-2 border-transparent bg-indigo-50 p-6 text-center transition-all hover:border-indigo-400"
            >
              <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-400 text-3xl transition-transform group-hover:scale-110"
              >
                🐈
              </div>
              <h3 class="text-lg font-bold text-indigo-950">Mundo Gatos</h3>
              <p class="mt-1 text-xs text-slate-500">Arenas, rascadores, comida</p>
            </a>

            <!-- Categoría Farmacia -->
            <a
              href="#destacados"
              class="group rounded-2xl border-2 border-transparent bg-emerald-50 p-6 text-center transition-all hover:border-emerald-400"
            >
              <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-400 text-3xl transition-transform group-hover:scale-110"
              >
                💊
              </div>
              <h3 class="text-lg font-bold text-indigo-950">Cuidado & Salud</h3>
              <p class="mt-1 text-xs text-slate-500">Antiparasitarios, vitaminas</p>
            </a>

            <!-- Categoría Juguetes -->
            <a
              href="#destacados"
              class="group rounded-2xl border-2 border-transparent bg-rose-50 p-6 text-center transition-all hover:border-rose-400"
            >
              <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-400 text-3xl transition-transform group-hover:scale-110"
              >
                🎾
              </div>
              <h3 class="text-lg font-bold text-indigo-950">Juguetes</h3>
              <p class="mt-1 text-xs text-slate-500">Pelotas, interactivos, hilos</p>
            </a>
          </div>
        </div>
      </section>

      <!-- SECCIÓN PRODUCTOS DESTACADOS (Catálogo dinámico con llamadas directas) -->
      <section id="destacados" class="bg-slate-50 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mb-12 flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-3xl font-bold text-indigo-950">Las Ofertas Favoritas en Temuco</h2>
              <p class="font-medium text-slate-500">
                Stock actualizado semanalmente con precios competitivos locales
              </p>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Producto 1 -->
            <article
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
            >
              <div class="p-6">
                <div
                  class="relative mb-4 flex h-48 w-full items-center justify-center rounded-xl bg-slate-100"
                >
                  <span class="text-5xl">🥩</span>
                  <span
                    class="absolute top-3 left-3 rounded bg-red-500 px-2 py-1 text-xs font-bold text-white"
                    >-15% OFF</span
                  >
                </div>
                <span class="text-xs font-bold tracking-wider text-orange-600 uppercase"
                  >Alimento Perros</span
                >
                <h3 class="mt-1 mb-2 text-lg font-bold text-indigo-950">
                  Alimento Premium Adulto Raza Mediana/Grande (15kg)
                </h3>
                <p class="text-sm text-slate-600">
                  Nutrición balanceada con altos niveles de proteína para climas fríos.
                </p>
              </div>
              <div
                class="flex items-center justify-between border-t border-slate-50 bg-slate-50/50 p-6 pt-0"
              >
                <div>
                  <span class="block text-xs text-slate-400 line-through">$45.990</span>
                  <span class="text-xl font-bold text-indigo-950">$38.900</span>
                </div>
                <a
                  href="https://wa.me/56987654321?text=Hola,%20me%20interesa%20comprar%20el%20Alimento%20Premium%20Adulto%20de%2015kg"
                  target="_blank"
                  class="rounded-xl bg-indigo-600 p-3 font-bold text-white shadow-sm transition-all hover:bg-indigo-700"
                  aria-label="Comprar por WhatsApp"
                >
                  🛒 Agregar
                </a>
              </div>
            </article>

            <!-- Producto 2 -->
            <article
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
            >
              <div class="p-6">
                <div
                  class="relative mb-4 flex h-48 w-full items-center justify-center rounded-xl bg-slate-100"
                >
                  <span class="text-5xl">🏰</span>
                  <span
                    class="absolute top-3 right-3 rounded bg-teal-500 px-2 py-1 text-xs font-bold text-white"
                    >Más Vendido</span
                  >
                </div>
                <span class="text-xs font-bold tracking-wider text-purple-600 uppercase"
                  >Mundo Gatos</span
                >
                <h3 class="mt-1 mb-2 text-lg font-bold text-indigo-950">
                  Rascador Castillo de 3 Niveles con Juguete
                </h3>
                <p class="text-sm text-slate-600">
                  Estructura firme tapizada en felpa suave con postes de yute para sus uñas.
                </p>
              </div>
              <div
                class="flex items-center justify-between border-t border-slate-50 bg-slate-50/50 p-6 pt-0"
              >
                <div>
                  <span class="block text-xs text-slate-400 opacity-0">-</span>
                  <span class="text-xl font-bold text-indigo-950">$29.990</span>
                </div>
                <a
                  href="https://wa.me/56987654321?text=Hola,%20me%20interesa%20comprar%20el%20Rascador%20Castillo%20de%203%20Niveles"
                  target="_blank"
                  class="rounded-xl bg-indigo-600 p-3 font-bold text-white shadow-sm transition-all hover:bg-indigo-700"
                  aria-label="Comprar por WhatsApp"
                >
                  🛒 Agregar
                </a>
              </div>
            </article>

            <!-- Producto 3 -->
            <article
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
            >
              <div class="p-6">
                <div
                  class="relative mb-4 flex h-48 w-full items-center justify-center rounded-xl bg-slate-100"
                >
                  <span class="text-5xl">🧥</span>
                </div>
                <span class="text-xs font-bold tracking-wider text-blue-600 uppercase"
                  >Accesorios</span
                >
                <h3 class="mt-1 mb-2 text-lg font-bold text-indigo-950">
                  Capa Impermeable Térmica con Ajuste Ergonómico
                </h3>
                <p class="text-sm text-slate-600">
                  Protege eficazmente a tu mascota de las intensas lluvias de la región.
                </p>
              </div>
              <div
                class="flex items-center justify-between border-t border-slate-50 bg-slate-50/50 p-6 pt-0"
              >
                <div>
                  <span class="block text-xs text-slate-400 line-through">$18.500</span>
                  <span class="text-xl font-bold text-indigo-950">$14.990</span>
                </div>
                <a
                  href="https://wa.me/56987654321?text=Hola,%20me%20interesa%20comprar%20la%20Capa%20Impermeable%20Termica"
                  target="_blank"
                  class="rounded-xl bg-indigo-600 p-3 font-bold text-white shadow-sm transition-all hover:bg-indigo-700"
                  aria-label="Comprar por WhatsApp"
                >
                  🛒 Agregar
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- SECCIÓN LOGÍSTICA / CONFIANZA LOCAL -->
      <section id="despacho" class="bg-indigo-950 py-16 text-white">
        <div
          class="mx-auto grid max-w-7xl gap-8 px-4 text-center sm:px-6 md:grid-cols-3 md:text-left lg:px-8"
        >
          <div class="rounded-2xl border border-indigo-800 bg-indigo-900/40 p-6">
            <div class="mb-3 text-3xl">📍</div>
            <h3 class="mb-2 text-xl font-bold">Zonas de Cobertura</h3>
            <p class="text-sm text-indigo-200">
              Llegamos a todo Temuco, Labranza, Cajón y Padre Las Casas. Entregas en menos de 24
              horas hábiles.
            </p>
          </div>

          <div class="rounded-2xl border border-indigo-800 bg-indigo-900/40 p-6">
            <div class="mb-3 text-3xl">💳</div>
            <h3 class="mb-2 text-xl font-bold">Métodos de Pago</h3>
            <p class="text-sm text-indigo-200">
              Paga de forma 100% segura mediante transferencia bancaria electrónica o
              efectivo/tarjeta al momento de recibir.
            </p>
          </div>

          <div class="rounded-2xl border border-indigo-800 bg-indigo-900/40 p-6">
            <div class="mb-3 text-3xl">⭐</div>
            <h3 class="mb-2 text-xl font-bold">Garantía Conforme</h3>
            <p class="text-sm text-indigo-200">
              ¿El tamaño de la capa o el arnés no le quedó? Hacemos el cambio de talla a domicilio
              sin costos extra.
            </p>
          </div>
        </div>
      </section>

      <!-- SECCIÓN TESTIMONIOS -->
      <section class="bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="mb-12 text-center text-3xl font-bold text-indigo-950">
            Pet Lovers Felices en Temuco
          </h2>

          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            <blockquote
              class="flex flex-col justify-between rounded-2xl border border-slate-100 bg-slate-50 p-6"
            >
              <p class="mb-4 text-sm text-slate-600 italic">
                "Excelente el servicio de despacho a Labranza. El alimento llegó sellado y más
                barato que en las veterinarias del centro."
              </p>
              <cite class="flex items-center gap-2 text-sm font-bold text-indigo-950 not-italic">
                <span>🐾</span> Romina T. (Dueña de Max)
              </cite>
            </blockquote>

            <blockquote
              class="flex flex-col justify-between rounded-2xl border border-slate-100 bg-slate-50 p-6"
            >
              <p class="mb-4 text-sm text-slate-600 italic">
                "Compré el rascador castillo para mis dos gatos y les encantó. La atención por
                WhatsApp fue súper rápida y amable."
              </p>
              <cite class="flex items-center gap-2 text-sm font-bold text-indigo-950 not-italic">
                <span>🐾</span> Pedro S. (Dueño de Pelusa)
              </cite>
            </blockquote>

            <blockquote
              class="flex flex-col justify-between rounded-2xl border border-slate-100 bg-slate-50 p-6"
            >
              <p class="mb-4 text-sm text-slate-600 italic">
                "La capa impermeable salvó a mi quiltro de los paseos lluviosos de este invierno en
                Temuco. 10 de 10 con el cambio de talla."
              </p>
              <cite class="flex items-center gap-2 text-sm font-bold text-indigo-950 not-italic">
                <span>🐾</span> Francisca M. (Dueña de Cholo)
              </cite>
            </blockquote>
          </div>
        </div>
      </section>

      <!-- SECCIÓN CONTACTO / FORMULARIO SIMULADO DIRECTO -->
      <section id="contacto" class="bg-amber-400 py-16 text-indigo-950">
        <div class="mx-auto max-w-5xl space-y-6 px-4 text-center sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold sm:text-4xl">¿Buscas una marca o formato específico?</h2>
          <p class="mx-auto max-w-2xl text-lg font-medium text-slate-900">
            Escríbenos directamente indicando qué necesita tu mascota. Te responderemos de inmediato
            con la cotización y factibilidad de entrega hoy mismo.
          </p>
          <div class="flex justify-center pt-2">
            <a
              href="https://wa.me/56987654321?text=Hola,%20busco%20un%20producto%20especifico%20para%20mi%20mascota"
              target="_blank"
              class="inline-flex items-center gap-3 rounded-2xl bg-indigo-950 px-10 py-5 text-lg font-bold text-white shadow-xl transition-all hover:bg-indigo-900"
            >
              💬 Consultar Stock Inmediato
            </a>
          </div>
          <p class="text-xs font-bold tracking-wider text-slate-800 uppercase">
            Atención de Lunes a Domingo — Temuco, Región de la Araucanía
          </p>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800 bg-slate-900 py-12 text-sm text-slate-400">
      <div
        class="mx-auto grid max-w-7xl items-center gap-8 px-4 text-center sm:px-6 md:grid-cols-2 md:text-left lg:px-8"
      >
        <div>
          <p class="mb-1 text-lg font-bold text-white">Garras & Patas S.A.</p>
          <p>&copy; 2026 Distribuidora de Alimentos y Accesorios para Mascotas Limitada.</p>
        </div>
        <div class="flex justify-center gap-6 text-xs md:justify-end">
          <a href="#" class="transition-colors hover:text-white">Políticas de Despacho</a>
          <a href="#" class="transition-colors hover:text-white">Términos Comerciales</a>
        </div>
      </div>
    </footer>

    <!-- INTERACTIVIDAD MÓVIL (Menú de navegación móvil funcional) -->
    <script>
      const hamburgerBtn = document.getElementById("hamburger-btn");
      const mobileDropdown = document.getElementById("mobile-dropdown");

      hamburgerBtn.addEventListener("click", () => {
        mobileDropdown.classList.toggle("hidden");
      });

      // Auto-cerrar menú al hacer clic en secciones
      const dropdownLinks = mobileDropdown.querySelectorAll("a");
      dropdownLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileDropdown.classList.add("hidden");
        });
      });
    </script>
  </body>
</html>
