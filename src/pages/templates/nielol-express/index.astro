---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Ñielol Express | Los Mejores Completos y Chorrillanas de Temuco";
const description = "Ñielol Express | Los Mejores Completos y Chorrillanas de Temuco";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Tipografía con personalidad para comida rápida -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-brand {
        font-family: "Lilita One", cursive;
      }
      body {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
    </style>
  </head>
  <body class="bg-zinc-50 text-zinc-900 antialiased">
    <!-- AVISO SUPERIOR / PROMO -->
    <div
      class="bg-yellow-400 px-4 py-2 text-center text-xs font-extrabold tracking-wider text-red-700 uppercase"
    >
      ⚡ ¡Retira al paso en 10 minutos! Agenda tu pedido por WhatsApp ⚡
    </div>

    <!-- NAVBAR -->
    <header class="sticky top-0 z-50 border-b border-zinc-200 bg-white shadow-sm">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="#" class="group flex items-center gap-1">
          <span
            class="font-brand inline-block text-3xl tracking-wide text-red-600 transition-transform group-hover:scale-105"
            >ÑIELOL</span
          >
          <span
            class="font-brand inline-block text-3xl tracking-wide text-yellow-500 transition-transform group-hover:scale-105"
            >EXPRESS</span
          >
        </a>

        <nav
          class="hidden items-center gap-8 text-sm font-bold tracking-wide text-zinc-700 uppercase md:flex"
        >
          <a href="#carta" class="transition-colors hover:text-red-600">La Carta</a>
          <a href="#promos" class="transition-colors hover:text-red-600">Promos Universitarias</a>
          <a href="#DondeEstamos" class="transition-colors hover:text-red-600">¿Dónde Estamos?</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56987654321?text=Hola%20Ñielol%20Express,%20quiero%20hacer%20un%20pedido"
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-xl bg-red-600 px-6 py-3 text-center text-sm font-bold tracking-wide text-white shadow-md shadow-red-600/20 transition-all hover:bg-red-700"
          >
            ¡PIDE YA!
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO SECTION -->
      <section class="relative overflow-hidden bg-yellow-400 py-16 lg:py-24">
        <!-- Decoraciones de fondo geométricas y limpias -->
        <div class="absolute -top-12 -right-12 h-96 w-96 rounded-full bg-red-600 opacity-10"></div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8"
        >
          <div class="space-y-6 text-center md:text-left">
            <span
              class="rounded-md bg-red-600 px-4 py-1.5 text-xs font-black tracking-widest text-white uppercase shadow-sm"
            >
              📍 100% Temucano
            </span>
            <h1
              class="font-brand text-5xl leading-none tracking-wide text-red-600 sm:text-6xl lg:text-7xl"
            >
              ¡El verdadero gigante al paso!
            </h1>
            <p class="mx-auto max-w-lg text-lg leading-relaxed font-semibold text-red-950 md:mx-0">
              Bajón criollo de calidad en pleno centro de Temuco. Completos con palta de verdad,
              mayo casera y las chorrillanas más cargadas de la Región de la Araucanía.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#carta"
                class="transform rounded-xl bg-red-600 px-8 py-4 text-center font-extrabold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-red-700"
              >
                Ver la Carta Completa
              </a>
              <a
                href="https://wa.me/56987654321?text=Hola,%20quiero%20saber%20la%20promo%20del%20dia"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl border-2 border-red-600 bg-white px-8 py-4 text-center font-extrabold text-red-600 shadow-sm transition-all hover:bg-zinc-100"
              >
                Promo del Día 🌭
              </a>
            </div>
          </div>

          <div class="relative flex justify-center">
            <div
              class="absolute inset-0 scale-105 rotate-6 transform rounded-3xl bg-white/40 blur-xl filter"
            >
            </div>
            <img
              src="https://images.unsplash.com/photo-1626074353765-517a681e40be?q=80&w=800&auto=format&fit=crop"
              alt="Completos gigantes italianos con harta palta, tomate y mayo casera"
              class="relative z-10 w-full max-w-md rounded-3xl border-4 border-white object-cover shadow-xl"
            />
          </div>
        </div>
      </section>

      <!-- SECCIÓN PROMOS DESTACADAS -->
      <section id="promos" class="border-b border-zinc-200 bg-white py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="font-brand text-4xl tracking-wide text-red-600">Combos Rompe-Bolsillo</h2>
            <p class="mt-2 font-medium text-zinc-500">
              Ideales para estudiantes de Temuco. Sabor brutal que rinde el presupuesto.
            </p>
          </div>

          <div class="grid gap-8 md:grid-cols-2">
            <!-- Promo 1 -->
            <div
              class="relative flex flex-col items-start justify-between overflow-hidden rounded-3xl bg-gradient-to-br from-red-600 to-red-700 p-8 text-white shadow-xl"
            >
              <div
                class="font-brand absolute right-0 bottom-0 translate-x-10 translate-y-10 text-9xl text-white/5"
              >
                🌭
              </div>
              <div class="relative z-10 space-y-3">
                <span
                  class="rounded-full bg-yellow-400 px-3 py-1 text-xs font-black text-red-700 uppercase"
                  >La Más Pedida</span
                >
                <h3 class="font-brand text-3xl tracking-wide">Dupla Italiana Universitaria</h3>
                <p class="max-w-sm text-sm text-red-100">
                  2 Completos Italianos gigantes en pan artesanal + Bebida lata de 350ml a elección.
                </p>
                <p class="font-brand text-4xl text-yellow-400">
                  $4.990 <span class="font-sans text-xs font-normal text-red-200 line-through"
                    >$6.200</span
                  >
                </p>
              </div>
              <a
                href="https://wa.me/56987654321?text=Quiero%20la%20Promo%20Dupla%20Italiana"
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-10 mt-6 rounded-xl bg-yellow-400 px-6 py-3 text-sm font-extrabold text-red-800 shadow-md transition-all hover:bg-yellow-500"
              >
                Pedir Combo
              </a>
            </div>

            <!-- Promo 2 -->
            <div
              class="relative flex flex-col items-start justify-between overflow-hidden rounded-3xl bg-gradient-to-br from-zinc-900 to-zinc-950 p-8 text-white shadow-xl"
            >
              <div
                class="font-brand absolute right-0 bottom-0 translate-x-10 translate-y-10 text-9xl text-white/5"
              >
                🍟
              </div>
              <div class="relative z-10 space-y-3">
                <span
                  class="rounded-full bg-red-600 px-3 py-1 text-xs font-black text-white uppercase"
                  >Para Compartir</span
                >
                <h3 class="font-brand text-3xl tracking-wide">Chorrillana Ñielol Personal</h3>
                <p class="max-w-sm text-sm text-zinc-400">
                  Cama de papas fritas rústicas, harta carne picada, cebolla frita caramelizada y
                  huevo revuelto.
                </p>
                <p class="font-brand text-4xl text-yellow-400">
                  $6.500 <span class="font-sans text-xs font-normal text-zinc-500 line-through"
                    >$7.800</span
                  >
                </p>
              </div>
              <a
                href="https://wa.me/56987654321?text=Quiero%20la%20Promo%20Chorrillana%20Ñielol"
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-10 mt-6 rounded-xl bg-red-600 px-6 py-3 text-sm font-extrabold text-white shadow-md transition-all hover:bg-red-700"
              >
                Pedir Combo
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- LA CARTA / PRODUCTOS -->
      <section id="carta" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <h2 class="font-brand text-4xl tracking-wide text-zinc-900">
            Lo Mejor de Nuestra Vitrina
          </h2>
          <p class="mt-2 font-medium text-zinc-500">
            Preparado al momento frente a tus ojos. Ingredientes frescos locales.
          </p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Ítem 1 -->
          <div
            class="flex flex-col justify-between overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm transition-shadow hover:shadow-md"
          >
            <div>
              <div class="relative">
                <img
                  src="https://images.unsplash.com/photo-1626074353765-517a681e40be?q=80&w=500&auto=format&fit=crop"
                  alt="As de Vacuno Italiano"
                  class="h-48 w-full object-cover"
                />
                <span
                  class="absolute top-4 right-4 rounded-full bg-red-600 px-3 py-1 text-xs font-bold text-white shadow"
                  >El Favorito</span
                >
              </div>
              <div class="space-y-2 p-6">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-lg font-bold text-zinc-900">As de Vacuno Italiano</h4>
                  <span class="font-brand text-xl whitespace-nowrap text-red-600">$4.200</span>
                </div>
                <p class="text-sm leading-relaxed text-zinc-500">
                  Finas tiras de carne de vacuno salteadas a la plancha, tomate fresco, palta Hass
                  molida y nuestra clásica mayonesa de la casa.
                </p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <a
                href="https://wa.me/56987654321?text=Hola!%20Quiero%20pedir%20el%20As%20de%20Vacuno%20Italiano"
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full rounded-xl bg-zinc-100 py-3 text-center text-sm font-bold text-zinc-800 transition-all hover:bg-yellow-400 hover:text-red-700"
              >
                Pedir al WhatsApp
              </a>
            </div>
          </div>

          <!-- Ítem 2 -->
          <div
            class="flex flex-col justify-between overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm transition-shadow hover:shadow-md"
          >
            <div>
              <div class="relative">
                <img
                  src="https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?q=80&w=500&auto=format&fit=crop"
                  alt="Sánguche Mechada Luco"
                  class="h-48 w-full object-cover"
                />
              </div>
              <div class="space-y-2 p-6">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-lg font-bold text-zinc-900">Mechada Luco en Marraqueta</h4>
                  <span class="font-brand text-xl whitespace-nowrap text-red-600">$5.800</span>
                </div>
                <p class="text-sm leading-relaxed text-zinc-500">
                  Carne mechada desmenuzada cocinada a fuego lento por horas, servida con abundante
                  queso mantecoso derretido en marraqueta crujiente.
                </p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <a
                href="https://wa.me/56987654321?text=Hola!%20Quiero%20pedir%20la%20Mechada%20Luco"
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full rounded-xl bg-zinc-100 py-3 text-center text-sm font-bold text-zinc-800 transition-all hover:bg-yellow-400 hover:text-red-700"
              >
                Pedir al WhatsApp
              </a>
            </div>
          </div>

          <!-- Ítem 3 -->
          <div
            class="flex flex-col justify-between overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm transition-shadow hover:shadow-md"
          >
            <div>
              <div class="relative">
                <img
                  src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?q=80&w=500&auto=format&fit=crop"
                  alt="Papas Fritas Especial Ñielol"
                  class="h-48 w-full object-cover"
                />
              </div>
              <div class="space-y-2 p-6">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-lg font-bold text-zinc-900">Papas Express Especial</h4>
                  <span class="font-brand text-xl whitespace-nowrap text-red-600">$3.800</span>
                </div>
                <p class="text-sm leading-relaxed text-zinc-500">
                  Papas fritas grandes crujientes acompañadas de vienesas picadas y cubiertas con
                  nuestra famosa salsa de la casa. El bajón rápido definitivo.
                </p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <a
                href="https://wa.me/56987654321?text=Hola!%20Quiero%20pedir%20las%20Papas%20Express%20Especial"
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full rounded-xl bg-zinc-100 py-3 text-center text-sm font-bold text-zinc-800 transition-all hover:bg-yellow-400 hover:text-red-700"
              >
                Pedir al WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- DIRECCIÓN Y CONVERSIÓN -->
      <section id="DondeEstamos" class="border-t border-zinc-200 bg-zinc-100 py-16">
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
          <div class="space-y-6">
            <h2 class="font-brand text-4xl tracking-wide text-red-600">
              Pasa por tu bajón al centro
            </h2>
            <p class="leading-relaxed text-zinc-600">
              Nos ubicamos en el punto clave del movimiento estudiantil y comercial de Temuco. Ideal
              para pasar caminando, retirar rápido o pedir directo a tu oficina o sala de clases.
            </p>

            <div class="space-y-4 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
              <div class="flex items-start gap-3">
                <span class="text-2xl">📍</span>
                <div>
                  <h5 class="font-bold text-zinc-900">Nuestra Picá:</h5>
                  <p class="text-sm text-zinc-500">
                    Calle Claro Solar 980 (A pasos de la plaza), Temuco, Región de la Araucanía.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-2xl">⏰</span>
                <div>
                  <h5 class="font-bold text-zinc-900">Horario Continuo:</h5>
                  <p class="text-sm text-zinc-500">Lunes a Sábado: 11:30 a 22:30 hrs.</p>
                  <p class="text-sm font-semibold text-red-600 text-zinc-500">
                    Domingos: Cerrado por descanso.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Simulación de Mapa con la nueva paleta de color -->
          <div class="rounded-3xl bg-red-600 p-2 shadow-xl">
            <div
              class="relative flex h-72 flex-col items-center justify-center overflow-hidden rounded-2xl bg-white p-6 text-center"
            >
              <div
                class="absolute inset-0 bg-[radial-gradient(#dc2626_1px,transparent_1px)] [background-size:12px_12px] opacity-10"
              >
              </div>
              <span class="mb-2 text-4xl">🧭</span>
              <h4 class="font-brand text-xl tracking-wide text-zinc-800">
                Estamos a pasos de la Plaza de Armas
              </h4>
              <p class="mt-1 mb-4 max-w-xs text-xs text-zinc-400">
                Incrusta aquí el Google Maps de tu cliente para asegurar el posicionamiento web de
                Google Business Profile.
              </p>
              <a
                href="https://maps.google.com"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl bg-red-600 px-6 py-3 text-xs font-bold text-white shadow-sm transition-colors hover:bg-red-700"
              >
                Ver mapa en pantalla completa
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-zinc-900 py-12 text-sm text-zinc-400">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8"
      >
        <div class="text-center sm:text-left">
          <p class="font-brand text-2xl tracking-wide text-white">ÑIELOL EXPRESS</p>
          <p class="mt-1 text-xs text-zinc-500">&copy; 2026 Todos los derechos reservados.</p>
        </div>
        <div class="space-y-1 text-center sm:text-right">
          <p class="font-semibold text-zinc-300">Comida rápida con identidad regional</p>
          <p class="text-xs text-zinc-500">Diseñado para la Región de la Araucanía, Chile.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
