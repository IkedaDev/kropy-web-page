    </footer>

    <!-- Works Lightbox Modal with Slider functionality -->
    <div
      id="works-lightbox"
      class="bg-asphalt-950/95 fixed inset-0 z-50 flex hidden items-center justify-center p-4 backdrop-blur-md"
    >
      <!-- Close button -->
      <button
        onclick="closeWorksLightbox()"
        class="hover:text-kutral-acid absolute top-6 right-6 z-50 text-2xl font-black text-white focus:outline-none"
        aria-label="Cerrar"
      >
        ✕
      </button>

      <div class="relative flex w-full max-w-4xl flex-col items-center">
        <!-- Navigation controls -->
        <button
          onclick="prevWorkSlide()"
          class="hover:text-kutral-acid font-display absolute top-1/2 left-2 z-50 -translate-y-1/2 transform rounded bg-stone-900/50 px-3 py-1.5 text-3xl font-semibold text-white focus:outline-none sm:-left-12 sm:bg-transparent"
        >
          ◀
        </button>

        <button
          onclick="nextWorkSlide()"
          class="hover:text-kutral-acid font-display absolute top-1/2 right-2 z-50 -translate-y-1/2 transform rounded bg-stone-900/50 px-3 py-1.5 text-3xl font-semibold text-white focus:outline-none sm:-right-12 sm:bg-transparent"
        >
          ▶
        </button>

        <!-- Lightbox Image -->
        <img
          id="lightbox-work-img"
          src=""
          alt="Mural ampliado"
          class="max-h-[75vh] max-w-full rounded-none border border-stone-800 object-contain shadow-2xl"
        />

        <!-- Dynamic Caption -->
        <p
          id="lightbox-work-caption"
          class="mt-4 px-4 text-center text-xs font-light tracking-wider text-stone-300 uppercase"
        >
        </p>
      </div>
    </div>

    <!-- JavaScript Controllers -->
    <script>
      // DOM Elements
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      // Mobile Menu Toggle
      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Close mobile panel on click
      const navLinks = mobileMenu.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // FAQ Toggle
      function toggleMuralFaq(faqId) {
        const el = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId);

        if (el.classList.contains("hidden")) {
          el.classList.remove("hidden");
          icon.innerText = "－";
          icon.classList.add("text-kutral-acid");
        } else {
          el.classList.add("hidden");
          icon.innerText = "＋";
          icon.classList.remove("text-kutral-acid");
        }
      }

      // Works Filtering
      function filterWorks(category) {
        const items = document.querySelectorAll(".work-item");
        const buttons = document.querySelectorAll(".work-filter-btn");

        buttons.forEach((btn) => {
          btn.className =
            "work-filter-btn px-6 py-3 border-2 border-stone-800 text-[10px] font-black uppercase tracking-wider hover:border-stone-500 text-stone-300 hover:text-white transition-all";
        });

        const activeBtn = document.getElementById("btn-work-" + category);
        if (activeBtn) {
          activeBtn.className =
            "work-filter-btn px-6 py-3 border-2 border-kutral-500 text-[10px] font-black uppercase tracking-wider bg-kutral-500 text-white transition-all";
        }

        items.forEach((item) => {
          if (category === "all" || item.classList.contains(category)) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      }

      // Mural Budget Calculator logic
      let muralTypeSelected = "medium";
      let muralCostPerSqM = 45000;
      let muralWidth = 4;
      let muralHeight = 3;

      function updateMuroAncho(val) {
        muralWidth = parseInt(val);
        document.getElementById("ancho-display").innerText = `${muralWidth} Metros`;
        calculateMural();
      }

      function updateMuroAlto(val) {
        muralHeight = parseInt(val);
        document.getElementById("alto-display").innerText = `${muralHeight} Metros`;
        calculateMural();
      }

      function setMuralType(type, price) {
        muralTypeSelected = type;
        muralCostPerSqM = price;

        const buttons = document.querySelectorAll(".mural-type-btn");
        buttons.forEach((btn) => {
          btn.className =
            "mural-type-btn p-4 border border-stone-800 hover:border-stone-600 text-left bg-asphalt-950 text-stone-300 rounded-none transition-all";
        });

        const activeBtn = document.getElementById("type-" + type);
        activeBtn.className =
          "mural-type-btn p-4 border-2 border-kutral-500 text-left bg-kutral-500/10 text-white rounded-none transition-all";

        calculateMural();
      }

      function calculateMural() {
        const area = muralWidth * muralHeight;
        document.getElementById("resumen-area").innerText = `${area} m²`;

        // Estimate spray cans (~1.5 cans per square meter)
        const cans = Math.round(area * 1.5);
        document.getElementById("resumen-latas").innerText = `~ ${cans} Sprays`;

        // Estimate duration (approx 1 day per 5 square meters, minimum 2 days)
        const days = Math.max(
          2,
          Math.round(area / 5) + (muralTypeSelected === "realistic" ? 2 : 0)
        );
        document.getElementById("resumen-tiempo").innerText = `~ ${days} Días`;

        // Price base calculation
        const priceBase = area * muralCostPerSqM;
        document.getElementById("resumen-precio-base").innerText =
          `$${priceBase.toLocaleString("es-CL")}`;

        // Extras calculation
        let extras = 0;
        const prepChecked = document.getElementById("prep-imprimacion");
        if (prepChecked.checked) {
          extras += parseInt(prepChecked.value);
        }

        const barnizChecked = document.getElementById("prep-barniz");
        if (barnizChecked.checked) {
          // Barniz extra depends on height of muro
          extras += 15000 * muralHeight;
        }

        document.getElementById("resumen-precio-pre").innerText =
          `$${extras.toLocaleString("es-CL")}`;

        // Show Total final CLP
        const total = priceBase + extras;
        document.getElementById("calculo-total").innerText = `$${total.toLocaleString("es-CL")}`;
      }

      // Apply dynamic estimate straight into the form
      function applyEstimateToMuralContact() {
        const selectEl = document.getElementById("m-style");
        selectEl.value = muralTypeSelected === "realistic" ? "comercial" : muralTypeSelected;

        const totalVal = document.getElementById("calculo-total").innerText;
        const areaVal = document.getElementById("resumen-area").innerText;
        const daysVal = document.getElementById("resumen-tiempo").innerText;

        let extraNotes = [];
        if (document.getElementById("prep-imprimacion").checked)
          extraNotes.push("Limpieza e imprimación");
        if (document.getElementById("prep-barniz").checked) extraNotes.push("Barniz protector UV");

        const extraText =
          extraNotes.length > 0 ? ` Con adicionales de: ${extraNotes.join(", ")}.` : "";

        const generatedMessage = `Hola Kutral, me gustaría agendar un mural de complejidad "${muralTypeSelected}" con dimensiones de ${muralWidth}m de ancho por ${muralHeight}m de alto (${areaVal} totales).${extraText}\n\nPresupuesto autocalculado: ${totalVal} CLP (Plazo aproximado: ${daysVal}).\n\nQuedo atento a tu respuesta para definir el boceto.`;

        document.getElementById("m-msg").value = generatedMessage;

        // Scroll Smooth to form section
        document.getElementById("contacto").scrollIntoView({ behavior: "smooth" });
        setTimeout(() => {
          document.getElementById("m-name").focus();
        }, 800);
      }

      // Lightbox for Works Gallery
      let currentWorkIndex = 0;
      const galleryWorksData = [
        {
          src: "https://images.unsplash.com/photo-1518156677180-95a2893f3e9f?auto=format&fit=crop&w=1200&q=80",
          caption: "Confluencia Verde — Mural en interior de cafetería. Av. Alemania, Temuco.",
        },
        {
          src: "https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=1200&q=80",
          caption: "Fuerza de la Tierra — Mural comunitario. Padre Las Casas, Chile.",
        },
        {
          src: "https://images.unsplash.com/photo-1561055657-b9e0bf0fa360?auto=format&fit=crop&w=1200&q=80",
          caption: "Portal Araucaria — Decoración floral de terraza. Sector Poniente, Temuco.",
        },
        {
          src: "https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=1200&q=80",
          caption: "Estudio Textil Volcán — Fachada exterior de alto tránsito comercial, Temuco.",
        },
        {
          src: "https://images.unsplash.com/photo-1533158326339-7f3cf2404354?auto=format&fit=crop&w=1200&q=80",
          caption: "Humedal Vivo — Concientización ecológica en liceo. Victoria, Araucanía.",
        },
        {
          src: "https://images.unsplash.com/photo-1549887534-1541e9326642?auto=format&fit=crop&w=1200&q=80",
          caption: "Vuelo Cósmico — Naturaleza interior sobre madera, Pucón.",
        },
      ];

      const wLightbox = document.getElementById("works-lightbox");
      const wLightboxImg = document.getElementById("lightbox-work-img");
      const wLightboxCaption = document.getElementById("lightbox-work-caption");

      function openWorksLightbox(index) {
        currentWorkIndex = index;
        updateWorkSlide();
        wLightbox.classList.remove("hidden");
      }

      function closeWorksLightbox() {
        wLightbox.classList.add("hidden");
        wLightboxImg.src = "";
      }

      function updateWorkSlide() {
        const data = galleryWorksData[currentWorkIndex];
        wLightboxImg.src = data.src;
        wLightboxCaption.innerText = data.caption;
      }

      function nextWorkSlide() {
        currentWorkIndex = (currentWorkIndex + 1) % galleryWorksData.length;
        updateWorkSlide();
      }

      function prevWorkSlide() {
        currentWorkIndex =
          (currentWorkIndex - 1 + galleryWorksData.length) % galleryWorksData.length;
        updateWorkSlide();
      }

      // Keyboard Controls
      document.addEventListener("keydown", (e) => {
        if (!wLightbox.classList.contains("hidden")) {
          if (e.key === "Escape") closeWorksLightbox();
          if (e.key === "ArrowRight") nextWorkSlide();
          if (e.key === "ArrowLeft") prevWorkSlide();
        }
      });

      // Contact Form handling
      function handleMuralContactSubmit(event) {
        event.preventDefault();

        const clientName = document.getElementById("m-name").value;
        const successDesc = document.getElementById("mural-success-desc");

        successDesc.innerHTML = `Estimado(a) <strong>${clientName}</strong>, he recibido tu propuesta de diseño mural para tu espacio. Me pondré en contacto contigo por WhatsApp o e-mail en menos de 24 horas hábiles para coordinar detalles y mostrarte ideas.`;

        document.getElementById("mural-contact-form").classList.add("hidden");
        document.getElementById("mural-contact-success").classList.remove("hidden");
      }

      function resetMuralContactForm() {
        document.getElementById("mural-contact-form").reset();
        document.getElementById("mural-contact-form").classList.remove("hidden");
        document.getElementById("mural-contact-success").classList.add("hidden");
      }

      // Initialize calculation values on load
      window.onload = function () {
        calculateMural();
      };
    </script>
  </body>
</html>
