                onclick="resetMuralContactForm()"
                class="bg-stone-800 px-5 py-3 text-xs font-black tracking-wider text-white uppercase hover:bg-stone-700"
              >
                Enviar Otro Mensaje
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-asphalt-950 border-t-2 border-stone-800 py-16 text-xs text-stone-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-4">
          <!-- Brand section -->
          <div class="space-y-4 md:col-span-2">
            <span class="font-display block text-lg font-black tracking-tighter text-white"
              >KUTRAL MURALES</span
            >
            <p class="max-w-sm text-xs leading-relaxed font-light text-stone-400">
              Muralismo artístico, graffiti y transformaciones espaciales en Temuco y el sur de
              Chile. Llevando el color de la identidad regional a la vida urbana.
            </p>
          </div>

          <!-- Navigation link list -->
          <div>
            <h4 class="mb-4 text-xs font-black tracking-wider text-white uppercase">Navegación</h4>
            <ul class="space-y-2">
              <li>
                <a href="#manifiesto" class="hover:text-kutral-acid transition-colors"
                  >Camilo Kutral</a
                >
              </li>
              <li>
                <a href="#portafolio" class="hover:text-kutral-acid transition-colors"
                  >Portafolio de Muros</a
                >
              </li>
              <li>
                <a href="#calculadora" class="hover:text-kutral-acid transition-colors"
                  >Calculadora Online</a
                >
              </li>
              <li>
                <a href="#contacto" class="hover:text-kutral-acid transition-colors"
                  >Contacto Directo</a
                >
              </li>
            </ul>
          </div>

          <!-- Location details -->
          <div>
            <h4 class="mb-4 text-xs font-black tracking-wider text-white uppercase">
              Llegando a todo el Sur
            </h4>
            <p class="text-xs leading-relaxed font-light text-stone-400">
              Talleres locales ubicados en Temuco. Nos desplazamos con andamiaje y equipamiento
              propio a todas las provincias de la Araucanía, Los Ríos y Los Lagos.
            </p>
          </div>
        </div>

        <!-- Bottom Credits -->
        <div
          class="flex flex-col items-center justify-between gap-4 border-t border-stone-800 pt-8 text-[11px] text-stone-500 sm:flex-row"
        >
          <p>
            &copy; 2026 Kutral Murales. Todos los derechos reservados. Temuco, Región de la
            Araucanía, Chile.
          </p>
          <div class="flex gap-4">
            <a href="#" class="transition-colors hover:text-white">Términos de Encargo</a>
            <a href="#" class="transition-colors hover:text-white">Políticas de Cuidado</a>
