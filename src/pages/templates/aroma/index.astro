    <!-- SECCIÓN HERO: Composición translúcida y envolvente -->
    <section class="relative mx-auto max-w-7xl px-6 py-20 sm:px-10 lg:py-32">
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
        <!-- Mensajes y Copys en el Cristal -->
        <div class="space-y-8 text-center lg:col-span-7 lg:text-left">
          <div
            class="glass-panel inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-[9px] font-bold tracking-[0.2em] text-[--kutral-clay] uppercase"
          >
            <span class="h-2 w-2 animate-pulse rounded-full bg-[--kutral-clay]"></span> TEMUCO, ARAUCANÍA
          </div>

          <h1
            class="font-editorial text-5xl leading-[1.05] tracking-tight text-white sm:text-7xl lg:text-8xl"
          >
