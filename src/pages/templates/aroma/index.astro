                  class="glass-input kutral-transition w-full rounded-xl px-4 py-3 text-xs outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="kutral-transition w-full rounded-full bg-white py-4 text-center text-[10px] font-bold tracking-widest text-black uppercase shadow-sm hover:bg-[--kutral-clay] hover:text-white"
              >
                Agendar Clase de Prueba Gratis &rarr;
              </button>
            </form>

            <!-- Notificación de Éxito Limpia -->
            <div
              id="contact-success-msg"
              class="mt-4 hidden rounded-xl border border-[--kutral-clay]/20 bg-[--kutral-clay]/10 p-4 text-center text-xs font-semibold text-white"
            >
              🌋 ¡Solicitud recibida! Te contactaremos vía WhatsApp para coordinar tu día de acceso
              de cortesía al laboratorio.
            </div>
          </div>
        </div>
      </section>

      <!-- PIE DE PÁGINA (Estilo Corporativo Kropy) -->
      <footer
        class="relative border-t border-[--glass-border] bg-[#05080A] py-14 text-[--kutral-muted]"
      >
        <div class="mx-auto max-w-7xl px-6 sm:px-10">
          <div
            class="flex flex-col items-center justify-between gap-8 border-b border-white/5 pb-8 md:flex-row"
          >
            <div class="space-y-1 text-center md:text-left">
              <span class="font-editorial block text-xl font-bold tracking-tight text-white italic"
                >Aroma<span class="text-[--kutral-clay] not-italic">.</span></span
              >
              <span class="block text-[9px] tracking-widest text-gray-500 uppercase"
                >Kinetic & Thermal Lab • Temuco</span
              >
            </div>

            <!-- Enlaces Rápidos del Pie -->
            <div
              class="flex flex-wrap justify-center gap-6 text-[10px] font-bold tracking-wider text-gray-400 uppercase"
            >
              <a href="#concepto" class="kutral-transition hover:text-[--kutral-clay]">Concepto</a>
              <a href="#ciclo" class="kutral-transition hover:text-[--kutral-clay]">Ciclo</a>
              <a href="#clases" class="kutral-transition hover:text-[--kutral-clay]">Clases</a>
              <a href="#planes" class="kutral-transition hover:text-[--kutral-clay]">Tarifas</a>
            </div>
          </div>

          <!-- Propiedad Intelectual Kropy -->
          <div
            class="flex flex-col items-center justify-between gap-4 pt-8 text-center text-[10px] tracking-wide text-gray-500 sm:flex-row sm:text-left"
          >
            <p>
              &copy; 2026 Aroma ATHLETIC LAB. Diseñado para potenciar tu portafolio de landings
              profesionales.
            </p>
            <div class="flex gap-4">
              <a href="#" class="hover:text-white">Aviso de Privacidad</a>
              <span class="text-neutral-700">|</span>
              <p class="text-white">
                Desarrollado por <a href="#" class="font-bold hover:text-[--kutral-clay]">Kropy</a>
              </p>
            </div>
          </div>
        </div>
      </footer>

      <script>
        /* --- MENÚ MÓVIL DESPLEGABLE --- */
        const menuToggle = document.getElementById("drawer-toggle");
        const mobileDrawer = document.getElementById("mobile-drawer");
        const menuIcon = document.getElementById("drawer-icon");

        menuToggle.addEventListener("click", () => {
          mobileDrawer.classList.toggle("hidden");
          if (mobileDrawer.classList.contains("hidden")) {
            menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
          } else {
            menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12");
          }
        });

        const drawerLinks = mobileDrawer.querySelectorAll("a");
        drawerLinks.forEach((link) => {
          link.addEventListener("click", () => {
            mobileDrawer.classList.add("hidden");
            menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
          });
        });

        /* --- SWITCHER INTERACTIVO DEL ESTADO TÉRMICO --- */
        const thermalStates = {
          kutral: {
            icon: "🔥",
            subtitle: "ESTADO DE ACTIVACIÓN CELULAR",
            title: "Aroma: Calor & Fuerza",
            description:
              "Es el centro de esfuerzo neuromuscular. Aquí se trabaja la fuerza de sobrecarga progresiva con plataformas olímpicas y sistemas de poleas calibradas. Las salas se mantienen calefaccionadas a temperatura constante para optimizar la elasticidad de tus tendones durante la sesión.",
            temp: "24°C Constante",
            focus: "Hipertrofia & Fuerza",
            image:
              "https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&w=500&q=80",
          },
          piru: {
            icon: "❄️",
            subtitle: "ESTADO DE RECUPERACIÓN METABÓLICA",
            title: "Piru: Frío & Contraste",
            description:
              "La zona de restauración biológica más potente de la Araucanía. Sumérgete en nuestras piletas de agua helada purificada a 4°C y alterna con sesiones en saunas secos revestidos de cedro a 90°C para modular la inflamación y regular tu sistema nervioso autónomo.",
            temp: "4°C Agua / 90°C Sauna Seco",
            focus: "Drenaje & Antinflamatorio",
            image:
              "https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=500&q=80",
          },
        };

        function switchThermalState(stateKey, buttonElement) {
          const data = thermalStates[stateKey];

          // Actualizar contenido
          document.getElementById("thermal-icon").textContent = data.icon;
          document.getElementById("thermal-subtitle").textContent = data.subtitle;
          document.getElementById("thermal-title").textContent = data.title;
          document.getElementById("thermal-description").textContent = data.description;
          document.getElementById("thermal-temp").textContent = data.temp;
          document.getElementById("thermal-focus").textContent = data.focus;
          document.getElementById("thermal-image").src = data.image;

          // Cambiar estados activos de los botones
          const buttons = document.querySelectorAll(".thermal-toggle-btn");
          buttons.forEach((btn) => {
            btn.classList.remove("bg-white", "text-black");
            btn.classList.add("bg-transparent", "text-[--kutral-muted]");
          });

          if (buttonElement) {
            buttonElement.classList.remove("bg-transparent", "text-[--kutral-muted]");
            buttonElement.classList.add("bg-white", "text-black");
          }
        }

        /* --- FILTRO DINÁMICO DE CLASES --- */
        function filterClasses(category, btnElement) {
          const cards = document.querySelectorAll(".class-card-item");

          cards.forEach((card) => {
            if (category === "all" || card.getAttribute("data-tab") === category) {
              card.style.display = "block";
              setTimeout(() => {
                card.style.opacity = "1";
              }, 10);
            } else {
              card.style.opacity = "0";
              setTimeout(() => {
                card.style.display = "none";
              }, 200);
            }
          });

          // Estilo activo para las pestañas de clases
          const buttons = document.querySelectorAll(".class-filter-btn");
          buttons.forEach((btn) => {
            btn.classList.remove("bg-white", "text-black");
            btn.classList.add("bg-transparent", "text-[--kutral-muted]");
          });

          if (btnElement) {
            btnElement.classList.remove("bg-transparent", "text-[--kutral-muted]");
            btnElement.classList.add("bg-white", "text-black");
          }
        }

        /* --- INTERACTIVE BILLING Period (Toggle CLP Mensual / Trimestral con 25% Ahorro) --- */
        let isQuarterly = false;

        function toggleBillingPeriod(annualMode, btnElement) {
          const priceBasic = document.getElementById("price-basic");
          const priceAthlete = document.getElementById("price-athlete");
          const priceElite = document.getElementById("price-elite");

          const labelBasic = document.getElementById("label-basic");
          const labelAthlete = document.getElementById("label-athlete");
          const labelElite = document.getElementById("label-elite");

          const btnBasic = document.getElementById("btn-basic-link");
          const btnAthlete = document.getElementById("btn-athlete-link");
          const btnElite = document.getElementById("btn-elite-link");

          // Actualizar estilo de los botones del toggle
          const buttons = document.querySelectorAll(".billing-btn");
          buttons.forEach((btn) => {
            btn.classList.remove("bg-white", "text-black");
            btn.classList.add("bg-transparent", "text-[--kutral-muted]");
          });

          btnElement.classList.remove("bg-transparent", "text-[--kutral-muted]");
          btnElement.classList.add("bg-white", "text-black");

          isQuarterly = annualMode;

          if (isQuarterly) {
            // Valores trimestrales con un 25% de ahorro en CLP chileno
            priceBasic.textContent = "$28.500";
            priceAthlete.textContent = "$36.000";
            priceElite.textContent = "$51.000";

            labelBasic.textContent = "/ mes (cobrado trimestral)";
            labelAthlete.textContent = "/ mes (cobrado trimestral)";
            labelElite.textContent = "/ mes (cobrado trimestral)";

            // Enlaces directos formateados para WhatsApp
            btnBasic.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20quiero%20más%20información%20sobre%20el%20plan%20Musculacion%20Pass%20(Pago%20Trimestral).";
            btnAthlete.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20quiero%20más%20información%20sobre%20el%20plan%20Active%20Pass%20(Pago%20Trimestral).";
            btnElite.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20quiero%20más%20información%20sobre%20el%20plan%20Elite%20(Pago%20Trimestral).";
          } else {
            // Regresar a valores estándar CLP
            priceBasic.textContent = "$38.000";
            priceAthlete.textContent = "$48.000";
            priceElite.textContent = "$68.000";

            labelBasic.textContent = "/ mes estándar";
            labelAthlete.textContent = "/ mes estándar";
            labelElite.textContent = "/ mes estándar";

            btnBasic.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20me%20interesa%20inscribirme%20en%20el%20plan%20Musculacion%20Pass%20(Mensual).";
            btnAthlete.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20me%20interesa%20inscribirme%20en%20el%20plan%20Active%20Pass%20(Mensual).";
            btnElite.href =
              "https://wa.me/56900000000?text=Hola%20Aroma,%20me%20interesa%20inscribirme%20en%20el%20plan%20Elite%20(Mensual).";
          }
        }

        /* --- CAROUSEL DE TESTIMONIOS INTERACTIVO --- */
        let currentReviewIndex = 0;
        const slides = document.querySelectorAll(".testimonial-slide");

        function showReview(index) {
          slides.forEach((slide, i) => {
            slide.classList.add("opacity-0", "hidden");
            slide.classList.remove("opacity-100", "block");
            if (i === index) {
              slide.classList.remove("hidden");
              setTimeout(() => {
                slide.classList.add("opacity-100", "block");
              }, 50);
            }
          });
        }

        function nextReview() {
          currentReviewIndex++;
          if (currentReviewIndex >= slides.length) {
            currentReviewIndex = 0;
          }
          showReview(currentReviewIndex);
        }

        function prevReview() {
          currentReviewIndex--;
          if (currentReviewIndex < 0) {
            currentReviewIndex = slides.length - 1;
          }
          showReview(currentReviewIndex);
        }

        /* --- ACORDEÓN DE PREGUNTAS FRECUENTES (FAQs) --- */
        function toggleFaq(button) {
          const content = button.nextElementSibling;
          const icon = button.querySelector(".faq-icon");

          // Cerrar otros acordeones abiertos para mantener orden visual
          const allContents = document.querySelectorAll(".faq-content");
          const allIcons = document.querySelectorAll(".faq-icon");

          allContents.forEach((c) => {
            if (c !== content) {
              c.style.maxHeight = null;
            }
          });
          allIcons.forEach((i) => {
            if (i !== icon) {
              i.textContent = "+";
              i.classList.remove("rotate-45");
            }
          });

          // Alternar estado del acordeón pulsado
          if (content.style.maxHeight) {
            content.style.maxHeight = null;
            icon.textContent = "+";
            icon.classList.remove("rotate-45");
          } else {
            content.style.maxHeight = content.scrollHeight + "px";
            icon.textContent = "×";
            icon.classList.add("rotate-45");
          }
        }

        /* --- ENVÍO DE FORMULARIO DE CONTACTO --- */
        function handleContactSubmit(event) {
          event.preventDefault();

          const name = document.getElementById("contact-name").value;
          const phone = document.getElementById("contact-phone").value;
          const plan = document.getElementById("contact-plan").value;
          const message = document.getElementById("contact-message").value;

          const submitBtn = event.target.querySelector('button[type="submit"]');
          submitBtn.textContent = "Procesando...";
          submitBtn.disabled = true;

          setTimeout(() => {
            submitBtn.textContent = "Agendar Clase de Prueba Gratis →";
            submitBtn.disabled = false;

            const successBlock = document.getElementById("contact-success-msg");
            successBlock.classList.remove("hidden");

            // Reiniciar inputs
            event.target.reset();

            // Ocultar mensaje de éxito tras 7 segundos
            setTimeout(() => {
              successBlock.classList.add("hidden");
            }, 7000);
          }, 1000);
        }
      </script>
    </section>
  </body>
</html>
