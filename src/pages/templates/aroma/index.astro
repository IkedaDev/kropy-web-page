<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aroma | Kinetic & Thermal Lab • Temuco</title>

    <!-- Tailwind CSS (Default CDN) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Plus Jakarta Sans (Limpia y moderna) & Playfair Display (Serif de lujo orgánico) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* CSS PURO: Variables y efectos de Glassmorphic puro (Grasmorfismo) de nivel internacional */
      :root {
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-bg-hover: rgba(255, 255, 255, 0.08);
        --glass-border: rgba(255, 255, 255, 0.12);
        --glass-border-focus: rgba(255, 255, 255, 0.25);
        --glass-dark-card: rgba(15, 20, 22, 0.6);
        --kutral-clay: #e28f66; /* Terracota volcánica */
        --kutral-teal: #48cae4; /* Agua glacial */
        --kutral-text-light: #f5f7f8; /* Blanco cristalino */
        --kutral-muted: #a0aab0; /* Gris bruma */
      }

      body {
        background-color: #0b0f11; /* Fondo de obsidiana / basalto profundo */
        color: var(--kutral-text-light);
        font-family: "Plus Jakarta Sans", sans-serif;
        letter-spacing: -0.01em;
      }

      .font-editorial {
        font-family: "Playfair Display", serif;
      }

      /* Efecto de Desenfoque y Cristal Esmerilado (Glassmorphism) */
      .glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        border: 1px solid var(--glass-border);
        box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.25);
      }

      .glass-panel-dark {
        background: var(--glass-dark-card);
        backdrop-filter: blur(24px) saturate(130%);
        -webkit-backdrop-filter: blur(24px) saturate(130%);
        border: 1px solid var(--glass-border);
        box-shadow: 0 16px 48px 0 rgba(0, 0, 0, 0.4);
      }

      .glass-button {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--kutral-text-light);
      }

      .glass-button:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.3);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
      }

      .glass-input {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        color: white;
        backdrop-filter: blur(4px);
      }

      .glass-input:focus {
        background: rgba(255, 255, 255, 0.06);
        border-color: var(--kutral-clay);
        box-shadow: 0 0 15px rgba(226, 143, 102, 0.2);
      }

      /* Orbes de luz líquida de fondo (Simula magma e hielo flotando tras el cristal) */
      .liquid-light-orange {
        background: radial-gradient(
          circle,
          rgba(226, 143, 102, 0.2) 0%,
          rgba(226, 143, 102, 0) 70%
        );
        filter: blur(80px);
        animation: float-orange 20s infinite alternate ease-in-out;
      }

      .liquid-light-blue {
        background: radial-gradient(circle, rgba(72, 202, 228, 0.15) 0%, rgba(72, 202, 228, 0) 70%);
        filter: blur(100px);
        animation: float-blue 24s infinite alternate ease-in-out;
      }

      @keyframes float-orange {
        0% {
          transform: scale(1) translate(0px, 0px);
        }
        100% {
          transform: scale(1.3) translate(150px, -80px);
        }
      }

      @keyframes float-blue {
        0% {
          transform: scale(1) translate(0px, 0px);
        }
        100% {
          transform: scale(1.2) translate(-100px, 120px);
        }
      }

      /* Transiciones fluidas */
      .kutral-transition {
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
  </head>
  <body class="relative min-h-screen overflow-x-hidden antialiased">
