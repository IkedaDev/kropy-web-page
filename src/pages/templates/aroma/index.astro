    <!-- SECCIÓN FILOSOFÍA: Tres Cristales Flotantes -->
    <section id="concepto" class="border-y border-[--glass-border] py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <div class="mx-auto mb-20 max-w-2xl space-y-3 text-center">
