                    class="bg-studio-900 border-studio-800 focus:border-electric-500 mt-2 block w-full rounded-xl border px-4 py-3 text-sm text-white focus:outline-none"
                  />
                </div>
                <div>
                  <label
                    for="c-phone"
                    class="text-studio-400 block text-[10px] font-semibold tracking-wider uppercase"
                    >WhatsApp o Fono:</label
                  >
                  <input
                    type="tel"
                    id="c-phone"
                    required
                    class="bg-studio-900 border-studio-800 focus:border-electric-500 mt-2 block w-full rounded-xl border px-4 py-3 text-sm text-white focus:outline-none"
                    placeholder="+56 9 ..."
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <label
                    for="c-type"
                    class="text-studio-400 block text-[10px] font-semibold tracking-wider uppercase"
                    >Tipo de Solicitud:</label
                  >
                  <select
                    id="c-type"
                    class="bg-studio-900 border-studio-800 focus:border-electric-500 mt-2 block w-full rounded-xl border px-4 py-3 text-sm text-white focus:outline-none"
                  >
                    <option value="arriendo">Arriendo de Set</option>
                    <option value="producto">Producción de Producto / E-Commerce</option>
                    <option value="retratos">Sesión de Retratos Corporativos</option>
                    <option value="otro">Otras Consultas / Cotización Especial</option>
                  </select>
                </div>
                <div>
                  <label
                    for="c-date"
                    class="text-studio-400 block text-[10px] font-semibold tracking-wider uppercase"
                    >Fecha Requerida:</label
                  >
                  <input
                    type="date"
                    id="c-date"
                    required
                    class="bg-studio-900 border-studio-800 focus:border-electric-500 mt-2 block w-full rounded-xl border px-4 py-3 text-sm text-white focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label
                  for="c-msg"
                  class="text-studio-400 block text-[10px] font-semibold tracking-wider uppercase"
                  >Detalles del Proyecto y Cotización Seleccionada:</label
                >
                <textarea
                  id="c-msg"
                  rows="4"
                  required
                  class="bg-studio-900 border-studio-800 focus:border-electric-500 mt-2 block w-full rounded-xl border px-4 py-3 text-sm text-white focus:outline-none"
                  placeholder="Describe brevemente tus requerimientos o indica si estás aplicando un presupuesto cotizado en la calculadora..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="bg-electric-600 hover:bg-electric-700 shadow-electric-600/10 inline-flex w-full items-center justify-center rounded-xl px-6 py-4 text-xs font-bold tracking-widest text-white uppercase shadow-lg transition-all"
              >
                Enviar Solicitud de Reserva
              </button>
            </form>

            <!-- Success State (Dynamic DOM injection) -->
            <div id="contact-success" class="hidden space-y-4 py-12 text-center">
              <div
                class="bg-electric-600/10 border-electric-500 text-electric-400 mx-auto flex h-16 w-16 items-center justify-center rounded-full border text-2xl font-bold"
              >
                ✓
              </div>
              <h4 class="font-display text-2xl font-bold text-white">¡Solicitud Procesada!</h4>
              <p id="success-desc" class="text-studio-300 mx-auto max-w-md text-sm">
                Nos contactaremos contigo en menos de 12 horas hábiles para coordinar la
                factibilidad y agendar formalmente la hora en el set.
              </p>
              <button
                onclick="resetContactForm()"
                class="bg-studio-800 hover:bg-studio-700 rounded-lg px-5 py-2.5 text-xs font-bold tracking-widest text-white uppercase"
              >
                Enviar Otra Solicitud
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-studio-950 text-studio-400 border-studio-800 border-t py-16 text-[11px]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-4">
          <!-- Brand bio -->
          <div class="space-y-4 md:col-span-2">
            <span class="font-display block text-lg font-bold tracking-tight text-white"
              >ANDINO ESTUDIO</span
            >
            <p class="text-studio-400 max-w-sm text-xs leading-relaxed font-light">
              Estudio líder en servicios de fotografía y producción audiovisual de nivel industrial
              en Temuco. Respaldando el crecimiento de marcas en la Araucanía.
            </p>
          </div>

          <!-- Navigation link list -->
          <div>
            <h4 class="mb-4 text-[10px] font-bold tracking-widest text-white uppercase">
              Navegación
            </h4>
            <ul class="space-y-2">
              <li>
                <a href="#espacios" class="hover:text-electric-400 transition-colors"
                  >Infraestructura</a>
              </li>
              <li>
                <a href="#portafolio" class="hover:text-electric-400 transition-colors"
                  >Portafolio</a>
              </li>
              <li>
                <a href="#calculador" class="hover:text-electric-400 transition-colors"
                  >Cotizador de Horas</a>
              </li>
              <li>
                <a href="#contacto" class="hover:text-electric-400 transition-colors"
                  >Contacto Directo</a>
              </li>
            </ul>
          </div>

          <!-- Location details -->
          <div>
            <h4 class="mb-4 text-[10px] font-bold tracking-widest text-white uppercase">
              Soporte Local
            </h4>
            <p class="text-studio-400 text-xs leading-relaxed font-light">
              Ubicado a pasos del centro comercial Av. Alemania. Accesibilidad universal y
              estacionamiento privado para carga y descarga de equipos de filmación.
            </p>
          </div>
        </div>

        <!-- Bottom Credits -->
        <div
          class="border-studio-800 flex flex-col items-center justify-between gap-4 border-t pt-8 text-[10px] sm:flex-row"
        >
          <p>
            &copy; 2026 Andino Estudio SPA. Todos los derechos reservados. Temuco, Araucanía, Chile.
          </p>
          <div class="flex gap-4">
            <a href="#" class="transition-colors hover:text-white">Términos del Servicio</a>
            <a href="#" class="transition-colors hover:text-white">Reglas del Estudio</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Fully Functional Lightbox Modal with Slider functionality -->
    <div
      id="lightbox-modal"
      class="bg-studio-950/95 fixed inset-0 z-50 flex hidden items-center justify-center p-4 backdrop-blur-md"
    >
      <!-- Close button -->
      <button
        onclick="closeLightbox()"
        class="hover:text-electric-400 absolute top-6 right-6 z-50 text-2xl text-white focus:outline-none"
        aria-label="Cerrar"
      >
        ✕
      </button>

      <div class="relative flex w-full max-w-4xl flex-col items-center">
        <!-- Navigation controls -->
        <button
          onclick="prevSlide()"
          class="hover:text-electric-400 font-display bg-studio-900/50 absolute top-1/2 left-2 z-50 -translate-y-1/2 transform rounded px-3 py-1.5 text-3xl font-semibold text-white focus:outline-none sm:-left-12 sm:bg-transparent"
        >
          ◀
        </button>

        <button
          onclick="nextSlide()"
          class="hover:text-electric-400 font-display bg-studio-900/50 absolute top-1/2 right-2 z-50 -translate-y-1/2 transform rounded px-3 py-1.5 text-3xl font-semibold text-white focus:outline-none sm:-right-12 sm:bg-transparent"
        >
          ▶
        </button>

        <!-- Lightbox Slide Image container -->
        <img
          id="lightbox-img"
          src=""
          alt="Ampliada"
          class="border-studio-800 max-h-[75vh] max-w-full rounded-lg border object-contain shadow-2xl"
        />

        <!-- Dynamic descriptive text -->
        <p
          id="lightbox-caption"
          class="text-studio-300 mt-4 px-4 text-center text-xs font-light tracking-wider"
        >
        </p>
      </div>
    </div>

    <!-- JavaScript Controllers -->
    <script>
      // DOM Elements
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      // Mobile Navigation Toggle
      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Close mobile panel on menu item click
      const navLinks = mobileMenu.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // FAQ Accordion Handler
      function toggleFaq(faqId) {
        const el = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId);

        if (el.classList.contains("hidden")) {
          el.classList.remove("hidden");
          icon.innerText = "－";
          icon.classList.add("text-electric-400");
        } else {
          el.classList.add("hidden");
          icon.innerText = "＋";
          icon.classList.remove("text-electric-400");
        }
      }

      // Portfolio Filtering logic
      function filterPortfolio(category) {
        const items = document.querySelectorAll(".portfolio-item");
        const buttons = document.querySelectorAll(".portfolio-filter-btn");

        // Reset active style on buttons
        buttons.forEach((btn) => {
          btn.className =
            "portfolio-filter-btn px-6 py-2.5 rounded-lg border border-studio-800 text-[10px] font-bold uppercase tracking-widest hover:bg-studio-800 text-studio-300 hover:text-white transition-all";
        });

        // Set active style for selected filter button
        const activeBtn = document.getElementById("btn-filter-" + category);
        if (activeBtn) {
          activeBtn.className =
            "portfolio-filter-btn px-6 py-2.5 rounded-lg border border-electric-500 text-[10px] font-bold uppercase tracking-widest bg-electric-600 text-white transition-all";
        }

        // Show or hide elements
        items.forEach((item) => {
          if (category === "all" || item.classList.contains(category)) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      }

      // Dynamic Cost Calculator States
      let currentSvcType = "arriendo";
      let currentHourlyRate = 30000;
      let selectedHours = 4;

      function setCalService(type, hourlyRate) {
        currentSvcType = type;
        currentHourlyRate = hourlyRate;

        // Update design buttons status
        const buttons = document.querySelectorAll(".calc-svc-btn");
        buttons.forEach((btn) => {
          btn.className =
            "calc-svc-btn p-4 border border-studio-800 text-left hover:bg-studio-900 text-studio-300 hover:text-white rounded-xl transition-all";
        });

        const activeBtn = document.getElementById("svc-" + type);
        activeBtn.className =
          "calc-svc-btn p-4 border border-electric-500 text-left bg-electric-600/10 text-white rounded-xl transition-all";

        // Update Summary Name
        const names = {
          arriendo: "Arriendo Set",
          producto: "Fotos de Producto / Catálogo",
          retratos: "Sesión de Retratos",
        };
        document.getElementById("summary-svc").innerText = names[type];

        calcTotal();
      }

      function updateHours(val) {
        selectedHours = parseInt(val);
        document.getElementById("hours-display").innerText = `${selectedHours} Horas`;
        document.getElementById("summary-hours").innerText = `${selectedHours} Horas`;
        calcTotal();
      }

      function calcTotal() {
        // Calculate base cost
        let baseCost = currentHourlyRate * selectedHours;
        document.getElementById("summary-base-val").innerText =
          `$${baseCost.toLocaleString("es-CL")}`;

        // Calculate extras
        let extrasCost = 0;

        // Asistente (Fixed total)
        const assistCheck = document.getElementById("extra-asistente");
        if (assistCheck.checked) {
          extrasCost += parseInt(assistCheck.value);
        }

        // Iluminacion (Hourly extra)
        const lightCheck = document.getElementById("extra-iluminacion");
        if (lightCheck.checked) {
          extrasCost += parseInt(lightCheck.value) * selectedHours;
        }

        // Postprod (Fixed total)
        const postCheck = document.getElementById("extra-postprod");
        if (postCheck.checked) {
          extrasCost += parseInt(postCheck.value);
        }

        document.getElementById("summary-extras-val").innerText =
          `$${extrasCost.toLocaleString("es-CL")}`;

        // Show Total
        let total = baseCost + extrasCost;
        document.getElementById("summary-total").innerText = `$${total.toLocaleString("es-CL")}`;
      }

      // Populate Contact Form instantly using calculation
      function applyEstimateToContact() {
        // Select type in form drop-down
        const selectEl = document.getElementById("c-type");
        selectEl.value = currentSvcType;

        // Generate customized text
        const hoursVal = selectedHours;
        const extrasChecked = [];
        if (document.getElementById("extra-asistente").checked)
          extrasChecked.push("Asistente de Iluminación");
        if (document.getElementById("extra-iluminacion").checked)
          extrasChecked.push("Kit Profoto Premium");
        if (document.getElementById("extra-postprod").checked)
          extrasChecked.push("Edición Express");

        const extrasText =
          extrasChecked.length > 0 ? `\nAdicionales requeridos: ${extrasChecked.join(", ")}.` : "";
        const totalPrice = document.getElementById("summary-total").innerText;

        const text = `Hola Andino Estudio, me interesa programar un servicio de ${document.getElementById("summary-svc").innerText} por un total de ${hoursVal} horas.${extrasText}\n\nPresupuesto estimado autocalculado: ${totalPrice} CLP. Favor indicar fechas disponibles.`;

        document.getElementById("c-msg").value = text;

        // Focus and Smooth scroll to form
        document.getElementById("contacto").scrollIntoView({ behavior: "smooth" });
        setTimeout(() => {
          document.getElementById("c-name").focus();
        }, 800);
      }

      // Gallery Lightbox Controller with Carousel Logic
      let activeImageIndex = 0;

      // Define list of images with detailed descriptions for slide functionality
      const galleryImages = [
        {
          src: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1200&q=80",
          caption: "E-Commerce de Calzado Técnico — Ciclorama de obra con difusores de luz Godox",
        },
        {
          src: "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=1200&q=80",
          caption: "Directorio Inmobiliaria Araucanía — Retrato formal corporativo de alta calidad",
        },
        {
          src: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80",
          caption: "Hotel Boutique en Pucón — Fotografía de arquitectura e interiorismo",
        },
        {
          src: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=1200&q=80",
          caption: "Campaña de Tecnología & Audio — Estilismo comercial avanzado",
        },
        {
          src: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1200&q=80",
          caption:
            "Staff Médico Clínica Temuco — Sesiones grupales de marca personal y profesional",
        },
        {
          src: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80",
          caption:
            "Showroom Corporativo Araucanía — Registro fotográfico de interiores para constructoras",
        },
      ];

      const lightbox = document.getElementById("lightbox-modal");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");

      function openLightbox(index) {
        activeImageIndex = index;
        updateLightboxSlide();
        lightbox.classList.remove("hidden");
      }

      function closeLightbox() {
        lightbox.classList.add("hidden");
        lightboxImg.src = "";
      }

      function updateLightboxSlide() {
        const currentData = galleryImages[activeImageIndex];
        lightboxImg.src = currentData.src;
        lightboxCaption.innerText = currentData.caption;
      }

      function nextSlide() {
        activeImageIndex = (activeImageIndex + 1) % galleryImages.length;
        updateLightboxSlide();
      }

      function prevSlide() {
        activeImageIndex = (activeImageIndex - 1 + galleryImages.length) % galleryImages.length;
        updateLightboxSlide();
      }

      // Keyboard accessibility inside Lightbox
      document.addEventListener("keydown", (e) => {
        if (!lightbox.classList.contains("hidden")) {
          if (e.key === "Escape") closeLightbox();
          if (e.key === "ArrowRight") nextSlide();
          if (e.key === "ArrowLeft") prevSlide();
        }
      });

      // Contact form handling and DOM injection state
      function handleContactSubmit(event) {
        event.preventDefault();

        const userName = document.getElementById("c-name").value;
        const successDesc = document.getElementById("success-desc");

        // Custom message success
        successDesc.innerHTML = `Estimado(a) <strong>${userName}</strong>, hemos recibido tu solicitud de reserva para las dependencias de nuestro estudio en Temuco. Nos contactaremos de inmediato por vía telefónica o correo electrónico en menos de 12 horas hábiles.`;

        // State changes
        document.getElementById("contact-form").classList.add("hidden");
        document.getElementById("contact-success").classList.remove("hidden");
      }

      function resetContactForm() {
        document.getElementById("contact-form").reset();
        document.getElementById("contact-form").classList.remove("hidden");
        document.getElementById("contact-success").classList.add("hidden");
      }

      // Initialize total pricing on load
      window.onload = function () {
        calcTotal();
      };
    </script>
  </body>
</html>
