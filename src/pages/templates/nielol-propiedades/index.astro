          </p>
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div>
              <span class="text-brand-navy block text-3xl font-black">+150</span>
              <span class="text-xs font-bold tracking-wider text-slate-500 uppercase"
                >Propiedades Transadas</span
              >
            </div>
            <div>
              <span class="text-brand-navy block text-3xl font-black">100%</span>
              <span class="text-xs font-bold tracking-wider text-slate-500 uppercase"
                >Clientes Satisfechos</span
              >
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN CONTACTO / CAPTACIÓN -->
      <section id="contacto" class="bg-brand-light border-t border-slate-200 py-20">
        <div
          class="mx-auto max-w-4xl rounded-3xl border border-slate-100 bg-white p-8 px-4 shadow-xl sm:p-12 sm:px-6 lg:px-8"
        >
          <div class="mx-auto mb-10 max-w-2xl text-center">
            <h2 class="text-brand-navy text-3xl font-bold tracking-tight">
              Hablemos de tu Proyecto Inmobiliario
            </h2>
            <p class="mt-3 text-slate-600">
              Completa el formulario y te contactaré en menos de 24 horas hábiles para coordinar una
              reunión.
            </p>
          </div>

          <form action="#" method="POST" class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1 block text-xs font-bold text-slate-500 uppercase"
                >Nombre Completo</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="focus:border-brand-gold w-full rounded-lg border border-slate-200 bg-slate-50 p-3 transition-colors focus:outline-none"
                placeholder="Ej: Juan Pérez"
              />
            </div>
            <div>
              <label for="phone" class="mb-1 block text-xs font-bold text-slate-500 uppercase"
                >Teléfono de Contacto</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="focus:border-brand-gold w-full rounded-lg border border-slate-200 bg-slate-50 p-3 transition-colors focus:outline-none"
                placeholder="Ej: +56 9 1234 5678"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="email" class="mb-1 block text-xs font-bold text-slate-500 uppercase"
                >Correo Electrónico</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="focus:border-brand-gold w-full rounded-lg border border-slate-200 bg-slate-50 p-3 transition-colors focus:outline-none"
                placeholder="juan.perez@email.com"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="interest" class="mb-1 block text-xs font-bold text-slate-500 uppercase"
                >¿En qué te puedo ayudar?</label
              >
              <select
                id="interest"
                name="interest"
                class="focus:border-brand-gold w-full rounded-lg border border-slate-200 bg-slate-50 p-3 transition-colors focus:outline-none"
              >
                <option>Quiero vender una propiedad en Temuco</option>
                <option>Quiero comprar una casa / departamento</option>
                <option>Busco invertir en parcelas</option>
                <option>Otro tipo de asesoría</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="mb-1 block text-xs font-bold text-slate-500 uppercase"
                >Mensaje (Opcional)</label
              >
              <textarea
                id="message"
                name="message"
                rows="4"
                class="focus:border-brand-gold w-full rounded-lg border border-slate-200 bg-slate-50 p-3 transition-colors focus:outline-none"
                placeholder="Cuéntame brevemente los detalles de tu propiedad o lo que buscas..."
              ></textarea>
            </div>
            <div class="pt-2 sm:col-span-2">
              <button
                type="submit"
                class="bg-brand-gold w-full rounded-lg py-4 text-sm font-bold tracking-wider text-white uppercase shadow-lg transition-colors hover:bg-amber-700"
                >Enviar Solicitud de Asesoría</button
              >
            </div>
          </form>
