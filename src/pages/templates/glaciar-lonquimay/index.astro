---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Agua Glaciar Lonquimay | Reparto de Agua Purificada en Temuco";
const description =
  "¿Buscas agua purificada de la mejor calidad en Temuco? En Glaciar Lonquimay te ofrecemos bidones de 20L y 12L con osmosis inversa. Despacho rápido a domicilio y empresas en Temuco y Padre Las Casas.";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Estilo Limpio, Fluido y Tecnológico -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-heading {
        font-family: "Plus Jakarta Sans", sans-serif;
      }
      body {
        font-family: "Outfit", sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <!-- CINTA LOGÍSTICA DE COBERTURA -->
    <div
      class="bg-gradient-to-r from-cyan-600 to-blue-700 px-4 py-2 text-center text-xs font-bold tracking-widest text-white uppercase"
    >
      💧 Despacho sin costo en Temuco Urbano, Labranza y Padre Las Casas 💧
    </div>

    <!-- NAVBAR CRISTALINA (GLASSMORPHISM) -->
    <header class="sticky top-0 z-50 border-b border-slate-900 bg-slate-950/80 backdrop-blur-md">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="#" class="group flex items-center gap-2">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr from-cyan-400 to-blue-600 shadow-lg shadow-cyan-500/20"
          >
            <span class="text-lg text-white">❄️</span>
          </div>
          <div class="flex flex-col">
            <span class="font-heading text-lg leading-none font-extrabold tracking-tight text-white"
              >GLACIAR</span
            >
            <span
              class="font-heading mt-0.5 text-[10px] font-bold tracking-widest text-cyan-400 uppercase"
              >LONQUIMAY</span
            >
          </div>
        </a>

        <nav
          class="hidden items-center gap-8 text-xs font-bold tracking-wider text-slate-400 uppercase md:flex"
        >
          <a href="#proceso" class="transition-colors hover:text-cyan-400">Pureza</a>
          <a href="#productos" class="transition-colors hover:text-cyan-400">Formatos</a>
          <a href="#planes" class="transition-colors hover:text-cyan-400">Planes Oficina</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56922221111?text=Hola!%20Quiero%20solicitar%20recargas%20de%20agua%20Glaciar%20Lonquimay"
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-full bg-cyan-500 px-5 py-2.5 text-center text-xs font-bold tracking-wider text-slate-950 uppercase shadow-lg shadow-cyan-500/20 transition-all hover:bg-cyan-400"
          >
            Pedir Bidón
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO ULTRA-REFRESCANTE -->
      <section
        class="relative overflow-hidden border-b border-slate-900 bg-slate-900 py-20 lg:py-28"
      >
        <!-- Destellos de luz azul de fondo simulan reflejos de agua -->
        <div class="absolute top-0 right-0 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl filter">
        </div>
        <div class="absolute bottom-0 left-0 h-96 w-96 rounded-full bg-blue-600/10 blur-3xl filter">
        </div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-12 lg:px-8"
        >
          <div class="space-y-6 text-center md:col-span-7 md:text-left">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-slate-800 bg-slate-950 px-3 py-1 text-xs font-bold tracking-wider text-cyan-400 uppercase"
            >
              💧 Calidad Certificada · Libre de Sodio
            </div>
            <h1
              class="font-heading text-4xl leading-none font-black tracking-tight text-white uppercase sm:text-5xl lg:text-6xl"
            >
              Agua purificada de pureza <span
                class="bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent"
                >absoluta</span
              >
            </h1>
            <p
              class="mx-auto max-w-xl text-sm leading-relaxed font-medium text-slate-400 md:mx-0 md:text-base"
            >
              Disfruta de una hidratación liviana y equilibrada en Temuco. Nuestro proceso de
              filtrado elimina el sarro, metales pesados y micropartículas mediante tecnología de
              ósmosis inversa de nivel internacional.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#productos"
                class="rounded-full bg-gradient-to-r from-cyan-500 to-blue-600 px-8 py-4 text-center text-xs font-bold tracking-wider text-white uppercase shadow-xl shadow-cyan-500/10 transition-all hover:from-cyan-400 hover:to-blue-500"
              >
                Formatos de Recarga
              </a>
              <a
                href="tel:+56922221111"
                class="rounded-full border border-slate-800 bg-slate-950 px-8 py-4 text-center text-xs font-bold tracking-wider text-slate-200 uppercase transition-all hover:bg-slate-800"
              >
                Llamar Directo 📞
              </a>
            </div>
          </div>

          <div class="flex justify-center md:col-span-5">
            <div
              class="relative w-full max-w-xs rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl"
            >
              <img
                src="https://images.unsplash.com/photo-1548839140-29a749e1cf4d?q=80&w=600&auto=format&fit=crop"
                alt="Bidón de agua purificada de 20 litros transparente y cristalino"
                class="h-80 w-full rounded-2xl object-cover brightness-110 contrast-105 filter"
              />
              <div
                class="font-heading absolute -right-4 -bottom-4 rounded-xl border-2 border-slate-950 bg-cyan-500 px-4 py-2 text-xs font-black tracking-wide text-slate-950 uppercase shadow-lg"
              >
                Formato 20L
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROCESO DE PURIFICACIÓN INDUSTRIAL -->
      <section id="proceso" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <span class="font-heading block text-xs font-bold tracking-widest text-cyan-400 uppercase"
            >Ingeniería del Agua</span
          >
          <h2 class="font-heading mt-1 text-3xl font-black text-white uppercase">
            Nuestro Estándar de Retención
          </h2>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Etapa 1 -->
          <div class="space-y-3 rounded-2xl border border-slate-800 bg-slate-900 p-6">
            <span class="block text-xl">🔬</span>
            <h3 class="font-heading text-sm font-bold tracking-wider text-white uppercase">
              Filtro de Sedimentos
            </h3>
            <p class="text-xs leading-relaxed text-slate-400">
              Retiene micropartículas suspendidas, arenas, óxidos y elementos macroscópicos del agua
              cruda inicial.
            </p>
          </div>
          <!-- Etapa 2 -->
          <div class="space-y-3 rounded-2xl border border-slate-800 bg-slate-900 p-6">
            <span class="block text-xl">🫧</span>
            <h3 class="font-heading text-sm font-bold tracking-wider text-white uppercase">
              Carbón Activado
            </h3>
            <p class="text-xs leading-relaxed text-slate-400">
              Elimina por completo el cloro elemental, compuestos volátiles orgánicos, olores y
              sabores indeseados.
            </p>
          </div>
          <!-- Etapa 3 -->
          <div class="space-y-3 rounded-2xl border border-slate-800 bg-slate-900 p-6">
            <span class="block text-xl">🌀</span>
            <h3 class="font-heading text-sm font-bold tracking-wider text-white uppercase">
              Ósmosis Inversa
            </h3>
            <p class="text-xs leading-relaxed text-slate-400">
              Filtración por membranas que retiene el 99.6% de los minerales pesados y sales
              disueltas nocivas.
            </p>
          </div>
          <!-- Etapa 4 -->
          <div class="space-y-3 rounded-2xl border border-slate-800 bg-slate-900 p-6">
            <span class="block text-xl">⚡</span>
            <h3 class="font-heading text-sm font-bold tracking-wider text-white uppercase">
              Luz Ultravioleta UV-C
            </h3>
            <p class="text-xs leading-relaxed text-slate-400">
              Barrera terminal que esteriliza virus y bacterias microscópicas, garantizando agua
              100% inocua.
            </p>
          </div>
        </div>
      </section>

      <!-- PRODUCTOS / CATÁLOGO DE RECARGAS -->
      <section id="productos" class="border-y border-slate-900 bg-slate-900/40 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto mb-12 max-w-xl text-center">
            <h2 class="font-heading text-3xl font-black text-white uppercase">
              Formatos de Distribución
            </h2>
            <p class="mt-1 text-xs font-medium tracking-widest text-slate-500 uppercase">
              Elige la medida ideal para tu consumo diario
            </p>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Producto 1 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-sm transition-all hover:border-cyan-500/30"
            >
              <div class="space-y-4 p-6">
                <div class="aspect-video w-full overflow-hidden rounded-2xl bg-slate-950">
                  <img
                    src="https://images.unsplash.com/photo-1548839140-29a749e1cf4d?q=80&w=400&auto=format&fit=crop"
                    alt="Recarga de bidon de agua purificada de 20l en Temuco"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="space-y-1">
                  <div class="font-heading flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-extrabold tracking-tight text-white uppercase">
                      Recarga Bidón 20 Litros
                    </h4>
                    <span class="text-base font-black whitespace-nowrap text-cyan-400">$3.500</span>
                  </div>
                  <p class="text-xs leading-relaxed text-slate-400">
                    El tamaño familiar estándar. Bidón de policarbonato ultra resistente, sanitizado
                    e higienizado herméticamente en cada ciclo de llenado.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922221111?text=Hola!%20Quiero%20solicitar%20la%20Recarga%20de%2020L"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-slate-800 bg-slate-950 py-3.5 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-cyan-500 hover:text-slate-950"
                >
                  Solicitar Recarga
                </a>
              </div>
            </div>

            <!-- Producto 2 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-sm transition-all hover:border-cyan-500/30"
            >
              <div class="space-y-4 p-6">
                <div class="aspect-video w-full overflow-hidden rounded-2xl bg-slate-950">
                  <img
                    src="https://images.unsplash.com/photo-1608889175123-8ec330b86f84?q=80&w=400&auto=format&fit=crop"
                    alt="Recarga de bidon de agua purificada de 12l compacto"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="space-y-1">
                  <div class="font-heading flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-extrabold tracking-tight text-white uppercase">
                      Recarga Bidón 12 Litros
                    </h4>
                    <span class="text-base font-black whitespace-nowrap text-cyan-400">$2.700</span>
                  </div>
                  <p class="text-xs leading-relaxed text-slate-400">
                    Formato liviano y ergonómico, ideal para departamentos, adultos mayores o
                    consumo individual semanal. Fácil manipulación de carga.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922221111?text=Hola!%20Quiero%20solicitar%20la%20Recarga%20de%2012L"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-slate-800 bg-slate-950 py-3.5 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-cyan-500 hover:text-slate-950"
                >
                  Solicitar Recarga
                </a>
              </div>
            </div>

            <!-- Producto 3 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-sm transition-all hover:border-cyan-500/30"
            >
              <div class="space-y-4 p-6">
                <div class="aspect-video w-full overflow-hidden rounded-2xl bg-slate-950">
                  <img
                    src="https://images.unsplash.com/photo-1523362628745-0c100150b504?q=80&w=400&auto=format&fit=crop"
                    alt="Dispensador de agua fria y caliente electrico premium"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="space-y-1">
                  <div class="font-heading flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-extrabold tracking-tight text-white uppercase">
                      Dispensador Eléctrico XL
                    </h4>
                    <span class="text-base font-black whitespace-nowrap text-cyan-400">$45.000</span
                    >
                  </div>
                  <p class="text-xs leading-relaxed text-slate-400">
                    Equipo compresor premium para agua fría digital (hasta 5°C) y caliente (hasta
                    90°C, ideal para té o café instantáneo). Garantía técnica de 1 año.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922221111?text=Hola!%20Me%20interesa%20comprar%20el%20Dispensador%20Electrico%20XL"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-slate-800 bg-slate-950 py-3.5 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-cyan-500 hover:text-slate-950"
                >
                  Comprar Equipo
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN DE PLANES CORPORATIVOS (EMPRESAS) -->
      <section id="planes" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div
          class="grid items-center gap-12 rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-8 lg:grid-cols-12 lg:p-12"
        >
          <div class="space-y-6 lg:col-span-7">
            <span
              class="font-heading block text-xs font-bold tracking-widest text-cyan-400 uppercase"
              >// SOLUCIONES DE ABASTECIMIENTO CORPORATIVO</span
            >
            <h2 class="font-heading text-3xl font-black tracking-tight text-white uppercase">
              Convenios para Oficinas e Instituciones en Temuco
            </h2>
            <p class="text-sm leading-relaxed text-slate-400">
              Olvídate de quedarte sin agua en medio de la jornada laboral. Diseñamos rutas de
              reposición fija automatizada para empresas, centros médicos, colegios y oficinas
              comerciales en la Araucanía. Emitimos factura electrónica inmediata.
            </p>
            <div
              class="font-heading grid grid-cols-2 gap-4 text-xs font-bold tracking-wider text-slate-300 uppercase"
            >
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
                🔹 Dispensador en Comodato
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
                🔹 Facturación Mensualizada
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
                🔹 Sanitización Semestral Gratis
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
                🔹 Stock Prioritario Asegurado
              </div>
            </div>
          </div>

          <div class="space-y-4 rounded-2xl border border-slate-800 bg-slate-950 p-6 lg:col-span-5">
            <h3 class="font-heading text-sm font-black tracking-wider text-white uppercase">
              Cotizar Plan Oficina
            </h3>
            <p class="text-xs text-slate-400">
              Indícanos un aproximado de tu consumo institucional para estructurar una tarifa
              preferencial.
            </p>

            <form
              action="https://wa.me/56922221111"
              method="GET"
              target="_blank"
              class="font-heading space-y-4 text-xs"
            >
              <input
                type="hidden"
                name="text"
                value="Hola Glaciar Lonquimay, solicito cotización para convenio de agua en mi oficina comercial."
              />
              <div class="space-y-1">
                <label class="text-[10px] font-bold tracking-widest text-slate-500 uppercase"
                  >Consumo Mensual Estimado</label
                >
                <select
                  class="w-full rounded-xl border border-slate-800 bg-slate-900 px-4 py-3 font-medium text-slate-300 focus:border-cyan-400 focus:outline-none"
                >
                  <option>De 4 a 10 Bidones al mes</option>
                  <option>De 10 a 30 Bidones al mes</option>
                  <option>Más de 30 Bidones (Gran Institución)</option>
                </select>
              </div>
              <button
                type="submit"
                class="w-full rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 py-3.5 text-xs font-bold tracking-wider text-white uppercase shadow-md shadow-cyan-500/10 transition-all"
              >
                Enviar Solicitud de Convenio
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- MAPA LOGÍSTICO Y DATOS SEO LOCAL -->
      <section
        class="mx-auto grid max-w-7xl items-center gap-12 border-t border-slate-900 px-4 py-16 sm:px-6 md:grid-cols-2 lg:px-8"
      >
        <div class="space-y-6">
          <h3 class="font-heading text-2xl font-black text-white uppercase">
            Planta de Embotellado y Logística Veloz
          </h3>
          <p class="text-sm leading-relaxed text-slate-400">
            Nuestra planta centralizada cuenta con rigurosas autorizaciones sanitarias chilenas.
            Desde este núcleo coordinamos diariamente los camiones repartidores que recorren Av.
            Alemania, Huérfanos, Pueblo Nuevo, San Ramón y la periferia industrial de la Araucanía.
          </p>
          <div class="font-heading space-y-4 text-xs font-bold text-slate-300 uppercase">
            <div class="flex items-start gap-3">
              <span class="text-cyan-400">📍</span>
              <div>
                <p class="font-bold text-white">Planta Central de Distribución:</p>
                <p class="mt-0.5 font-sans font-medium text-slate-400 normal-case">
                  Calle Las Quilas 01420 (Cerca del parque), Temuco, Región de la Araucanía.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-cyan-400">🕒</span>
              <div>
                <p class="font-bold text-white">Horarios de Despacho Telefónico y Ruta:</p>
                <p class="mt-0.5 font-sans font-medium text-slate-400 normal-case">
                  Lunes a Sábado: 08:30 a 19:30 hrs (Reparto continuo).
                </p>
                <p class="font-sans font-medium text-red-400 normal-case">
                  Domingos y Festivos: Cerrado por mantención de filtros térmicos.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Simulación de Mapa Técnico / Cristalino -->
        <div class="rounded-3xl border border-slate-800 bg-slate-900 p-2 shadow-inner">
          <div
            class="relative flex h-64 flex-col items-center justify-center overflow-hidden rounded-2xl bg-slate-950 p-6 text-center"
          >
            <div
              class="absolute inset-0 bg-[radial-gradient(#22d3ee_1px,transparent_1px)] [background-size:16px_16px] opacity-5"
            >
            </div>
            <span class="mb-1 text-3xl text-cyan-400">🗺️</span>
            <h4 class="font-heading text-sm font-black tracking-wider text-white uppercase">
              MAPA DE REPARTO EXPRESÓ
            </h4>
            <p
              class="mt-1 mb-4 max-w-xs font-sans text-[11px] leading-relaxed font-medium text-slate-500"
            >
              Incrusta aquí el Iframe responsivo de Google Maps de la distribuidora de agua de tu
              cliente. Es vital para consolidar el posicionamiento en Google My Business y el SEO
              local de Temuco.
            </p>
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-heading rounded-xl border border-slate-800 bg-slate-900 px-5 py-3 text-[10px] font-bold tracking-widest text-cyan-400 uppercase transition-all hover:bg-cyan-500 hover:text-slate-950"
            >
              Ver Cuadrante de Despacho
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER CORPORATIVO -->
    <footer
      class="font-heading border-t border-slate-900 bg-slate-950 py-12 text-xs text-slate-600"
    >
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 md:flex-row lg:px-8"
      >
        <div class="space-y-1 text-center md:text-left">
          <p class="text-sm font-black tracking-tight text-white">
            GLACIAR<span class="text-cyan-400"> LONQUIMAY</span>
          </p>
          <p class="font-sans font-medium">
            &copy; 2026 Aguas Purificadas Premium. Todos los derechos reservados. Temuco, Araucanía,
            Chile.
          </p>
        </div>
        <div
          class="space-y-1 text-center text-[9px] font-bold tracking-widest text-slate-700 uppercase md:text-right"
        >
          <p>Marcado Estructural Semántico HTML5 / CSS Estricto sin parámetros fraccionarios.</p>
          <p class="font-sans font-medium text-slate-700 normal-case">
            Diseñado con alto rendimiento de indexación orgánica para venta directa en entornos
            digitales móviles.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
