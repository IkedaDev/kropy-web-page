    <!-- Javascript Logic -->
    <script>
      // Mobile menu toggle logic
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Toggle mobile menu off when clicking a link
      const navLinks = mobileMenu.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // FAQ Accordion logic
      function toggleAccordion(faqId) {
        const el = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId.split("-")[1]);

        if (el.classList.contains("hidden")) {
          el.classList.remove("hidden");
          icon.classList.add("rotate-180");
        } else {
          el.classList.add("hidden");
          icon.classList.remove("rotate-180");
        }
      }

      // Evaluator state & logic
      let currentStep = 1;
      let selectedArea = "familia";

      function selectType(area) {
        selectedArea = area;
        // Clear prior styling on active option
        for (let i = 1; i <= 3; i++) {
          document
            .getElementById("label-opt-" + i)
            .classList.remove("border-gold-500", "bg-gold-50/50");
        }
        if (area === "familia")
          document.getElementById("label-opt-1").classList.add("border-gold-500", "bg-gold-50/50");
        if (area === "civil")
          document.getElementById("label-opt-2").classList.add("border-gold-500", "bg-gold-50/50");
        if (area === "laboral")
          document.getElementById("label-opt-3").classList.add("border-gold-500", "bg-gold-50/50");
      }

      function navigateStep(direction) {
        // Basic Form Validation for Step 3
        if (currentStep === 3 && direction === 1) {
          const nameInput = document.getElementById("client-name");
          const phoneInput = document.getElementById("client-phone");
          const emailInput = document.getElementById("client-email");

          if (!nameInput.value || !phoneInput.value || !emailInput.value) {
            nameInput.reportValidity();
            phoneInput.reportValidity();
            emailInput.reportValidity();
            return; // Prevent progression if invalid
          }
        }

        // Hide Current Step
        if (currentStep <= 3) {
          document.getElementById("step-" + currentStep).classList.add("hidden");
        }

        currentStep += direction;

        // Render Next Step
        if (currentStep === 4) {
          // Submit Simulation / Success Screen
          document.getElementById("step-success").classList.remove("hidden");
          document.getElementById("form-nav").classList.add("hidden");
          document.getElementById("step-indicator").innerText = "Listo";
          document.getElementById("step-indicator").className =
            "text-xs font-bold text-emerald-500 uppercase bg-emerald-500/10 px-2 py-1 rounded";

          // Update final result card metrics
          const urgencyVal = document.getElementById("urgency").value;
          document.getElementById("dyn-priority").innerText = urgencyVal;
          document.getElementById("dyn-priority").className =
            `uppercase font-semibold ${urgencyVal === "alta" ? "text-rose-600" : urgencyVal === "media" ? "text-amber-600" : "text-slate-600"}`;
          document.getElementById("dyn-area").innerText =
            selectedArea.charAt(0).toUpperCase() + selectedArea.slice(1);
        } else {
          document.getElementById("step-" + currentStep).classList.remove("hidden");
          document.getElementById("step-indicator").innerText = "Paso " + currentStep + " de 3";

          // Handle back button visibility
          if (currentStep === 1) {
            document.getElementById("prev-btn").classList.add("invisible");
          } else {
            document.getElementById("prev-btn").classList.remove("invisible");
          }

          // Handle button content at step 3
          if (currentStep === 3) {
            document.getElementById("next-btn").innerHTML =
              `Enviar Consulta <svg class="ml-2 -mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>`;
          } else {
            document.getElementById("next-btn").innerHTML =
              `Siguiente Paso <svg class="ml-2 -mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
          }
        }
      }

      // Contact Form Submit Handler
      function handleContactSubmit(event) {
        event.preventDefault();
        // Perform fake submit transition
        document.getElementById("contact-form").classList.add("hidden");
        document.getElementById("contact-success").classList.remove("hidden");
      }
    </script>
