<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MINA | Salón de Peluquería & Estilo Orgánico</title>

    <!-- Tailwind CSS (Default CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Playfair Display (Serif Elegante) & Inter (Sans-serif Limpio) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      @import "tailwindcss";
      /* Paleta de colores mediterránea y orgánica con CSS Puro */
      : root {
        --mina-sand: #f7f4ef; /* Fondo principal suave */
        --mina-terracotta: #d3a284; /* Acento cálido suave */
        --mina-clay: #b66d52; /* Acento profundo */
        --mina-olive: #4e594c; /* Contraste natural elegante */
        --mina-dark: #2a2624; /* Texto y elementos oscuros */
        --mina-cream: #faf9f6; /* Fondo secundario luminoso */
      }

      body {
        background-color: var(--mina-sand);
        color: var(--mina-dark);
        font-family: "Inter", sans-serif;
      }

      .font-serif-elegant {
        font-family: "Playfair Display", serif;
      }

      /* Estructuras curvas inspiradas en arcos de terracota */
      .arch-image-top {
        border-top-left-radius: 9999px;
        border-top-right-radius: 9999px;
      }

      .arch-image-bottom {
        border-bottom-left-radius: 9999px;
        border-bottom-right-radius: 9999px;
      }

      /* Transiciones fluidas */
      .smooth-transition {
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
      }

      /* Estilo personalizado de pestañas activas */
      .tab-active {
        color: var(--mina-clay);
        border-bottom-color: var(--mina-clay);
      }

      /* Efecto de grano o textura sutil */
      .noise-overlay {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.02'/%3E%3C/svg%3E");
      }
    </style>
  </head>
  <body class="noise-overlay relative overflow-x-hidden antialiased">
    <!-- Encabezado Fijo Minimalista -->
    <header
      class="sticky top-0 z-50 border-b border-[#2A2624]/5 bg-[#F7F4EF]/90 py-5 backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 sm:px-8 lg:px-12">
        <!-- Logo Conceptual -->
        <a href="#" class="group">
          <span class="font-serif-elegant block text-2xl tracking-widest text-[#2A2624] uppercase"
            >MINA</span
          >
          <span class="-mt-1 block text-[9px] font-light tracking-[0.25em] text-[#4E594C] uppercase"
            >Studio Capilar</span
          >
        </a>

        <!-- Enlaces de navegación elegantes -->
        <nav
          class="hidden items-center space-x-12 text-xs font-medium tracking-widest text-[#2A2624]/80 uppercase md:flex"
        >
          <a href="#filosofia" class="smooth-transition hover:text-[#B66D52]">Filosofía</a>
          <a href="#quiz" class="smooth-transition hover:text-[#B66D52]">Test de Estilo</a>
          <a href="#lookbook" class="smooth-transition hover:text-[#B66D52]">Inspiración</a>
          <a href="#carta" class="smooth-transition hover:text-[#B66D52]">Servicios</a>
          <a href="#contacto" class="smooth-transition hover:text-[#B66D52]">Ubicación</a>
        </nav>

        <!-- CTA de Contacto Directo -->
        <div class="flex items-center gap-4">
          <a
            href="https://wa.me/34600000000"
            target="_blank"
            class="smooth-transition hidden rounded-full border border-[#2A2624] px-6 py-2.5 text-xs tracking-widest text-[#2A2624] uppercase hover:bg-[#2A2624] hover:text-[#F7F4EF] sm:inline-flex"
          >
            Consultar por WhatsApp
          </a>

          <!-- Toggle Menú Móvil -->
          <button id="mobile-toggle" class="p-1 text-[#2A2624] focus:outline-none md:hidden">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                id="nav-burger"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú Desplegable Móvil -->
      <div
        id="mobile-menu"
        class="absolute left-0 hidden w-full border-t border-[#2A2624]/5 bg-[#FAF9F6] px-6 py-8 shadow-sm md:hidden"
      >
        <div
          class="flex flex-col space-y-6 text-xs font-medium tracking-widest text-[#2A2624]/90 uppercase"
        >
          <a href="#filosofia" class="hover:text-[#B66D52]">Filosofía</a>
          <a href="#quiz" class="hover:text-[#B66D52]">Test de Estilo</a>
          <a href="#lookbook" class="hover:text-[#B66D52]">Inspiración</a>
          <a href="#carta" class="hover:text-[#B66D52]">Servicios</a>
          <a href="#contacto" class="hover:text-[#B66D52]">Ubicación</a>
          <a
            href="https://wa.me/34600000000"
            target="_blank"
            class="rounded-full bg-[#2A2624] py-3 text-center text-xs tracking-widest text-[#F7F4EF] uppercase"
          >
            Mensaje por WhatsApp
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section Asimétrico -->
    <section class="mx-auto max-w-7xl px-6 py-12 sm:px-8 md:py-24 lg:px-12">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <!-- Columna de Texto Poética -->
        <div class="space-y-8 lg:col-span-6">
          <div
            class="inline-flex items-center gap-2 text-[10px] font-semibold tracking-[0.2em] text-[#4E594C] uppercase"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#B66D52]"></span>
            Peluquería Consciente y Sostenible
          </div>

          <h1
            class="font-serif-elegant text-4xl leading-[1.1] font-light text-[#2A2624] sm:text-5xl lg:text-6xl"
          >
            Cabello que respira <br />
            <span class="text-[#B66D52] italic">belleza orgánica</span> y natural.
          </h1>

          <p class="md:text-md max-w-lg text-sm leading-relaxed font-light text-[#2A2624]/80">
            Diseñamos cortes y coloraciones personalizadas que respetan la naturaleza de tu cabello
            y la salud de tu cuero cabelludo. Sin artificios, sin técnicas agresivas, solo la caída
            natural de tu estilo.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col items-stretch gap-4 pt-4 sm:flex-row sm:items-center">
            <a
              href="#quiz"
              class="smooth-transition rounded-full bg-[#4E594C] px-8 py-4 text-center text-xs tracking-widest text-[#FAF9F6] uppercase hover:bg-[#3d463b]"
            >
              Encuentra tu Estilo Ideal (Test)
            </a>
            <a
              href="#lookbook"
              class="smooth-transition rounded-full border border-[#2A2624]/20 px-8 py-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#2A2624]"
            >
              Inspirarte en el Lookbook
            </a>
          </div>
        </div>

        <!-- Columna de Imágenes Estilo Galería con Arcos -->
        <div class="relative grid grid-cols-12 gap-4 lg:col-span-6">
          <!-- Imagen Principal en Arco -->
          <div
            class="arch-image-top col-span-7 aspect-[3/4] overflow-hidden border border-[#2A2624]/5 bg-[#FAF9F6] shadow-sm"
          >
            <img
              src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=600&q=80"
              alt="Corte orgánico y textura natural"
              class="h-full w-full object-cover brightness-95 grayscale"
              onerror="this.onerror=null;this.src='https://placehold.co/400x530/e6dfd5/2e2b27?text=Mina+Studio'"
            />
          </div>

          <!-- Imagen Secundaria en Arco Invertido -->
          <div
            class="arch-image-bottom col-span-5 aspect-[3/4] translate-y-6 transform self-end overflow-hidden border border-[#2A2624]/5 bg-[#FAF9F6] shadow-sm"
          >
            <img
              src="https://images.unsplash.com/photo-1605497746444-ac9dbd39f404?auto=format&fit=crop&w=400&q=80"
              alt="Color natural mediterráneo"
              class="h-full w-full object-cover brightness-95 grayscale"
              onerror="this.onerror=null;this.src='https://placehold.co/300x400/e6dfd5/2e2b27?text=Mina+Studio'"
            />
          </div>

          <!-- Sello Circular Flotante -->
          <div
            class="font-serif-elegant absolute -top-4 -right-4 flex h-24 w-24 items-center justify-center rounded-full border border-[#2A2624]/10 bg-[#D3A284]/25 p-2 text-center text-[10px] tracking-widest text-[#2A2624] uppercase italic backdrop-blur-md"
          >
            Sabor Orgánico
          </div>
        </div>
      </div>
    </section>

    <!-- Filosofía / Manifiesto Orgánico -->
    <section id="filosofia" class="border-y border-[#2A2624]/5 bg-[#FAF9F6] py-20">
      <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
        <div class="mx-auto mb-16 max-w-3xl space-y-6 text-center">
          <span class="block text-xs font-semibold tracking-[0.25em] text-[#B66D52] uppercase"
            >Nuestra Razón de Ser</span
          >
          <h2 class="font-serif-elegant text-3xl text-[#2A2624] sm:text-4xl">
            El ritual del cuidado consciente
          </h2>
          <div class="mx-auto h-[1px] w-12 bg-[#B66D52]"></div>
          <p class="text-sm leading-relaxed font-light text-[#2A2624]/70">
            Creemos en una peluquería que se toma su tiempo. En Mina Studio eliminamos las prisas y
            los ruidos para crear un espacio de bienestar donde reconectar contigo a través del
            cuidado honesto.
          </p>
        </div>

        <!-- Grid de Pilares con Formas Arqueadas Suaves -->
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Pilar 1 -->
          <div class="space-y-4 rounded-3xl border border-[#2A2624]/5 bg-[#F7F4EF] p-8 text-center">
            <div
              class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#4E594C]/10 text-lg font-semibold text-[#4E594C]"
            >
              Ⅰ
            </div>
            <h3 class="font-serif-elegant text-lg tracking-wider text-[#2A2624] uppercase">
              Coloración Botánica
            </h3>
            <p class="text-xs leading-relaxed font-light text-[#2A2624]/70">
              Coloración de alta gama formulada con aceites vegetales, barros terapéuticos e
              ingredientes naturales libres de amoníaco. Cobertura perfecta que respira salud.
            </p>
          </div>

          <!-- Pilar 2 -->
          <div class="space-y-4 rounded-3xl border border-[#2A2624]/5 bg-[#F7F4EF] p-8 text-center">
            <div
              class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#D3A284]/20 text-lg font-semibold text-[#B66D52]"
            >
              Ⅱ
            </div>
            <h3 class="font-serif-elegant text-lg tracking-wider text-[#2A2624] uppercase">
              Cortes con Alma
            </h3>
            <p class="text-xs leading-relaxed font-light text-[#2A2624]/70">
              Estudiamos la fisonomía de tu rostro, pero sobre todo la caída de tu fibra capilar.
              Creamos cortes fáciles de llevar en tu día a día, sin esclavitudes de peinado.
            </p>
          </div>

          <!-- Pilar 3 -->
          <div class="space-y-4 rounded-3xl border border-[#2A2624]/5 bg-[#F7F4EF] p-8 text-center">
            <div
              class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#4E594C]/10 text-lg font-semibold text-[#4E594C]"
            >
              Ⅲ
            </div>
            <h3 class="font-serif-elegant text-lg tracking-wider text-[#2A2624] uppercase">
              Cosmética Vegana
            </h3>
            <p class="text-xs leading-relaxed font-light text-[#2A2624]/70">
              Champús, mascarillas y tratamientos libres de siliconas pesadas, sulfatos y parabenos
              artificiales. Tratamos tu fibra desde el interior con activos puros.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quiz de Estilo Interactivo -->
    <section id="quiz" class="mx-auto max-w-4xl px-6 py-20 sm:px-8">
      <div
        class="relative overflow-hidden rounded-[2.5rem] border border-[#2A2624]/5 bg-[#FAF9F6] p-8 shadow-sm sm:p-12"
      >
        <div class="mx-auto mb-8 max-w-xl space-y-4 text-center">
          <span class="block text-[10px] font-semibold tracking-[0.25em] text-[#B66D52] uppercase"
            >Descubre tu look idóneo</span
          >
          <h2 class="font-serif-elegant text-2xl text-[#2A2624] sm:text-3xl">
            Diagnóstico Capilar Rápido
          </h2>
          <p class="text-xs font-light text-[#2A2624]/70">
            Responde estas 3 sencillas preguntas y nuestro recomendador te sugerirá la dirección de
            estilo más saludable y favorecedora para ti.
          </p>
        </div>

        <!-- Contenedor del Quiz -->
        <div id="quiz-container" class="space-y-6">
          <!-- Paso 1 -->
          <div id="step-1" class="quiz-step space-y-4">
            <div
              class="flex items-center justify-between border-b border-[#2A2624]/5 pb-2 text-xs tracking-widest text-[#2A2624]/60 uppercase"
            >
              <span>Paso 1 de 3</span>
              <span>Tipo de Cabello</span>
            </div>
            <p class="text-center text-sm font-medium text-[#2A2624]">
              ¿Cómo describirías la textura natural de tu fibra?
            </p>
            <div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-3">
              <button
                onclick="nextStep(1, 'liso')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Liso / Delgado
              </button>
              <button
                onclick="nextStep(1, 'ondulado')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Ondulado / Con volumen
              </button>
              <button
                onclick="nextStep(1, 'rizado')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Rizado / Afro
              </button>
            </div>
          </div>

          <!-- Paso 2 (Oculto Inicialmente) -->
          <div id="step-2" class="quiz-step hidden space-y-4">
            <div
              class="flex items-center justify-between border-b border-[#2A2624]/5 pb-2 text-xs tracking-widest text-[#2A2624]/60 uppercase"
            >
              <span>Paso 2 de 3</span>
              <span>Tu Rutina Diaria</span>
            </div>
            <p class="text-center text-sm font-medium text-[#2A2624]">
              ¿Cuánto tiempo dedicas activamente a peinarte en la mañana?
            </p>
            <div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-3">
              <button
                onclick="nextStep(2, 'rapido')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Menos de 5 min (Al natural)
              </button>
              <button
                onclick="nextStep(2, 'medio')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                10 a 15 min (Secador ligero)
              </button>
              <button
                onclick="nextStep(2, 'dedicado')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Dedicado (Styling completo)
              </button>
            </div>
          </div>

          <!-- Paso 3 (Oculto Inicialmente) -->
          <div id="step-3" class="quiz-step hidden space-y-4">
            <div
              class="flex items-center justify-between border-b border-[#2A2624]/5 pb-2 text-xs tracking-widest text-[#2A2624]/60 uppercase"
            >
              <span>Paso 3 de 3</span>
              <span>Tu Objetivo de Cambio</span>
            </div>
            <p class="text-center text-sm font-medium text-[#2A2624]">
              ¿Qué dirección de cambio buscas actualmente?
            </p>
            <div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-3">
              <button
                onclick="calculateResult('refrescar')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Mantener y dar brillo/salud
              </button>
              <button
                onclick="calculateResult('cortar')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Corte cómodo y fresco
              </button>
              <button
                onclick="calculateResult('color')"
                class="smooth-transition rounded-xl border border-[#2A2624]/10 p-4 text-center text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#B66D52] hover:bg-[#F7F4EF]"
              >
                Cambio de color / Luminosidad
              </button>
            </div>
          </div>

          <!-- Resultado (Oculto Inicialmente) -->
          <div id="quiz-result" class="quiz-step hidden space-y-6 text-center">
            <div
              class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#4E594C]/10 text-2xl text-[#4E594C]"
            >
              ✨
            </div>
            <div class="space-y-2">
              <span class="text-[10px] font-semibold tracking-widest text-[#B66D52] uppercase"
                >Recomendación Personalizada</span
              >
              <h3 id="result-title" class="font-serif-elegant text-xl text-[#2A2624] sm:text-2xl">
                Corte Botánico Bob & Terapia de Brillo
              </h3>
              <p
                id="result-desc"
                class="mx-auto max-w-lg text-xs leading-relaxed font-light text-[#2A2624]/80"
              >
                Recomendamos una silueta limpia de corte medio a corto que maximice el volumen
                natural de tus ondas sin requerir peinados constantes, complementado con un baño de
                aceites orgánicos.
              </p>
            </div>

            <div class="flex flex-col justify-center gap-3 pt-4 sm:flex-row">
              <button
                onclick="resetQuiz()"
                class="smooth-transition rounded-full border border-[#2A2624]/20 px-6 py-3.5 text-xs tracking-widest text-[#2A2624] uppercase hover:border-[#2A2624]"
              >
                Repetir Test
              </button>
              <a
                id="whatsapp-result-link"
                href="https://wa.me/34600000000"
                target="_blank"
                class="smooth-transition flex items-center justify-center gap-2 rounded-full bg-[#4E594C] px-8 py-3.5 text-xs tracking-widest text-[#FAF9F6] uppercase hover:bg-[#3d463b]"
              >
                <span>Consultar este estilo</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lookbook Inspiracional de Tendencias -->
    <section id="lookbook" class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
      <div class="mx-auto mb-12 max-w-2xl space-y-4 text-center">
        <span class="block text-xs font-semibold tracking-[0.25em] text-[#B66D52] uppercase"
          >Galería de Tendencias</span
        >
        <h2 class="font-serif-elegant text-3xl text-[#2A2624] sm:text-4xl">
          Colección de Estilo Organizado
        </h2>
        <p class="text-xs font-light text-[#2A2624]/70">
          Explora nuestros trabajos de firma. Filtrados según tu estilo preferido de cuidado o
          longitud.
        </p>

        <!-- Filtros interactivos del Lookbook -->
        <div class="flex flex-wrap justify-center gap-2 pt-6">
          <button
            onclick="filterLookbook('todos')"
            class="filter-btn smooth-transition rounded-full border border-[#2A2624] bg-[#2A2624] px-5 py-2 text-[10px] tracking-widest text-[#FAF9F6] uppercase"
          >
            Todos
          </button>
          <button
            onclick="filterLookbook('cortes')"
            class="filter-btn smooth-transition rounded-full border border-[#2A2624]/10 px-5 py-2 text-[10px] tracking-widest text-[#2A2624] uppercase hover:border-[#2A2624]"
          >
            Cortes Naturales
          </button>
          <button
            onclick="filterLookbook('color')"
            class="filter-btn smooth-transition rounded-full border border-[#2A2624]/10 px-5 py-2 text-[10px] tracking-widest text-[#2A2624] uppercase hover:border-[#2A2624]"
          >
            Coloración Orgánica
          </button>
          <button
            onclick="filterLookbook('texturas')"
            class="filter-btn smooth-transition rounded-full border border-[#2A2624]/10 px-5 py-2 text-[10px] tracking-widest text-[#2A2624] uppercase hover:border-[#2A2624]"
          >
            Tratamientos & Brillo
          </button>
        </div>
      </div>

      <!-- Rejilla de Imágenes del Lookbook -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Look 1: Cortes -->
        <div class="look-card group" data-category="cortes">
          <div
            class="relative aspect-[3/4] overflow-hidden rounded-3xl border border-[#2A2624]/5 bg-[#FAF9F6]"
          >
            <img
              src="https://images.unsplash.com/photo-1595959183075-c1d09e519826?auto=format&fit=crop&w=500&q=80"
              alt="Corte Bob Francés"
              class="smooth-transition h-full w-full object-cover brightness-95 grayscale group-hover:scale-105"
              onerror="this.onerror=null;this.src='https://placehold.co/400x530/FAF9F6/2e2b27?text=Bob+Frances'"
