    <script>
      /* --- Menú Desplegable de Smartphone --- */
      const mobileToggle = document.getElementById("mobile-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const navBurger = document.getElementById("nav-burger");

      mobileToggle.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        if (mobileMenu.classList.contains("hidden")) {
          navBurger.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        } else {
          navBurger.setAttribute("d", "M6 18L18 6M6 6l12 12");
        }
      });

      // Cerrar menú al presionar un enlace
      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          navBurger.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });

      /* --- Quiz de Estilo Interactivo --- */
      let userAnswers = {
        texture: "",
        routine: "",
      };

      function nextStep(currentStep, answer) {
        // Guardar respuesta del paso actual
        if (currentStep === 1) {
          userAnswers.texture = answer;
          document.getElementById("step-1").classList.add("hidden");
          document.getElementById("step-2").classList.remove("hidden");
        } else if (currentStep === 2) {
          userAnswers.routine = answer;
          document.getElementById("step-2").classList.add("hidden");
          document.getElementById("step-3").classList.remove("hidden");
        }
      }

      function calculateResult(finalGoal) {
        document.getElementById("step-3").classList.add("hidden");
        const resultBox = document.getElementById("quiz-result");
        resultBox.classList.remove("hidden");

        const title = document.getElementById("result-title");
        const desc = document.getElementById("result-desc");
        const waLink = document.getElementById("whatsapp-result-link");

        let recommendedStyle = "Corte Francés Orgánico & Barros Relajantes";
        let recommendedDesc =
          "Para mantener un equilibrio perfecto en tu día a día, sugerimos una silueta de longitud media con coloración a base de tierras naturales que aportan brillo y fuerza sin dañar.";

        // Lógica simple de decisión adaptada al usuario
        if (userAnswers.texture === "rizado") {
          recommendedStyle = "Corte en Seco 'Curly Shape' & Hidratación de Lino";
          recommendedDesc =
            "Diseñaremos el volumen de tus rizos cortando en seco para una caída óptima, sumado a un baño ácido de lino que selle la hidratación profunda.";
        } else if (finalGoal === "color") {
          recommendedStyle = "Balayage Orgánico 'Sunkissed' y Ritual de Brillo";
          recommendedDesc =
            "Ideal para añadir puntos de luz tridimensionales imitando la acción del sol, utilizando nuestra exclusiva decoloración de base oleosa libre de amoniaco.";
        } else if (finalGoal === "cortar" && userAnswers.routine === "rapido") {
          recommendedStyle = "Bob Desestructurado 'Wash & Go' Sostenible";
          recommendedDesc =
            "Corte ultra cómodo que se adapta a tu caída natural. Peinarlo requerirá menos de 2 minutos para lucir un aire sofisticado pero muy desenfadado.";
        }

        title.textContent = recommendedStyle;
        desc.textContent = recommendedDesc;

        // Formular un enlace de WhatsApp con la consulta del resultado
        const message = `Hola Mina Studio, he completado el Test de Estilo de su web y mi recomendación idónea es: *${recommendedStyle}*. Me gustaría consultar disponibilidad de agenda para este servicio.`;
        waLink.href = `https://wa.me/34600000000?text=${encodeURIComponent(message)}`;
      }

      function resetQuiz() {
        userAnswers = { texture: "", routine: "" };
        document.getElementById("quiz-result").classList.add("hidden");
        document.getElementById("step-1").classList.remove("hidden");
      }

      /* --- Filtros del Lookbook --- */
      function filterLookbook(category) {
        // Cambiar estados activos de los botones
        const filterButtons = document.querySelectorAll(".filter-btn");
        filterButtons.forEach((btn) => {
          btn.classList.remove("bg-[#2A2624]", "text-[#FAF9F6]");
          btn.classList.add("border-[#2A2624]/10", "text-[#2A2624]");
        });

        // Marcar botón activo
        event.currentTarget.classList.remove("border-[#2A2624]/10", "text-[#2A2624]");
        event.currentTarget.classList.add("bg-[#2A2624]", "text-[#FAF9F6]");

        // Filtrar las tarjetas del lookbook
        const cards = document.querySelectorAll(".look-card");
        cards.forEach((card) => {
          if (category === "todos" || card.getAttribute("data-category") === category) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      }

      /* --- Acordeón de FAQs --- */
      function toggleFAQ(index) {
        const content = document.getElementById(`faq-content-${index}`);
        const icon = document.getElementById(`faq-icon-${index}`);

        if (content.classList.contains("hidden")) {
          content.classList.remove("hidden");
          icon.textContent = "−";
        } else {
          content.classList.add("hidden");
          icon.textContent = "+";
        }
      }
    </script>
  </body>
</html>
