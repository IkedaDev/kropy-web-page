        class="absolute left-0 hidden w-full border-t border-[#1A2E26]/5 bg-[#FAF8F5] px-6 py-8 shadow-md md:hidden"
      >
        <div
          class="flex flex-col space-y-5 text-[11px] font-medium tracking-[0.2em] text-[#262E2A]/90 uppercase"
        >
          <a href="#filosofia" class="hover:text-[#C2A26A]">El Oasis</a>
          <a href="#alquimista" class="hover:text-[#C2A26A]">El Alquimista</a>
          <a href="#herbolario" class="hover:text-[#C2A26A]">Herbolario</a>
          <a href="#rituales" class="hover:text-[#C2A26A]">Rituales</a>
          <a href="#acustica" class="hover:text-[#C2A26A]">Sonidos</a>
          <a
            href="https://wa.me/34600000000"
            target="_blank"
            class="rounded-full bg-[#1A2E26] py-3.5 text-center text-[10px] tracking-[0.2em] text-[#FAF8F5] uppercase"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section: Un Invernadero de Luz y Plantas -->
    <section class="mx-auto max-w-7xl px-6 py-12 sm:px-8 md:py-24 lg:px-12">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <!-- Copy Poético y Natural -->
        <div class="space-y-8 lg:col-span-6">
          <div
            class="inline-flex items-center gap-2 text-[9px] font-semibold tracking-[0.25em] text-[#8DA189] uppercase"
          >
            <span class="pulse-soft h-2 w-2 rounded-full bg-[#C2A26A]"></span>
            Tu cabello sanado por el poder de la tierra
          </div>

          <h1
            class="font-serif-botanical text-5xl leading-[1.05] font-light text-[#1A2E26] sm:text-6xl lg:text-7xl"
          >
            La belleza <br />
            nace de una <br />
            <span class="text-[#8DA189] italic">raíz en calma.</span>
          </h1>

          <p class="md:text-md max-w-lg text-sm leading-relaxed font-light text-[#262E2A]/85">
            En SOLUM no camuflamos el daño con siliconas. Curamos el cuero cabelludo y la fibra con
