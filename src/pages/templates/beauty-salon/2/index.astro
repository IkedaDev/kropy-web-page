          </div>
        </a>

        <!-- Navegación Orgánica -->
        <nav
          class="hidden items-center space-x-10 text-[11px] font-medium tracking-[0.2em] text-[#262E2A]/85 uppercase md:flex"
        >
          <a href="#filosofia" class="organic-transition hover:text-[#C2A26A]">El Oasis</a>
          <a href="#alquimista" class="organic-transition hover:text-[#C2A26A]">El Alquimista</a>
          <a href="#herbolario" class="organic-transition hover:text-[#C2A26A]">Herbolario</a>
          <a href="#rituales" class="organic-transition hover:text-[#C2A26A]">Rituales</a>
          <a href="#acustica" class="organic-transition hover:text-[#C2A26A]">Sonidos</a>
        </nav>

        <!-- CTA Directo -->
        <div class="flex items-center gap-4">
          <a
            href="https://wa.me/34600000000"
            target="_blank"
            class="organic-transition hidden rounded-full bg-[#1A2E26] px-6 py-3 text-[10px] font-medium tracking-[0.2em] text-[#FAF8F5] uppercase hover:bg-[#C2A26A] sm:inline-flex"
