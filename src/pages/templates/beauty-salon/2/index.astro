        </div>

        <!-- Imagen Conceptual Invernadero / Arco -->
        <div class="relative grid grid-cols-12 gap-4 lg:col-span-6">
          <!-- Arco de Invernadero Principal -->
          <div
            class="greenhouse-arch col-span-8 aspect-[3/4.5] overflow-hidden border border-[#1A2E26]/5 bg-[#F1ECE3] shadow-sm"
