<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SOLUM | Peluquería Botánica & Herbolario Capilar</title>

    <!-- Google Fonts: Cormorant Garamond (Elegancia clásica botánica) & Inter (Lectura limpia) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      @import "tailwindcss";
      /* Paleta de colores botánica y de invernadero orgánico - CSS Puro sin alterar Tailwind */
      :root {
        --solum-forest: #1a2e26; /* Verde bosque profundo alpino */
        --solum-sage: #8da189; /* Verde salvia suave */
        --solum-cream: #faf8f5; /* Blanco alabastro cálido */
        --solum-gold: #c2a26a; /* Latón/Oro cepillado orgánico */
        --solum-moss: #3e544a; /* Verde musgo intermedio */
        --solum-charcoal: #262e2a; /* Texto oscuro profundo */
        --solum-sand: #f1ece3; /* Arena de río suave */
      }

      body {
        background-color: var(--solum-cream);
        color: var(--solum-charcoal);
        font-family: "Inter", sans-serif;
      }

      .font-serif-botanical {
        font-family: "Cormorant Garamond", serif;
      }

      /* Formas arquitectónicas orgánicas: Arcos de invernadero */
      .greenhouse-arch {
        border-top-left-radius: 120px;
        border-top-right-radius: 120px;
      }

      .leaf-shape-right {
        border-top-right-radius: 100px;
        border-bottom-left-radius: 100px;
      }

      .leaf-shape-left {
        border-top-left-radius: 100px;
        border-bottom-right-radius: 100px;
      }

      /* Transiciones lentas inspiradas en la naturaleza */
      .organic-transition {
        transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Textura orgánica sutil en el fondo */
      .organic-overlay {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='organicNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23organicNoise)' opacity='0.015'/%3E%3C/svg%3E");
      }

      /* Animación suave de pulso para elementos activos */
      @keyframes soft-pulse {
        0%,
        100% {
          opacity: 0.6;
          transform: scale(1);
        }
        50% {
          opacity: 1;
          transform: scale(1.05);
        }
      }

      .pulse-soft {
        animation: soft-pulse 4s infinite ease-in-out;
      }
    </style>
  </head>
  <body class="organic-overlay relative overflow-x-hidden antialiased">
    <!-- Encabezado Flotante Botánico -->
    <header
      class="sticky top-0 z-50 border-b border-[#1A2E26]/5 bg-[#FAF8F5]/90 py-5 backdrop-blur-md"
