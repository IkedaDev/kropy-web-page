    <!-- Mezclador Botánico Interactivo: El Alquimista -->
    <section id="alquimista" class="mx-auto max-w-4xl px-6 py-24 sm:px-8">
      <div
        class="relative overflow-hidden rounded-[3rem] border border-[#1A2E26]/10 bg-[#FAF8F5] p-8 shadow-sm sm:p-14"
      >
        <div class="mx-auto mb-10 max-w-xl space-y-4 text-center">
          <span class="block text-[9px] font-bold tracking-[0.3em] text-[#C2A26A] uppercase"
            >Prueba de Autodiagnóstico</span
          >
          <h2 class="font-serif-botanical text-3xl text-[#1A2E26] sm:text-4xl">
            El Alquimista Botánico
          </h2>
          <p class="text-xs font-light text-[#262E2A]/80">
            Selecciona la condición principal de tu cuero cabelludo y el estado de tu fibra capilar.
            Diseñaremos tu infusión botánica ideal para tu ritual.
          </p>
        </div>

        <!-- Interfaz del Alquimista -->
        <div class="space-y-8">
          <!-- Paso 1: Cuero Cabelludo -->
          <div class="space-y-3">
            <label
              class="block text-center text-[10px] font-semibold tracking-[0.2em] text-[#8DA189] uppercase sm:text-left"
              >1. Estado de tu Cuero Cabelludo</label
            >
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <button
                onclick="selectScalp('graso', this)"
                class="scalp-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Exceso de Grasa / Pesado
              </button>
              <button
                onclick="selectScalp('seco', this)"
                class="scalp-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Sensible / Seco / Descamación
              </button>
              <button
                onclick="selectScalp('debil', this)"
                class="scalp-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Frágil / Tendencia a Caída
              </button>
            </div>
          </div>

          <!-- Paso 2: Estado de la Fibra -->
          <div class="space-y-3">
            <label
              class="block text-center text-[10px] font-semibold tracking-[0.2em] text-[#8DA189] uppercase sm:text-left"
              >2. Estado de la Fibra Capilar</label
            >
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <button
                onclick="selectFiber('quebradizo', this)"
                class="fiber-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Muy Dañado / Quebradizo
              </button>
              <button
                onclick="selectFiber('deshidratado', this)"
                class="fiber-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Falta de Brillo / Opaco
              </button>
              <button
                onclick="selectFiber('sinvolumen', this)"
                class="fiber-btn organic-transition rounded-2xl border border-[#1A2E26]/10 bg-[#FAF8F5] p-4 text-center text-xs tracking-widest text-[#262E2A] uppercase hover:border-[#1A2E26]"
              >
                Fino / Sin Volumen
              </button>
            </div>
          </div>

          <!-- Contenedor del Destilador de Pociones -->
          <div class="flex flex-col items-center border-t border-[#1A2E26]/5 pt-6">
            <button
              id="brew-btn"
              onclick="brewPotion()"
              class="organic-transition cursor-not-allowed rounded-full bg-[#1A2E26] px-10 py-4 text-[10px] font-medium tracking-[0.25em] text-[#FAF8F5] uppercase opacity-50 hover:bg-[#C2A26A]"
              disabled
            >
              Destilar Mi Infusión Botánica
            </button>
          </div>

          <!-- Resultado de la Poción (Oculto al inicio) -->
          <div
            id="potion-result"
            class="animate-fade-in mt-8 hidden space-y-6 rounded-[2rem] border border-[#1A2E26]/10 bg-[#F1ECE3]/60 p-6 text-center sm:p-8"
          >
            <!-- Animación Simbólica de Vasija/Planta -->
            <div
