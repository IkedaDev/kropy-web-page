          >
            Agua de Lluvia Filtrada
          </div>
        </div>
      </div>
    </section>

    <!-- Filosofía del Oasis Sostenible -->
    <section id="filosofia" class="border-y border-[#1A2E26]/5 bg-[#F1ECE3]/40 py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
        <div class="mx-auto mb-20 max-w-2xl space-y-6 text-center">
          <span class="block text-[10px] font-bold tracking-[0.3em] text-[#C2A26A] uppercase"
