              >Peluquería Botánica Sensorial</span
            >
          </div>

          <!-- Enlaces del Footer -->
          <div
            class="flex flex-wrap justify-center gap-8 text-[10px] font-medium tracking-widest text-[#FAF8F5]/80 uppercase"
          >
            <a href="#filosofia" class="organic-transition hover:text-[#C2A26A]">El Oasis</a>
            <a href="#alquimista" class="organic-transition hover:text-[#C2A26A]">El Alquimista</a>
            <a href="#herbolario" class="organic-transition hover:text-[#C2A26A]">El Herbolario</a>
            <a href="#rituales" class="organic-transition hover:text-[#C2A26A]">Los Rituales</a>
          </div>
        </div>

        <!-- Legales & Copyright -->
        <div
          class="flex flex-col items-center justify-between gap-4 pt-12 text-[9px] font-light tracking-widest text-[#FAF8F5]/40 uppercase sm:flex-row"
        >
          <p>
            &copy; 2026 SOLUM Capilar. Cultivando la salud del cabello con respeto botánico
            absoluto.
          </p>
          <div class="flex gap-6">
            <a href="#" class="hover:text-[#C2A26A]">Términos de la Tierra</a>
            <a href="#" class="hover:text-[#C2A26A]">Política de Respeto Orgánico</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      /* --- Menú Desplegable de Smartphone --- */
      const mobileToggle = document.getElementById("mobile-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const navBurger = document.getElementById("nav-burger");

      mobileToggle.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        if (mobileMenu.classList.contains("hidden")) {
          navBurger.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        } else {
          navBurger.setAttribute("d", "M6 18L18 6M6 6l12 12");
        }
      });

      // Cerrar menú al presionar un enlace
      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          navBurger.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });

      /* --- El Alquimista Botánico Interactivo --- */
      let selectedScalpVal = "";
      let selectedFiberVal = "";

      function selectScalp(value, element) {
        // Deseleccionar botones anteriores de la sección cuero cabelludo
        const scalpButtons = document.querySelectorAll(".scalp-btn");
        scalpButtons.forEach((btn) => {
          btn.classList.remove("bg-[#1A2E26]", "text-[#FAF8F5]", "border-[#1A2E26]");
          btn.classList.add("bg-[#FAF8F5]", "text-[#262E2A]", "border-[#1A2E26]/10");
        });

        // Seleccionar el actual
        element.classList.remove("bg-[#FAF8F5]", "text-[#262E2A]", "border-[#1A2E26]/10");
        element.classList.add("bg-[#1A2E26]", "text-[#FAF8F5]", "border-[#1A2E26]");
        selectedScalpVal = value;

        checkAlchemistReady();
      }

      function selectFiber(value, element) {
        // Deseleccionar botones de fibra
        const fiberButtons = document.querySelectorAll(".fiber-btn");
        fiberButtons.forEach((btn) => {
          btn.classList.remove("bg-[#1A2E26]", "text-[#FAF8F5]", "border-[#1A2E26]");
          btn.classList.add("bg-[#FAF8F5]", "text-[#262E2A]", "border-[#1A2E26]/10");
        });

        // Seleccionar actual
        element.classList.remove("bg-[#FAF8F5]", "text-[#262E2A]", "border-[#1A2E26]/10");
        element.classList.add("bg-[#1A2E26]", "text-[#FAF8F5]", "border-[#1A2E26]");
        selectedFiberVal = value;

        checkAlchemistReady();
      }

      function checkAlchemistReady() {
        const brewBtn = document.getElementById("brew-btn");
        if (selectedScalpVal !== "" && selectedFiberVal !== "") {
          brewBtn.classList.remove("opacity-50", "cursor-not-allowed");
          brewBtn.removeAttribute("disabled");
        }
      }

      function brewPotion() {
        const resultSection = document.getElementById("potion-result");
        resultSection.classList.remove("hidden");

        const title = document.getElementById("potion-name");
        const desc = document.getElementById("potion-desc");
        const waLink = document.getElementById("potion-whatsapp-link");

        const i1 = document.getElementById("ing-1");
        const i2 = document.getElementById("ing-2");
        const i3 = document.getElementById("ing-3");

        let potionName = "Infundido Calmante de Lavanda";
        let potionDesc =
          "Fórmula diseñada para apaciguar el cuero cabelludo, sellando la cutícula con un brillo suave y sin peso.";
        let ing1 = "Lavanda";
        let ing2 = "Agua de Rosas";
        let ing3 = "Aceite de Caléndula";

        // Combinatoria de poción según selección
        if (selectedScalpVal === "graso" && selectedFiberVal === "quebradizo") {
          potionName = "Arcilla Caolín & Tratamiento de Ortiga Reparadora";
          potionDesc =
            "Una arcilla purificadora de caolín absorbe los aceites de la raíz mientras envolvemos tus puntas en una cataplasma tibia de romero y ortiga para estructurar la fibra rota.";
          ing1 = "Arcilla Caolín";
          ing2 = "Infusión de Ortiga";
          ing3 = "Hojas de Romero";
        } else if (selectedScalpVal === "graso") {
          potionName = "Elixir Astringente de Ortiga & Salvia Salvaje";
          potionDesc =
            "Diseñado para limpiar profundamente los bulbos pilosos, regulando el sebo. Tu melena recuperará ligereza, movimiento y brillo cristalino.";
          ing1 = "Ortiga Verde";
          ing2 = "Salvia Salvaje";
          ing3 = "Té de Árbol";
        } else if (selectedScalpVal === "seco" && selectedFiberVal === "deshidratado") {
          potionName = "Ritual de Caléndula Cruda & Néctar de Coco Caliente";
          potionDesc =
            "El tratamiento de nutrición por excelencia de SOLUM. El cuero cabelludo descamado se sana con caléndula, mientras las longitudes secas beben lípidos puros de coco tibio.";
          ing1 = "Aceite de Coco";
          ing2 = "Flores de Caléndula";
          ing3 = "Agua de Rosas";
        } else if (selectedScalpVal === "debil") {
          potionName = "Infusión Capilar Fortificante de Romero & Cola de Caballo";
          potionDesc =
            "Ritual de estimulación térmica. Usamos romero infundido en agua de lluvia para irrigar el folículo, aportando sílice vegetal orgánico para engrosar el cabello.";
          ing1 = "Romero Estimulante";
          ing2 = "Cola de Caballo";
          ing3 = "Lodo Marino";
        }

        title.textContent = potionName;
        desc.textContent = potionDesc;
        i1.textContent = ing1;
        i2.textContent = ing2;
        i3.textContent = ing3;

        // Enlace personalizado de WhatsApp
        const message = `Hola SOLUM, he usado el Mezclador de su web y mi fórmula fresca recomendada es: *${potionName}*. ¿Tienen disponibilidad para un ritual esta semana?`;
        waLink.href = `https://wa.me/34600000000?text=${encodeURIComponent(message)}`;

        // Hacer scroll suave hacia el resultado
        setTimeout(() => {
          resultSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }, 100);
      }

      function resetAlchemist() {
        selectedScalpVal = "";
        selectedFiberVal = "";

        // Reiniciar botones
        const allButtons = document.querySelectorAll(".scalp-btn, .fiber-btn");
        allButtons.forEach((btn) => {
          btn.classList.remove("bg-[#1A2E26]", "text-[#FAF8F5]", "border-[#1A2E26]");
          btn.classList.add("bg-[#FAF8F5]", "text-[#262E2A]", "border-[#1A2E26]/10");
        });

        const brewBtn = document.getElementById("brew-btn");
        brewBtn.classList.add("opacity-50", "cursor-not-allowed");
        brewBtn.setAttribute("disabled", "true");

        document.getElementById("potion-result").classList.add("hidden");
      }

      /* --- El Invernadero Acústico (Web Audio API) --- */
      let audioContext = null;
      let ambientOscillator = null;
      let ambientGain = null;
      let isSoundPlaying = false;
      let waveInterval = null;

      function toggleSoundscape() {
        const btnText = document.getElementById("sound-btn-text");
        const btnIcon = document.getElementById("sound-btn-icon");
        const statusText = document.getElementById("sound-status");

        if (!isSoundPlaying) {
          // Crear contexto de audio si no existe
          if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
          }

          // Iniciar sintetizador de ruido/viento meditativo
          ambientOscillator = audioContext.createOscillator();
          ambientGain = audioContext.createGain();

          // Frecuencia baja de relajación (solenoide zen)
          ambientOscillator.type = "sine";
          ambientOscillator.frequency.setValueAtTime(120, audioContext.currentTime); // 120Hz profundo

          // LFO de modulación de volumen para emular viento
          const lfo = audioContext.createOscillator();
          const lfoGain = audioContext.createGain();
          lfo.frequency.setValueAtTime(0.2, audioContext.currentTime); // 0.2Hz oscilación lenta (5 segundos)
          lfoGain.gain.setValueAtTime(0.02, audioContext.currentTime);

          lfo.connect(lfoGain);
          lfoGain.connect(ambientGain.gain);

          ambientOscillator.connect(ambientGain);
          ambientGain.connect(audioContext.destination);

          // Configurar volumen maestro muy sutil
          ambientGain.gain.setValueAtTime(0.015, audioContext.currentTime);

          lfo.start();
          ambientOscillator.start();

          isSoundPlaying = true;
          btnText.textContent = "Apagar Sonido";
          btnIcon.textContent = "🔇";
          statusText.textContent = "Sonido Activo";

          // Animación visual de ondas
          startWaveAnimation();
        } else {
          // Detener audio de forma segura
          if (ambientOscillator) {
            ambientOscillator.stop();
            ambientOscillator.disconnect();
          }
          isSoundPlaying = false;
          btnText.textContent = "Activar Sonido";
          btnIcon.textContent = "🔊";
          statusText.textContent = "Sonido Apagado";
          stopWaveAnimation();
        }
      }

      function startWaveAnimation() {
        const waves = [
          document.getElementById("wave-1"),
          document.getElementById("wave-2"),
          document.getElementById("wave-3"),
          document.getElementById("wave-4"),
          document.getElementById("wave-5"),
        ];

        waveInterval = setInterval(() => {
          waves.forEach((wave) => {
            const randomHeight = Math.floor(Math.random() * 30) + 8;
            wave.style.height = `${randomHeight}px`;
          });
        }, 300);
      }

      function stopWaveAnimation() {
        clearInterval(waveInterval);
        const waves = [
          document.getElementById("wave-1"),
          document.getElementById("wave-2"),
          document.getElementById("wave-3"),
          document.getElementById("wave-4"),
          document.getElementById("wave-5"),
        ];
        // Altura por defecto
        waves[0].style.height = "12px";
        waves[1].style.height = "24px";
        waves[2].style.height = "32px";
        waves[3].style.height = "16px";
        waves[4].style.height = "8px";
      }

      /* --- Acordeón de Preguntas Frecuentes --- */
      function toggleFAQ(index) {
        const content = document.getElementById(`faq-content-${index}`);
        const icon = document.getElementById(`faq-icon-${index}`);

        if (content.classList.contains("hidden")) {
          content.classList.remove("hidden");
          icon.textContent = "−";
        } else {
          content.classList.add("hidden");
          icon.textContent = "+";
        }
      }
    </script>
  </body>
</html>
