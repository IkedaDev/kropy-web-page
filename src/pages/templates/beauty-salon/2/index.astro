        <!-- Logo Solum -->
        <a href="#" class="group flex items-center gap-3">
          <div
            class="organic-transition flex h-8 w-8 items-center justify-center rounded-full border border-[#1A2E26]/20 text-[#8DA189] group-hover:border-[#C2A26A]"
          >
            <span class="font-serif-botanical text-xs">🌿</span>
          </div>
          <div>
            <span
              class="font-serif-botanical block text-2xl font-medium tracking-[0.15em] text-[#1A2E26] uppercase"
