              🏺
              <span class="pulse-soft absolute -top-1 -right-1 text-xs">✨</span>
            </div>

            <div class="space-y-2">
              <span class="text-[9px] font-bold tracking-[0.25em] text-[#C2A26A] uppercase"
                >Fórmula Fresca Destilada</span
              >
              <h3 id="potion-name" class="font-serif-botanical text-2xl text-[#1A2E26]">
                Elixir Purificante de Lavanda & Romero
              </h3>
              <p
                id="potion-desc"
                class="mx-auto max-w-lg text-xs leading-relaxed font-light text-[#262E2A]/85"
              >
                Una base calmante enriquecida con arcilla blanca pura para exfoliar suavemente las
                células muertas del cuero cabelludo, combinada con un baño tibio de ortiga para
                vigorizar la longitud.
              </p>
            </div>

            <!-- Ingredientes de la Poción Activos -->
            <div class="flex flex-wrap justify-center gap-3 py-2">
              <span
                id="ing-1"
                class="rounded-full border border-[#1A2E26]/5 bg-[#FAF8F5] px-4 py-2 text-[9px] tracking-wider text-[#1A2E26] uppercase"
                >Aceite de Romero</span
              >
              <span
                id="ing-2"
                class="rounded-full border border-[#1A2E26]/5 bg-[#FAF8F5] px-4 py-2 text-[9px] tracking-wider text-[#1A2E26] uppercase"
                >Arcilla Caolín</span
              >
              <span
                id="ing-3"
                class="rounded-full border border-[#1A2E26]/5 bg-[#FAF8F5] px-4 py-2 text-[9px] tracking-wider text-[#1A2E26] uppercase"
                >Salvia Fresca</span
              >
            </div>

            <div class="flex flex-col justify-center gap-4 pt-4 sm:flex-row">
              <button
                onclick="resetAlchemist()"
                class="organic-transition rounded-full border border-[#1A2E26]/20 px-6 py-3.5 text-[10px] tracking-[0.2em] text-[#1A2E26] uppercase hover:border-[#1A2E26]"
              >
                Reiniciar Mezclador
              </button>
              <a
                id="potion-whatsapp-link"
                href="https://wa.me/34600000000"
                target="_blank"
                class="organic-transition flex items-center justify-center gap-2 rounded-full bg-[#1A2E26] px-8 py-3.5 text-[10px] font-medium tracking-[0.2em] text-[#FAF8F5] uppercase hover:bg-[#8DA189]"
              >
                <span>Solicitar este ritual</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- El Herbolario: Biblioteca Orgánica Interactiva -->
    <section id="herbolario" class="border-t border-[#1A2E26]/5 bg-[#FAF8F5] py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
        <div class="mx-auto mb-16 max-w-xl space-y-4 text-center">
          <span class="block text-[10px] font-bold tracking-[0.3em] text-[#C2A26A] uppercase"
            >Nuestro Almacén Natural</span
          >
          <h2 class="font-serif-botanical text-3xl text-[#1A2E26] sm:text-4xl">
            El Herbolario Capilar
          </h2>
          <p class="text-xs font-light text-[#262E2A]/75">
            Explora la pureza de los ingredientes crudos que guardamos en frascos de vidrio ámbar y
            que vertemos en cada infusión capilar.
          </p>
        </div>

        <!-- Grid de Ingredientes del Herbolario con efectos interactivos -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Ingrediente 1 -->
          <div
            class="group organic-transition flex flex-col justify-between rounded-[2rem] border border-[#1A2E26]/10 bg-[#FAF8F5] p-6 shadow-sm hover:border-[#8DA189] hover:shadow-md"
          >
            <div class="space-y-4">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8DA189]/15 text-xl text-[#1A2E26]"
              >
                🌿
              </div>
              <div>
                <span class="text-[9px] font-bold tracking-widest text-[#C2A26A] uppercase"
