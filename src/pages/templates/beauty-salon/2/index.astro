              class="h-full w-full object-cover brightness-[0.95] saturate-[0.85]"
              onerror="this.onerror=null;this.src='https://placehold.co/300x480/8DA189/FAF8F5?text=Botanicals'"
            />
          </div>

          <!-- Sello de Autenticidad Flotante -->
          <div
