    <style>
      @import "tailwindcss";
      /* Paleta de colores Casa Luna: Misticismo orgánico sin configurar Tailwind */
      :root {
        --luna-night: #0e1622; /* Azul medianoche cósmico */
        --luna-terracotta: #d38b75; /* Terracota bohemio */
        --luna-sand: #faf5f0; /* Arena del desierto suave */
        --luna-gold: #e5c3a6; /* Oro rosado apagado */
        --luna-charcoal: #2a2625; /* Texto oscuro suave */
        --luna-blush: #f0dfd5; /* Rosa empolvado cálido */
        --luna-sage: #7a8d80; /* Verde salvia místico */
      }

      body {
        background-color: var(--luna-sand);
        color: var(--luna-charcoal);
        font-family: "Inter", sans-serif;
      }

      .font-serif-luna {
        font-family: "Playfair Display", serif;
      }

      /* Formas arqueadas místicas y orgánicas */
      .cosmic-arch {
        border-top-left-radius: 999px;
        border-top-right-radius: 999px;
      }

      /* Efecto de ruido cósmico sutil de fondo */
      .cosmic-overlay {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='cosmicNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23cosmicNoise)' opacity='0.02'/%3E%3C/svg%3E");
      }

      /* Transición holística lenta */
      .celestial-transition {
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Rotación orbital continua */
      @keyframes orbit {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .orbital-spin {
        animation: orbit 30s infinite linear;
      }

      /* Pulso de estrella */
      @keyframes star-pulse {
        0%,
        100% {
          opacity: 0.3;
          transform: scale(0.9);
        }
        50% {
          opacity: 1;
          transform: scale(1.1);
        }
      }

      .pulse-star {
        animation: star-pulse 3s infinite ease-in-out;
      }
    </style>
  </head>
