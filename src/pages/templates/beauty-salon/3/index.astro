      /* --- El Cuenco de Cuarzo Sensorial (Web Audio API) --- */
      let audioCtx = null;

      function ringSingingBowl() {
        const bowlIcon = document.getElementById("bowl-inner");
        const statusText = document.getElementById("bowl-status");

        // Efecto visual de vibración temporal
        bowlIcon.classList.add("scale-125", "rotate-12");
        statusText.textContent = "¡Vibrando en 432Hz!";
        setTimeout(() => {
          bowlIcon.classList.remove("scale-125", "rotate-12");
          statusText.textContent = "Cuenco de Cuarzo en Silencio";
        }, 3000);

        // Iniciar e inicializar contexto de audio al interactuar
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        const now = audioCtx.currentTime;

        // Generador de frecuencia de campana pura
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        // Sintonización mística: 432Hz fundamental y un pequeño sobretono sutil a 864Hz para realismo acústico
        osc.type = "sine";
        osc.frequency.setValueAtTime(432, now);

        // Segundo oscilador armónico
        const overtonesOsc = audioCtx.createOscillator();
        const overtonesGain = audioCtx.createGain();
        overtonesOsc.type = "sine";
        overtonesOsc.frequency.setValueAtTime(864, now); // Armónico puro

        // Conectar nodos de volumen y ganancia
        osc.connect(gainNode);
        overtonesOsc.connect(overtonesGain);
        gainNode.connect(audioCtx.destination);
        overtonesGain.connect(audioCtx.destination);

        // Ajuste y decaimiento exponencial del sonido (simulando metal/cristal)
        gainNode.gain.setValueAtTime(0.08, now);
        gainNode.gain.exponentialRampToValueAtTime(0.001, now + 4.5); // Sonará durante 4.5 segundos lentamente

        overtonesGain.gain.setValueAtTime(0.02, now);
        overtonesGain.gain.exponentialRampToValueAtTime(0.0001, now + 2.5);

        // Iniciar sintetizadores
        osc.start();
        overtonesOsc.start();

        // Parar fuentes tras el apagamiento exponencial
        osc.stop(now + 5);
        overtonesOsc.stop(now + 3);
      }

      /* --- Acordeón de FAQs Celestes --- */
