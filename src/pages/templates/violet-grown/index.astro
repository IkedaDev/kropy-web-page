---
import SeoHead from "../../../components/SeoHead.astro";

const title =
  "Violet Grown | Dermoestética Capilar, Crioterapia & Alquimia Botánica • Temuco Chile";
const description =
  "Violet Grown | Dermoestética Capilar, Crioterapia & Alquimia Botánica • Temuco Chile";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Plus Jakarta Sans (UI moderna) & Playfair Display (Serif de lujo editorial) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* CSS PURO: Variables de diseño de autor para Violet Grown (Plum & Lilac Opal Palette) */
      :root {
        --kallfu-bg: #faf5f8; /* Lino lavanda / Arena suave fría */
        --kallfu-white: #ffffff; /* Blanco puro sólido */
        --kallfu-border: #e8dee5; /* Divisores finos lila claro */
        --kallfu-plum: #3c1b30; /* Morado ciruela profundo (Lujo místico) */
        --kallfu-lilac: #8e70a6; /* Lila amatista */
        --kallfu-lilac-light: #f0e9f3; /* Salvia/lila suave de fondo para cajas */
        --kallfu-rose: #d09cb8; /* Rosa viejo / Dusty Rose */
        --kallfu-dark: #231b21; /* Berenjena oscuro para alta legibilidad */
        --kallfu-muted: #72636e; /* Bruma grisácea con matiz lila */
      }

      body {
        background-color: var(--kallfu-bg);
        color: var(--kallfu-dark);
        font-family: "Plus Jakarta Sans", sans-serif;
        letter-spacing: -0.015em;
      }

      .font-editorial {
        font-family: "Playfair Display", serif;
      }

      /* Transiciones fluidas */
      .kallfu-transition {
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Estilos específicos para Bento Grid */
      .bento-card {
        background-color: var(--kallfu-white);
        border: 1px solid var(--kallfu-border);
        border-radius: 24px;
        padding: 2rem;
        box-shadow:
          0 4px 20px -2px rgba(60, 27, 48, 0.02),
          0 2px 6px -1px rgba(0, 0, 0, 0.01);
      }

      .bento-card:hover {
        box-shadow:
          0 12px 30px -4px rgba(60, 27, 48, 0.04),
          0 4px 12px -2px rgba(0, 0, 0, 0.015);
        border-color: var(--kallfu-lilac);
      }
    </style>
  </head>
  <body class="relative min-h-screen overflow-x-hidden antialiased">
    <!-- CABECERA DE AUTOR: Limpia, Fina y Ajustada -->
    <header
      class="sticky top-0 z-50 border-b border-[--kallfu-border] bg-[#FAF5F8]/80 py-4 backdrop-blur-lg"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 sm:px-10">
        <!-- Logotipo del Salón de Autor -->
        <a href="#" class="group flex items-center gap-3" aria-label="Volver al inicio">
          <div
            class="font-editorial kallfu-transition flex h-8 w-8 items-center justify-center rounded-full border border-[--kallfu-plum] text-sm font-semibold text-[--kallfu-dark] italic group-hover:bg-[--kallfu-plum] group-hover:text-white"
          >
            K
          </div>
          <span
            class="font-editorial kallfu-transition text-xl font-bold tracking-tight text-[--kallfu-dark] uppercase italic group-hover:text-[--kallfu-plum]"
          >
            Violet Grown<span class="text-[--kallfu-rose] not-italic">.</span>
          </span>
        </a>

        <!-- Navegación Minimalista -->
        <nav
          class="hidden items-center space-x-10 text-[10px] font-bold tracking-[0.25em] text-[--kallfu-muted] uppercase lg:flex"
        >
          <a href="#concepto" class="kallfu-transition hover:text-[--kallfu-plum]">El Método</a>
          <a href="#alquimia" class="kallfu-transition hover:text-[--kallfu-plum]">Alquimia</a>
          <a href="#lookbook" class="kallfu-transition hover:text-[--kallfu-plum]">Lookbook</a>
          <a href="#planes" class="kallfu-transition hover:text-[--kallfu-plum]">Membresías</a>
        </nav>

        <!-- Acción de Alta Conversión -->
        <div class="flex items-center gap-4">
          <a
            href="https://wa.me/56912345678?text=Hola%20Violet Grown,%20me%20gustaría%20agendar%20un%20diagnóstico%20capilar%20en%20vuestro%20salón%20de%20Temuco."
            target="_blank"
            class="kallfu-transition flex h-fit items-center justify-center rounded-full bg-[--kallfu-plum] px-6 py-3 text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kallfu-lilac] hover:shadow-md"
          >
            Agendar Cita
          </a>

          <!-- Menú móvil sutil -->
          <button
            id="drawer-toggle"
            class="rounded-full border border-[--kallfu-border] bg-white p-2 text-[--kallfu-dark] focus:outline-none lg:hidden"
            aria-label="Abrir Menú"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                id="drawer-icon"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Cajón de navegación móvil -->
      <div
        id="mobile-drawer"
        class="absolute left-0 hidden w-full border-b border-[--kallfu-border] bg-[#FAF5F8] px-6 py-6 shadow-lg lg:hidden"
      >
        <div
          class="flex flex-col space-y-4 text-[10px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
        >
          <a href="#concepto" class="py-1 hover:text-[--kallfu-plum]">El Método</a>
          <a href="#alquimia" class="py-1 hover:text-[--kallfu-plum]">Alquimia</a>
          <a href="#lookbook" class="py-1 hover:text-[--kallfu-plum]">Lookbook</a>
          <a href="#planes" class="py-1 hover:text-[--kallfu-plum]">Membresías</a>
          <a
            href="https://wa.me/56912345678"
            class="mt-2 block rounded-full bg-[--kallfu-plum] py-3.5 text-center text-[10px] font-bold tracking-widest text-white uppercase"
            >Reservar Turno</a
          >
        </div>
      </div>
    </header>

    <!-- SECCIÓN HERO: Estructura Bento Grid Compacta de Alto Impacto -->
    <section class="mx-auto max-w-7xl px-6 py-16 sm:px-10">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
        <!-- Bento Box 1: Gran Título Editorial (Spans 8 cols on md+) -->
        <div
          class="bento-card flex h-full min-h-[340px] flex-col justify-between space-y-8 md:col-span-8"
        >
          <div class="space-y-4 text-left">
            <div
              class="inline-flex items-center gap-2 rounded-full bg-[--kallfu-lilac-light] px-3 py-1 text-[9px] font-bold tracking-[0.2em] text-[--kallfu-plum] uppercase"
            >
              ✨ DERMOESTÉTICA & SANACIÓN CAPILAR BOTÁNICA
            </div>
            <h1
              class="font-editorial text-4xl leading-[1.1] tracking-tight text-[--kallfu-dark] sm:text-6xl"
            >
              El cabello como <span class="font-normal text-[--kallfu-rose] italic"
                >espejo vital</span
              > de tu salud interna.
            </h1>
          </div>
          <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
            <a
              href="#planes"
              class="kallfu-transition flex h-fit items-center justify-center rounded-full bg-[--kallfu-plum] px-8 py-4 text-center text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kallfu-lilac] hover:shadow-md"
            >
              Ver Membresías
            </a>
            <a
              href="#alquimia"
              class="kallfu-transition flex h-fit items-center justify-center rounded-full border border-[--kallfu-border] bg-transparent bg-white/50 px-8 py-4 text-center text-[10px] font-bold tracking-widest text-[--kallfu-dark] uppercase hover:border-[--kallfu-dark]"
            >
              Explorar Alquimia Capilar
            </a>
          </div>
        </div>

        <!-- Bento Box 2: Showcase de Imagen Passepartout (Spans 4 cols on md+) -->
        <div class="bento-card flex min-h-[340px] flex-col justify-between p-4 md:col-span-4">
          <div
            class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-gray-100 bg-gray-50/50 p-1.5 md:aspect-[3/4]"
          >
            <img
              src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=600&q=80"
              alt="Hebra capilar reparada y brillante en Violet Grown Temuco"
              class="h-full w-full rounded-xl object-cover brightness-[1.01] saturate-[0.35]"
              onerror="this.onerror=null;this.src='https://placehold.co/400x500/FAF5F8/231B21?text=Kallfu+Hair'"
            />
          </div>
          <div
            class="flex items-center justify-between border-t border-[--kallfu-border] pt-3 text-left"
          >
            <div>
              <span
                class="block text-[8px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
                >Salón de Autor</span
              >
              <span class="font-editorial text-xs font-bold text-[--kallfu-dark] italic"
                >Av. Alemania, Temuco</span
              >
            </div>
            <span
              class="rounded-full bg-[--kallfu-lilac-light] px-3 py-1.5 text-[8px] font-bold tracking-wider text-[--kallfu-plum] uppercase"
              >Refugio Capilar</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN FILOSOFÍA: Línea de Tiempo del Spa en Formato Bento (Asimétrico y Original) -->
    <section id="concepto" class="border-t border-b border-[--kallfu-border] bg-white/30 py-16">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <div class="mx-auto mb-16 max-w-2xl space-y-3 text-center">
          <span
            class="block text-[10px] font-bold tracking-[0.25em] text-[--kallfu-lilac] uppercase"
            >EL RITUAL</span
          >
          <h2 class="font-editorial text-3xl text-[--kallfu-dark] sm:text-4xl">
            La Experiencia Violet Grown
          </h2>
          <p class="text-sm font-light text-[--kallfu-muted]">
            Diseñamos un recorrido de bienestar para que tu visita sea un momento de calma,
            desintoxicación e hidratación profunda.
          </p>
        </div>

        <!-- Bento Grid de la Experiencia -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <!-- Paso 1 (Spans 6) -->
          <div
            class="bento-card flex h-full min-h-[220px] flex-col justify-between space-y-6 hover:shadow-md md:col-span-6"
          >
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
              <span class="text-[9px] font-bold tracking-widest text-[--kallfu-rose] uppercase"
                >Fase de Entrada</span
              >
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-[--kallfu-lilac-light] text-xs font-bold text-[--kallfu-plum]"
                >1</span
              >
            </div>
            <div>
              <h3 class="font-editorial mb-2 text-xl font-bold text-[--kallfu-dark]">
                Aromaterapia & Bienvenida
              </h3>
              <p class="text-xs leading-relaxed font-light text-[--kallfu-muted]">
                Iniciamos cada ritual con masajes en los hombros e inhalación de aceites esenciales
                de lavanda y menta piperita. Calma el sistema nervioso, reduce los niveles de
                cortisol y prepara el folículo capilar.
              </p>
            </div>
          </div>

          <!-- Paso 2 (Spans 6) -->
          <div
            class="bento-card flex h-full min-h-[220px] flex-col justify-between space-y-6 hover:shadow-md md:col-span-6"
          >
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
              <span class="text-[9px] font-bold tracking-widest text-[--kallfu-rose] uppercase"
                >Fase Purificante</span
              >
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-[--kallfu-lilac-light] text-xs font-bold text-[--kallfu-plum]"
                >2</span
              >
            </div>
            <div>
              <h3 class="font-editorial mb-2 text-xl font-bold text-[--kallfu-dark]">
                Lavado con Agua de Lluvia
              </h3>
              <p class="text-xs leading-relaxed font-light text-[--kallfu-muted]">
                Lavamos tu cabello exclusivamente con agua de lluvia purificada y tratada mediante
                filtros de triple etapa. Al ser libre de sarro, cal y metales, limpia con suavidad y
                potencia el brillo.
              </p>
            </div>
          </div>

          <!-- Paso 3 (Spans 6) -->
          <div
            class="bento-card flex h-full min-h-[220px] flex-col justify-between space-y-6 hover:shadow-md md:col-span-6"
          >
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
              <span class="text-[9px] font-bold tracking-widest text-[--kallfu-rose] uppercase"
                >Fase de Alquimia</span
              >
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-[--kallfu-lilac-light] text-xs font-bold text-[--kallfu-plum]"
                >3</span
              >
            </div>
            <div>
              <h3 class="font-editorial mb-2 text-xl font-bold text-[--kallfu-dark]">
                Mezclador Botánico Nátivo
              </h3>
              <p class="text-xs leading-relaxed font-light text-[--kallfu-muted]">
                Formulamos tu mascarilla de hidratación o reparación mezclando extractos botánicos
                puros en tu presencia. Incorporamos aceite de avellano chileno, maqui antioxidante y
                queratina vegetal.
              </p>
            </div>
          </div>

          <!-- Paso 4 (Spans 6) -->
          <div
            class="bento-card flex h-full min-h-[220px] flex-col justify-between space-y-6 hover:shadow-md md:col-span-6"
          >
            <div class="flex items-center justify-between border-b border-gray-100 pb-3">
              <span class="text-[9px] font-bold tracking-widest text-[--kallfu-rose] uppercase"
                >Fase de Cierre</span
              >
              <span
                class="flex h-8 w-8 items-center justify-center rounded-full bg-[--kallfu-lilac-light] text-xs font-bold text-[--kallfu-plum]"
                >4</span
              >
            </div>
            <div>
              <h3 class="font-editorial mb-2 text-xl font-bold text-[--kallfu-dark]">
                Crioterapia Capilar a -16°C
              </h3>
              <p class="text-xs leading-relaxed font-light text-[--kallfu-muted]">
                Finalizamos sellando los nutrientes aplicados mediante planchas refrigeradoras
                criogénicas. El frío extremo obliga a la cutícula a compactarse, atrapando la
                hidratación y controlando el frizz.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA EXCLUSIVA: EL MEZCLADOR ALQUÍMICO CAPILAR (Bento Mixer) -->
    <section id="alquimia" class="mx-auto max-w-7xl px-6 py-16 sm:px-10">
      <div class="mx-auto mb-16 max-w-2xl space-y-3 text-center">
        <span class="block text-xs font-bold tracking-widest text-[--kallfu-plum] uppercase"
          >ALQUIMIA PERSONALIZADA</span
        >
        <h2 class="font-editorial text-3xl text-[--kallfu-dark] sm:text-4xl">
          El Mezclador de Activos
        </h2>
        <p class="text-sm font-light text-[--kallfu-muted]">
          Selecciona las condiciones específicas de tu cuero cabelludo y tu meta capilar para
          formular al instante tu ritual botánico personalizado.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
        <!-- Entrada de Alquimia (Spans 7) -->
        <div class="bento-card flex flex-col justify-between space-y-8 text-left md:col-span-7">
          <div class="flex items-center gap-3 border-b border-black/5 pb-4">
            <span class="text-2xl">🧪</span>
            <div>
              <span
                class="block text-[8px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
                >FORMULACIÓN EN TIEMPO REAL</span
              >
              <h3 class="font-editorial text-xl font-bold text-[--kallfu-dark]">
                Ingredientes Activos
              </h3>
            </div>
          </div>

          <!-- Paso 1: Tipo de Cuero Cabelludo -->
          <div class="space-y-3">
            <span
              class="block text-[10px] font-extrabold tracking-widest text-[--kallfu-muted] uppercase"
              >1. Diagnóstico del Cuero Cabelludo</span
            >
            <div class="grid grid-cols-3 gap-3">
              <button
                onclick="selectScalp('seco', this)"
                class="scalp-btn kallfu-transition rounded-2xl border border-[--kallfu-plum]/10 bg-[--kallfu-lilac-light] py-3 text-xs font-bold text-[--kallfu-plum] select-none"
              >
                Seco
              </button>
              <button
                onclick="selectScalp('graso', this)"
                class="scalp-btn kallfu-transition rounded-2xl border border-[--kallfu-border] bg-[#FAF5F8] py-3 text-xs font-bold text-[--kallfu-muted] select-none hover:border-[--kallfu-plum]"
              >
                Graso
              </button>
              <button
                onclick="selectScalp('sensible', this)"
                class="scalp-btn kallfu-transition rounded-2xl border border-[--kallfu-border] bg-[#FAF5F8] py-3 text-xs font-bold text-[--kallfu-muted] select-none hover:border-[--kallfu-plum]"
              >
                Sensible
              </button>
            </div>
          </div>

          <!-- Paso 2: Meta del Cabello -->
          <div class="space-y-3">
            <span
              class="block text-[10px] font-extrabold tracking-widest text-[--kallfu-muted] uppercase"
              >2. Meta de la Hebra</span
            >
            <div class="grid grid-cols-3 gap-3">
              <button
                onclick="selectGoal('hidratacion', this)"
                class="goal-btn kallfu-transition rounded-xl border border-[--kallfu-plum]/10 bg-[--kallfu-lilac-light] py-3 text-xs font-bold text-[--kallfu-plum] select-none"
              >
                Hidratar
              </button>
              <button
                onclick="selectGoal('fuerza', this)"
                class="goal-btn kallfu-transition rounded-xl border border-[--kallfu-border] bg-[#FAF5F8] py-3 text-xs font-bold text-[--kallfu-muted] select-none hover:border-[--kallfu-plum]"
              >
                Fortalecer
              </button>
              <button
                onclick="selectGoal('brillo', this)"
                class="goal-btn kallfu-transition rounded-xl border border-[--kallfu-border] bg-[#FAF5F8] py-3 text-xs font-bold text-[--kallfu-muted] select-none hover:border-[--kallfu-plum]"
              >
                Dar Brillo
              </button>
            </div>
          </div>
        </div>

        <!-- Salida / Resultados de Alquimia (Spans 5) -->
        <div
          class="bento-card flex min-h-[380px] flex-col justify-between border border-[--kallfu-border] bg-[#FAF5F8] text-center md:col-span-5"
        >
          <div class="space-y-4">
            <span class="block text-[8px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
              >RECETA BOTÁNICA RECOMENDADA</span
            >
            <span
              class="font-editorial block text-2xl leading-tight font-bold tracking-tight text-[--kallfu-plum]"
              id="recipe-name-display">Elíxir de Avellano & Ácido Hialurónico</span
            >
            <p
              class="mx-auto max-w-xs text-[11px] font-light text-[--kallfu-muted]"
              id="recipe-desc-display"
            >
              Diseñado especialmente para cuero cabelludo seco que requiere restaurar la barrera
              lipídica y retener humedad natural.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4 border-t border-black/5 pt-4 text-left">
            <div>
              <span
                class="block text-[8px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
                >Valor Estimado</span
              >
              <span
                class="mt-0.5 block text-xs font-extrabold text-[--kallfu-dark]"
                id="recipe-price-display">$35.000 CLP</span
              >
            </div>
            <div>
              <span
                class="block text-[8px] font-bold tracking-widest text-[--kallfu-muted] uppercase"
                >Duración Ritual</span
              >
              <span
                class="mt-0.5 block text-xs font-extrabold text-[--kallfu-dark]"
                id="recipe-time-display">75 Minutos</span
              >
            </div>
          </div>

          <a
            id="alchemy-cta"
            href="https://wa.me/56912345678?text=Hola%20Violet Grown,%20he%20formulado%20un%20Elíxir%20de%20Avellano%20y%20Hialurónico%20para%20cuero%20cabelludo%20seco%20en%20vuestro%20mezclador%20alquímico."
            target="_blank"
            class="kutral-transition flex w-full items-center justify-center gap-2 rounded-full bg-[--kallfu-plum] py-4 text-center text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kallfu-lilac]"
          >
            <span>Reservar esta Fórmula</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA: EL LOOKBOOK DE TENDENCIAS CAPILARES (Bento Spotlight) -->
    <section id="lookbook" class="border-t border-[--kallfu-border] bg-white py-16">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <div class="mx-auto mb-16 max-w-2xl space-y-3 text-center">
          <span class="block text-xs font-bold tracking-widest text-[--kallfu-rose] uppercase"
            >INSPIRACIÓN EDITORIAL</span
          >
          <h2 class="font-editorial text-3xl text-[--kallfu-dark] sm:text-4xl">
            Lookbook de Tendencias
          </h2>
          <p class="text-sm font-light text-[--kallfu-muted]">
            Explora cortes de diseño y efectos de color de autor especialmente seleccionados para el
            sur de Chile.
          </p>

          <!-- Pestañas de Lookbook (Interacciones Corregidas) -->
          <div class="flex flex-wrap justify-center gap-2 pt-6">
            <button
              onclick="switchLookbookTab('ondas', this)"
              class="lookbook-tab-btn kutral-transition rounded-full bg-[--kallfu-plum] px-5 py-2.5 text-[10px] font-bold tracking-widest text-white uppercase"
            >
              Ondas Glaciales
            </button>
            <button
              onclick="switchLookbookTab('shag', this)"
