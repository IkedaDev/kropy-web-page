---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Papas Criminales | Pollo Frito y Papas Cargadas en Temuco";
const description = "Papas Criminales | Pollo Frito y Papas Cargadas en Temuco";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Estilo chunky / cómic urbano -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Lexend:wght@400;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-heavy {
        font-family: "Bungee", cursive;
      }
      body {
        font-family: "Lexend", sans-serif;
      }
      /* Efecto de sombra neo-brutalista plana */
      .brutal-shadow {
        shadow: 4px 4px 0px 0px rgba(0, 0, 0, 1);
      }
    </style>
  </head>
  <body class="bg-yellow-400 text-black antialiased selection:bg-black selection:text-white">
    <!-- MARQUESINA DINÁMICA (TEXTO CORRIDO) -->
    <div
      class="font-heavy overflow-hidden border-b-4 border-black bg-black py-3 text-sm tracking-widest whitespace-nowrap text-yellow-400"
    >
      <div class="inline-block animate-bounce px-4">
        ⚡ EL BAJÓN MÁS BUSCADO DE LA ARAUCANÍA ⚡ SPICY CHICKEN ⚡ PAPAS GIGANTES ⚡ EL BAJÓN MÁS
        BUSCADO DE LA ARAUCANÍA ⚡
      </div>
    </div>

    <!-- NAVBAR HEROICA -->
    <header class="sticky top-0 z-50 border-b-4 border-black bg-white">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4">
        <a
          href="#"
          class="-rotate-1 transform border-4 border-black bg-red-600 px-4 py-2 text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-transform hover:rotate-0"
        >
          <span class="font-heavy block text-xl tracking-tight">PAPAS</span>
          <span
            class="font-heavy block border-t-2 border-black bg-yellow-400 text-center text-xs tracking-widest text-black"
            >CRIMINALES</span
          >
        </a>

        <nav class="hidden items-center gap-6 text-xs font-black tracking-wider uppercase md:flex">
          <a
            href="#delito"
            class="border-2 border-black bg-yellow-400 px-3 py-1.5 transition-colors hover:bg-black hover:text-yellow-400"
            >El Menú</a
          >
          <a
            href="#combos"
            class="border-2 border-black bg-yellow-400 px-3 py-1.5 transition-colors hover:bg-black hover:text-yellow-400"
            >Los Baldes</a
          >
          <a
            href="#ZonadeArresto"
            class="border-2 border-black bg-yellow-400 px-3 py-1.5 transition-colors hover:bg-black hover:text-yellow-400"
            >¿Dónde Caer?</a
          >
        </nav>

        <div>
          <a
            href="https://wa.me/56955556666?text=Quiero%20entregarme%20al%20sabor%20de%20Papas%20Criminales"
            target="_blank"
            rel="noopener noreferrer"
            class="block border-4 border-black bg-black px-6 py-3 text-center text-xs font-black tracking-widest text-yellow-400 uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-colors hover:bg-red-600 hover:text-white"
          >
            Pide Delivery
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO POP-ART -->
      <section class="relative border-b-4 border-black bg-red-600 py-16 text-white lg:py-24">
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 md:grid-cols-2">
          <div class="space-y-6 text-center md:text-left">
            <h1
              class="font-heavy inline-block -rotate-1 transform border-4 border-black bg-black p-4 text-4xl leading-none tracking-tight text-yellow-400 uppercase shadow-[6px_6px_0px_0px_rgba(255,255,255,1)] sm:text-5xl lg:text-6xl"
            >
              Sabor criminal al paso
            </h1>
            <p class="text-lg leading-snug font-bold text-white drop-shadow-md md:text-xl">
              ¿Cansado de las porciones tacañas? En Temuco cocinamos sin piedad. Crujientes tenders
              de pollo marinados por 24 horas y montañas de papas fritas rústicas con las salsas más
              adictivas del sur.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#delito"
                class="transform border-4 border-black bg-yellow-400 px-8 py-4 text-sm font-black tracking-wider text-black uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all hover:-translate-y-1 hover:bg-white"
              >
                Ver Evidencia (Menú)
              </a>
              <a
                href="#ZonadeArresto"
                class="border-4 border-black bg-black px-8 py-4 text-sm font-black tracking-wider text-yellow-400 uppercase shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] transition-all hover:bg-zinc-900"
              >
                Ver Mapa de Retiro
              </a>
            </div>
          </div>

          <div class="flex justify-center">
            <div
              class="max-w-sm rotate-2 transform border-4 border-black bg-white p-4 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]"
            >
              <img
                src="https://images.unsplash.com/photo-1573080496219-bb080dd4f877?q=80&w=600&auto=format&fit=crop"
                alt="Balde gigante de papas fritas cargadas con tocino picado y queso derretido"
                class="h-72 w-full border-4 border-black object-cover"
              />
              <p class="font-heavy mt-4 text-center text-lg tracking-wider text-black uppercase">
                ⚠️ PORCIÓN INDECENTE
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN BALDES / COMBOS MONSTRUOSOS -->
      <section id="combos" class="mx-auto max-w-7xl px-4 py-16">
        <div class="mx-auto mb-12 max-w-2xl space-y-2 text-center">
          <span class="bg-black px-4 py-1 text-xs font-black tracking-widest text-white uppercase"
            >Formatos de Alto Calibre</span
          >
          <h2 class="font-heavy text-3xl tracking-wide uppercase sm:text-4xl">
            Nuestros Baldes de Combate
          </h2>
        </div>

        <div class="grid gap-8 md:grid-cols-2">
          <!-- Balde 1 -->
          <div
            class="flex flex-col items-start justify-between border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="w-full space-y-4">
              <div
                class="flex -rotate-1 transform items-center justify-between border-2 border-black bg-yellow-400 p-2"
              >
                <h3 class="font-heavy text-xl tracking-wide uppercase">
                  Balde "Culpable Absoluto"
                </h3>
                <span
                  class="border border-black bg-black px-3 py-1 text-sm font-black text-yellow-400"
                  >$11.990</span
                >
              </div>
              <p class="text-sm leading-relaxed font-bold text-zinc-700">
                8 Tenders de pechuga de pollo ultra crujientes + Cama gigante de papas fritas
                familiares + 3 salsas artesanales a elección (Alioli, Barbacoa ahumada y Mayo-Pica).
              </p>
            </div>
            <a
              href="https://wa.me/56955556666?text=Quiero%20el%20Balde%20Culpable%20Absoluto"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 block w-full border-4 border-black bg-red-600 py-4 text-center text-xs font-black tracking-widest text-white uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-colors hover:bg-black hover:text-yellow-400"
            >
              Ordenar este Delito
            </a>
          </div>

          <!-- Balde 2 -->
          <div
            class="flex flex-col items-start justify-between border-4 border-black bg-white p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="w-full space-y-4">
              <div
                class="flex rotate-1 transform items-center justify-between border-2 border-black bg-red-600 p-2 text-white"
              >
                <h3 class="font-heavy text-xl tracking-wide uppercase">Papas "Prófugas XL"</h3>
                <span
                  class="border border-black bg-black px-3 py-1 text-sm font-black text-yellow-400"
                  >$8.500</span
                >
              </div>
              <p class="text-sm leading-relaxed font-bold text-zinc-700">
                Montaña de papas fritas rústicas bañadas en doble porción de salsa de queso cheddar
                inyectada, lluvia de tocino crocante deshidratado y cebollín fresco de la zona.
              </p>
            </div>
            <a
              href="https://wa.me/56955556666?text=Quiero%20las%20Papas%20Profugas%20XL"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 block w-full border-4 border-black bg-black py-4 text-center text-xs font-black tracking-widest text-yellow-400 uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-colors hover:bg-red-600 hover:text-white"
            >
              Ordenar este Delito
            </a>
          </div>
        </div>
      </section>

      <!-- LA CARTA EN FORMATO LISTA DE CARGOS -->
      <section id="delito" class="border-t-4 border-black bg-white py-16">
        <div class="mx-auto max-w-7xl px-4">
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2
              class="font-heavy inline-block border-4 border-black bg-yellow-400 px-4 py-2 text-3xl uppercase"
            >
              El Menú del Crimen
            </h2>
            <p class="mt-3 text-sm font-bold text-zinc-600">
              Disponibles de forma individual para armar tu propio combo al paso.
            </p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Ítem 1 -->
            <div
              class="flex flex-col justify-between border-4 border-black bg-yellow-400/20 p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-base font-black text-black uppercase">
                    Chicken Burger Prontuario
                  </h4>
                  <span class="font-heavy text-sm whitespace-nowrap text-red-600">$5.400</span>
                </div>
                <p class="text-xs leading-relaxed font-bold text-zinc-600">
                  Pechuga de pollo frito crujiente, lechuga hidropónica, pepinillos dulces y nuestra
                  icónica salsa criminal en pan brioche sellado con mantequilla.
                </p>
              </div>
              <a
                href="https://wa.me/56955556666?text=Quiero%20la%20Burger%20Prontuario"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 border-2 border-black bg-black py-2 text-center text-[11px] font-black tracking-wider text-white uppercase transition-colors hover:bg-red-600"
                >Pedir Ahora</a
              >
            </div>

            <!-- Ítem 2 -->
            <div
              class="flex flex-col justify-between border-4 border-black bg-yellow-400/20 p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-base font-black text-black uppercase">
                    Papas Criminales Individuales
                  </h4>
                  <span class="font-heavy text-sm whitespace-nowrap text-red-600">$3.200</span>
                </div>
                <p class="text-xs leading-relaxed font-bold text-zinc-600">
                  Nuestra versión clásica. Papas fritas corte grueso con sazón especial de la casa
                  de la frontera (especias secretas no picantes).
                </p>
              </div>
              <a
                href="https://wa.me/56955556666?text=Quiero%20Papas%20Individuales"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 border-2 border-black bg-black py-2 text-center text-[11px] font-black tracking-wider text-white uppercase transition-colors hover:bg-red-600"
                >Pedir Ahora</a
              >
            </div>

            <!-- Ítem 3 -->
            <div
              class="flex flex-col justify-between border-4 border-black bg-yellow-400/20 p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
            >
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="text-base font-black text-black uppercase">Tenders de Pollo x5</h4>
                  <span class="font-heavy text-sm whitespace-nowrap text-red-600">$4.900</span>
                </div>
                <p class="text-xs leading-relaxed font-bold text-zinc-600">
                  5 Tiras de pollo seleccionadas y rebozadas a mano con el crujido perfecto
                  garantizado. Incluye una salsa a elección.
                </p>
              </div>
              <a
                href="https://wa.me/56955556666?text=Quiero%20Tenders%20x5"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 border-2 border-black bg-black py-2 text-center text-[11px] font-black tracking-wider text-white uppercase transition-colors hover:bg-red-600"
                >Pedir Ahora</a
              >
            </div>
          </div>
        </div>
      </section>

      <!-- LOCALIZACIÓN / RETIRO (ZONA DE ARRESTO) -->
      <section id="ZonadeArresto" class="mx-auto max-w-7xl px-4 py-16">
        <div
          class="grid items-center gap-12 border-4 border-black bg-white p-8 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] md:grid-cols-2 lg:p-12"
        >
          <div class="space-y-6">
            <h2 class="font-heavy text-3xl tracking-tight text-red-600 uppercase">
              ¿Dónde entregarse al sabor?
            </h2>
            <p class="leading-relaxed font-bold text-zinc-800">
              Estamos ubicados en pleno barrio universitario y gastronómico de Temuco. Si andas
              dando vueltas por San Martín, pasa caminando a retirar tu balde ardiendo.
            </p>

            <div class="space-y-4 text-sm font-bold text-black">
              <div class="-rotate-1 transform border-2 border-black bg-yellow-400 p-4">
                <p class="font-black uppercase">📍 Dirección del Almacén:</p>
                <p class="mt-1 text-xs text-zinc-900">
                  Av. San Martín 01540 (Cerca de los locales nocturnos), Temuco, Región de la
                  Araucanía.
                </p>
              </div>
              <div class="rotate-1 transform border-2 border-black bg-black p-4 text-white">
                <p class="font-black text-yellow-400 uppercase">🕒 Turnos de Guardia:</p>
                <p class="mt-1 text-xs text-zinc-300">Domingo a Jueves: 12:30 a 23:30 hrs.</p>
                <p class="text-xs text-yellow-400">
                  Viernes y Sábado: 12:30 a 02:00 hrs (Perfecto para antes o después del carrete).
                </p>
              </div>
            </div>

            <div class="pt-2">
              <a
                href="tel:+56955556666"
                class="inline-block border-2 border-black bg-red-600 px-4 py-2 text-xs font-black tracking-wider text-white uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-colors hover:bg-black hover:text-white"
              >
                📞 Llamar por Teléfono Directo: +56 9 5555 6666
              </a>
            </div>
          </div>

          <!-- Simulación de mapa con la estética Neo-Brutalista -->
          <div
            class="border-4 border-black bg-black p-2 shadow-[6px_6px_0px_0px_rgba(239,68,68,1)]"
          >
            <div
              class="relative flex h-64 flex-col items-center justify-center overflow-hidden border-2 border-black bg-yellow-400 p-6 text-center"
            >
              <span class="mb-2 animate-bounce text-4xl">🎯</span>
              <h4 class="font-heavy text-lg tracking-wide text-black uppercase">
                Sector Av. San Martín
              </h4>
              <p class="mt-1 mb-4 max-w-xs text-xs font-bold text-zinc-800">
                Reemplaza este recuadro por un mapa responsivo de Google Maps para potenciar el SEO
                local del negocio.
              </p>
              <a
                href="https://maps.google.com"
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-black bg-black px-4 py-2 text-xs font-black tracking-widest text-yellow-400 uppercase transition-colors hover:bg-white hover:text-black"
              >
                Ver Ubicación Satelital
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER NEO-BRUTALISTA -->
    <footer class="border-t-4 border-black bg-black py-12 text-xs font-bold text-zinc-400">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 md:flex-row"
      >
        <div class="space-y-1 text-center md:text-left">
          <p class="font-heavy text-xl tracking-wide text-yellow-400">PAPAS CRIMINALES</p>
          <p class="text-[11px] text-zinc-500">
            &copy; 2026 Todos los derechos reservados. Temuco, Chile.
          </p>
        </div>
        <div class="space-y-1 text-center tracking-wider text-zinc-500 uppercase md:text-right">
          <p class="text-zinc-300">Diseñado con alta tracción para la Región de la Araucanía.</p>
          <p class="text-[10px]">
            Código limpio listo para optimización y velocidad móvil instantánea.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
