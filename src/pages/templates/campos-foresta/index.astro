<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO de Alta Relevancia Agropecuaria Regional -->
    <title>Campos de La Frontera | Distribuidora de Productos Agrícolas en Temuco</title>
    <meta
      name="description"
      content="Productos agrícolas seleccionados directo del campo a tu mesa o negocio en Temuco. Papas de Carahue, hortalizas frescas, miel multifloral y harinas artesanales de la Araucanía. Despacho mayorista y detalle."
    />
    <meta
      name="keywords"
      content="productos agrícolas temuco, venta de papas temuco, hortalizas por mayor la araucania, verduras a domicilio temuco, sacos de harina temuco, productor agricola temuco, feria pinto delivery"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.camposdelafrontera.cl" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Campos de La Frontera | Frutos y Verduras de la Araucanía" />
    <meta
      property="og:description"
      content="Trazabilidad, frescura y precios justos directo del productor local. Despachos programados en Temuco y Padre Las Casas."
    />
    <meta
      property="og:image"
      content="https://images.unsplash.com/photo-1592417817098-8f3d6eb18865?q=80&w=800&auto=format&fit=crop"
    />
    <meta property="og:url" content="https://www.camposdelafrontera.cl" />

    <!-- Importación de Tailwind CSS solicitada -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Combinación Orgánica y Corporativa -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;700;800&family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,400&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-organic {
        font-family: "Fraunces", serif;
      }
      body {
        font-family: "Albert Sans", sans-serif;
      }
    </style>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <!-- CINTA DE DESPACHO PROGRAMADO -->
    <div
      class="border-b border-emerald-900 bg-emerald-950 px-4 py-2 text-center text-xs font-medium tracking-wide text-emerald-100"
    >
      🚜 Despacho gratuito en Temuco urbano por compras sobre $30.000. Rutas los Martes y Jueves.
    </div>

    <!-- NAVBAR CORPORATIVA AGRARIA -->
    <header class="sticky top-0 z-50 border-b border-stone-200 bg-white/80 backdrop-blur-md">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="#" class="group flex items-center gap-2">
          <div
            class="font-organic flex h-10 w-10 items-center justify-center rounded-full bg-emerald-800 text-xl text-white shadow-inner"
          >
            🌾
          </div>
          <div class="flex flex-col">
            <span class="font-organic text-lg leading-none font-bold text-emerald-900 md:text-xl"
              >Campos</span
            >
            <span class="mt-0.5 text-[10px] font-bold tracking-widest text-stone-500 uppercase"
              >De La Frontera</span
            >
          </div>
        </a>

        <nav
          class="hidden items-center gap-8 text-xs font-bold tracking-wider text-stone-600 uppercase md:flex"
        >
          <a href="#valores" class="transition-colors hover:text-emerald-800">Origen</a>
          <a href="#catalogo" class="transition-colors hover:text-emerald-800">Productos del Mes</a>
          <a href="#mayorista" class="transition-colors hover:text-emerald-800">Canal Mayorista</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56933334444?text=Hola%20Campos%20de%20la%20Frontera,%20solicito%20el%20catalogo%20de%20precios%20actualizado"
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-lg bg-emerald-800 px-5 py-3 text-center text-xs font-bold tracking-wider text-white uppercase shadow-md transition-colors hover:bg-emerald-900"
          >
            Descargar Catálogo
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO ECO-MODERNO -->
      <section
        class="relative overflow-hidden border-b border-stone-200 bg-gradient-to-b from-stone-100 to-stone-50 py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
          <div class="space-y-6 text-center md:text-left">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800"
            >
              🌱 Cosechas de la Región de la Araucanía
            </div>
            <h1 class="font-organic text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl">
              Alimentos honestos, frescos y de <span class="font-normal text-emerald-800 italic"
                >nuestra tierra</span
              >.
            </h1>
            <p class="mx-auto max-w-lg text-sm leading-relaxed text-stone-600 md:mx-0 md:text-base">
              Abastecemos a familias, restaurantes y verdulerías de Temuco con productos de primera
              categoría. Trazabilidad garantizada, sin intermediarios innecesarios y apoyando la
              agricultura familiar local.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#catalogo"
                class="rounded-xl bg-emerald-800 px-8 py-4 text-center text-xs font-bold tracking-wider text-white uppercase shadow-lg shadow-emerald-900/10 transition-all hover:bg-emerald-900"
              >
                Ver Productos Disponibles
              </a>
              <a
                href="#mayorista"
                class="rounded-xl border border-stone-300 bg-white px-8 py-4 text-center text-xs font-bold tracking-wider text-emerald-900 uppercase shadow-sm transition-all hover:bg-stone-100"
              >
                Cotización Mayorista
              </a>
            </div>
          </div>

          <div class="flex justify-center">
            <div class="relative w-full max-w-md">
              <!-- Círculo decorativo natural de fondo -->
              <div class="absolute inset-0 rounded-full bg-emerald-800/5 blur-2xl filter"></div>
              <img
                src="https://images.unsplash.com/photo-1592417817098-8f3d6eb18865?q=80&w=600&auto=format&fit=crop"
                alt="Cajón rústico de madera lleno de vegetales frescos y orgánicos cosechados del campo"
                class="relative z-10 h-80 w-full rounded-3xl border border-stone-200 object-cover shadow-xl lg:h-96"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN DIFERENCIADORES TÉCNICOS -->
      <section id="valores" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <div class="space-y-3 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
            <span class="block text-2xl">🚜</span>
            <h3 class="text-base font-bold tracking-wide text-stone-900 uppercase">
              100% Producción Local
            </h3>
            <p class="text-xs leading-relaxed text-stone-500">
              Fomentamos el desarrollo rural de comunas aledañas como Vilcún, Lautaro, Freire y
              Carahue, trayendo lo mejor de la Araucanía a la ciudad.
            </p>
          </div>
          <div class="space-y-3 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
            <span class="block text-2xl">📦</span>
            <h3 class="text-base font-bold tracking-wide text-stone-900 uppercase">
              Cadenas de Frío Controladas
            </h3>
            <p class="text-xs leading-relaxed text-stone-500">
              Cuidamos cada etapa de manipulación y transporte para asegurar que hortalizas y frutos
              no pierdan sus propiedades nutricionales.
            </p>
          </div>
          <div
            class="space-y-3 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm sm:col-span-2 lg:col-span-1"
          >
            <span class="block text-2xl">⚖️</span>
            <h3 class="text-base font-bold tracking-wide text-stone-900 uppercase">
              Pesaje Honesto Garantizado
            </h3>
            <p class="text-xs leading-relaxed text-stone-500">
              Sin sorpresas en tus despachos. Pesaje digital certificado tanto en formatos
              minoristas como en sacos tradicionales de gran volumen.
            </p>
          </div>
        </div>
      </section>

      <!-- CATÁLOGO / GRILLA DE PRODUCTOS -->
      <section id="catalogo" class="border-y border-stone-200 bg-stone-100 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mb-12 flex flex-col justify-between md:flex-row md:items-end">
            <div class="max-w-md text-center md:text-left">
              <span class="text-xs font-bold tracking-widest text-emerald-800 uppercase"
                >Disponibilidad de Temporada</span
              >
              <h2 class="font-organic mt-1 text-3xl text-stone-900">
                Cosechas Listas para Despacho
              </h2>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Producto 1 -->
            <div
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all hover:shadow-md"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1518977676601-b53f82aba655?q=80&w=500&auto=format&fit=crop"
                  alt="Saco de Papas Seleccionadas de Carahue"
                  class="h-48 w-full object-cover"
                />
                <div class="space-y-2 p-6">
                  <div class="flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-bold text-stone-900">
                      Saco de Papas Premium (Carahue)
                    </h4>
                    <span class="text-base font-bold whitespace-nowrap text-emerald-800"
                      >$14.500</span
                    >
                  </div>
                  <p class="text-xs leading-relaxed text-stone-500">
                    Formato malla de 25kg. Papa rosada de tamaño uniforme, limpia y de excelente
                    comportamiento para preparaciones comerciales u hogareñas.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56933334444?text=Hola!%20Me%20interesa%20encargar%20Sacos%20de%20Papas%20Premium"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-stone-200 bg-stone-50 py-3 text-center text-xs font-bold tracking-wider text-stone-700 uppercase transition-colors hover:bg-emerald-800 hover:text-white"
                >
                  Cotizar / Solicitar
                </a>
              </div>
            </div>

            <!-- Producto 2 -->
            <div
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all hover:shadow-md"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1587486913049-53fc88980cfc?q=80&w=500&auto=format&fit=crop"
                  alt="Miel Multifloral de la Araucania"
                  class="h-48 w-full object-cover"
                />
                <div class="space-y-2 p-6">
                  <div class="flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-bold text-stone-900">Miel Multifloral Nativa 1Kg</h4>
                    <span class="text-base font-bold whitespace-nowrap text-emerald-800"
                      >$6.800</span
                    >
                  </div>
                  <p class="text-xs leading-relaxed text-stone-500">
                    Miel 100% cruda de apiarios ubicados en la precordillera de Curacautín. Sin
                    azúcar añadida, textura cremosa y aroma intenso floral.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56933334444?text=Hola!%20Me%20interesa%20encargar%20Miel%20Multifloral%20Nativa"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-stone-200 bg-stone-50 py-3 text-center text-xs font-bold tracking-wider text-stone-700 uppercase transition-colors hover:bg-emerald-800 hover:text-white"
                >
                  Cotizar / Solicitar
                </a>
              </div>
            </div>

            <!-- Producto 3 -->
            <div
              class="flex flex-col justify-between overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all hover:shadow-md"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1509440159596-0249088772ff?q=80&w=500&auto=format&fit=crop"
                  alt="Harina Integral Molida en Piedra"
                  class="h-48 w-full object-cover"
                />
                <div class="space-y-2 p-6">
                  <div class="flex items-baseline justify-between gap-2">
                    <h4 class="text-base font-bold text-stone-900">
                      Harina Integral de Trigo (Saco 10Kg)
                    </h4>
                    <span class="text-base font-bold whitespace-nowrap text-emerald-800"
                      >$9.200</span
                    >
                  </div>
                  <p class="text-xs leading-relaxed text-stone-500">
                    Molienda en piedra artesanal que conserva el germen y salvado del trigo. Ideal
                    para panaderías de masa madre y repostería saludable local.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56933334444?text=Hola!%20Me%20interesa%20encargar%20Sacos%20de%20Harina%20Integral"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full rounded-xl border border-stone-200 bg-stone-50 py-3 text-center text-xs font-bold tracking-wider text-stone-700 uppercase transition-colors hover:bg-emerald-800 hover:text-white"
                >
                  Cotizar / Solicitar
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN DE SECTOR COMERCIAL / MAYORISTA -->
      <section id="mayorista" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div
          class="grid items-center gap-12 rounded-3xl border border-emerald-900 bg-emerald-950 p-8 text-white lg:grid-cols-2 lg:p-12"
        >
          <div class="space-y-6">
            <span class="block text-xs font-bold tracking-widest text-emerald-400 uppercase"
              >Distribución B2B / Locales comerciales</span
            >
            <h2 class="font-organic text-3xl text-emerald-50">
              ¿Abasteces un Minimarket, Restaurant o Verdulería?
            </h2>
            <p class="text-sm leading-relaxed text-emerald-200">
              Creamos planes de entrega periódica con precios volumétricos altamente competitivos
              para el comercio establecido en la Región de la Araucanía. Asegura stock permanente
              durante todo el año fiscal con facturación electrónica inmediata.
            </p>
            <ul class="space-y-3 text-xs font-semibold tracking-wider text-emerald-100 uppercase">
              <li class="flex items-center gap-3">
                <span class="text-emerald-400">✓</span> Precios especiales por pallets completos o mallas
                mayoristas.
              </li>
              <li class="flex items-center gap-3">
                <span class="text-emerald-400">✓</span> Factura o guía de despacho digital integrada para
                contabilidad.
              </li>
              <li class="flex items-center gap-3">
                <span class="text-emerald-400">✓</span> Despacho prioritario directo en bodegas comerciales
                de Temuco.
              </li>
            </ul>
          </div>

          <div class="space-y-4 rounded-2xl bg-white p-8 text-stone-900 shadow-xl">
            <h3 class="text-base font-bold tracking-wide text-stone-900 uppercase">
              Solicitud de Cuenta Comercial
            </h3>
            <p class="text-xs text-stone-500">
              Déjanos tus requerimientos de volumen y un ejecutivo comercial te enviará la planilla
              de precios mayoristas en menos de 2 horas.
            </p>

            <form action="https://wa.me/56933334444" method="GET" target="_blank" class="space-y-3">
              <input
                type="hidden"
                name="text"
                value="Hola, requiero información y precios de la sección comercial mayorista."
              />
              <div class="space-y-1">
                <label class="text-[10px] font-bold tracking-widest text-stone-400 uppercase"
                  >Razón Social / Nombre</label
                >
                <input
                  type="text"
                  placeholder="Ej: Verdulería El Campo"
                  required
                  class="w-full rounded-lg border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-medium focus:border-emerald-800 focus:outline-none"
                />
              </div>
              <div class="space-y-1">
                <label class="text-[10px] font-bold tracking-widest text-stone-400 uppercase"
                  >Producto de Mayor Interés</label
                >
                <select
                  class="w-full rounded-lg border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-medium text-stone-600 focus:border-emerald-800 focus:outline-none"
                >
                  <option>Papas por Mayor (Sacos)</option>
                  <option>Hortalizas de Temporada</option>
                  <option>Harinas e Insumos Secos</option>
                  <option>Pedidos Mixtos Frecuentes</option>
                </select>
              </div>
              <button
                type="submit"
                class="w-full rounded-lg bg-emerald-800 py-3 text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all hover:bg-emerald-900"
              >
                Contactar con Ventas Mayoristas
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- UBICACIÓN LOGÍSTICA / SEO LOCAL MAP -->
      <section
        class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 lg:px-8"
      >
        <div class="space-y-6">
          <h3 class="font-organic text-2xl text-stone-900">Centro de Acopio y Despacho</h3>
          <p class="text-sm leading-relaxed text-stone-600">
            Nuestras bodegas de operaciones estratégicas permiten un flujo logístico ágil hacia
            todas las macrozonas de Temuco, Padre Las Casas, Labranza y la salida norte/sur por la
            Ruta 5.
          </p>
          <div class="space-y-4 text-xs font-semibold tracking-wider text-stone-700 uppercase">
            <div class="flex items-start gap-3">
              <span class="text-lg">📍</span>
              <div>
                <p class="font-bold text-stone-900">Oficina de Coordinación:</p>
                <p class="mt-0.5 font-normal text-stone-500 normal-case">
                  Camino Viejo a Cajón KM 2.5, Temuco, Región de la Araucanía.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-lg">🕒</span>
              <div>
                <p class="font-bold text-stone-900">Horarios de Carga y Coordinación:</p>
                <p class="mt-0.5 font-normal text-stone-500 normal-case">
                  Lunes a Viernes: 08:00 a 17:30 hrs.
                </p>
                <p class="font-normal text-stone-500 normal-case">
                  Sábados: 08:30 a 13:00 hrs (Solo retiro de pedidos agendados).
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Simulación Limpia de Mapa Corporativo -->
        <div class="rounded-2xl border border-stone-200 bg-white p-2 shadow-sm">
          <div
            class="relative flex h-64 flex-col items-center justify-center overflow-hidden rounded-xl bg-stone-50 p-6 text-center"
          >
            <div
              class="absolute inset-0 bg-[radial-gradient(#065f46_1px,transparent_1px)] [background-size:14px_14px] opacity-10"
            >
            </div>
            <span class="mb-2 text-3xl">🗺️</span>
            <h4 class="font-organic text-lg text-stone-800">Conectividad Ruta 5 Sur</h4>
            <p class="mt-1 mb-4 max-w-xs text-[11px] text-stone-400">
              Incrusta el Iframe de Google Maps corporativo aquí para consolidar las métricas de SEO
              Local y geolocalización.
            </p>
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-emerald-800 px-5 py-2.5 text-[10px] font-bold tracking-wider text-white uppercase shadow-sm transition-colors hover:bg-emerald-900"
            >
              Ver Mapa de Cobertura Logística
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER INSTITUCIONAL -->
    <footer class="border-t border-stone-200 bg-white py-12 text-xs font-medium text-stone-500">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8"
      >
        <div class="space-y-1 text-center sm:text-left">
          <p class="font-organic text-xl font-bold text-emerald-950">Campos de La Frontera</p>
          <p>&copy; 2026 Abastecimiento Sostenible. Todos los derechos reservados.</p>
        </div>
        <div
          class="space-y-1 text-center text-[10px] font-bold tracking-widest text-stone-400 uppercase sm:text-right"
        >
          <p>Desarrollo estricto bajo estándares HTML5 / Tailwind CSS semántico.</p>
          <p class="font-normal text-stone-400 normal-case">
            Temuco, Región de la Araucanía, Chile.
          </p>
        </div>
      </div>
    </footer>
