    <!-- INTERACCIONES Y LÓGICA DE BOTONES (JS NATIVO) -->
    <script>
      // Lógica Menú Móvil
      const mobileMenuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const menuIcon = document.getElementById("menu-icon");

      mobileMenuBtn.addEventListener("click", () => {
        const isExpanded = mobileMenu.classList.contains("hidden");
        if (isExpanded) {
          mobileMenu.classList.remove("hidden");
          menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12"); // Icono Cerrar (X)
        } else {
          mobileMenu.classList.add("hidden");
          menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16"); // Icono Hamburguesa
        }
      });

      // Cerrar menú móvil al hacer click en un enlace
      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });

      // Función dinámica al presionar "Ver Detalles" en las propiedades
      function setSubject(propertyText) {
        const textarea = document.getElementById("mensaje");
        textarea.value = `Hola Andrea, me interesa obtener más información sobre la propiedad "${propertyText}". Quedo atento/a a tus comentarios.`;
        // Scroll fluido inmediato al formulario
        document.getElementById("contacto").scrollIntoView({ behavior: "smooth" });
      }

      // Lógica de Envío del Formulario (Feedback interactivo)
      const form = document.getElementById("contact-form");
      const successAlert = document.getElementById("form-success");

      form.addEventListener("submit", (e) => {
        e.preventDefault(); // Evita recarga real en el template de venta

        // Simular carga de envío
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerText = "Enviando...";

        setTimeout(() => {
          form.reset();
          submitBtn.disabled = false;
          submitBtn.innerText = "Enviar Solicitud de Asesoría";
          successAlert.classList.remove("hidden");

          // Ocultar alerta después de 5 segundos
          setTimeout(() => {
            successAlert.classList.add("hidden");
          }, 5000);
        }, 1200);
      });
    </script>
  </body>
