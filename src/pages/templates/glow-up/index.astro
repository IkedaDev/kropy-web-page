            btnElite.href =
              "https://wa.me/56912345678?text=Hola%20GlowUp,%20me%20interesa%20contratar%20el%20plan%20Thermodynamic%20Elite%20(Mensual).";
          }
        }

        /* --- CAROUSEL DE TESTIMONIOS INTERACTIVO --- */
        let currentReviewIndex = 0;
        const slides = document.querySelectorAll(".testimonial-slide");

        function showReview(index) {
          slides.forEach((slide, i) => {
            slide.classList.add("opacity-0", "hidden");
            slide.classList.remove("opacity-100", "block");
            if (i === index) {
              slide.classList.remove("hidden");
              setTimeout(() => {
                slide.classList.add("opacity-100", "block");
              }, 50);
            }
          });
        }

        function nextReview() {
          currentReviewIndex++;
          if (currentReviewIndex >= slides.length) {
            currentReviewIndex = 0;
          }
          showReview(currentReviewIndex);
        }

        function prevReview() {
          currentReviewIndex--;
          if (currentReviewIndex < 0) {
            currentReviewIndex = slides.length - 1;
          }
          showReview(currentReviewIndex);
        }

        /* --- ACORDEÓN DE PREGUNTAS FRECUENTES (FAQs) --- */
        function toggleFaq(button) {
          const content = button.nextElementSibling;
          const icon = button.querySelector(".faq-icon");

          // Cerrar otros acordeones abiertos para mantener orden visual
          const allContents = document.querySelectorAll(".faq-content");
          const allIcons = document.querySelectorAll(".faq-icon");

          allContents.forEach((c) => {
            if (c !== content) {
              c.style.maxHeight = null;
            }
          });
          allIcons.forEach((i) => {
            if (i !== icon) {
              i.textContent = "+";
              i.classList.remove("rotate-45");
            }
          });

          // Alternar estado del acordeón pulsado
          if (content.style.maxHeight) {
            content.style.maxHeight = null;
            icon.textContent = "+";
            icon.classList.remove("rotate-45");
          } else {
            content.style.maxHeight = content.scrollHeight + "px";
            icon.textContent = "×";
            icon.classList.add("rotate-45");
          }
        }

        /* --- ENVÍO DE FORMULARIO DE CONTACTO --- */
        function handleContactSubmit(event) {
          event.preventDefault();

          const name = document.getElementById("contact-name").value;
          const phone = document.getElementById("contact-phone").value;
          const plan = document.getElementById("contact-plan").value;
          const message = document.getElementById("contact-message").value;

          const submitBtn = event.target.querySelector('button[type="submit"]');
          submitBtn.textContent = "Procesando...";
          submitBtn.disabled = true;

          setTimeout(() => {
            submitBtn.textContent = "Agendar Clase de Prueba Gratis →";
            submitBtn.disabled = false;

            const successBlock = document.getElementById("contact-success-msg");
            successBlock.classList.remove("hidden");

            // Reiniciar inputs
            event.target.reset();

            // Ocultar mensaje de éxito tras 7 segundos
            setTimeout(() => {
              successBlock.classList.add("hidden");
            }, 7000);
          }, 1000);
        }
      </script>
    </section>
  </body>
</html>
