---
import SeoHead from "../../../components/SeoHead.astro";

const title = "GlowUp | Dermoestética Capilar, Crioterapia & Spa Botánico • Temuco Chile";
const description = "GlowUp | Dermoestética Capilar, Crioterapia & Spa Botánico • Temuco Chile";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Plus Jakarta Sans (UI moderna) & Playfair Display (Serif de lujo editorial) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* CSS PURO: Variables de diseño de autor para GlowUp (Lino, Araucaria y Arcilla) */
      :root {
        --kutral-bg: #fdfbf7; /* Lino cálido / Arena suave */
        --kutral-white: #ffffff; /* Blanco puro */
        --kutral-border: #f0ede6; /* Divisores orgánicos finos */
        --kutral-pine: #1b362f; /* Verde Araucaria profundo */
        --kutral-pine-container: #e9efea; /* Verde salvia suave */
        --kutral-clay: #d0a98c; /* Crema de avellana / Arcilla */
        --kutral-clay-dark: #b58461; /* Arcilla tostada */
        --kutral-dark: #2e3331; /* Pizarra suave de alta legibilidad */
        --kutral-muted: #7e8581; /* Gris bruma del sur */
      }

      body {
        background-color: var(--kutral-bg);
        color: var(--kutral-dark);
        font-family: "Plus Jakarta Sans", sans-serif;
        letter-spacing: -0.01em;
      }

      .font-editorial {
        font-family: "Playfair Display", serif;
      }

      /* Transiciones suaves de alta gama */
      .kutral-transition {
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Efecto de desvanecimiento suave para interactividad */
      .fade-transition {
        transition:
          opacity 0.3s ease-in-out,
          transform 0.3s ease-in-out;
      }
    </style>
  </head>
  <body class="relative min-h-screen overflow-x-hidden antialiased">
    <!-- CABECERA DE AUTOR: Transparente, Asimétrica y de Líneas Finas -->
    <header
      class="sticky top-0 z-50 border-b border-[--kutral-border] bg-[#FDFBF7]/80 py-4 backdrop-blur-lg"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 sm:px-10">
        <!-- Logotipo del Salón de Autor -->
        <a href="#" class="group flex items-center gap-3" aria-label="Volver al inicio">
          <div
            class="font-editorial kutral-transition flex h-8 w-8 items-center justify-center rounded-full border border-[--kutral-pine] text-sm font-semibold text-[--kutral-dark] italic group-hover:bg-[--kutral-pine] group-hover:text-white"
          >
            K
          </div>
          <span
            class="font-editorial kutral-transition text-xl font-bold tracking-tight text-[--kutral-dark] uppercase italic group-hover:text-[--kutral-pine]"
          >
            GlowUp<span class="text-[--kutral-clay] not-italic">.</span>
          </span>
        </a>

        <!-- Navegación Minimalista -->
        <nav
          class="hidden items-center space-x-10 text-[10px] font-bold tracking-[0.25em] text-[--kutral-muted] uppercase lg:flex"
        >
          <a href="#concepto" class="kutral-transition hover:text-[--kutral-pine]">El Método</a>
          <a href="#alquimia" class="kutral-transition hover:text-[--kutral-pine]">Alquimia</a>
          <a href="#lookbook" class="kutral-transition hover:text-[--kutral-pine]">Lookbook</a>
          <a href="#planes" class="kutral-transition hover:text-[--kutral-pine]">Membresías</a>
        </nav>

        <!-- Acción de Conversión Rápida -->
        <div class="flex items-center gap-4">
          <a
            href="https://wa.me/56912345678?text=Hola%20GlowUp,%20me%20gustaría%20agendar%20un%20diagnóstico%20capilar%20en%20vuestro%20salón%20de%20Temuco."
            target="_blank"
            class="kutral-transition rounded-full bg-[--kutral-pine] px-6 py-3 text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kutral-clay-dark]"
          >
            Agendar Cita
          </a>

          <!-- Menú móvil sutil -->
          <button
            id="drawer-toggle"
            class="p-2 text-[--kutral-dark] focus:outline-none lg:hidden"
            aria-label="Abrir Menú"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                id="drawer-icon"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Cajón de navegación móvil -->
      <div
        id="mobile-drawer"
        class="absolute left-0 hidden w-full border-b border-[--kutral-border] bg-[#FDFBF7] px-6 py-6 shadow-lg lg:hidden"
      >
        <div
          class="flex flex-col space-y-4 text-[10px] font-bold tracking-widest text-[--kutral-muted] uppercase"
        >
          <a href="#concepto" class="py-1 hover:text-[--kutral-pine]">El Método</a>
          <a href="#alquimia" class="py-1 hover:text-[--kutral-pine]">Alquimia</a>
          <a href="#lookbook" class="py-1 hover:text-[--kutral-pine]">Lookbook</a>
          <a href="#planes" class="py-1 hover:text-[--kutral-pine]">Membresías</a>
          <a
            href="https://wa.me/56912345678"
            class="mt-2 block rounded-full bg-[--kutral-pine] py-3.5 text-center text-[10px] font-bold tracking-widest text-white uppercase"
            >Reservar Turno</a
          >
        </div>
      </div>
    </header>

    <!-- SECCIÓN HERO: Composición limpia, aireada e inspiradora -->
    <section class="relative mx-auto max-w-7xl px-6 py-16 sm:px-10 lg:py-24">
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
        <!-- Copys de Lujo Editorial -->
        <div class="space-y-8 text-center lg:col-span-7 lg:text-left">
          <div
            class="inline-flex items-center gap-2 rounded-full bg-[--kutral-pine-container] px-3 py-1 text-[9px] font-bold tracking-[0.2em] text-[--kutral-pine] uppercase"
          >
            ✨ DERMOESTÉTICA & SANACIÓN CAPILAR BIOLÓGICA
          </div>

          <h1
            class="font-editorial text-5xl leading-[1.05] tracking-tight text-[--kutral-dark] sm:text-7xl lg:text-8xl"
          >
            El cabello como <br />
            <span class="font-normal text-[--kutral-clay-dark] italic">espejo vital.</span>
          </h1>

          <p
            class="mx-auto max-w-xl text-sm leading-relaxed font-light text-[--kutral-muted] md:text-base lg:mx-0"
          >
            GlowUp es un spa capilar de autor. Diseñamos terapias de restauración biológica para
            proteger y sanar tu cabello de la rigurosidad climática del sur, uniendo la precisión de
            la crioterapia a -16°C con dermoanalítica y activos botánicos puros.
          </p>

          <!-- Acciones Claras de Conversión -->
          <div
            class="flex flex-col items-stretch justify-center gap-4 pt-4 sm:flex-row sm:items-center lg:justify-start"
          >
            <a
              href="#planes"
              class="kutral-transition rounded-full bg-[--kutral-pine] px-8 py-4 text-center text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kutral-clay-dark]"
            >
              Planes & Membresías
            </a>
            <a
              href="#alquimia"
              class="kutral-transition rounded-full border border-[--kutral-border] bg-white px-8 py-4 text-center text-[10px] font-bold tracking-widest text-[--kutral-dark] uppercase hover:border-[--kutral-dark]"
            >
              Mezclador Alquímico Capilar
            </a>
          </div>
        </div>

        <!-- Columna de Imagen Estilo Passepartout (Limpio y Premium) -->
        <div class="flex justify-center lg:col-span-5">
          <div
            class="w-full max-w-[380px] rounded-3xl border border-[--kutral-border] bg-white p-4 shadow-[0_12px_40px_rgba(0,0,0,0.015)]"
          >
            <div class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl">
              <img
                src="https://images.unsplash.com/photo-1562322140-8baeececf3df?auto=format&fit=crop&w=600&q=80"
                alt="Cabello sano e hidratado tras un tratamiento biológico en GlowUp Temuco"
                class="h-full w-full object-cover brightness-[1.01] saturate-[0.3]"
                onerror="this.onerror=null;this.src='https://placehold.co/400x500/FDFBF7/2E3331?text=Kallfu+Hair'"
              />
            </div>

            <div
              class="mt-4 flex items-center justify-between border-t border-[--kutral-border] pt-3 text-left"
            >
              <div>
                <span
                  class="block text-[8px] font-bold tracking-widest text-[--kutral-muted] uppercase"
                  >Salón de Autor</span
                >
                <span class="font-editorial text-xs font-bold text-[--kutral-dark] italic"
                  >Avenida Alemania, Temuco</span
                >
              </div>
              <span
                class="rounded-full border border-[--kutral-pine]/10 bg-[--kutral-pine-container] px-3 py-1.5 text-[8px] font-bold tracking-wider text-[--kutral-pine] uppercase"
                >Refugio Capilar</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN FILOSOFÍA: La línea de tiempo del Spa Capilar (Asimétrica y Original) -->
    <section id="concepto" class="border-y border-[--kutral-border] bg-white py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <div class="mx-auto mb-20 max-w-2xl space-y-3 text-center">
          <span
            class="block text-[10px] font-bold tracking-[0.25em] text-[--kutral-clay-dark] uppercase"
            >EL RITUAL</span
          >
          <h2 class="font-editorial text-3xl text-[--kutral-dark] sm:text-4xl">
            La Experiencia GlowUp
          </h2>
          <p class="text-sm font-light text-[--kutral-muted]">
            Diseñamos un recorrido sensorial para que tu visita sea un momento de calma,
            desintoxicación e hidratación profunda.
          </p>
        </div>

        <!-- Línea de Tiempo Asimétrica y Original -->
        <div class="relative ml-4 space-y-16 border-l border-[--kutral-border] md:ml-32">
          <!-- Paso 1 -->
          <div class="group relative pl-8 md:pl-12">
            <!-- Nodo indicador -->
            <div
              class="kutral-transition absolute top-1.5 -left-[13px] flex h-6 w-6 items-center justify-center rounded-full border-2 border-[--kutral-pine] bg-white text-[10px] font-bold text-[--kutral-pine] group-hover:bg-[--kutral-pine] group-hover:text-white"
            >
              1
            </div>
            <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-12">
              <div class="md:col-span-4">
                <span
                  class="text-[9px] font-bold tracking-widest text-[--kutral-clay-dark] uppercase"
                  >Fase de Entrada</span
                >
                <h3 class="font-editorial text-lg font-bold text-[--kutral-dark]">
                  Aromaterapia & Bienvenida
                </h3>
              </div>
              <div class="md:col-span-8">
                <p class="text-xs leading-relaxed font-light text-[--kutral-muted]">
                  Iniciamos cada ritual con masajes en los hombros e inhalación de aceites
                  esenciales de lavanda y menta piperita. Calma el sistema nervioso, reduce los
                  niveles de cortisol y prepara el folículo capilar para recibir el tratamiento.
                </p>
              </div>
            </div>
          </div>

          <!-- Paso 2 -->
          <div class="group relative pl-8 md:pl-12">
            <div
              class="kutral-transition absolute top-1.5 -left-[13px] flex h-6 w-6 items-center justify-center rounded-full border-2 border-[--kutral-pine] bg-white text-[10px] font-bold text-[--kutral-pine] group-hover:bg-[--kutral-pine] group-hover:text-white"
            >
              2
            </div>
            <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-12">
              <div class="md:col-span-4">
                <span
                  class="text-[9px] font-bold tracking-widest text-[--kutral-clay-dark] uppercase"
                  >Fase Purificante</span
                >
                <h3 class="font-editorial text-lg font-bold text-[--kutral-dark]">
                  Lavado con Agua de Lluvia
                </h3>
              </div>
              <div class="md:col-span-8">
                <p class="text-xs leading-relaxed font-light text-[--kutral-muted]">
                  Lavamos tu cabello exclusivamente con agua de lluvia purificada y tratada mediante
                  filtros de triple etapa. Al ser libre de sarro, cal y metales pesados, limpia con
                  máxima suavidad, equilibra el pH y potencia el brillo.
                </p>
              </div>
            </div>
          </div>

          <!-- Paso 3 -->
          <div class="group relative pl-8 md:pl-12">
            <div
              class="kutral-transition absolute top-1.5 -left-[13px] flex h-6 w-6 items-center justify-center rounded-full border-2 border-[--kutral-pine] bg-white text-[10px] font-bold text-[--kutral-pine] group-hover:bg-[--kutral-pine] group-hover:text-white"
            >
              3
            </div>
            <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-12">
              <div class="md:col-span-4">
                <span
                  class="text-[9px] font-bold tracking-widest text-[--kutral-clay-dark] uppercase"
                  >Fase de Alquimia</span
                >
                <h3 class="font-editorial text-lg font-bold text-[--kutral-dark]">
                  Mezclador Botánico Nátivo
                </h3>
              </div>
              <div class="md:col-span-8">
                <p class="text-xs leading-relaxed font-light text-[--kutral-muted]">
                  Formulamos tu mascarilla de hidratación o reparación mezclando extractos botánicos
                  puros en tu presencia. Incorporamos aceite de avellano chileno, maqui antioxidante
                  y queratina vegetal según tu diagnóstico.
                </p>
              </div>
            </div>
          </div>

          <!-- Paso 4 -->
          <div class="group relative pl-8 md:pl-12">
            <div
              class="kutral-transition absolute top-1.5 -left-[13px] flex h-6 w-6 items-center justify-center rounded-full border-2 border-[--kutral-pine] bg-white text-[10px] font-bold text-[--kutral-pine] group-hover:bg-[--kutral-pine] group-hover:text-white"
            >
              4
            </div>
            <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-12">
              <div class="md:col-span-4">
                <span
                  class="text-[9px] font-bold tracking-widest text-[--kutral-clay-dark] uppercase"
                  >Fase de Cierre</span
                >
                <h3 class="font-editorial text-lg font-bold text-[--kutral-dark]">
                  Crioterapia Capilar a -16°C
                </h3>
              </div>
              <div class="md:col-span-8">
                <p class="text-xs leading-relaxed font-light text-[--kutral-muted]">
                  Finalizamos sellando los nutrientes aplicados mediante planchas refrigeradoras
                  criogénicas. El frío extremo obliga a la cutícula a compactarse, atrapando la
                  hidratación y controlando el frizz por semanas.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA EXCLUSIVA: EL MEZCLADOR ALQUÍMICO CAPILAR (Custom Botanical Diagnostic) -->
    <section id="alquimia" class="mx-auto max-w-7xl px-6 py-24 sm:px-10">
      <div class="mx-auto mb-16 max-w-2xl space-y-3 text-center">
        <span class="block text-xs font-bold tracking-widest text-[--kutral-pine] uppercase"
          >ALQUIMIA PERSONALIZADA</span
        >
        <h2 class="font-editorial text-3xl text-[--kutral-dark] sm:text-4xl">
          El Mezclador de Activos
        </h2>
        <p class="text-sm font-light text-[--kutral-muted]">
          Selecciona las condiciones específicas de tu cuero cabelludo y tu meta capilar para
          formular al instante tu ritual botánico personalizado.
        </p>
      </div>

      <div
        class="rounded-3xl border border-[--kutral-border] bg-white p-8 shadow-[0_12px_40px_rgba(0,0,0,0.01)] sm:p-12"
      >
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
          <!-- Columna Izquierda: Ajustes de Alquimia -->
          <div class="space-y-8 text-left lg:col-span-6">
            <div class="flex items-center gap-3 border-b border-black/5 pb-4">
              <span class="text-2xl">🧪</span>
              <div>
                <span
                  class="block text-[8px] font-bold tracking-widest text-[--kutral-muted] uppercase"
                  >FORMULACIÓN EN TIEMPO REAL</span
                >
                <h3 class="font-editorial text-xl font-bold text-[--kutral-dark]">
                  Seleccionar Ingredientes Activos
                </h3>
              </div>
            </div>

            <!-- Paso 1: Tipo de Cuero Cabelludo -->
            <div class="space-y-3">
              <span class="block text-xs font-bold tracking-widest text-[--kutral-muted] uppercase"
                >1. Diagnóstico del Cuero Cabelludo</span
              >
              <div class="grid grid-cols-3 gap-3">
                <button
                  onclick="selectScalp('seco', this)"
                  class="scalp-btn kutral-transition rounded-xl border border-[--kutral-pine]/10 bg-[--kutral-pine-container] py-3 text-xs font-bold text-[--kutral-pine] select-none"
                >
                  Seco
                </button>
                <button
                  onclick="selectScalp('graso', this)"
                  class="scalp-btn kutral-transition rounded-xl border border-[--kutral-border] bg-[#FAF8F5] py-3 text-xs font-bold text-[--kutral-muted] select-none hover:border-[--kutral-pine]"
                >
                  Graso
                </button>
                <button
                  onclick="selectScalp('sensible', this)"
                  class="scalp-btn kutral-transition rounded-xl border border-[--kutral-border] bg-[#FAF8F5] py-3 text-xs font-bold text-[--kutral-muted] select-none hover:border-[--kutral-pine]"
                >
                  Sensible
                </button>
              </div>
            </div>

            <!-- Paso 2: Meta del Cabello -->
            <div class="space-y-3">
              <span class="block text-xs font-bold tracking-widest text-[--kutral-muted] uppercase"
                >2. Meta Principal de la Hebra</span
              >
              <div class="grid grid-cols-3 gap-3">
                <button
                  onclick="selectGoal('hidratacion', this)"
                  class="goal-btn kutral-transition rounded-xl border border-[--kutral-pine]/10 bg-[--kutral-pine-container] py-3 text-xs font-bold text-[--kutral-pine] select-none"
                >
                  Hidratar
                </button>
                <button
                  onclick="selectGoal('fuerza', this)"
                  class="goal-btn kutral-transition rounded-xl border border-[--kutral-border] bg-[#FAF8F5] py-3 text-xs font-bold text-[--kutral-muted] select-none hover:border-[--kutral-pine]"
                >
                  Fortalecer
                </button>
                <button
                  onclick="selectGoal('brillo', this)"
                  class="goal-btn kutral-transition rounded-xl border border-[--kutral-border] bg-[#FAF8F5] py-3 text-xs font-bold text-[--kutral-muted] select-none hover:border-[--kutral-pine]"
                >
                  Dar Brillo
                </button>
              </div>
            </div>
          </div>

          <!-- Columna Derecha: Tarjeta de Receta en Tiempo Real -->
          <div class="flex h-full flex-col justify-center lg:col-span-6">
            <div
              class="space-y-6 rounded-3xl border border-[--kutral-border] bg-[#FAF8F5] p-6 text-center sm:p-8"
            >
              <div class="space-y-2">
                <span
                  class="block text-[8px] font-bold tracking-widest text-[--kutral-muted] uppercase"
                  >RECETA BOTÁNICA DESTILADA</span
                >
                <span
                  class="font-editorial block text-2xl leading-tight font-bold tracking-tight text-[--kutral-pine]"
                  id="recipe-name-display">Elíxir de Avellano & Ácido Hialurónico</span
                >
                <p
                  class="mx-auto max-w-sm text-[11px] font-light text-[--kutral-muted]"
                  id="recipe-desc-display"
                >
                  Diseñado especialmente para cuero cabelludo seco que requiere restaurar la barrera
                  lipídica y retener humedad natural.
                </p>
              </div>

              <!-- Detalles Técnicos -->
              <div class="grid grid-cols-2 gap-4 border-t border-black/5 pt-4 text-left">
                <div>
                  <span
                    class="block text-[8px] font-bold tracking-widest text-[--kutral-muted] uppercase"
                    >Valor Estimado</span
                  >
                  <span
                    class="mt-0.5 block text-xs font-extrabold text-[--kutral-dark]"
                    id="recipe-price-display">$35.000 CLP</span
                  >
                </div>
                <div>
                  <span
                    class="block text-[8px] font-bold tracking-widest text-[--kutral-muted] uppercase"
                    >Duración Ritual</span
                  >
                  <span
                    class="mt-0.5 block text-xs font-extrabold text-[--kutral-dark]"
                    id="recipe-time-display">75 Minutos</span
                  >
                </div>
              </div>

              <!-- CTA Dinámico -->
              <a
                id="alchemy-cta"
                href="https://wa.me/56912345678?text=Hola%20GlowUp,%20he%20formulado%20un%20Elíxir%20de%20Avellano%20y%20Hialurónico%20para%20cuero%20cabelludo%20seco%20en%20vuestro%20mezclador%20alquímico."
                target="_blank"
                class="kutral-transition flex w-full items-center justify-center gap-2 rounded-full bg-[--kutral-pine] py-4 text-center text-[10px] font-bold tracking-widest text-white uppercase shadow-sm hover:bg-[--kutral-clay-dark]"
              >
                <span>Sincronizar Receta por WhatsApp</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN INTERACTIVA: EL LOOKBOOK DE TENDENCIAS CAPILARES (Original, Editorial y Funcional) -->
    <section id="lookbook" class="border-t border-[--kutral-border] bg-white py-24">
      <div class="mx-auto max-w-7xl px-6 sm:px-10">
        <div class="mx-auto mb-16 max-w-2xl space-y-3 text-center">
          <span class="block text-xs font-bold tracking-widest text-[--kutral-clay-dark] uppercase"
            >INSPIRACIÓN EDITORIAL</span
          >
          <h2 class="font-editorial text-3xl text-[--kutral-dark] sm:text-4xl">
            Lookbook de Tendencias
          </h2>
          <p class="text-sm font-light text-[--kutral-muted]">
            Explora cortes de diseño y efectos de color de autor especialmente seleccionados para el
            sur de Chile.
          </p>

          <!-- Pestañas de Lookbook (Interacciones Corregidas) -->
          <div class="flex flex-wrap justify-center gap-2 pt-6">
            <button
              onclick="switchLookbookTab('ondas', this)"
