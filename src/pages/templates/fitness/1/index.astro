      /* CSS PURO: Definición de variables de diseño exclusivas para KRONOS (Sin tocar config de Tailwind) */
      :root {
        --kronos-black: #0b0b0c; /* Fondo ultra oscuro de alta gama */
        --kronos-card: #151518; /* Color de tarjetas y secciones secundarias */
        --kronos-volt: #d2ff26; /* Verde volt de rendimiento deportivo */
        --kronos-volt-hover: #bce620; /* Variación hover del acento */
        --kronos-steel: #f3f4f6; /* Texto principal claro */
        --kronos-muted: #8e9196; /* Texto descriptivo atenuado */
        --kronos-border: #26262b; /* Bordes elegantes de separación */
      }

      body {
        background-color: var(--kronos-black);
        color: var(--kronos-steel);
        font-family: "Inter", sans-serif;
      }

      .font-syne {
        font-family: "Syne", sans-serif;
      }

      /* Efecto de ruido sutil de fondo */
      .kronos-noise {
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.015'/%3E%3C/svg%3E");
      }

      /* Gradientes premium de rendimiento */
      .glowing-orbs {
        filter: blur(140px);
        opacity: 0.08;
        mix-blend-mode: screen;
      }

      /* Transiciones suaves corporativas */
      .kropy-transition {
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
    </style>
