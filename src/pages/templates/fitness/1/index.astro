    <script>
      /* --- MENÚ MÓVIL DESPLEGABLE --- */
      const mobileToggleBtn = document.getElementById("menu-toggle-btn");
      const mobileMenuDrawer = document.getElementById("mobile-menu-drawer");
      const menuIcon = document.getElementById("menu-icon");

      mobileToggleBtn.addEventListener("click", () => {
        mobileMenuDrawer.classList.toggle("hidden");
        if (mobileMenuDrawer.classList.contains("hidden")) {
          menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        } else {
          menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12");
        }
      });

      // Cerrar menú al hacer click en un enlace móvil
      const drawerLinks = mobileMenuDrawer.querySelectorAll("a");
      drawerLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenuDrawer.classList.add("hidden");
          menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });

      /* --- SELECTOR DE CLASES DINÁMICO (Filtro JS) --- */
      function switchClassTab(category, btnElement) {
        const cards = document.querySelectorAll(".class-card-item");

        // Filtrar las tarjetas
        cards.forEach((card) => {
          if (category === "all" || card.getAttribute("data-tab") === category) {
            card.style.display = "block";
            setTimeout(() => {
              card.style.opacity = "1";
            }, 10);
          } else {
            card.style.opacity = "0";
            setTimeout(() => {
              card.style.display = "none";
            }, 200);
          }
        });

        // Estilos activos del botón seleccionado
        const buttons = document.querySelectorAll(".tab-btn");
        buttons.forEach((btn) => {
          btn.classList.remove("bg-[--kronos-volt]", "text-black");
          btn.classList.add("bg-[#151518]", "text-white", "border-[#26262B]");
        });

        if (btnElement) {
          btnElement.classList.remove("bg-[#151518]", "text-white", "border-[#26262B]");
          btnElement.classList.add("bg-[--kronos-volt]", "text-black");
        }
      }

      /* --- INTERACTIVE BILLING (Toggle Mensual/Anual) --- */
      let isAnnual = false;

      function toggleBillingPeriod() {
        const circle = document.getElementById("toggle-circle");
        const priceBasic = document.getElementById("price-basic");
        const priceAthlete = document.getElementById("price-athlete");
        const priceElite = document.getElementById("price-elite");

        const labelBasic = document.getElementById("label-basic");
        const labelAthlete = document.getElementById("label-athlete");
        const labelElite = document.getElementById("label-elite");

        const btnBasic = document.getElementById("btn-basic-link");
        const btnAthlete = document.getElementById("btn-athlete-link");
        const btnElite = document.getElementById("btn-elite-link");

        isAnnual = !isAnnual;

        if (isAnnual) {
          // Activar animación a la derecha
          circle.classList.add("translate-x-6");

          // Actualizar precios con descuento (25% aprox)
          priceBasic.textContent = "36€";
          priceAthlete.textContent = "59€";
          priceElite.textContent = "149€";

          labelBasic.textContent = "/ mes (pago anual)";
          labelAthlete.textContent = "/ mes (pago anual)";
          labelElite.textContent = "/ mes (pago anual)";

          // Actualizar links automáticos de WhatsApp
          btnBasic.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20Basic%20Pass%20(Anual).";
          btnAthlete.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20Athlete%20Pass%20(Anual).";
          btnElite.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20KRONOS%20Elite%20(Anual).";
        } else {
          // Desactivar animación
          circle.classList.remove("translate-x-6");

          // Regresar a precios base mensuales
          priceBasic.textContent = "49€";
          priceAthlete.textContent = "79€";
          priceElite.textContent = "199€";

          labelBasic.textContent = "/ mes";
          labelAthlete.textContent = "/ mes";
          labelElite.textContent = "/ mes";

          btnBasic.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20Basic%20Pass%20(Mensual).";
          btnAthlete.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20Athlete%20Pass%20(Mensual).";
          btnElite.href =
            "https://wa.me/34600000000?text=Hola%20KRONOS,%20quiero%20más%20información%20sobre%20el%20plan%20KRONOS%20Elite%20(Mensual).";
        }
      }

      /* --- CAROUSEL DE TESTIMONIOS INTERACTIVO --- */
      let currentReviewIndex = 0;
      const slides = document.querySelectorAll(".testimonial-slide");

      function showReview(index) {
        slides.forEach((slide, i) => {
          slide.classList.add("opacity-0", "hidden");
          slide.classList.remove("opacity-100", "block");
          if (i === index) {
            slide.classList.remove("hidden");
            setTimeout(() => {
              slide.classList.add("opacity-100", "block");
            }, 50);
          }
        });
      }

      function nextReview() {
        currentReviewIndex++;
        if (currentReviewIndex >= slides.length) {
          currentReviewIndex = 0;
        }
        showReview(currentReviewIndex);
      }

      function prevReview() {
        currentReviewIndex--;
        if (currentReviewIndex < 0) {
          currentReviewIndex = slides.length - 1;
        }
        showReview(currentReviewIndex);
      }

      /* --- ACORDEÓN DE PREGUNTAS FRECUENTES (FAQs) --- */
      function toggleFaq(button) {
        const content = button.nextElementSibling;
        const icon = button.querySelector(".faq-icon");

        // Cerrar otros abiertos para mantener limpieza visual
        const allContents = document.querySelectorAll(".faq-content");
        const allIcons = document.querySelectorAll(".faq-icon");

        allContents.forEach((c) => {
          if (c !== content) {
            c.style.maxHeight = null;
          }
        });
        allIcons.forEach((i) => {
          if (i !== icon) {
            i.textContent = "+";
            i.classList.remove("rotate-45");
          }
        });

        // Alternar estado actual
        if (content.style.maxHeight) {
          content.style.maxHeight = null;
          icon.textContent = "+";
          icon.classList.remove("rotate-45");
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          icon.textContent = "×";
          icon.classList.add("rotate-45");
        }
      }

      /* --- ENVÍO DE FORMULARIO DE CONTACTO (Simulación Profesional) --- */
      function handleContactSubmit(event) {
        event.preventDefault();

        const name = document.getElementById("contact-name").value;
        const email = document.getElementById("contact-email").value;
        const plan = document.getElementById("contact-plan").value;
        const message = document.getElementById("contact-message").value;

        // Simulación sutil de carga y guardado local seguro
        const submitBtn = event.target.querySelector('button[type="submit"]');
        submitBtn.textContent = "Procesando...";
        submitBtn.disabled = true;

        setTimeout(() => {
          // Restaurar botón y mostrar mensaje de éxito
          submitBtn.textContent = "Enviar Solicitud de Registro →";
          submitBtn.disabled = false;

          // Mostrar bloque de éxito animado
          const successBlock = document.getElementById("contact-success-msg");
          successBlock.classList.remove("hidden");

          // Auto-limpieza del formulario
          event.target.reset();

          // Cerrar feedback tras 6 segundos
          setTimeout(() => {
            successBlock.classList.add("hidden");
          }, 6000);
        }, 1200);
      }
    </script>
  </body>
</html>
