                    <option value="12:30">12:30 hrs</option>
                    <option value="13:30">13:30 hrs</option>
                    <option value="14:30">14:30 hrs</option>
                    <option value="15:30">15:30 hrs</option>
                    <option value="19:30">19:30 hrs</option>
                    <option value="20:30">20:30 hrs</option>
                    <option value="21:30">21:30 hrs</option>
                    <option value="22:30">22:30 hrs</option>
                  </select>
                </div>
                <div>
                  <label
                    for="book-count"
                    class="block text-xs font-bold tracking-wider text-stone-400 uppercase"
                    >Personas:</label
                  >
                  <select
                    id="book-count"
                    class="bg-bark-900 border-bark-800 mt-2 block w-full rounded-lg border px-4 py-3 text-sm text-white focus:border-amber-500 focus:outline-none"
                  >
                    <option value="1">1 Persona</option>
                    <option value="2" selected>2 Personas</option>
                    <option value="4">4 Personas</option>
                    <option value="6">6 Personas</option>
                    <option value="8">8 Personas</option>
                    <option value="grupo">Más de 10 (Evento)</option>
