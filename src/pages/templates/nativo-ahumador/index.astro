              <div>
                <label
                  for="book-notes"
                  class="block text-xs font-bold tracking-wider text-stone-400 uppercase"
                  >Notas de la reserva / Requerimientos especiales:</label
                >
                <textarea
                  id="book-notes"
                  rows="4"
                  class="bg-bark-900 border-bark-800 mt-2 block w-full rounded-lg border px-4 py-3 text-sm text-white focus:border-amber-500 focus:outline-none"
                  placeholder="Indícanos si necesitas silla de bebé, si celebras un cumpleaños o si traes mascota..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="from-embers-500 hover:from-embers-600 shadow-embers-500/10 inline-flex w-full items-center justify-center rounded-lg bg-gradient-to-r to-amber-600 px-6 py-4 text-xs font-bold tracking-wider text-white uppercase shadow-md transition-all hover:to-amber-700"
              >
                Confirmar Mi Reserva Ahora
              </button>
            </form>

            <!-- Success Confirmation Panel -->
            <div id="booking-restaurant-success" class="hidden space-y-6 py-8 text-center">
              <div
                class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-amber-500 bg-amber-500/10 text-2xl font-black text-amber-400"
              >
                ✓
              </div>
              <div class="space-y-2">
                <h4 class="font-display text-2xl font-bold tracking-tight text-white uppercase">
                  ¡Reserva Confirmada!
                </h4>
                <p class="text-xs text-stone-400">
                  Te esperamos para vivir una experiencia de humo inolvidable.
                </p>
              </div>

              <!-- Reservation Voucher summary -->
              <div
                class="bg-bark-900 border-bark-800 mx-auto max-w-sm space-y-3 rounded-xl border p-6 text-left font-mono text-xs"
              >
                <div class="flex justify-between">
                  <span class="text-stone-500">CÓDIGO:</span>
                  <span id="voucher-code" class="font-bold text-amber-400">#NAT-8492</span>
                </div>
                <div class="border-bark-800 flex justify-between border-t pt-2">
                  <span class="text-stone-500">TITULAR:</span>
                  <span id="voucher-name" class="font-bold text-white">Carlos Silva</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-500">FECHA:</span>
                  <span id="voucher-date" class="text-white">20/05/2026</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-500">HORA:</span>
                  <span id="voucher-time" class="text-white">20:30 hrs</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-500">MESA PARA:</span>
                  <span id="voucher-guests" class="font-bold text-white">4 Personas</span>
                </div>
              </div>

              <p class="mx-auto max-w-md text-[10px] text-stone-500">
                He recibido los detalles de tu mesa. Se te enviará un recordatorio automático por
                WhatsApp antes del servicio.
              </p>

              <button
                onclick="resetRestaurantBookingForm()"
