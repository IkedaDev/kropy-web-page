    <!-- JS Logic and Event Handlers -->
    <script>
      // DOM Elements
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      // Mobile Menu toggle controller
      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Auto close panel when option clicked
      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // FAQ accordion toggler
      function toggleRestaurantFaq(faqId) {
        const container = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId);

        if (container.classList.contains("hidden")) {
          container.classList.remove("hidden");
          icon.innerText = "－";
          icon.classList.add("text-amber-500");
        } else {
          container.classList.add("hidden");
          icon.innerText = "＋";
          icon.classList.remove("text-amber-500");
        }
      }

      // Interactive Gastronomic Menu Filter
      function filterMenu(category) {
        const items = document.querySelectorAll(".menu-item");
        const buttons = document.querySelectorAll(".menu-filter-btn");

        // Reset buttons styling to default
        buttons.forEach((btn) => {
          btn.className =
            "menu-filter-btn px-6 py-3 text-[10px] font-bold uppercase tracking-wider bg-bark-900 border border-bark-800 text-stone-300 hover:text-white rounded-full transition-all";
        });

        // Highlight active button
        const activeBtn = document.getElementById("btn-menu-" + category);
        if (activeBtn) {
          activeBtn.className =
            "menu-filter-btn px-6 py-3 text-[10px] font-bold uppercase tracking-wider bg-embers-500 text-white rounded-full transition-all";
        }

        // Hide or Show menu cards based on filtering selection
        items.forEach((item) => {
          if (category === "all" || item.classList.contains(category)) {
            item.style.display = "block";
          } else {
            item.style.display = "none";
          }
        });
      }

      // Live Event Budget Calculator Logic
      let eventMenuTypeSelected = "nativo";
      let eventMenuPricePerPerson = 28900;
      let eventGuestsCount = 15;

      function updateGuests(val) {
        eventGuestsCount = parseInt(val);
        document.getElementById("guests-display").innerText = `${eventGuestsCount} Personas`;
        calculateEventPrice();
      }

      function setEventMenu(menuKey, price) {
        eventMenuTypeSelected = menuKey;
        eventMenuPricePerPerson = price;

        // Reset menu level selection buttons
        const buttons = document.querySelectorAll(".event-menu-btn");
        buttons.forEach((btn) => {
          btn.className =
            "event-menu-btn p-4 border border-bark-800 hover:border-stone-600 text-left bg-bark-900 text-stone-300 rounded-xl transition-all";
        });

        // Highlight active button
        const activeBtn = document.getElementById("menu-" + menuKey);
        if (activeBtn) {
          activeBtn.className =
            "event-menu-btn p-4 border-2 border-amber-500 text-left bg-amber-500/5 text-white rounded-xl transition-all";
        }

        calculateEventPrice();
      }

      function calculateEventPrice() {
        // Update guests count in summary panel
        document.getElementById("summary-guests").innerText = `${eventGuestsCount} Personas`;

        // Display Menu name in summary
        let menuNameText = "Menú Nativo";
        if (eventMenuTypeSelected === "tradicional") menuNameText = "Menú Huérfano";
        if (eventMenuTypeSelected === "premium") menuNameText = "Festín de la Araucanía";
        document.getElementById("summary-menu").innerText = menuNameText;

        // Calculate Base Price
        const basePrice = eventGuestsCount * eventMenuPricePerPerson;
        document.getElementById("summary-base-price").innerText =
          `$${basePrice.toLocaleString("es-CL")}`;

        // Calculate Extras
        let extrasCost = 0;
        const beerCheckbox = document.getElementById("add-beer-bar");
        if (beerCheckbox.checked) {
          // Beer bar price is per guest
          extrasCost += parseInt(beerCheckbox.value) * eventGuestsCount;
        }

        const exclusiveCheckbox = document.getElementById("add-exclusive");
        if (exclusiveCheckbox.checked) {
          // Exclusive salon fee is a fixed price
          extrasCost += parseInt(exclusiveCheckbox.value);
        }

        document.getElementById("summary-extras-price").innerText =
          `$${extrasCost.toLocaleString("es-CL")}`;

        // Show Total
        const total = basePrice + extrasCost;
        document.getElementById("event-total-display").innerText =
          `$${total.toLocaleString("es-CL")}`;
      }

      // Action when 'Reservar con esta Cotización' is clicked
      function applyEventToBookingForm() {
        const selectCount = document.getElementById("book-count");
        selectCount.value = "grupo";

        const totalVal = document.getElementById("event-total-display").innerText;
        const menuName = document.getElementById("summary-menu").innerText;

        let extrasSelected = [];
        if (document.getElementById("add-beer-bar").checked)
          extrasSelected.push("Barra libre de Schops");
        if (document.getElementById("add-exclusive").checked)
          extrasSelected.push("Exclusividad de Salón de Madera");

        const extrasMsg =
          extrasSelected.length > 0
            ? ` con servicios adicionales de: ${extrasSelected.join(", ")}.`
            : "";

        const computedMessage = `Hola Nativo Ahumador, me gustaría reservar para un evento corporativo/privado de ${eventGuestsCount} personas. Nos interesa el "${menuName}"${extrasMsg}.\n\nPresupuesto cotizado online en la web: ${totalVal} CLP.\n\nPor favor, confírmenme disponibilidad para definir detalles.`;

        document.getElementById("book-notes").value = computedMessage;

        // Smooth scroll down to booking contact block
        document.getElementById("reserva").scrollIntoView({ behavior: "smooth" });
        setTimeout(() => {
          document.getElementById("book-name").focus();
        }, 800);
      }

      // Reservation System submission
      function handleRestaurantBookingSubmit(event) {
        event.preventDefault();

        // Extract values to create Voucher
        const bName = document.getElementById("book-name").value;
        const bDate = document.getElementById("book-date").value;
        const bTime = document.getElementById("book-time").value;
        const bCount = document.getElementById("book-count").value;

        // Generate fake voucher code
        const randomCode = "#NAT-" + Math.floor(1000 + Math.random() * 9000);

        // Populate voucher display
        document.getElementById("voucher-code").innerText = randomCode;
        document.getElementById("voucher-name").innerText = bName;
        document.getElementById("voucher-date").innerText = bDate.split("-").reverse().join("/");
        document.getElementById("voucher-time").innerText = bTime + " hrs";

        let guestsLabel = bCount;
        if (bCount === "grupo") guestsLabel = "Grupo grande (+10)";
        else guestsLabel = bCount + " Personas";
        document.getElementById("voucher-guests").innerText = guestsLabel;

        // Hide form and display voucher
        document.getElementById("booking-restaurant-form").classList.add("hidden");
        document.getElementById("booking-restaurant-success").classList.remove("hidden");
      }

      function resetRestaurantBookingForm() {
        document.getElementById("booking-restaurant-form").reset();
        document.getElementById("booking-restaurant-form").classList.remove("hidden");
        document.getElementById("booking-restaurant-success").classList.add("hidden");
      }

      // Initialize calculations on document ready
      window.onload = function () {
        // Set today's date or tomorrow's as default on input date
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById("book-date").value = tomorrow.toISOString().substring(0, 10);

        // Calculate starting totals
        calculateEventPrice();
      };
    </script>
  </body>
</html>
