    </section>

    <!-- Footer / Pie de Página -->
    <footer class="bg-bark-950 border-bark-900 border-t py-16 text-xs text-stone-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-4">
          <!-- Brand and descriptions -->
          <div class="space-y-4 md:col-span-2">
            <span class="font-display block text-lg font-bold tracking-wider text-white"
              >NATIVO AHUMADOR</span
            >
            <p class="max-w-sm text-xs leading-relaxed font-light text-stone-400">
              Gastronomía de humo y brasas lenta en Temuco. El calor del fuego sureño conjugado con
              las mejores carnes regionales y cerveza artesanal de primer nivel.
