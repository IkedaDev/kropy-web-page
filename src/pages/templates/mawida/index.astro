      <script>
        /* --- MENÚ MÓVIL DESPLEGABLE --- */
        const menuToggle = document.getElementById("drawer-toggle");
        const mobileDrawer = document.getElementById("mobile-drawer");
        const menuIcon = document.getElementById("drawer-icon");

        menuToggle.addEventListener("click", () => {
          mobileDrawer.classList.toggle("hidden");
          if (mobileDrawer.classList.contains("hidden")) {
            menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
          } else {
            menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12");
          }
        });

        const drawerLinks = mobileDrawer.querySelectorAll("a");
        drawerLinks.forEach((link) => {
          link.addEventListener("click", () => {
            mobileDrawer.classList.add("hidden");
            menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
          });
        });

        /* --- CALCULADORA DE PRESUPUESTO INTERACTIVO DE M² EN CLP (FíSICA SENSORIAL) --- */
        let selectedStandardKey = "premium";

        function selectStandard(standardKey, btnElement) {
          selectedStandardKey = standardKey;

          // Actualizar estilo visual plano de los botones
          const buttons = document.querySelectorAll(".standard-btn");
          buttons.forEach((btn) => {
            btn.classList.remove(
              "bg-[--md-sys-color-primary-container]",
              "text-[--md-sys-color-primary]",
              "border-[--md-sys-color-primary]/20"
            );
            btn.classList.add("bg-gray-50", "text-[--md-sys-color-muted]", "border-gray-200");
          });

          btnElement.classList.remove(
            "bg-gray-50",
            "text-[--md-sys-color-muted]",
            "border-gray-200"
          );
          btnElement.classList.add(
            "bg-[--md-sys-color-primary-container]",
            "text-[--md-sys-color-primary]",
            "border-[--md-sys-color-primary]/20"
          );

          calculateConstructionBudget();
        }

        function calculateConstructionBudget() {
          const areaValue = parseInt(document.getElementById("input-area").value);
          document.getElementById("area-val").textContent = `${areaValue} M²`;

          // Configuración de costos por M² de construcción real en el Sur de Chile
          const costPerM2 = selectedStandardKey === "premium" ? 950000 : 780000;
          const timePerM2 = selectedStandardKey === "premium" ? 0.05 : 0.045;

          // Cálculos matemáticos
          const totalPrice = areaValue * costPerM2;
          const designFees = Math.round(totalPrice * 0.1); // 10% Honorarios de diseño de arquitectura
          const constructionMonths = Math.max(6, Math.round(areaValue * timePerM2 + 2));

          // Actualizar visualizaciones con formato de moneda chilena (CLP)
          document.getElementById("total-price-display").textContent =
            `$${totalPrice.toLocaleString("es-CL")} CLP`;
          document.getElementById("design-fees-display").textContent =
            `$${designFees.toLocaleString("es-CL")} CLP`;
          document.getElementById("construction-time-display").textContent =
            `${constructionMonths} Meses de ejecución`;

          // Actualizar link de WhatsApp con el cálculo real
          const standardLabel =
            selectedStandardKey === "premium" ? "Premium Bioclimático" : "Hormigón Visto & Acero";
          const msgText = `Hola Mawida, he calculado el estimado para un proyecto de ${areaValue} M² con estándar de terminación ${standardLabel}. El valor estimado es de $${totalPrice.toLocaleString("es-CL")} CLP. Me gustaría programar una cita.`;
          document.getElementById("calculator-cta").href =
            `https://wa.me/56912345678?text=${encodeURIComponent(msgText)}`;
        }

        /* --- FILTRO DINÁMICO DE CLASES / PROYECTOS (TOTALMENTE OPERATIVO) --- */
        function filterPortfolio(category, btnElement) {
          const cards = document.querySelectorAll(".class-card-item");

          cards.forEach((card) => {
            if (category === "all" || card.getAttribute("data-tab") === category) {
              card.classList.remove("hidden");
              card.classList.add("block");
            } else {
              card.classList.remove("block");
              card.classList.add("hidden");
            }
          });

          // Estilo activo e inactivo de botones con directrices M3
          const buttons = document.querySelectorAll(".class-filter-btn");
          buttons.forEach((btn) => {
            btn.classList.remove("bg-[--md-sys-color-primary]", "text-white", "shadow-sm");
            btn.classList.add("bg-transparent", "text-[--md-sys-color-muted]");
          });

          if (btnElement) {
            btnElement.classList.remove("bg-transparent", "text-[--md-sys-color-muted]");
            btnElement.classList.add("bg-[--md-sys-color-primary]", "text-white", "shadow-sm");
          }
        }

        /* --- INTERACTIVE BILLING Period (Toggle CLP Mensual / Trimestral con 25% Ahorro) --- */
        let isQuarterly = false;

        function toggleBillingPeriod(annualMode, btnElement) {
          const priceBasic = document.getElementById("price-basic");
          const priceAthlete = document.getElementById("price-athlete");
          const priceElite = document.getElementById("price-elite");

          const labelBasic = document.getElementById("label-basic");
          const labelAthlete = document.getElementById("label-athlete");
          const labelElite = document.getElementById("label-elite");

          const btnBasic = document.getElementById("btn-basic-link");
          const btnAthlete = document.getElementById("btn-athlete-link");
          const btnElite = document.getElementById("btn-elite-link");

          // Actualizar estilo del interruptor M3
          const buttons = document.querySelectorAll(".billing-btn");
          buttons.forEach((btn) => {
            btn.classList.remove("bg-[--md-sys-color-primary]", "text-white", "shadow-sm");
            btn.classList.add("bg-transparent", "text-[--md-sys-color-muted]");
          });

          btnElement.classList.remove("bg-transparent", "text-[--md-sys-color-muted]");
          btnElement.classList.add("bg-[--md-sys-color-primary]", "text-white", "shadow-sm");

          isQuarterly = annualMode;

          if (isQuarterly) {
            // Valores trimestrales con un 25% de ahorro en CLP chileno (Honorarios totales proyectados)
            priceBasic.textContent = "$285.000";
            priceAthlete.textContent = "$360.000";
            priceElite.textContent = "$510.000";

            labelBasic.textContent = "/ cuota mensual (Proyecto Cerrado)";
            labelAthlete.textContent = "/ cuota mensual (Proyecto Cerrado)";
            labelElite.textContent = "/ cuota mensual (Proyecto Cerrado)";

            // Enlaces directos formateados para WhatsApp
            btnBasic.href =
              "https://wa.me/56912345678?text=Hola%20Mawida,%20quiero%20más%20información%20sobre%20el%20plan%20Basic%20Design%20Pass%20(Proyecto%20Cerrado).";
            btnAthlete.href =
