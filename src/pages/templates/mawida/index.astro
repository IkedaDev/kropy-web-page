        --md-sys-color-outline: #727974; /* Delineado M3 */
        --md-sys-color-text: #191c1b; /* Carbón M3 */
        --md-sys-color-muted: #5b625e; /* Gris de lectura */

        /* M3 Elevations (Elevation Levels 1 to 5) */
        --md-elevation-1: 0px 1px 3px 1px rgba(0, 0, 0, 0.15), 0px 1px 2px 0px rgba(0, 0, 0, 0.3);
        --md-elevation-2: 0px 2px 6px 2px rgba(0, 0, 0, 0.15), 0px 1px 2px 0px rgba(0, 0, 0, 0.3);
        --md-elevation-3: 0px 4px 8px 3px rgba(0, 0, 0, 0.15), 0px 1px 3px 0px rgba(0, 0, 0, 0.3);
      }

      body {
        background-color: var(--md-sys-color-background);
        color: var(--md-sys-color-text);
        font-family: "Plus Jakarta Sans", sans-serif;
        letter-spacing: -0.01em;
      }

      .font-editorial {
        font-family: "Playfair Display", serif;
      }

      /* Utilidades M3 */
      .m3-elevation-1 {
        box-shadow: var(--md-elevation-1);
      }

      .m3-elevation-2 {
        box-shadow: var(--md-elevation-2);
      }

      .m3-elevation-3 {
        box-shadow: var(--md-elevation-3);
      }

      /* Efecto de Onda de Presión Táctil (Ripple feedback) */
      .m3-ripple {
        position: relative;
        overflow: hidden;
      }
      .m3-ripple::after {
        content: "";
        background: rgba(255, 255, 255, 0.2);
        display: block;
        position: absolute;
        border-radius: 50%;
        padding-top: 240%;
        padding-left: 240%;
        margin-top: -120%;
        margin-left: -120%;
        opacity: 0;
        transition: all 0.8s;
      }
      .m3-ripple:active::after {
        padding-top: 0;
        padding-left: 0;
        margin-top: 0;
        margin-left: 0;
        opacity: 1;
        transition: 0s;
      }

      /* Transición suave estándar */
      .m3-transition {
        transition: all 0.3s cubic-bezier(0.2, 0, 0, 1);
      }
    </style>
