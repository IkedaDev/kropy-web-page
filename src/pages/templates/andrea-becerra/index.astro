    <script>
      // Mobile navigation panel controller
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Autoclose mobile panel upon clicking section navigation
      const navLinks = mobileMenu.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // Accordion toggle handler for FAQs
      function toggleFaq(faqId) {
        const el = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId.split("-")[1]);

        if (el.classList.contains("hidden")) {
          el.classList.remove("hidden");
          icon.classList.add("rotate-180");
        } else {
          el.classList.add("hidden");
          icon.classList.remove("rotate-180");
        }
      }

      // Contact Form Fake Submit Transition
      function handleContactSubmit(event) {
        event.preventDefault();
        document.getElementById("contact-form").classList.add("hidden");
        document.getElementById("contact-success").classList.remove("hidden");
      }

      // Wizard Interactive Estimator Logic
      let wizStep = 1;
      let selectedCategory = "Familia";

      const btnNext = document.getElementById("wiz-next-btn");
      const btnPrev = document.getElementById("wiz-prev-btn");

      function selectCategory(category) {
        selectedCategory = category;

        // Highlight styling toggle
        const buttons = document.querySelectorAll(".wizard-option-btn");
        buttons.forEach((btn) => {
          btn.classList.remove("border-forest-600", "bg-forest-50");
        });

        // Target the selected choice element (simple logic, we proceed to next step automatically)
        navigateWizard(1);
      }

      function navigateWizard(direction) {
        // Validation step check for contact inputs
        if (wizStep === 3 && direction === 1) {
          const nameInp = document.getElementById("wiz-name");
          const phoneInp = document.getElementById("wiz-phone");
          const emailInp = document.getElementById("wiz-email");

          if (!nameInp.value || !phoneInp.value || !emailInp.value) {
            nameInp.reportValidity();
            phoneInp.reportValidity();
            emailInp.reportValidity();
            return;
          }
        }

        // Hide Current
        if (wizStep <= 3) {
          document.getElementById("wizard-step-" + wizStep).classList.add("hidden");
        }

        wizStep += direction;

        // Render next
        if (wizStep === 4) {
          document.getElementById("wizard-success").classList.remove("hidden");
          document.getElementById("wizard-actions").classList.add("hidden");

          // Set text on summary success screen
          document.getElementById("wiz-res-name").innerText =
            document.getElementById("wiz-name").value;
          document.getElementById("wiz-res-cat").innerText = selectedCategory;

          // Read checked urgency value
          const urgencies = document.getElementsByName("wizard-urgency");
          let checkedUrgency = "Sin urgencia";
          for (let i = 0; i < urgencies.length; i++) {
            if (urgencies[i].checked) {
              checkedUrgency = urgencies[i].value;
              break;
            }
          }
          document.getElementById("wiz-res-urg").innerText = checkedUrgency;
          document.getElementById("wizard-progress").innerText = "Listo";
          document.getElementById("wizard-progress").className =
            "text-xs font-bold text-white bg-emerald-600 px-3 py-1 rounded-full uppercase";
        } else {
          document.getElementById("wizard-step-" + wizStep).classList.remove("hidden");
          document.getElementById("wizard-progress").innerText = "Paso " + wizStep + " de 3";

          // Toggle visibility on prev button
          if (wizStep === 1) {
            btnPrev.classList.add("invisible");
          } else {
            btnPrev.classList.remove("invisible");
          }

          // Adjust text of main action button
          if (wizStep === 3) {
            btnNext.innerText = "Enviar para Estudio";
          } else {
            btnNext.innerText = "Siguiente Paso";
          }
        }
      }

      // Attach wizard button click handlers
      btnNext.addEventListener("click", () => {
        navigateWizard(1);
      });
    </script>
  </body>
