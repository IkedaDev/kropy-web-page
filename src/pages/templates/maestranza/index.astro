---
import SeoHead from "../../../components/SeoHead.astro";

const title = "La Maestranza Al Paso | Sándwiches Premium y Tradición en Temuco";
const description = "La Maestranza Al Paso | Sándwiches Premium y Tradición en Temuco";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Combinación tipográfica Vintage Elegante -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Instrument+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-vintage {
        font-family: "DM Serif Display", serif;
      }
      body {
        font-family: "Instrument Sans", sans-serif;
      }
    </style>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <!-- BARRA DE BIENVENIDA -->
    <div
      class="border-b border-amber-500/20 bg-red-950 px-4 py-2 text-center text-xs font-medium tracking-widest text-amber-200 uppercase"
    >
      📜 Recetas patrimoniales con el verdadero sabor ferroviario de la Araucanía
    </div>

    <!-- NAVBAR VINTAGE -->
    <header
      class="bg-opacity-95 sticky top-0 z-50 border-b border-stone-200 bg-stone-50 backdrop-blur-md"
    >
      <div class="mx-auto flex h-24 max-w-6xl items-center justify-between px-4">
        <a href="#" class="group flex flex-col text-left">
          <span class="font-vintage text-2xl leading-none tracking-wide text-red-900 md:text-3xl"
            >La Maestranza</span
          >
          <span
            class="mt-1 border-t border-amber-800/20 pt-0.5 text-[10px] font-bold tracking-widest text-amber-700 uppercase md:text-xs"
            >SÁNDWICHES AL PASO</span
          >
        </a>

        <nav
          class="hidden items-center gap-8 text-xs font-bold tracking-widest text-stone-600 uppercase md:flex"
        >
          <a href="#historia" class="transition-colors hover:text-red-900">Nuestra Estación</a>
          <a href="#carta" class="transition-colors hover:text-red-900">Nuestros Sándwiches</a>
          <a href="#itinerario" class="transition-colors hover:text-red-900">Horarios y Destino</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56966667777?text=Hola%20La%20Maestranza,%20deseo%20hacer%20un%20pedido%20al%20paso"
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-none border border-red-950 bg-red-900 px-6 py-3 text-center text-xs font-semibold tracking-widest text-amber-50 uppercase shadow-sm transition-all hover:bg-red-950"
          >
            Hacer Pedido
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO TRADICIONAL -->
      <section
        class="relative border-b border-stone-200 bg-[radial-gradient(#e7e5e4_1px,transparent_1px)] [background-size:20px_20px] py-16 lg:py-24"
      >
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 md:grid-cols-2">
          <div class="space-y-6 text-center md:text-left">
            <span class="block text-xs font-bold tracking-widest text-amber-700 uppercase"
              >Desde el corazón del Barrio Estación</span
            >
            <h1 class="font-vintage text-4xl leading-tight text-red-900 sm:text-5xl lg:text-6xl">
              Sándwiches con historia y carne de verdad.
            </h1>
            <p class="mx-auto max-w-md text-base leading-relaxed text-stone-600 md:mx-0 md:text-lg">
              Herederos del sabor de antaño. Cocinamos nuestra carne mechada en olla de fierro
              durante 6 horas continuas. Ingredientes de la zona seleccionados para un bajón con
              identidad chilena.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#carta"
                class="bg-red-900 px-8 py-4 text-xs font-bold tracking-widest text-white uppercase shadow-md transition-colors hover:bg-red-950"
              >
                Explorar la Carta
              </a>
              <a
                href="#itinerario"
                class="border border-stone-300 bg-transparent px-8 py-4 text-xs font-bold tracking-widest text-stone-800 uppercase transition-all hover:bg-stone-100"
              >
                ¿Cómo llegar?
              </a>
            </div>
          </div>

          <div class="flex justify-center">
            <div
              class="relative max-w-sm rounded-none border border-stone-200 bg-stone-100 p-4 shadow-xl"
            >
              <!-- Pequeño sello estético de época -->
              <div
                class="absolute -top-4 -right-4 rotate-12 transform border border-amber-700 bg-amber-600 px-3 py-1 text-[10px] font-bold tracking-widest text-stone-950 uppercase"
              >
                ⭐ Sabor Casero
              </div>
              <img
                src="https://images.unsplash.com/photo-1553909489-cd47e0907980?q=80&w=600&auto=format&fit=crop"
                alt="Sándwich gourmet de carne mechada premium con queso fundido"
                class="h-80 w-full object-cover uppercase grayscale-[10%] sepia-[15%] filter"
              />
              <p class="font-vintage mt-3 text-center text-sm text-stone-800 italic">
                "El verdadero sándwich de olla chileno"
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN RESEÑA / CONCEPTO -->
      <section id="historia" class="mx-auto max-w-4xl space-y-4 px-4 py-16 text-center">
        <span class="text-xs font-bold tracking-widest text-amber-700 uppercase"
          >Nuestra Filosofía</span
        >
        <h2 class="font-vintage text-3xl text-red-900">Sin atajos, sin prisas en la cocina</h2>
        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-stone-600">
          En La Maestranza no creemos en los ingredientes artificiales. El pan marraqueta se recibe
          tibio cada mañana de panaderías tradicionales de Temuco, la palta se muele al tenedor y
          las salsas se preparan desde cero siguiendo las recetas de nuestras abuelas de la
          Araucanía.
        </p>
        <div class="mx-auto mt-4 h-px w-16 bg-amber-600"></div>
      </section>

      <!-- LA CARTA PATRIMONIAL -->
      <section id="carta" class="border-y border-stone-200 bg-stone-100 py-16">
        <div class="mx-auto max-w-6xl px-4">
          <div class="mx-auto mb-12 max-w-xl space-y-2 text-center">
            <h2 class="font-vintage text-3xl text-red-900">Especialidades de la Cocina</h2>
            <p class="text-xs font-medium tracking-widest text-stone-500 uppercase">
              Servidos al paso en el momento exacto
            </p>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Sándwich 1 -->
            <div
              class="flex flex-col justify-between border border-stone-200 bg-stone-50 p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <div class="space-y-4">
                <div class="border-b border-stone-200 pb-3">
                  <span
                    class="mb-1 block text-[10px] font-bold tracking-widest text-amber-700 uppercase"
                    >El Orgullo de la Casa</span
                  >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-vintage text-xl text-stone-900">Mechada Ferroviaria</h3>
                    <span class="text-sm font-bold whitespace-nowrap text-red-900">$6.200</span>
                  </div>
                </div>
                <p class="text-xs leading-relaxed text-stone-600">
                  Abundante carne mechada desmenuzada al jugo en marraqueta crujiente, acompañada de
                  rodajas de tomate campestre, palta natural y nuestra ají verde suave seleccionado.
                </p>
              </div>
              <a
                href="https://wa.me/56966667777?text=Hola!%20Quiero%20encargar%20la%20Mechada%20Ferroviaria"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 block w-full border border-red-900/40 bg-transparent py-3 text-center text-xs font-bold tracking-widest text-red-900 uppercase transition-colors hover:bg-red-900 hover:text-white"
              >
                Encargar al Paso
              </a>
            </div>

            <!-- Sándwich 2 -->
            <div
              class="flex flex-col justify-between border border-stone-200 bg-stone-50 p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <div class="space-y-4">
                <div class="border-b border-stone-200 pb-3">
                  <span
                    class="mb-1 block text-[10px] font-bold tracking-widest text-amber-700 uppercase"
                    >Tradición de Campo</span
                  >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-vintage text-xl text-stone-900">Churrasco Obrero</h3>
                    <span class="text-sm font-bold whitespace-nowrap text-red-900">$5.900</span>
                  </div>
                </div>
                <p class="text-xs leading-relaxed text-stone-600">
                  Finos cortes de asiento de vacuno a la plancha, abundante queso mantecoso fundido
                  de fundo regional y una ligera pincelada de ajo asado en pan frica artesanal.
                </p>
              </div>
              <a
                href="https://wa.me/56966667777?text=Hola!%20Quiero%20encargar%20el%20Churrasco%20Obrero"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 block w-full border border-red-900/40 bg-transparent py-3 text-center text-xs font-bold tracking-widest text-red-900 uppercase transition-colors hover:bg-red-900 hover:text-white"
              >
                Encargar al Paso
              </a>
            </div>

            <!-- Sándwich 3 -->
            <div
              class="flex flex-col justify-between border border-stone-200 bg-stone-50 p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <div class="space-y-4">
                <div class="border-b border-stone-200 pb-3">
                  <span
                    class="mb-1 block text-[10px] font-bold tracking-widest text-amber-700 uppercase"
                    >Fritas al Momento</span
                  >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-vintage text-xl text-stone-900">Empanada de Pino Real</h3>
                    <span class="text-sm font-bold whitespace-nowrap text-red-900">$2.500</span>
                  </div>
                </div>
                <p class="text-xs leading-relaxed text-stone-600">
                  Empanada frita XL rellena de pino de vacuno picado a cuchillo (no molido),
                  sazonada con comino de época, cebolla bien sudada, huevo duro y aceituna entera.
                </p>
              </div>
              <a
                href="https://wa.me/56966667777?text=Hola!%20Quiero%20encargar%20la%20Empanada%20de%20Pino%20Real"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 block w-full border border-red-900/40 bg-transparent py-3 text-center text-xs font-bold tracking-widest text-red-900 uppercase transition-colors hover:bg-red-900 hover:text-white"
              >
                Encargar al Paso
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ITINERARIO / UBICACIÓN -->
      <section id="itinerario" class="mx-auto max-w-6xl px-4 py-16">
        <div
          class="grid items-center gap-12 rounded-none border border-stone-800 bg-stone-900 p-8 text-stone-100 md:grid-cols-2 lg:p-12"
        >
          <div class="space-y-6">
            <span class="block text-xs font-bold tracking-widest text-amber-500 uppercase"
              >¿Dónde encontrarnos?</span
            >
            <h2 class="font-vintage text-3xl text-amber-100">Estación de Destino</h2>
            <p class="text-sm leading-relaxed text-stone-400">
              Estamos ubicados a pasos del polo patrimonial y comercial de Temuco, en un punto
              accesible tanto para trabajadores como para familias que buscan rescatar el sabor
              clásico nacional.
            </p>

            <div
              class="space-y-4 border-l-2 border-amber-600 pl-4 text-xs font-semibold tracking-wide text-stone-300 uppercase"
            >
              <div>
                <p class="text-[10px] font-bold text-amber-500">📍 Andén Principal:</p>
                <p class="mt-1 font-normal text-stone-100 normal-case">
                  Av. Barros Arana 0420 (Frente al Museo Ferroviario), Temuco, Región de la
                  Araucanía.
                </p>
              </div>
              <div>
                <p class="text-[10px] font-bold text-amber-500">🕒 Horario Ferroviario:</p>
                <p class="mt-1 font-normal text-stone-100 normal-case">
                  Lunes a Viernes: 11:30 a 20:30 hrs (Ideal almuerzo y once de regreso).
                </p>
                <p class="mt-1 font-normal text-stone-100 normal-case">
                  Sábados: 11:30 a 16:00 hrs.
                </p>
                <p class="mt-1 font-normal text-red-400 normal-case">
                  Domingos: Cerrado por descanso de maestras.
                </p>
              </div>
            </div>

            <div class="pt-2">
              <a
                href="tel:+56966667777"
                class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-amber-400 uppercase transition-colors hover:text-amber-300"
              >
                <span>📞 Teléfono Fijo de Pedidos: +56 9 6666 7777</span>
              </a>
            </div>
          </div>

          <!-- Contenedor estético del Mapa -->
          <div class="border border-stone-700 bg-stone-950 p-2">
            <div
              class="relative flex h-64 flex-col items-center justify-center bg-stone-900 p-6 text-center"
            >
              <span class="mb-2 text-3xl">🚂</span>
              <h4 class="font-vintage text-lg tracking-wide text-amber-400">
                Eje Histórico Barros Arana
              </h4>
              <p class="mt-1 mb-4 max-w-xs text-[11px] text-stone-500">
                Reemplaza este bloque por un mapa interactivo de Google Maps. Ideal para la
                indexación de SEO Local de tu cliente en Temuco.
              </p>
              <a
                href="https://maps.google.com"
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-none border border-red-950 bg-red-900 px-5 py-3 text-[10px] font-bold tracking-widest text-white uppercase transition-colors hover:bg-red-950"
              >
                Ver Mapa de Vías
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER EDITORIAL -->
    <footer class="border-t border-stone-900 bg-stone-950 py-12 text-xs text-stone-500">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 border-t border-stone-900/40 px-4 pt-4 sm:flex-row"
      >
        <div class="space-y-1 text-center sm:text-left">
          <p class="font-vintage text-lg tracking-wide text-amber-200">La Maestranza</p>
          <p class="text-[11px] text-stone-600">
            &copy; 2026 Tradición al Paso. Temuco, Región de la Araucanía, Chile.
          </p>
        </div>
        <div
          class="space-y-1 text-center font-bold tracking-widest text-stone-600 uppercase sm:text-right"
        >
          <p class="text-stone-400">Patrimonio Gastronómico de la Frontera</p>
          <p class="text-[10px] font-normal text-stone-600 normal-case">
            Template optimizado con estándares estrictos de accesibilidad y marcado semántico
            estructural.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
