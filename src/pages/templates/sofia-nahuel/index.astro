---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Sofía Nahuel | Fotógrafa de Bodas & Retratos en Temuco y Pucón";
const description = "Sofía Nahuel | Fotógrafa de Bodas & Retratos en Temuco y Pucón";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Elegant Sans and Minimal Editorial Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@200;300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Tailwind Theme Customization (Cinematic Charcoal & Fine Champagne gold) -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ["Montserrat", "sans-serif"],
              serif: ["Cinzel", "serif"],
            },
            colors: {
              obsidian: {
                50: "#f6f6f6",
                900: "#121214",
                950: "#0a0a0b",
              },
              champagne: {
                100: "#fbf7f0",
                400: "#dfcfb7",
                500: "#c5b093",
                600: "#a68f70",
              },
              mist: {
                100: "#eceff1",
                500: "#90a4ae",
              },
            },
          },
        },
      };
    </script>

    <!-- Schema.org JSON-LD para SEO de Profesional de Fotografía Local -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "PhotographyStore",
        "name": "Sofía Nahuel Fotografía",
        "image": "https://images.unsplash.com/photo-1554080353-a576cf803bda?auto=format&fit=crop&w=800&q=80",
        "@id": "https://www.sofianahuel.cl/#photographer",
        "url": "https://www.sofianahuel.cl/",
        "telephone": "+56987654321",
        "priceRange": "$$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Pasaje El Vergel 430",
          "addressLocality": "Temuco",
          "addressRegion": "Araucanía",
          "postalCode": "4780000",
          "addressCountry": "CL"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -38.7396,
          "longitude": -72.5903
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:00",
          "closes": "20:00"
        }
      }
    </script>
  </head>
  <body
    class="bg-obsidian-950 text-obsidian-50 selection:bg-champagne-500 selection:text-obsidian-950 font-sans antialiased"
  >
    <!-- Header / Navigation -->
    <header
      class="bg-obsidian-950/80 sticky top-0 z-50 border-b border-white/5 backdrop-blur-md transition-all duration-300"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-20 items-center justify-between">
          <!-- Signature Logo -->
          <a href="#inicio" class="group flex flex-col focus:outline-none">
            <span
              class="group-hover:text-champagne-400 font-serif text-xl font-bold tracking-widest text-white transition-colors sm:text-2xl"
              >SOFÍA NAHUEL</span
            >
            <span
              class="text-champagne-500 -mt-1 block text-[9px] font-light tracking-[0.3em] uppercase"
              >Fotografía de Historias</span
            >
          </a>

          <!-- Desktop Navigation Menu -->
          <nav class="hidden items-center space-x-8 md:flex">
            <a
              href="#sobre-mi"
              class="hover:text-champagne-400 text-xs font-medium tracking-widest text-white/70 uppercase transition-colors"
              >Sobre Mí</a
            >
            <a
              href="#portafolio"
              class="hover:text-champagne-400 text-xs font-medium tracking-widest text-white/70 uppercase transition-colors"
              >Portafolio</a
            >
            <a
              href="#experiencia"
              class="hover:text-champagne-400 text-xs font-medium tracking-widest text-white/70 uppercase transition-colors"
              >La Experiencia</a
            >
            <a
              href="#tarifas"
              class="hover:text-champagne-400 text-xs font-medium tracking-widest text-white/70 uppercase transition-colors"
              >Inversión</a
            >
            <a
              href="#preguntas"
              class="hover:text-champagne-400 text-xs font-medium tracking-widest text-white/70 uppercase transition-colors"
              >Preguntas</a
            >
            <a
              href="#contacto"
              class="border-champagne-400/30 hover:border-champagne-400 text-champagne-400 hover:bg-champagne-600/10 inline-flex items-center justify-center rounded-none border px-5 py-2.5 text-[10px] font-semibold tracking-wider uppercase transition-all duration-300 hover:text-white"
            >
              Agendar Sesión
            </a>
          </nav>

          <!-- Mobile Menu Button -->
          <div class="flex items-center md:hidden">
            <button
              id="mobile-menu-btn"
              type="button"
              class="hover:text-champagne-400 text-white focus:outline-none"
              aria-label="Menu"
            >
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  id="menu-icon-open"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
                <path
                  id="menu-icon-close"
                  class="hidden"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Navigation Panel -->
      <div
        id="mobile-menu"
        class="bg-obsidian-900 hidden space-y-4 border-b border-white/5 px-4 pt-4 pb-8 md:hidden"
      >
        <a
          href="#sobre-mi"
          class="hover:text-champagne-400 block rounded-none px-3 py-2 text-xs font-medium tracking-wider text-white/80 uppercase hover:bg-white/5"
          >Sobre Mí</a
        >
        <a
          href="#portafolio"
          class="hover:text-champagne-400 block rounded-none px-3 py-2 text-xs font-medium tracking-wider text-white/80 uppercase hover:bg-white/5"
          >Portafolio</a
        >
        <a
          href="#experiencia"
          class="hover:text-champagne-400 block rounded-none px-3 py-2 text-xs font-medium tracking-wider text-white/80 uppercase hover:bg-white/5"
          >La Experiencia</a
        >
        <a
          href="#tarifas"
          class="hover:text-champagne-400 block rounded-none px-3 py-2 text-xs font-medium tracking-wider text-white/80 uppercase hover:bg-white/5"
          >Inversión</a
        >
        <a
          href="#preguntas"
          class="hover:text-champagne-400 block rounded-none px-3 py-2 text-xs font-medium tracking-wider text-white/80 uppercase hover:bg-white/5"
          >Preguntas</a
        >
        <a
          href="#contacto"
          class="border-champagne-500 text-champagne-400 hover:bg-champagne-500/10 block w-full border px-4 py-3 text-center text-xs font-semibold tracking-widest uppercase transition-colors"
        >
          Agendar Sesión de Fotos
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section
      id="inicio"
      class="bg-obsidian-950 relative flex min-h-screen items-center justify-center overflow-hidden"
    >
      <!-- Background moody landscape image with heavy overlay -->
      <div class="absolute inset-0 z-0">
        <div
          class="from-obsidian-950 via-obsidian-950/40 to-obsidian-950/70 absolute inset-0 bg-gradient-to-t"
        >
        </div>
        <img
          src="https://images.unsplash.com/photo-1475503572774-15a45e5d60b9?auto=format&fit=crop&w=1920&q=80"
          alt="Fotografía de boda en bosque del sur"
          class="h-full w-full object-cover opacity-35 grayscale filter"
          onerror="this.src='https://placehold.co/1920x1080/0a0a0b/ffffff?text=Bosque+de+la+Araucania'"
        />
      </div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
        <span class="text-champagne-400 mb-3 block text-xs font-semibold tracking-[0.4em] uppercase"
          >MATRIMONIOS & EDITORIAL DE AUTOR</span
        >
        <h1
          class="mb-6 font-serif text-4xl leading-none font-light tracking-tight text-white sm:text-6xl lg:text-8xl"
        >
          Capturar el sur <br />
          <span class="text-champagne-400 italic">en una mirada</span>
        </h1>
        <p
          class="mx-auto mb-8 max-w-2xl text-sm leading-relaxed font-light text-white/70 sm:text-lg"
        >
          Historias reales y luz indómita en Temuco, Pucón, Villarrica y la indomable Patagonia. Mi
          enfoque documental busca eternizar la risa espontánea, el viento de la Araucanía y los
          abrazos honestos.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="#contacto"
            class="bg-champagne-500 hover:bg-champagne-600 text-obsidian-950 inline-flex items-center justify-center rounded-none px-8 py-3.5 text-xs font-semibold tracking-widest uppercase shadow-lg transition-all duration-300"
          >
            Reserva tu Cita
          </a>
          <a
            href="#portafolio"
            class="inline-flex items-center justify-center rounded-none border border-white/20 px-8 py-3.5 text-xs font-semibold tracking-widest text-white uppercase transition-all duration-300 hover:border-white"
          >
            Explora el Portafolio
          </a>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div
        class="absolute bottom-8 left-1/2 flex -translate-x-1/2 transform flex-col items-center gap-2 text-white/40"
      >
        <span class="text-[9px] font-light tracking-[0.3em] uppercase">Deslizar</span>
        <div class="relative h-12 w-1 overflow-hidden rounded-full bg-white/10">
          <div
            class="bg-champagne-400 absolute top-0 right-0 left-0 h-4 animate-bounce rounded-full"
          >
          </div>
        </div>
      </div>
    </section>

    <!-- About Section (Personal Profile) -->
    <section id="sobre-mi" class="bg-obsidian-900 border-y border-white/5 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
          <!-- Left: Portrait with southern aesthetic overlay -->
          <div class="relative lg:col-span-5">
            <div
              class="border-champagne-500/20 absolute inset-0 z-0 translate-x-4 translate-y-4 border"
            >
            </div>
            <div class="bg-obsidian-950 relative z-10 overflow-hidden p-2 shadow-2xl">
              <!-- Portrait placeholder resembling a southern photographer -->
              <img
                src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&h=1000&q=80"
                alt="Sofía Nahuel fotógrafa en Temuco"
                class="h-[450px] w-full object-cover contrast-110 grayscale filter"
                onerror="this.src='https://placehold.co/800x1000/0a0a0b/ffffff?text=Sofia+Nahuel+Retrato'"
              />
            </div>
          </div>

          <!-- Right: Artistic Statement -->
          <div class="space-y-6 lg:col-span-7">
            <span class="text-champagne-500 block text-xs font-semibold tracking-[0.3em] uppercase"
              >Detrás del Lente</span
            >
            <h2 class="font-serif text-3xl font-light tracking-wide text-white sm:text-5xl">
              La luz esculpida por el bosque
            </h2>
            <div class="bg-champagne-400 h-px w-16"></div>
            <p class="text-sm leading-relaxed font-light text-white/80 sm:text-base">
              Soy Sofía, nacida bajo la lluvia de la Región de la Araucanía. Estudié Artes Visuales
              y encontré en la cámara el medio perfecto para capturar la mística de nuestro paisaje
              sureño y las uniones más íntimas de las personas.
            </p>
            <p class="text-sm leading-relaxed font-light text-white/60">
              No me atraen las poses forzadas, la iluminación sobrecargada ni las sonrisas fingidas.
              Prefiero el retrato sutil que habla de un lazo genuino, las arrugas en los ojos al
              reír, la elegancia de una ceremonia al aire libre junto al Lago Villarrica, o la
              atmósfera nublada de un atardecer invernal en Temuco.
            </p>

            <!-- Personal stats / details -->
            <div class="grid grid-cols-2 gap-6 border-t border-white/5 pt-6 sm:grid-cols-3">
              <div>
                <span class="text-champagne-400 block font-serif text-2xl font-bold">7+ Años</span>
                <p class="mt-1 text-[10px] tracking-widest text-white/50 uppercase">
                  Guardando memorias en el sur
                </p>
              </div>
              <div>
                <span class="text-champagne-400 block font-serif text-2xl font-bold"
                  >150+ Bodas</span
                >
                <p class="mt-1 text-[10px] tracking-widest text-white/50 uppercase">
                  Testimonios documentados
                </p>
              </div>
              <div>
                <span class="text-champagne-400 block font-serif text-2xl font-bold">U. Mayor</span>
                <p class="mt-1 text-[10px] tracking-widest text-white/50 uppercase">
                  Formación en Artes visuales
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portafolio" class="bg-obsidian-950 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <span class="text-champagne-500 block text-xs font-semibold tracking-[0.3em] uppercase"
            >El Trabajo</span
          >
          <h2 class="mt-2 font-serif text-3xl font-light tracking-wide text-white sm:text-4xl">
            Momentos Atrapados en el Tiempo
          </h2>
          <div class="bg-champagne-400 mx-auto mt-4 h-px w-16"></div>
        </div>

        <!-- Interactive Categories Filter -->
        <div class="mb-10 flex flex-wrap justify-center gap-2">
          <button
            onclick="filterPortfolio('all')"
            class="portfolio-filter-btn text-obsidian-950 hover:text-obsidian-950 rounded-none border border-white/10 bg-white px-6 py-2 text-[10px] font-semibold tracking-widest uppercase transition-all hover:bg-white"
          >
            Todos
          </button>
          <button
            onclick="filterPortfolio('bodas')"
            class="portfolio-filter-btn hover:text-champagne-400 rounded-none border border-white/10 px-6 py-2 text-[10px] font-semibold tracking-widest uppercase transition-all hover:bg-white/5"
          >
            Bodas & Elopements
          </button>
          <button
            onclick="filterPortfolio('retratos')"
            class="portfolio-filter-btn hover:text-champagne-400 rounded-none border border-white/10 px-6 py-2 text-[10px] font-semibold tracking-widest uppercase transition-all hover:bg-white/5"
          >
            Retratos Editorial
          </button>
          <button
            onclick="filterPortfolio('naturaleza')"
            class="portfolio-filter-btn hover:text-champagne-400 rounded-none border border-white/10 px-6 py-2 text-[10px] font-semibold tracking-widest uppercase transition-all hover:bg-white/5"
          >
            Paisaje & Editorial
          </button>
        </div>

        <!-- Photo Grid -->
        <div id="portfolio-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Photo 1: Boda -->
          <div
            class="portfolio-item bodas group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Boda íntima en Pucón"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase"
                >Pucón, Araucanía</span
              >
              <h3 class="mt-1 font-serif text-lg font-medium text-white">
                Elopement en las Faldas del Volcán
              </h3>
            </div>
          </div>

          <!-- Photo 2: Retrato -->
          <div
            class="portfolio-item retratos group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Retrato de mujer en la neblina"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase">Temuco</span>
              <h3 class="mt-1 font-serif text-lg font-medium text-white">
                Retrato en Luz Natural de Invierno
              </h3>
            </div>
          </div>

          <!-- Photo 3: Naturaleza -->
          <div
            class="portfolio-item naturaleza group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Paisaje de montaña y araucarias"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase"
                >Parque Conguillío</span
              >
              <h3 class="mt-1 font-serif text-lg font-medium text-white">
                La Soledad de las Araucarias Milenarias
              </h3>
            </div>
          </div>

          <!-- Photo 4: Boda -->
          <div
            class="portfolio-item bodas group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Boda en cabaña de madera"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase"
                >Lago Villarrica</span
              >
              <h3 class="mt-1 font-serif text-lg font-medium text-white">Conexión Junto al Lago</h3>
            </div>
          </div>

          <!-- Photo 5: Retrato -->
          <div
            class="portfolio-item retratos group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Sesion personal de retrato editorial"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase"
                >Estudio Temuco</span
              >
              <h3 class="mt-1 font-serif text-lg font-medium text-white">
                Miradas de Contrastes Profundos
              </h3>
            </div>
          </div>

          <!-- Photo 6: Naturaleza -->
          <div
            class="portfolio-item naturaleza group bg-obsidian-900 relative aspect-[4/5] cursor-pointer overflow-hidden"
            onclick="openLightbox(this)"
          >
            <img
              src="https://images.unsplash.com/photo-1542224566-6e85f2e6772f?auto=format&fit=crop&w=800&h=1000&q=80"
              alt="Sendero bajo coihues"
              class="h-full w-full object-cover contrast-110 grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:filter-none"
            />
            <div
              class="from-obsidian-950 absolute inset-0 flex flex-col justify-end bg-gradient-to-t via-transparent to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-90"
            >
              <span class="text-champagne-400 text-[9px] tracking-widest uppercase"
                >Cerro Ñielol</span
              >
              <h3 class="mt-1 font-serif text-lg font-medium text-white">
                Senderos de Lluvia y Bosque Nativo
              </h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience & Philosophy (The "Why") -->
    <section
      id="experiencia"
      class="bg-obsidian-900 relative overflow-hidden border-t border-white/5 py-20"
    >
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <!-- Text Column -->
          <div class="space-y-6">
            <span class="text-champagne-500 block text-xs font-semibold tracking-[0.3em] uppercase"
              >Filosofía de Trabajo</span
            >
            <h2 class="font-serif text-3xl font-light tracking-wide text-white sm:text-4xl">
              La fotografía como un legado de familia
            </h2>
            <div class="bg-champagne-400 h-px w-16"></div>
            <p class="text-sm leading-relaxed font-light text-white/80 sm:text-base">
              Tu sesión de fotos o el día de tu boda no deberían sentirse como una obligación de
              posar continuamente. Trabajo con un flujo orgánico: guío de manera sutil pero dejo
              espacio a que tu esencia ruede libre de presiones.
            </p>

            <div class="space-y-4">
              <div class="flex gap-4">
                <div
                  class="border-champagne-500/20 text-champagne-400 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-none border bg-white/5"
                >
                  <span class="text-xs font-bold">01</span>
                </div>
                <div>
                  <h4 class="text-xs font-semibold tracking-widest text-white uppercase">
                    Conexión Previa
                  </h4>
                  <p class="mt-1 text-xs text-white/60">
                    Nos juntamos a conversar (en Temuco o vía videollamada) para conocer qué les
