    </footer>

    <!-- Lightbox Modal -->
    <div
      id="lightbox-modal"
      class="bg-obsidian-950/95 fixed inset-0 z-50 flex hidden items-center justify-center p-4 backdrop-blur-md"
    >
      <button
        onclick="closeLightbox()"
        class="hover:text-champagne-400 absolute top-6 right-6 text-2xl text-white focus:outline-none"
        aria-label="Cerrar"
      >
        ✕
      </button>
      <div class="flex w-full max-w-4xl flex-col items-center">
        <img
          id="lightbox-img"
          src=""
          alt="Ampliada"
          class="max-h-[80vh] max-w-full border border-white/5 object-contain"
        />
        <p
          id="lightbox-caption"
          class="mt-4 text-center text-xs font-light tracking-wider text-white/60"
        >
        </p>
      </div>
    </div>

    <!-- JavaScript Controllers -->
    <script>
      // Mobile Navigation Toggle
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("menu-icon-open");
      const closeIcon = document.getElementById("menu-icon-close");

      mobileBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      });

      // Close mobile panel on menu click
      const navLinks = mobileMenu.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          openIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        });
      });

      // FAQ Accordion Handler
      function toggleFaq(faqId) {
        const el = document.getElementById(faqId);
        const icon = document.getElementById("faq-icon-" + faqId.split("-")[1]);

        if (el.classList.contains("hidden")) {
          el.classList.remove("hidden");
          icon.classList.add("rotate-180");
        } else {
          el.classList.add("hidden");
          icon.classList.remove("rotate-180");
        }
      }

      // Portfolio Filtering logic
      function filterPortfolio(category) {
        const items = document.querySelectorAll(".portfolio-item");
        const buttons = document.querySelectorAll(".portfolio-filter-btn");

        // Style buttons accordingly
        buttons.forEach((btn) => {
          btn.classList.remove("bg-white", "text-obsidian-950");
          btn.classList.add("hover:bg-white/5", "hover:text-champagne-400");
        });

        // Re-apply active styles based on trigger
        event.currentTarget.classList.add("bg-white", "text-obsidian-950");
        event.currentTarget.classList.remove("hover:bg-white/5", "hover:text-champagne-400");

        // Toggle visibility
        items.forEach((item) => {
          if (category === "all" || item.classList.contains(category)) {
            item.classList.remove("hidden");
          } else {
            item.classList.add("hidden");
          }
        });
      }

      // Pricing Plans Data & Selector
      const pricingData = {
        bodas: [
          {
            badge: "Esencial",
            title: "Elopement Íntimo",
            desc: "Perfecto para uniones privadas o ceremonias íntimas al aire libre.",
            price: "$350.000",
            features: [
              "✓ 4 horas de cobertura continua",
              "✓ 150 fotos reveladas digitalmente",
              "✓ Galería online privada por 6 meses",
              "✓ Cobertura por Sofía Nahuel",
            ],
          },
          {
            badge: "Completo",
            title: "Boda Coihue",
            desc: "Cobertura de la jornada completa desde preparativos a la fiesta.",
            price: "$650.000",
            features: [
              "✓ Cobertura completa (hasta 10 horas)",
              "✓ 400+ fotos reveladas con retoque",
              "✓ Galería online privada por 1 año",
              "✓ Sesión previa pre-boda de regalo",
            ],
          },
          {
            badge: "Premium",
            title: "Boda Volcán Premium",
            desc: "Máxima cobertura con dos fotógrafos y libro impreso premium.",
            price: "$980.000",
            features: [
              "✓ Cobertura completa (sin límites de horas)",
              "✓ Segundo fotógrafo de asistencia",
              "✓ 600+ fotos con retoque fino",
              "✓ Libro impreso (Photobook) tapa de cuero",
            ],
          },
        ],
        retratos: [
          {
            badge: "Digital",
            title: "Sesión Simple",
            desc: "Ideal para renovación de portafolio personal o fotos al aire libre.",
            price: "$120.000",
            features: [
              "✓ 1 hora de sesión en locación",
              "✓ 20 fotos en alta resolución editadas",
              "✓ 1 cambio de vestuario",
              "✓ Entrega digital en 10 días",
            ],
          },
          {
            badge: "Recomendado",
            title: "Retrato de Autor",
            desc: "Sesión conceptual profunda para marcas personales o artistas.",
            price: "$180.000",
            features: [
              "✓ 2 horas de sesión artística",
              "✓ 40 fotos finamente editadas",
              "✓ 3 cambios de vestuarios",
              "✓ Asesoría previa de concepto y look",
            ],
          },
          {
            badge: "Completo",
            title: "Sesión de Pareja",
            desc: "Sesión romántica de pre-boda en paisajes icónicos del sur.",
            price: "$220.000",
            features: [
              "✓ 3 horas de sesión en Pucón o Villarrica",
              "✓ 60 fotos con retoque de color sureño",
              "✓ Galería privada para descarga directa",
              "✓ Ideal para invitaciones de boda",
            ],
          },
        ],
      };

      function selectPricingCategory(category) {
        // Adjust buttons style
        const buttons = document.querySelectorAll(".pricing-toggle-btn");
        buttons.forEach((btn) => {
          btn.className =
            "pricing-toggle-btn px-6 py-2.5 border border-white/10 text-[10px] font-semibold uppercase tracking-widest hover:bg-white/5 hover:text-champagne-400 transition-all rounded-none";
        });

        const activeBtn = document.getElementById("p-btn-" + category);
        activeBtn.className =
          "pricing-toggle-btn px-6 py-2.5 border border-champagne-500 text-[10px] font-semibold uppercase tracking-widest bg-champagne-500 text-obsidian-950 transition-all rounded-none";

        // Update content elements (Card 1, Card 2, Card 3)
        const data = pricingData[category];

        // Card 1
        document.getElementById("p1-badge").innerText = data[0].badge;
        document.getElementById("p1-title").innerText = data[0].title;
        document.getElementById("p1-desc").innerText = data[0].desc;
        document.getElementById("p1-price").innerHTML =
          `${data[0].price} <span class="text-xs text-white/50 font-sans font-light">CLP</span>`;
        renderFeatures("p1-features", data[0].features);

        // Card 2
        document.getElementById("p2-badge").innerText = data[1].badge;
        document.getElementById("p2-title").innerText = data[1].title;
        document.getElementById("p2-desc").innerText = data[1].desc;
        document.getElementById("p2-price").innerHTML =
          `${data[1].price} <span class="text-xs text-white/50 font-sans font-light">CLP</span>`;
        renderFeatures("p2-features", data[1].features);

        // Card 3
        document.getElementById("p3-badge").innerText = data[2].badge;
        document.getElementById("p3-title").innerText = data[2].title;
        document.getElementById("p3-desc").innerText = data[2].desc;
        document.getElementById("p3-price").innerHTML =
          `${data[2].price} <span class="text-xs text-white/50 font-sans font-light">CLP</span>`;
        renderFeatures("p3-features", data[2].features);
      }

      function renderFeatures(containerId, featuresArray) {
        const el = document.getElementById(containerId);
        el.innerHTML = "";
        featuresArray.forEach((f) => {
          const li = document.createElement("li");
          li.className = "flex items-center gap-2";
          li.innerText = f;
          el.appendChild(li);
        });
      }

      // Lightbox Modal Controller
      const lightbox = document.getElementById("lightbox-modal");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");

      function openLightbox(element) {
        const img = element.querySelector("img");
        const title = element.querySelector("h3") ? element.querySelector("h3").innerText : "";
        const location = element.querySelector("span")
          ? element.querySelector("span").innerText
          : "";

        lightboxImg.src = img.src;
        lightboxCaption.innerText = title ? `${title} — ${location}` : "";
        lightbox.classList.remove("hidden");
      }

      function closeLightbox() {
        lightbox.classList.add("hidden");
        lightboxImg.src = "";
      }

      // Contact Submission
      function handleBookingSubmit(event) {
        event.preventDefault();
        document.getElementById("booking-form").classList.add("hidden");
        document.getElementById("booking-success").classList.remove("hidden");
      }
    </script>
  </body>
</html>
