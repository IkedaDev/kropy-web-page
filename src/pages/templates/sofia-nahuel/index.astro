              <li>
                <a href="#tarifas" class="hover:text-champagne-400 transition-colors"
                  >Inversión & Planes</a
                >
              </li>
              <li>
                <a href="#preguntas" class="hover:text-champagne-400 transition-colors"
                  >Preguntas Clientes</a
                >
              </li>
            </ul>
          </div>

          <!-- Location details -->
          <div>
            <h4 class="mb-4 text-[10px] font-semibold tracking-widest text-white uppercase">
              Región Cobertura
            </h4>
            <p class="text-xs leading-relaxed font-light text-white/50">
              Sesiones regulares en Temuco, Padre Las Casas, Villarrica, Pucón, Licanray,
              Curarrehue, Angol, y Victoria. Envíos de dossiers a todo Chile.
