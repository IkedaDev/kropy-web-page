        <!-- Bottom Credits -->
        <div
          class="flex flex-col items-center justify-between border-t border-white/5 pt-8 text-[10px] sm:flex-row"
        >
          <p>
            &copy; 2026 Sofía Nahuel Fotografía. Todos los derechos reservados. Temuco, Araucanía,
            Chile.
          </p>
          <div class="mt-4 flex gap-4 sm:mt-0">
            <a href="#" class="transition-colors hover:text-white">Políticas de Privacidad</a>
            <a href="#" class="transition-colors hover:text-white">Uso de Galería</a>
