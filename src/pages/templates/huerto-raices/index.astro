---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Huerto Raíces | Canastas Agroecológicas Premium en Temuco";
const description = "Huerto Raíces | Canastas Agroecológicas Premium en Temuco";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Combinación Minimalista y de Alta Gama (Serif Literaria + Sans Invisible) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;600&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-serif-lux {
        font-family: "Cormorant Garamond", serif;
      }
      body {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>
  <body class="bg-stone-50 text-neutral-800 antialiased selection:bg-neutral-200">
    <!-- HEADER MINIMALISTA -->
    <header
      class="sticky top-0 z-50 border-b border-neutral-200/60 bg-stone-50/80 backdrop-blur-md"
    >
      <div class="mx-auto flex h-20 max-w-5xl items-center justify-between px-6">
        <a href="#" class="flex flex-col text-left tracking-widest">
          <span class="font-serif-lux text-2xl leading-none font-semibold text-neutral-900"
            >huerto raíces</span
          >
          <span class="mt-1 text-[9px] font-medium tracking-widest text-stone-400 uppercase"
            >cultivo consciente · temuco</span
          >
        </a>

        <nav
          class="hidden items-center gap-10 text-[11px] font-medium tracking-widest text-neutral-500 uppercase md:flex"
        >
          <a href="#filosofia" class="transition-colors hover:text-neutral-900">Origen</a>
          <a href="#canastas" class="transition-colors hover:text-neutral-900">La Cosecha</a>
          <a href="#contacto" class="transition-colors hover:text-neutral-900">Contacto</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56911112222?text=Hola%20Huerto%20Raices,%20me%20gustaria%20suscribirme%20a%20las%20canastas%20semanales"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-neutral-900 px-5 py-2.5 text-[10px] font-semibold tracking-widest text-neutral-900 uppercase transition-all hover:bg-neutral-900 hover:text-white"
          >
            Suscribirse
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO LIMPIO Y TIPOGRÁFICO -->
      <section class="mx-auto max-w-5xl border-b border-neutral-200/40 px-6 py-20 lg:py-32">
        <div class="grid items-center gap-12 md:grid-cols-12">
          <div class="space-y-6 text-center md:col-span-7 md:text-left">
            <span class="block text-[10px] font-semibold tracking-widest text-stone-400 uppercase"
              >Sustentabilidad local desde la Araucanía</span
            >
            <h1
              class="font-serif-lux text-4xl leading-tight font-medium text-neutral-900 sm:text-5xl lg:text-6xl"
            >
              La belleza de lo simple. Alimentos cosechados <span
                class="font-normal text-stone-500 italic">con calma</span
              >.
            </h1>
            <p class="mx-auto max-w-md text-sm leading-relaxed font-light text-neutral-500 md:mx-0">
              Cuidamos parcelas a pequeña escala en las afueras de Temuco. No utilizamos pesticidas
              químicos ni procesos acelerados. El resultado son vegetales de sabor honesto, repletos
              de vida y nutrientes esenciales.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row md:justify-start">
              <a
                href="#canastas"
                class="bg-neutral-900 px-8 py-4 text-center text-[10px] font-medium tracking-widest text-white uppercase transition-colors hover:bg-neutral-800"
              >
                Ver Cosecha de la Semana
              </a>
            </div>
          </div>

          <div class="flex justify-center md:col-span-5">
            <div
              class="aspect-[3/4] w-full max-w-xs overflow-hidden bg-neutral-200 grayscale-[20%] transition-all duration-700 hover:grayscale-0"
            >
              <img
                src="https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=600&auto=format&fit=crop"
                alt="Verduras frescas cosechadas ordenadas de forma minimalista sobre un fondo neutro"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- VALORES / MANIFESTO MINIMALISTA -->
      <section id="filosofia" class="mx-auto max-w-4xl space-y-6 px-6 py-24 text-center">
        <span class="text-[10px] font-semibold tracking-widest text-stone-400 uppercase"
          >El Manifesto</span
        >
        <h2 class="font-serif-lux text-3xl font-medium text-neutral-900">
          Respetar los ciclos estacionales
        </h2>
        <p class="mx-auto max-w-xl text-sm leading-relaxed font-light text-neutral-500">
          Cada semana armamos nuestras canastas basándonos exclusivamente en lo que la tierra de
          Temuco está lista para entregar de forma natural. Sin invernaderos forzados
          artificialmente, sin largas cadenas de distribución de miles de kilómetros. Solo pureza
          local y frescura radical.
        </p>
      </section>

      <!-- SECCIÓN DE PRODUCTOS / EXPERIENCIA DE SUSCRIPCIÓN -->
      <section id="canastas" class="border-y border-neutral-200/40 bg-neutral-100/50 py-20">
        <div class="mx-auto max-w-5xl px-6">
          <div class="mb-16 space-y-1 text-center md:text-left">
            <span class="block text-[10px] font-semibold tracking-widest text-stone-400 uppercase"
              >Suscripciones Disponibles</span
            >
            <h2 class="font-serif-lux text-3xl font-medium text-neutral-900">
              Nuestras Canastas de Temporada
            </h2>
          </div>

          <div class="mx-auto grid max-w-3xl gap-12 sm:mx-0 sm:grid-cols-2">
            <!-- Canasta 1 -->
            <div class="flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="aspect-[4/3] w-full overflow-hidden bg-neutral-200 grayscale-[10%]">
                  <img
                    src="https://images.unsplash.com/photo-1574316071802-0d684efa7bf5?q=80&w=500&auto=format&fit=crop"
                    alt="Canasta básica de mimbre con hortalizas frescas del huerto"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="flex items-baseline justify-between border-b border-neutral-200 pb-2">
                  <h3 class="font-serif-lux text-xl font-semibold text-neutral-900">
                    Canasta Raíces Esencial
                  </h3>
                  <span class="text-xs font-semibold tracking-wider text-neutral-600"
                    >$18.000 / Semanal</span
                  >
                </div>
                <p class="text-xs leading-relaxed font-light text-neutral-500">
                  Ideal para 1 o 2 personas. Incluye un mix seleccionado de 5 variedades de
                  hortalizas de hoja verde, raíces de estación, un frasco de hierbas aromáticas
                  deshidratadas y 6 huevos de gallina libre de campo.
                </p>
              </div>
              <div class="pt-2">
                <a
                  href="https://wa.me/56911112222?text=Hola!%20Me%20interesa%20la%20Canasta%20Raices%20Esencial"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block w-full border border-neutral-900 bg-neutral-900 py-3.5 text-center text-[10px] font-medium tracking-widest text-white uppercase transition-colors hover:bg-transparent hover:text-neutral-900"
                >
                  Solicitar Canasta Semanal
                </a>
              </div>
            </div>

            <!-- Canasta 2 -->
            <div class="flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="aspect-[4/3] w-full overflow-hidden bg-neutral-200 grayscale-[10%]">
                  <img
                    src="https://images.unsplash.com/photo-1595855759920-86582396756a?q=80&w=500&auto=format&fit=crop"
                    alt="Canasta familiar agroecologica abundante"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="flex items-baseline justify-between border-b border-neutral-200 pb-2">
                  <h3 class="font-serif-lux text-xl font-semibold text-neutral-900">
                    Canasta Familiar Copiosa
                  </h3>
                  <span class="text-xs font-semibold tracking-wider text-neutral-600"
                    >$32.000 / Semanal</span
                  >
                </div>
                <p class="text-xs leading-relaxed font-light text-neutral-500">
                  Diseñada para familias conscientes. Una abundante selección de 8 variedades de
                  hortalizas de raíz y hoja, 12 huevos de campo, frutas de la estación (frutillas o
                  frambuesas locales) y un producto artesanal sorpresa de la comunidad.
                </p>
              </div>
              <div class="pt-2">
                <a
                  href="https://wa.me/56911112222?text=Hola!%20Me%20interesa%20la%20Canasta%20Familiar%20Copiosa"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block w-full border border-neutral-900 bg-neutral-900 py-3.5 text-center text-[10px] font-medium tracking-widest text-white uppercase transition-colors hover:bg-transparent hover:text-neutral-900"
                >
                  Solicitar Canasta Semanal
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN DE TRAZABILIDAD / DETALLES SUTILES -->
      <section class="mx-auto grid max-w-5xl items-center gap-12 px-6 py-20 md:grid-cols-2">
        <div class="space-y-4">
          <span class="block text-[10px] font-semibold tracking-widest text-stone-400 uppercase"
            >Trazabilidad Absoluta</span
          >
          <h3 class="font-serif-lux text-2xl font-medium text-neutral-900">
            De nuestra tierra a tu mesa, sin escalas intermedias
          </h3>
          <p class="text-xs leading-relaxed font-light text-neutral-500">
            Creemos firmemente en los canales cortos de comercialización. Cuando te suscribes a
            Huerto Raíces, sabes exactamente quién sembró la semilla, cómo se regó la planta y qué
            día exacto se desprendió de la tierra. Cero desperdicio, frescura inigualable.
          </p>
          <div
            class="space-y-2 pt-2 text-[11px] font-medium tracking-widest text-neutral-700 uppercase"
          >
            <p class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-400"></span> Agua de vertiente de napas cordilleranas
              certificadas.
            </p>
            <p class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-stone-400"></span> Reciclaje orgánico mediante
              compostaje y lombricultura.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-square overflow-hidden bg-neutral-200">
            <img
              src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?q=80&w=300&auto=format&fit=crop"
              alt="Detalle del cultivo"
              class="h-full w-full object-cover grayscale filter"
            />
          </div>
          <div class="aspect-square overflow-hidden bg-neutral-200">
            <img
              src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?q=80&w=300&auto=format&fit=crop"
              alt="Paisaje de campo natural"
              class="h-full w-full object-cover grayscale filter"
            />
          </div>
        </div>
      </section>

      <!-- CONTACTO, RUTAS Y GEOLOCALIZACIÓN SEO -->
      <section id="contacto" class="border-t border-neutral-200/60 bg-stone-100/50 py-20">
        <div class="mx-auto grid max-w-5xl items-start gap-12 px-6 md:grid-cols-12">
          <div class="space-y-6 md:col-span-6">
            <h3 class="font-serif-lux text-2xl font-medium text-neutral-900">
              Visitas e Información
            </h3>
            <p class="text-xs leading-relaxed font-light text-neutral-500">
              Aunque funcionamos prioritariamente bajo un modelo de reparto a domicilio coordinado
              en Temuco, abrimos nuestras puertas los fines de semana para retiros directos y
              recorridos guiados por los cultivos.
            </p>

            <div
              class="space-y-4 text-[11px] font-medium tracking-widest text-neutral-600 uppercase"
            >
              <div class="space-y-1 border-l border-neutral-300 pl-4">
                <p class="text-[9px] font-semibold text-neutral-400">📍 El Predio:</p>
                <p class="text-xs font-normal tracking-normal text-neutral-900 normal-case">
                  Camino Viejo a Cholchol KM 4.2 (Sector Tromén Rulo), Temuco, Región de la
                  Araucanía.
                </p>
              </div>
              <div class="space-y-1 border-l border-neutral-300 pl-4">
                <p class="text-[9px] font-semibold text-neutral-400">🕒 Cosecha y Entregas:</p>
                <p class="text-xs font-normal tracking-normal text-neutral-900 normal-case">
                  Martes y Viernes: Rutas de reparto en Temuco y Padre Las Casas (09:00 a 14:00
                  hrs).
                </p>
                <p class="text-xs font-normal tracking-normal text-neutral-900 normal-case">
                  Sábados: Retiros en el huerto y atención directa (10:00 a 16:00 hrs).
                </p>
              </div>
            </div>
          </div>

          <!-- Simulación Estética de Mapa Minimalista -->
          <div class="w-full border border-neutral-200 bg-white p-1 md:col-span-6">
            <div
              class="relative flex h-64 flex-col items-center justify-center overflow-hidden bg-stone-50 p-6 text-center"
            >
              <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#000_1px,transparent_1px),linear-gradient(to_bottom,#000_1px,transparent_1px)] bg-[size:24px_24px] opacity-5"
              >
              </div>
              <span class="font-serif-lux mb-2 text-xl text-stone-400 italic">Coordenadas</span>
              <h4 class="font-serif-lux text-lg font-medium tracking-wide text-neutral-900">
                Sector Rural Norte - Temuco
              </h4>
              <p
                class="mt-1 mb-4 max-w-xs font-sans text-[11px] leading-relaxed font-light text-neutral-400"
              >
                Configura aquí el iframe oficial de Google Maps. Indispensable para capturar
                búsquedas de geolocalización específicas y optimizar el SEO local.
              </p>
              <a
                href="https://maps.google.com"
                target="_blank"
                rel="noopener noreferrer"
                class="border border-neutral-900 px-5 py-2.5 text-[10px] font-semibold tracking-widest text-neutral-900 uppercase transition-colors hover:bg-neutral-900 hover:text-white"
              >
                Abrir Ubicación Digital
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER MINIMALISTA -->
    <footer
      class="border-t border-neutral-200/40 bg-stone-50 py-16 text-[11px] font-medium tracking-widest text-neutral-400"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 sm:flex-row"
      >
        <div class="space-y-1 text-center sm:text-left">
          <p class="font-serif-lux text-xl font-semibold tracking-wide text-neutral-900 lowercase">
            huerto raíces
          </p>
          <p class="font-sans text-[10px] font-light tracking-normal text-stone-400 normal-case">
            &copy; 2026 Cultivo Consciente. Todos los derechos reservados. Temuco, Araucanía, Chile.
          </p>
        </div>
        <div class="space-y-1 text-center text-[9px] font-semibold sm:text-right">
          <p class="text-neutral-500">Desarrollo Semántico Estricto sin parámetros decimales.</p>
          <p class="font-sans font-light tracking-normal text-stone-400 normal-case">
            Diseñado con enfoque de velocidad móvil instantánea e indexación limpia para motores de
            búsqueda.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
