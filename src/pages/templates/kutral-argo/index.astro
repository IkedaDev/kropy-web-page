---
import SeoHead from "../../../components/SeoHead.astro";

const title = "Kutral AgroInsumos | Bioestimulantes y Riego Tecnificado en Temuco";
const description = "Kutral AgroInsumos | Bioestimulantes y Riego Tecnificado en Temuco";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <SeoHead title={title} description={description} />

    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Combinación de Alta Tecnología y Precisión Gráfica -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono&family=Urbanist:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      .font-tech {
        font-family: "Space Mono", monospace;
      }
      body {
        font-family: "Urbanist", sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased">
    <!-- TICKER DE MONITOREO CLIMÁTICO / ALERTA AGRO -->
    <div
      class="font-tech border-b border-lime-400 bg-lime-500 px-4 py-2 text-center text-xs font-bold tracking-widest text-slate-950 uppercase"
    >
      [ALERTA COSECHA] Descuento del 15% en líneas de Riego Automatizado por Temporada Invernal en
      la Región.
    </div>

    <!-- HEADER / NAVBAR AGTECH -->
    <header
      class="bg-opacity-90 sticky top-0 z-50 border-b border-slate-900 bg-slate-950 backdrop-blur-md"
    >
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="#" class="flex items-center gap-3">
          <div
            class="font-tech flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-lime-400 to-emerald-600 font-black text-slate-950"
          >
            K_
          </div>
          <div class="flex flex-col">
            <span class="font-tech text-base font-bold tracking-tighter text-white"
              >KUTRAL<span class="text-lime-400">.AGRO</span></span
            >
            <span class="text-[9px] font-semibold tracking-widest text-slate-500 uppercase"
              >Tecnología de Cultivo</span
            >
          </div>
        </a>

        <nav
          class="font-tech hidden items-center gap-8 text-xs tracking-wider text-slate-400 uppercase md:flex"
        >
          <a href="#soluciones" class="transition-colors hover:text-lime-400">// Soluciones</a>
          <a href="#lineas" class="transition-colors hover:text-lime-400">// BioInsumos</a>
          <a href="#soporte" class="transition-colors hover:text-lime-400">// Ingeniería</a>
        </nav>

        <div>
          <a
            href="https://wa.me/56922223333?text=Hola%20Kutral%20Agro,%20necesito%20asesoria%20tecnica%20para%20un%20proyecto"
            target="_blank"
            rel="noopener noreferrer"
            class="font-tech block rounded-md border border-lime-500/30 bg-slate-900 px-4 py-2.5 text-center text-xs font-bold tracking-wider text-lime-400 uppercase transition-all hover:bg-lime-500 hover:text-slate-950"
          >
            Asesoría En Línea
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO HIGH-TECH AGRO -->
      <section
        class="relative overflow-hidden border-b border-slate-800 bg-slate-900 py-16 lg:py-24"
      >
        <!-- Retícula digital de fondo sutil -->
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,#84cc16_1px,transparent_1px),linear-gradient(to_bottom,#84cc16_1px,transparent_1px)] bg-[size:32px_32px] opacity-5"
        >
        </div>

        <div
          class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8"
        >
          <div class="space-y-6 text-center lg:col-span-7 lg:text-left">
            <span
              class="font-tech block inline-block rounded border border-slate-800 bg-slate-950 px-3 py-1.5 text-xs tracking-widest text-lime-400 uppercase"
            >
              // BIO-INGENIERÍA APLICADA AL SUR DE CHILE
            </span>
            <h1
              class="text-4xl leading-none font-black tracking-tight text-white uppercase sm:text-5xl lg:text-6xl"
            >
              Optimiza el rendimiento biológico de tu <span
                class="bg-gradient-to-r from-lime-400 to-emerald-400 bg-clip-text text-transparent"
                >suelo</span
              >
            </h1>
            <p
              class="mx-auto max-w-xl text-sm leading-relaxed font-medium text-slate-400 md:text-base lg:mx-0"
            >
              Kutral desarrolla y distribuye insumos agrícolas con base científica para enfrentar
              las cambiantes condiciones climáticas de la Araucanía. Fertilidad inteligente,
              micronutrientes quelatados y automatización hidráulica avanzada.
            </p>
            <div class="flex flex-col justify-center gap-4 pt-2 sm:flex-row lg:justify-start">
              <a
                href="#lineas"
                class="font-tech rounded-lg bg-lime-500 px-8 py-4 text-center text-xs font-bold tracking-wider text-slate-950 uppercase shadow-lg shadow-lime-500/10 transition-all hover:bg-lime-400"
              >
                Ver Catálogo Técnico
              </a>
              <a
                href="#soporte"
                class="font-tech rounded-lg border border-slate-800 bg-slate-950 px-8 py-4 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-all hover:bg-slate-800"
              >
                Cálculo de Riego Goteo
              </a>
            </div>
          </div>

          <div class="flex justify-center lg:col-span-5">
            <div
              class="relative w-full max-w-md rounded-xl border border-slate-800 bg-slate-950 p-4 shadow-2xl"
            >
              <div
                class="font-tech absolute top-6 left-6 z-20 rounded border border-lime-500/20 bg-slate-900/90 px-3 py-1 text-[10px] text-lime-400 uppercase"
              >
                ID_CULTIVO: #9842X
              </div>
              <img
                src="https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?q=80&w=600&auto=format&fit=crop"
                alt="Plantaciones agrícolas tecnificadas controladas bajo invernadero automatizado"
                class="h-72 w-full rounded-lg object-cover shadow-lg brightness-90 saturate-125 filter lg:h-80"
              />
              <div
                class="font-tech mt-4 flex items-center justify-between rounded border border-slate-800 bg-slate-900 p-3 text-xs text-slate-400"
              >
                <span>Módulo de Control Radicular</span>
                <span class="text-emerald-400">● ACTIVO</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN MATRIZ DE EFICIENCIA (GRID TÉCNICO) -->
      <section id="soluciones" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="font-tech grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="space-y-3 rounded-xl border border-slate-800 bg-slate-900 p-8">
            <p class="text-sm font-bold text-lime-400">// 01. BIOESTIMULACIÓN</p>
            <h3 class="text-base font-bold tracking-tight text-white uppercase">
              Activación Celular Activa
            </h3>
            <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
              Fórmulas orgánicas concentradas que aceleran el enraizamiento y mejoran la absorción
              de Nitrógeno, Fósforo y Potasio en suelos fríos.
            </p>
          </div>
          <div class="space-y-3 rounded-xl border border-slate-800 bg-slate-900 p-8">
            <p class="text-sm font-bold text-lime-400">// 02. HIDRO-CONTROL</p>
            <h3 class="text-base font-bold tracking-tight text-white uppercase">
              Riego por Goteo de Precisión
            </h3>
            <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
              Sistemas integrales con goteros autocompensados que reducen el gasto hídrico y
              optimizan la entrega de nutrientes disueltos (Fertirriego).
            </p>
          </div>
          <div
            class="space-y-3 rounded-xl border border-slate-800 bg-slate-900 p-8 sm:col-span-2 lg:col-span-1"
          >
            <p class="text-sm font-bold text-lime-400">// 03. SUSTRATOS MIX</p>
            <h3 class="text-base font-bold tracking-tight text-white uppercase">
              Precisión de Propagación
            </h3>
            <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
              Turba e inertes con pH estabilizado para germinación controlada en bandejas de alta
              densidad, minimizando la mortandad de plántulas.
            </p>
          </div>
        </div>
      </section>

      <!-- LÍNEAS DE INSUMOS DISPONIBLES (PRODUCTOS) -->
      <section id="lineas" class="border-y border-slate-900 bg-slate-900/50 py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div
            class="mb-12 flex flex-col items-start justify-between border-b border-slate-800 pb-6 md:flex-row md:items-end"
          >
            <div>
              <span class="font-tech block text-xs text-lime-400"
                >// UNIDADES DE ALTO RENDIMIENTO</span
              >
              <h2 class="mt-1 text-3xl font-black text-white uppercase">
                Insumos Biológicos y Estructurales
              </h2>
            </div>
          </div>

          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Ficha Producto 1 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-xl border border-slate-800 bg-slate-950 transition-all hover:border-lime-500/30"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1615485290382-441e4d049cb5?q=80&w=500&auto=format&fit=crop"
                  alt="Bidón químico de bioestimulante agrícola profesional"
                  class="h-44 w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
                />
                <div class="space-y-2 p-6">
                  <div class="font-tech flex items-baseline justify-between gap-2">
                    <h4 class="text-sm font-bold tracking-tight text-white uppercase">
                      Kutral Root Bio-Enraizador
                    </h4>
                    <span class="text-sm font-bold whitespace-nowrap text-lime-400">$48.900</span>
                  </div>
                  <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
                    Bidón de 20 Litros. Extracto concentrado de algas marinas y aminoácidos libres.
                    Diseñado para mitigar el estrés por trasplante y heladas en la zona sur.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922223333?text=Cotizar%20Kutral%20Root%20Bio-Enraizador"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-tech block w-full rounded border border-slate-800 bg-slate-900 py-3 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-lime-500 hover:text-slate-950"
                >
                  Solicitud de Ficha e Importación
                </a>
              </div>
            </div>

            <!-- Ficha Producto 2 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-xl border border-slate-800 bg-slate-950 transition-all hover:border-lime-500/30"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?q=80&w=500&auto=format&fit=crop"
                  alt="Mezclas de tierra y turbas profesionales para invernadero"
                  class="h-44 w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
                />
                <div class="space-y-2 p-6">
                  <div class="font-tech flex items-baseline justify-between gap-2">
                    <h4 class="text-sm font-bold tracking-tight text-white uppercase">
                      Turba Profesional Mezcla Profesional
                    </h4>
                    <span class="text-sm font-bold whitespace-nowrap text-lime-400">$19.500</span>
                  </div>
                  <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
                    Fardo compresado de 80 Litros. Combinación óptima de turba rubia báltica y
                    perlita expandida. Alta retención hídrica con excelente porosidad de aireación.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922223333?text=Cotizar%20Turba%20Profesional%20Mezcla"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-tech block w-full rounded border border-slate-800 bg-slate-900 py-3 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-lime-500 hover:text-slate-950"
                >
                  Solicitud de Ficha e Importación
                </a>
              </div>
            </div>

            <!-- Ficha Producto 3 -->
            <div
              class="group flex flex-col justify-between overflow-hidden rounded-xl border border-slate-800 bg-slate-950 transition-all hover:border-lime-500/30"
            >
              <div>
                <img
                  src="https://images.unsplash.com/photo-1563514223741-21b455043be6?q=80&w=500&auto=format&fit=crop"
                  alt="Cintas de riego y tuberías agrícolas automatizadas"
                  class="h-44 w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
                />
                <div class="space-y-2 p-6">
                  <div class="font-tech flex items-baseline justify-between gap-2">
                    <h4 class="text-sm font-bold tracking-tight text-white uppercase">
                      Cinta de Riego Premium 16mm
                    </h4>
                    <span class="text-sm font-bold whitespace-nowrap text-lime-400">$89.950</span>
                  </div>
                  <p class="font-sans text-xs leading-relaxed font-medium text-slate-400">
                    Rollo técnico de 500 metros. Goteros integrados a 20cm con caudal uniforme de
                    1.2 L/h. Alta resistencia a la radiación UV y taponamientos mecánicos.
                  </p>
                </div>
              </div>
              <div class="p-6 pt-0">
                <a
                  href="https://wa.me/56922223333?text=Cotizar%20Cinta%20de%20Riego%20Premium"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-tech block w-full rounded border border-slate-800 bg-slate-900 py-3 text-center text-xs font-bold tracking-wider text-slate-300 uppercase transition-colors hover:bg-lime-500 hover:text-slate-950"
                >
                  Solicitud de Ficha e Importación
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN DE INGENIERÍA DE PROYECTOS (B2B/FINANCIACIÓN) -->
      <section id="soporte" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div
          class="grid items-center gap-12 rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-8 lg:grid-cols-12 lg:p-12"
        >
          <div class="space-y-6 lg:col-span-7">
            <span class="font-tech block text-xs tracking-widest text-lime-400 uppercase"
              >// INGENIERÍA HIDRÁULICA Y FONDOS CONCURSABLES</span
            >
            <h2 class="text-3xl font-black tracking-tight text-white uppercase">
              Proyectos INDAP / CNR Ley de Riego
            </h2>
            <p class="font-sans text-sm leading-relaxed text-slate-400">
              Desarrollamos memorias técnicas y levantamientos topográficos digitales para la
              postulación a subsidios gubernamentales de riego en la Araucanía. Diseños óptimos
              validados por ingenieros agrónomos expertos para asegurar la adjudicación
              presupuestaria estatal.
            </p>
            <div class="font-tech grid grid-cols-2 gap-4 text-xs text-slate-300 uppercase">
              <div class="rounded border border-slate-800 bg-slate-950 p-3">
                📊 Planos de Cobertura GPS
              </div>
              <div class="rounded border border-slate-800 bg-slate-950 p-3">
                💧 Cubicaciones Hidráulicas
              </div>
              <div class="rounded border border-slate-800 bg-slate-950 p-3">
                🌱 Informes de Aptitud de Suelo
              </div>
              <div class="rounded border border-slate-800 bg-slate-950 p-3">
                💼 Carpetas de Postulación CNR
              </div>
            </div>
          </div>

          <div class="space-y-4 rounded-xl border border-slate-800 bg-slate-950 p-6 lg:col-span-5">
            <h3 class="font-tech text-sm font-bold tracking-wider text-white uppercase">
              // CONFIGURADOR DE DIAGNÓSTICO
            </h3>
            <p class="font-sans text-xs text-slate-400">
              Selecciona el área técnica estimada para recibir un pre-informe logístico por correo o
              WhatsApp.
            </p>

            <form
              action="https://wa.me/56922223333"
              method="GET"
              target="_blank"
              class="font-tech space-y-4 text-xs"
            >
              <input
                type="hidden"
                name="text"
                value="Hola Kutral, solicito pre-evaluación técnica de ingeniería agraria para mi predio."
              />
              <div class="space-y-1">
                <label class="text-[10px] tracking-widest text-slate-500 uppercase"
                  >Superficie Total del Predio</label
                >
                <select
                  class="w-full rounded border border-slate-800 bg-slate-900 px-4 py-3 font-medium text-slate-300 focus:border-lime-400 focus:outline-none"
                >
                  <option>Menos de 2 Hectáreas (Pequeño productor)</option>
                  <option>De 2 a 10 Hectáreas (Mediano predio)</option>
                  <option>Más de 10 Hectáreas (Escala comercial)</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class="text-[10px] tracking-widest text-slate-500 uppercase"
                  >Prioridad del Requerimiento</label
                >
                <select
                  class="w-full rounded border border-slate-800 bg-slate-900 px-4 py-3 font-medium text-slate-300 focus:border-lime-400 focus:outline-none"
                >
                  <option>Instalación de Riego Tecnificado</option>
                  <option>Plan de Nutrición y Fertilización Completa</option>
                  <option>Diseño Mecánico de Invernaderos Metálicos</option>
                </select>
              </div>
              <button
                type="submit"
                class="w-full rounded bg-lime-500 py-3.5 text-xs font-bold tracking-wider text-slate-950 uppercase transition-all hover:bg-lime-400"
              >
                Iniciar Pre-Evaluación Técnica
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- UBICACIÓN LOGÍSTICA / SALIDA NORTE TEMUCO -->
      <section
        class="mx-auto grid max-w-7xl items-center gap-12 border-t border-slate-900 px-4 py-16 sm:px-6 md:grid-cols-2 lg:px-8"
      >
        <div class="space-y-6">
          <h3 class="text-2xl font-black text-white uppercase">
            Despacho Central y Bodegas de Distribución
          </h3>
          <p class="font-sans text-sm leading-relaxed text-slate-400">
            Nuestra base comercial se ubica estratégicamente en el acceso norte de Temuco,
            garantizando un flujo logístico inmediato para camiones de carga pesada hacia comunas
            clave de la Araucanía como Victoria, Vilcún, Lautaro y Galvarino.
          </p>
          <div class="font-tech space-y-4 text-xs text-slate-300 uppercase">
            <div class="flex items-start gap-3">
              <span class="font-bold text-lime-400">[📍]</span>
              <div>
                <p class="font-bold text-white">Oficina de Distribución:</p>
                <p class="mt-0.5 font-sans font-medium text-slate-400 normal-case">
                  Av. Rudecindo Ortega 03400 (Salida Norte, a pasos del paso nivel), Temuco, Región
                  de la Araucanía.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="font-bold text-lime-400">[🕒]</span>
              <div>
                <p class="font-bold text-white">Horarios de Recepción Logística:</p>
                <p class="mt-0.5 font-sans font-medium text-slate-400 normal-case">
                  Lunes a Viernes: 08:30 a 18:00 hrs (Continuo).
                </p>
                <p class="font-sans font-medium text-slate-400 normal-case">
                  Sábados: 09:00 a 13:00 hrs (Coordinación de entregas críticas).
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Simulación de Mapa Técnico / Estilo Cyber-Agro -->
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-2 shadow-inner">
          <div
            class="relative flex h-64 flex-col items-center justify-center overflow-hidden rounded-lg bg-slate-950 p-6 text-center"
          >
            <div
              class="absolute inset-0 bg-[radial-gradient(#84cc16_1px,transparent_1px)] [background-size:16px_16px] opacity-5"
            >
            </div>
            <span class="font-tech mb-1 text-3xl text-lime-400">📡</span>
            <h4 class="font-tech text-sm font-bold tracking-wider text-white uppercase">
              GEO-LOCALIZACIÓN BODEGAS NORTE
            </h4>
            <p class="mt-1 mb-4 max-w-xs font-sans text-[11px] font-medium text-slate-500">
              Incrusta aquí la API o el Iframe de Google Maps corporativo de tu cliente para
              afianzar la indexación en Google Local Business y SEO regional.
            </p>
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-tech rounded border border-slate-800 bg-slate-900 px-5 py-3 text-[10px] font-bold tracking-widest text-lime-400 uppercase transition-colors hover:bg-lime-500 hover:text-slate-950"
            >
              Establecer Ruta de Despacho GPS
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER HIGH-TECH AGRARIO -->
    <footer class="font-tech border-t border-slate-900 bg-slate-950 py-12 text-xs text-slate-500">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:px-6 md:flex-row lg:px-8"
      >
        <div class="space-y-1 text-center md:text-left">
          <p class="text-sm font-bold tracking-tight text-white">
            KUTRAL<span class="text-lime-400">.AGRO</span>
          </p>
          <p class="font-sans font-medium">
            &copy; 2026 Ingeniería de Cultivos. Todos los derechos reservados. Temuco, Araucanía,
            Chile.
          </p>
        </div>
        <div
          class="space-y-1 text-center text-[10px] tracking-widest text-slate-600 uppercase md:text-right"
        >
          <p>Marcado Semántico Avanzado HTML5 / CSS Estricto sin parámetros decimales.</p>
          <p class="font-sans font-medium text-slate-600 normal-case">
            Optimizado para tiempos de carga móvil ultra veloces e indexación orgánica.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
